# Local Postgres (docker compose up -d db). Copy to .env — .env is gitignored.
DATABASE_URL="postgresql://indostore:indostore@localhost:5433/indostore"

# Supabase (Auth + Storage) — filled when a Supabase project is connected (M3). Left blank for local plain-Postgres dev.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
