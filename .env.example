# Local Postgres (docker compose up -d db). Copy to .env — .env is gitignored.
DATABASE_URL="postgresql://indostore:indostore@localhost:5433/indostore"

# Prod target = self-hosted PostgreSQL + PostgREST on a VPS (NOT Supabase).
# In prod, point DATABASE_URL at the VPS Postgres; Auth (JWT) + Storage (VPS / MinIO / S3-compatible)
# + RLS are self-hosted. The same Drizzle migrations apply unchanged.
