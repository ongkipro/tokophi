# Local Postgres (docker compose up -d db). Copy to .env — .env is gitignored.
DATABASE_URL="postgresql://tokophi:tokophi@localhost:5433/tokophi"

# Prod target = self-hosted PostgreSQL + PostgREST on a VPS (NOT Supabase).
# In prod, point DATABASE_URL at the VPS Postgres; Auth (JWT) + Storage (VPS / MinIO / S3-compatible)
# + RLS are self-hosted. The same Drizzle migrations apply unchanged.

# Local auth session secret (JWT signing). Set a strong value per environment.
AUTH_SECRET="change-me"

# KiriminAja shipping — get a sandbox key from developer.kiriminaja.com (Sandbox Dashboard → Integrasi)
KIRIMINAJA_ENV="sandbox"
KIRIMINAJA_API_KEY=""
KIRIMINAJA_ORDER_PREFIX=""

# AutoLaris payment gateway — dev key from seller.autolaris.com
AUTOLARIS_BASE="https://api-h2h.autolaris.com"
AUTOLARIS_API_KEY=""
# Shared secret guarding /api/public/pay/callback (interim, until AutoLaris HMAC spec confirmed).
# MUST be set in production — without it the callback that marks orders PAID is unverified.
AUTOLARIS_CALLBACK_SECRET=""
