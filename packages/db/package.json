{
  "name": "@tokophi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./article-order": "./src/article-order.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -e ../../../../../.env -- drizzle-kit generate",
    "push": "dotenv -e ../../.env -e ../../../../../.env -- drizzle-kit push",
    "migrate": "dotenv -e ../../.env -e ../../../../../.env -- drizzle-kit migrate",
    "studio": "dotenv -e ../../.env -e ../../../../../.env -- drizzle-kit studio",
    "reset": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/reset.ts",
    "seed": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed.ts",
    "seed:areas": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-areas.ts",
    "seed:reviews": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-reviews.ts",
    "seed:templates": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-templates.ts",
    "seed:journal": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-journal.ts",
    "seed:taxonomy": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-taxonomy.ts",
    "seed:products": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-products.ts",
    "seed:demo-ratings": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-demo-ratings.ts",
    "verify-rls": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/verify-rls.ts",
    "verify-rls-app": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/verify-rls-app.ts",
    "seed:recent": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/seed-recent.ts",
    "backfill:ship-address": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/backfill-ship-address.ts",
    "verify-migrations": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/verify-migrations.ts",
    "verify-ledger": "dotenv -e ../../.env -e ../../../../../.env -- tsx src/verify-ledger.ts"
  },
  "dependencies": {
    "@tokophi/lib": "*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@tokophi/sections": "*",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2"
  }
}
