# TokoΦ — env vars to set in Coolify for docker-compose.coolify.yml.
# Set these in Coolify → your resource → Environment Variables. The compose has dev-safe
# defaults for everything except secrets; override these before real use.

# --- Postgres (internal) ---
POSTGRES_PASSWORD=change-me-strong

# --- Auth (REQUIRED — do not ship the dev default) ---
AUTH_SECRET=generate-a-long-random-string

# --- KiriminAja shipping (platform-managed; from your sandbox/prod key) ---
KIRIMINAJA_ENV=sandbox
KIRIMINAJA_API_KEY=
KIRIMINAJA_ORDER_PREFIX=

# --- AutoLaris payment (platform-managed) ---
AUTOLARIS_BASE=https://api-h2h.autolaris.com
AUTOLARIS_API_KEY=
# guards /api/public/pay/callback — REQUIRED once payments are live
AUTOLARIS_CALLBACK_SECRET=

# --- Billing cron (schedule GET /api/cron/billing?secret=… daily via Coolify Scheduled Task) ---
CRON_SECRET=generate-a-random-string

# --- Cross-surface URLs (fill AFTER Coolify assigns domains to each service) ---
# admin's public URL — used for the payment callback_url
PUBLIC_APP_URL=https://admin.example.tld
# super-admin → admin deep-link (impersonation "Buka panel admin")
ADMIN_URL=https://admin.example.tld
# storefront (browser) → admin public endpoints
PUBLIC_ONGKIR_API=https://admin.example.tld/api/public/ongkir
PUBLIC_ORDER_API=https://admin.example.tld/api/public/order
