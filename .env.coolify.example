# TokoΦ — env vars to set in Coolify for docker-compose.coolify.yml.
# Set these in Coolify → your resource → Environment Variables. The compose has dev-safe
# defaults for everything except secrets; override these before real use.

# --- Postgres (internal) ---
POSTGRES_PASSWORD=change-me-strong


# Owner/superuser path for migrations and owner-only surfaces.
# Example:
# DATABASE_URL=postgres://tokophi:change-me-strong@postgres:5432/tokophi
#
# Prepared future merchant-admin runtime path only. Do NOT wire the canonical admin service to this
# until owner-only routes (`/api/public/*`, cron, cross-tenant reads) are split onto a second pool.
# Example future value:
# APP_DATABASE_URL=postgres://tokophi_runtime:change-me-runtime@postgres:5432/tokophi

# --- Auth (REQUIRED — do not ship the dev default) ---
AUTH_SECRET=generate-a-long-random-string

# --- Self-serve signup (/daftar + Google auto-provision) ---
# CLOSED unless explicitly enabled — the gate lives in lib/provision.ts (provisionStore), which is the
# choke point BOTH signup paths funnel through, so leaving this unset shuts the front door for real,
# not just visually. Does NOT affect super-admin's own createStore (onboarding by hand still works).
# Re-open with SIGNUP_ENABLED=true + redeploy.
# SIGNUP_ENABLED=true

# --- KiriminAja shipping (platform-managed; from your sandbox/prod key) ---
KIRIMINAJA_ENV=sandbox
KIRIMINAJA_API_KEY=
KIRIMINAJA_ORDER_PREFIX=

# --- AutoLaris payment (platform-managed) ---
AUTOLARIS_BASE=https://api-h2h.autolaris.com
AUTOLARIS_API_KEY=
# guards /api/public/pay/callback — REQUIRED once payments are live
AUTOLARIS_CALLBACK_SECRET=

# --- Billing cron (schedule GET /api/cron/billing?secret=… daily via Coolify Scheduled Task) ---
CRON_SECRET=generate-a-random-string

# --- Cross-surface URLs (fill AFTER Coolify assigns domains to each service) ---
# admin's public URL — used for the payment callback_url
PUBLIC_APP_URL=https://admin.example.tld
# super-admin → admin deep-link (impersonation "Buka panel admin")
ADMIN_URL=https://admin.example.tld
# storefront (browser) → admin public endpoints. MUST be the PUBLIC admin URL, not localhost — the
# SHOPPER's browser calls these cross-origin. The storefront reads them at RUNTIME (process.env), so
# they take effect on deploy without a rebuild. Wrong/empty here = the kecamatan search, order and
# payment all silently fail in production (checkout.astro).
PUBLIC_ONGKIR_API=https://admin.example.tld/api/public/ongkir
PUBLIC_ORDER_API=https://admin.example.tld/api/public/order
# CNAME target a merchant points their custom domain at (Pengaturan → Domain). Optional — code
# defaults to cname.tokophi.cc (apps/admin/lib/data/domain.ts:28) — Cloudflare-for-SaaS runs on the
# tokophi.cc zone, whose fallback origin is cname.tokophi.cc. The three zones: .com = platform
# (landing, app., rich.) · .id = merchant storefronts · .cc = custom-domain fallback origin, nothing else.
# ⚠️ This line said cname.tokophi.COM until 2026-08-08 and that was wrong. Trusting the same stale value
# in specs/docs/CUSTOM_DOMAIN.md cost real work: a fallback origin and a custom hostname were created in
# the WRONG zone, and a merchant was told to CNAME to the wrong target. If prose and code disagree about
# this value, the code wins.
CUSTOM_DOMAIN_CNAME_TARGET=cname.tokophi.cc
# Cloudflare for SaaS custom domains. Token scope: Zone / SSL and Certificates / Edit, limited to
# the tokophi.cc zone.
CF_SAAS_ZONE_ID=
CF_SAAS_API_TOKEN=
