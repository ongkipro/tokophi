---
// Progressive copy-to-clipboard, one implementation for every page (spec §18.1.3). Put <CopyScript />
// once on a page; mark each copy button as
//   <span id="awb">JP123</span>
//   <button type="button" data-copy="awb" hidden>Salin resi</button>
// `data-copy` names the element whose text is copied; `data-copy-value` overrides the copied text.
// Without JS the value stays on the page as selectable text and the button stays hidden, so nothing
// dead is shown. If the clipboard is refused, the text is selected instead and the live region says so.
interface Props {
  /** Announced after a successful copy. */
  copied?: string;
  /** Announced when the clipboard is unavailable and the text was selected instead. */
  selected?: string;
}
const { copied = "Disalin.", selected = "Teks dipilih. Salin secara manual." } = Astro.props;
---
<p class="sr-only" role="status" id="copy-status" data-copied={copied} data-selected={selected}></p>
<script>
  const status = document.getElementById("copy-status");
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const target = document.getElementById(b.dataset.copy!);
    if (!target) continue;
    b.hidden = false;
    const label = b.textContent;
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copyValue ?? target.textContent?.trim() ?? "");
        b.textContent = "Disalin";
        if (status) status.textContent = status.dataset.copied ?? "";
      } catch {
        getSelection()?.selectAllChildren(target);
        if (status) status.textContent = status.dataset.selected ?? "";
      }
      setTimeout(() => (b.textContent = label), 2000);
    });
  }
</script>
