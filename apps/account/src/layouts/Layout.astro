---
// One shell for every account page (spec §18): the prototype's Seller-aligned shell — 256 px sidebar,
// 64 px topbar, centred content, a five-item bottom bar on phones. Two workspaces share it:
// Belanja (buyer) and Affiliate; the workspace comes from the path, never from client state.
// Bahasa Indonesia, no third-party script (pages carry personal data and, on claim/invitation
// links, a secret in the URL).
import "../styles/global.css";
import { db } from "@tokophi/db";
import * as schema from "@tokophi/db/schema";
import { eq, sql } from "drizzle-orm";

export type Section = "beranda" | "pesanan" | "toko" | "alamat" | "akun" | "ringkasan" | "komisi" | "program" | "gabung";
interface Props {
  title: string;
  active?: Section;
  back?: { href: string; label: string };
}
const { title, active, back } = Astro.props;
const account = Astro.locals.account;
const shown = account?.name?.trim() || account?.email || "";
const initials =
  shown
    .split(/[\s@.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join("") || "?";
const affiliate = Astro.url.pathname === "/affiliate" || Astro.url.pathname.startsWith("/affiliate/");
// How many stores this account promotes: decides whether the workspace switch is shown at all.
const programmes = account
  ? Number(
      (
        await db
          .select({ n: sql<number>`count(*)` })
          .from(schema.affiliates)
          .where(eq(schema.affiliates.accountId, account.id))
      )[0]?.n ?? 0,
    )
  : 0;

type Item = { key: Section; href: string; label: string; icon: string };
const I = {
  home: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  box: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  bag: '<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  pin: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  user: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  wallet: '<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  plus: '<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/>',
};
const BUYER: Item[] = [
  { key: "beranda", href: "/", label: "Beranda", icon: I.home },
  { key: "pesanan", href: "/orders", label: "Pesanan", icon: I.box },
  { key: "toko", href: "/stores", label: "Toko", icon: I.bag },
  { key: "alamat", href: "/addresses", label: "Alamat", icon: I.pin },
  { key: "akun", href: "/account", label: "Akun", icon: I.user },
];
const AFFILIATE: Item[] = [
  { key: "ringkasan", href: "/affiliate", label: "Ringkasan", icon: I.home },
  { key: "komisi", href: "/affiliate/komisi", label: "Komisi", icon: I.wallet },
  { key: "program", href: "/affiliate/program", label: "Program", icon: I.link },
  { key: "gabung", href: "/affiliate/gabung", label: "Gabung", icon: I.plus },
  { key: "akun", href: "/account", label: "Akun", icon: I.user },
];
const nav = affiliate ? AFFILIATE : BUYER;
const home = affiliate ? "/affiliate" : "/";
// The brand row and topbar already name the workspace; the identity card says WHO is signed in.
const sub = affiliate && programmes > 0 ? `${programmes} program affiliate` : (account?.email ?? "");
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234f46e5'/%3E%3Ctext x='16' y='23' font-family='Arial,sans-serif' font-size='20' font-weight='700' text-anchor='middle' fill='white'%3E%CE%A6%3C/text%3E%3C/svg%3E" />
    <link rel="preload" href="/assets/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{`${title} · Akun TokoΦ`}</title>
    <script is:inline>
      // Theme before first paint: stored choice (light | dark) → system. One owner of the .dark class.
      (function () {
        var t = null;
        try { t = localStorage.getItem("tphi_theme"); } catch (e) {}
        var dark = t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Langsung ke isi</a>
    {account ? (
      <div class="app-shell" id="buyer-shell">
        <header class="topbar">
          <a class="brand mobile-brand" href={home} aria-label="Akun TokoΦ, beranda">
            <span style="font-weight:600;letter-spacing:-0.02em">Toko<span style="color:var(--primary)">Φ</span></span>
            <span style="font-weight:400;color:var(--muted-foreground)">{affiliate ? "Affiliate" : "Akun"}</span>
          </a>
          <div class="topbar-context">{affiliate ? "Affiliate" : "Akun pembeli"}</div>
          <div class="topbar-actions">
            <button class="icon-button theme-toggle" id="theme-toggle" type="button" aria-label="Ganti tema terang atau gelap">
              <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
              <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            </button>
            <a class="avatar-button" href="/account" aria-label={`Akun saya, ${shown}`}>{initials}</a>
          </div>
        </header>
        <div class="workspace">
          <aside class="sidebar" aria-label="Navigasi akun">
            <a href={home} class="sidebar-brand" aria-label="TokoΦ, beranda"><strong>Toko<span>Φ</span></strong><small>{affiliate ? "Affiliate" : "Akun pembeli"}</small></a>
            <div class="identity-card">
              <span class="avatar avatar-large" aria-hidden="true">{initials}</span>
              <div>
                <strong>{account.name ?? account.email}</strong>
                <span>{sub}</span>
              </div>
            </div>
            {programmes > 0 && (
              <nav class="workspace-switch" aria-label="Ruang kerja">
                <a href="/" aria-current={affiliate ? undefined : "page"}>Belanja</a>
                <a href="/affiliate" aria-current={affiliate ? "page" : undefined}>Affiliate</a>
              </nav>
            )}
            <nav class="sidebar-nav" aria-label="Menu utama">
              {nav.map((n) => (
                <a class="nav-item" href={n.href} aria-current={active === n.key ? "page" : undefined}>
                  <svg viewBox="0 0 24 24" class="nav-icon" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icon} />
                  {n.label}
                </a>
              ))}
            </nav>
            {!affiliate && programmes === 0 && (
              <div class="sidebar-note">
                <strong>Promosikan toko favorit</strong>
                <p>Dapat komisi dari pesanan lewat link Anda. <a href="/affiliate">Jadi affiliate</a></p>
              </div>
            )}
          </aside>
          <main class="content" id="content" tabindex="-1">
            {programmes > 0 && (
              <nav class="workspace-switch mobile-only" aria-label="Ruang kerja">
                <a href="/" aria-current={affiliate ? undefined : "page"}>Belanja</a>
                <a href="/affiliate" aria-current={affiliate ? "page" : undefined}>Affiliate</a>
              </nav>
            )}
            {back && (
              <a class="detail-back" href={back.href}>
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                {back.label}
              </a>
            )}
            <slot />
          </main>
        </div>
        <nav class="mobile-nav" aria-label="Navigasi akun mobile">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? "page" : undefined}>
              <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={n.icon} />
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    ) : (
      <main id="content" tabindex="-1">
        <slot />
      </main>
    )}
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        try { localStorage.setItem("tphi_theme", dark ? "dark" : "light"); } catch {}
      });
    </script>
  </body>
</html>
