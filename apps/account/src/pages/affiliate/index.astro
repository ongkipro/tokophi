---
// Affiliate · Ringkasan (spec §18.4 F): totals across every store, the hold rule in one line, and
// each programme with a share shortcut. Same shell and anatomy as the buyer Beranda.
import Layout from "../../layouts/Layout.astro";
import { db } from "@tokophi/db";
import { IDR } from "@tokophi/lib/format";
import { myAffiliateStores } from "../../data/affiliate";
import { signInUrl } from "../../lib/nav";
import { holdLine } from "../../lib/affiliate-view";
import ProgrammeRow from "./_ProgrammeRow.astro";
import CopyScript from "../../components/CopyScript.astro";
import JoinForm from "./_JoinForm.astro";

const account = Astro.locals.account;
if (!account) return Astro.redirect(signInUrl(Astro.url));
const stores = await myAffiliateStores(db, account.id);
const sum = (k: "readyIdr" | "heldIdr" | "paidIdr") => stores.reduce((s, x) => s + x[k], 0);
const tiles = [
  { label: "Siap dibayar", value: sum("readyIdr"), state: "siap", hint: "Tunggu transfer dari toko" },
  { label: "Masih ditahan", value: sum("heldIdr"), state: "ditahan", hint: "Termasuk belum selesai" },
  { label: "Sudah dibayar", value: sum("paidIdr"), state: "dibayar", hint: "Dicatat oleh toko" },
];
---
<Layout title="Affiliate" active="ringkasan">
  <header class="page-header">
    <div>
      <h1>Affiliate</h1>
      <p class="lead">Semua toko yang Anda promosikan, dalam satu akun. Komisi dihitung dan dibayar oleh masing-masing toko.</p>
    </div>
  </header>

  {Astro.url.searchParams.get("daftar") && (
    <div class="privacy-note aff-notice" role="status">
      <strong>Pendaftaran terkirim.</strong> Seller akan meninjaunya. Statusnya tampil di daftar program di bawah.
    </div>
  )}

  {stores.length === 0 ? (
    <section class="section-card aff-empty">
      <h2>Gabung program toko</h2>
      <p>Anda belum jadi affiliate toko mana pun. Daftar ke program affiliate sebuah toko dengan alamat tokonya. Seller meninjau pendaftaran Anda, lalu kode dan link Anda muncul di sini.</p>
      <JoinForm />
      <p class="field-help aff-after">Sudah jadi affiliate sebuah toko lewat formulir? Minta seller mengirim <strong>link undangan</strong> ke akun ini, supaya komisi Anda di toko itu tampil di sini juga.</p>
    </section>
  ) : (
    <>
      <div class="dashboard-stats-grid aff-stats" role="group" aria-label="Total komisi semua toko">
        {tiles.map((t) => (
          <a class="dashboard-stat-card" href={`/affiliate/komisi?state=${t.state}`}>
            <span class="aff-stat-label">{t.label}</span>
            <strong class="aff-stat-value num">{IDR(t.value)}</strong>
            <span class="aff-stat-note">{t.hint}</span>
          </a>
        ))}
      </div>
      <p class="field-help aff-hold">{holdLine(stores)}</p>

      <section aria-labelledby="prog-h">
        <div class="section-heading">
          <h2 id="prog-h">Program saya</h2>
          <a href="/affiliate/komisi">Lihat semua komisi</a>
        </div>
        <div class="order-list">
          {stores.map((s) => <ProgrammeRow s={s} share />)}
        </div>
        <p class="aff-more"><a class="link-button" href="/affiliate/gabung">+ Gabung program toko lain</a></p>
      </section>
      <CopyScript copied="Link disalin." selected="Link dipilih. Salin secara manual." />
    </>
  )}
</Layout>
