---
import { BILLING } from "@tokophi/lib/billing";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import LandingHero from "../components/LandingHero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import RouteGateway from "../components/RouteGateway.astro";
import StoreDemo from "../components/StoreDemo.astro";
import FinalCta from "../components/FinalCta.astro";

const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "https://app.tokophi.com/daftar";
const demoUrl = import.meta.env.PUBLIC_DEMO_URL || "https://batiknusantara.tokophi.id";
const title = "Platform toko online untuk seller Indonesia";
const description = "Buat toko online dan kelola produk, stok, pesanan, pembayaran, serta pengiriman dari satu Dashboard Seller berbahasa Indonesia.";
const url = "https://tokophi.com/";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${url}#organization`, name: "TokoΦ", url, areaServed: { "@type": "Country", name: "Indonesia" } },
    { "@type": "WebSite", "@id": `${url}#website`, url, name: "TokoΦ", inLanguage: "id-ID", publisher: { "@id": `${url}#organization` } },
    { "@type": "SoftwareApplication", name: "TokoΦ", applicationCategory: "BusinessApplication", operatingSystem: "Web", inLanguage: "id-ID", url, description },
  ],
};
---

<MarketingLayout {title} {description} path="/" {jsonLd} mainClass="home-main">
  <LandingHero {signupUrl} trialDays={BILLING.TRIAL_DAYS} demoUrl="/demo/" />
  <TrustStrip trialDays={BILLING.TRIAL_DAYS} />
  <RouteGateway />
  <StoreDemo {demoUrl} />
  <FinalCta {signupUrl} />
</MarketingLayout>
