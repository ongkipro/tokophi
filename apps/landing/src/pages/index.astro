---
import "../styles/global.css";

// Link targets are configurable at BUILD time (static output) via PUBLIC_* env vars.
// Production values are the defaults; a dev build can point them at localhost:
//   PUBLIC_LOGIN_URL=http://localhost:3000/login PUBLIC_SIGNUP_URL=http://localhost:3000/daftar npm run build -w @tokophi/landing
// `||`, not `??`: an unset Docker ARG becomes an EMPTY STRING env var, not undefined — `??` would
// keep the "" and render href="" (this shipped once; the live buttons had no target).
const loginUrl = import.meta.env.PUBLIC_LOGIN_URL || "https://app.tokophi.com/login";
const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "https://app.tokophi.com/daftar";

const title = "TokoΦ — platform commerce untuk penjual Indonesia";
const description =
  "TokoΦ adalah platform commerce SaaS untuk Indonesia: satu admin untuk mengelola toko online Anda — produk, pesanan, pelanggan, pembayaran, dan pengiriman lokal. Bahasa Indonesia, harga IDR. Segera hadir.";
const url = "https://tokophi.com/";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TokoΦ" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="min-h-dvh">
    <div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-6 py-10 sm:px-8 sm:py-14">
      <!-- Wordmark -->
      <header class="rise">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 rounded-xl text-ink"
          aria-label="TokoΦ — beranda"
        >
          <span
            class="grid size-9 place-items-center rounded-xl bg-primary font-serif text-lg font-bold text-white shadow-lg shadow-primary/25"
            aria-hidden="true">Φ</span
          >
          <span class="text-lg font-semibold tracking-tight">TokoΦ</span>
        </a>
      </header>

      <!-- Hero -->
      <main class="flex flex-1 flex-col justify-center py-14 sm:py-20">
        <p
          class="rise inline-flex w-fit items-center gap-2 rounded-full border border-line bg-white px-3.5 py-1.5 text-xs font-medium text-muted shadow-sm"
          style="animation-delay:60ms"
        >
          <span class="pulse-dot size-1.5 rounded-full bg-primary" aria-hidden="true"></span>
          Sedang dalam pengembangan
        </p>

        <h1
          class="rise mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          style="animation-delay:120ms"
        >
          Segera hadir.
        </h1>

        <p
          class="rise mt-5 max-w-xl text-lg leading-relaxed text-muted text-pretty"
          style="animation-delay:180ms"
        >
          <strong class="font-semibold text-ink">TokoΦ</strong> adalah platform commerce SaaS untuk
          Indonesia — satu admin untuk mengelola toko online Anda: produk, pesanan, pelanggan,
          pembayaran, dan pengiriman.
        </p>

        <!-- What it is (factual, no claims/metrics) -->
        <ul
          class="rise mt-9 grid gap-3 sm:grid-cols-3"
          style="animation-delay:240ms"
        >
          <li class="rounded-xl border border-line bg-white p-4 shadow-sm">
            <h2 class="text-sm font-semibold">Toko online + admin</h2>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Storefront dan panel pengelolaan dalam satu platform.
            </p>
          </li>
          <li class="rounded-xl border border-line bg-white p-4 shadow-sm">
            <h2 class="text-sm font-semibold">Bahasa Indonesia</h2>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Antarmuka Bahasa Indonesia, harga dalam Rupiah.
            </p>
          </li>
          <li class="rounded-xl border border-line bg-white p-4 shadow-sm">
            <h2 class="text-sm font-semibold">Pembayaran &amp; kurir lokal</h2>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              QRIS, e-wallet, transfer, COD, dan kurir dalam negeri.
            </p>
          </li>
        </ul>

        <!-- The two links that work today -->
        <div class="rise mt-10 flex flex-col gap-3 sm:flex-row sm:items-center" style="animation-delay:300ms">
          <a
            href={signupUrl}
            class="inline-flex h-11 items-center justify-center rounded-xl bg-primary px-5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-colors hover:bg-primary-hover"
          >
            Daftar toko
          </a>
          <a
            href={loginUrl}
            class="inline-flex h-11 items-center justify-center rounded-xl border border-line bg-white px-5 text-sm font-semibold text-ink shadow-sm transition-colors hover:bg-primary-soft"
          >
            Masuk
          </a>
          <p class="text-sm text-muted sm:ml-2">Sudah punya toko di TokoΦ? Lanjut ke admin.</p>
        </div>
      </main>

      <footer class="rise border-t border-line pt-6 text-sm text-muted" style="animation-delay:360ms">
        <p>&copy; {new Date().getFullYear()} TokoΦ &middot; tokophi.com</p>
      </footer>
    </div>
  </body>
</html>
