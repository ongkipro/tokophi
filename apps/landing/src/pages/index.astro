---
import "../styles/global.css";

// Link targets are configurable at BUILD time (static output) via PUBLIC_* env vars.
// Production values are the defaults; a dev build can point them at localhost:
//   PUBLIC_LOGIN_URL=http://localhost:3000/login PUBLIC_SIGNUP_URL=http://localhost:3000/daftar npm run build -w @tokophi/landing
// `||`, not `??`: an unset Docker ARG becomes an EMPTY STRING env var, not undefined — `??` would
// keep the "" and render href="" (this shipped once; the live buttons had no target).
const loginUrl = import.meta.env.PUBLIC_LOGIN_URL || "https://app.tokophi.com/login";
const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "https://app.tokophi.com/daftar";

const title = "TokoΦ — satu panel admin untuk toko online Anda";
const description =
  "TokoΦ menyatukan produk, pesanan, pelanggan, pembayaran, dan pengiriman untuk penjual di Indonesia dalam satu panel admin. Bahasa Indonesia, rupiah, kurir dan pembayaran lokal. Situsnya sedang disusun — tokonya sudah bisa dibuat.";
const url = "https://tokophi.com/";
const year = new Date().getFullYear();

// Absolute URL — og:image is one of the few tags crawlers will NOT resolve relatively.
// WhatsApp in particular drops the preview entirely on a relative path.
const ogImage = new URL("/og.png", url).href;

// Structured data. Deliberately NO `offers`/price: the plan is priced ex-PPN (the merchant pays
// base + 11%), so quoting a single number here would be a claim we'd have to defend. Say what
// TokoΦ is, not what it costs.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${url}#organization`,
      name: "TokoΦ",
      url,
      logo: ogImage,
      description,
      areaServed: { "@type": "Country", name: "Indonesia" },
    },
    {
      "@type": "WebSite",
      "@id": `${url}#website`,
      url,
      name: "TokoΦ",
      inLanguage: "id-ID",
      publisher: { "@id": `${url}#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: "TokoΦ",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      inLanguage: "id-ID",
      url,
      publisher: { "@id": `${url}#organization` },
      description,
    },
  ],
};
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfbfe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080913" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TokoΦ" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="TokoΦ — seluruh toko Anda, dalam satu panel." />

    <!-- summary_large_image, not summary: with a 1200x630 card the small variant crops it to a square. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="TokoΦ — seluruh toko Anda, dalam satu panel." />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <!-- One screen, always: the shell owns the viewport height and never scrolls. -->
    <div class="shell">
      <header class="rise shell-head">
        <a href="/" class="wordmark" aria-label="TokoΦ — beranda">
          <span class="wordmark-tile" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
              <ellipse cx="16" cy="16" rx="7.4" ry="9" stroke="currentColor" stroke-width="2.4"></ellipse>
              <rect x="14.8" y="3.6" width="2.4" height="24.8" rx="1.2" fill="currentColor"></rect>
            </svg>
          </span>
          <span class="wordmark-text">TokoΦ</span>
        </a>
      </header>

      <main class="hero">
        <div class="hero-copy">
          <p class="eyebrow rise pill" style="animation-delay:60ms">
            <span class="beacon dot" aria-hidden="true"></span>
            Segera hadir
          </p>

          <h1 class="display rise" style="animation-delay:120ms">
            Seluruh toko Anda, dalam satu panel.
          </h1>

          <p class="lede rise" style="animation-delay:180ms">
            <strong>TokoΦ</strong> menyatukan produk, pesanan, pelanggan, pembayaran, dan pengiriman
            untuk penjual di Indonesia. Situsnya masih kami susun — panel adminnya kami kerjakan
            lebih dulu, dan sudah bisa dipakai.
          </p>

          <div class="cta rise" style="animation-delay:240ms">
            <a href={signupUrl} class="btn btn-primary">Daftar toko</a>
            <a href={loginUrl} class="btn btn-ghost">Masuk</a>
          </div>

          <p class="micro rise" style="animation-delay:300ms">
            Gratis tiga hari untuk mulai. Sudah punya toko di TokoΦ? Langsung masuk.
          </p>
        </div>

        <!-- Signature: Φ is the golden ratio, so the mark sits inside a real Fibonacci
             subdivision (233×144 → 144, 89, 55, 34, 21, 13, 8, 5). Order out of a busy shop. -->
        <div class="plate-wrap" aria-hidden="true">
          <svg class="plate" viewBox="0 0 233 144" role="presentation" focusable="false">
            <g class="plate-grid">
              <rect x="144" y="0" width="89" height="89" class="plate-fill"></rect>
              <rect x="0" y="0" width="144" height="144"></rect>
              <rect x="144" y="0" width="89" height="89"></rect>
              <rect x="178" y="89" width="55" height="55"></rect>
              <rect x="144" y="110" width="34" height="34"></rect>
              <rect x="144" y="89" width="21" height="21"></rect>
              <rect x="165" y="89" width="13" height="13"></rect>
              <rect x="170" y="102" width="8" height="8"></rect>
            </g>
            <g class="plate-mark">
              <ellipse cx="72" cy="72" rx="31" ry="39" fill="none" stroke="currentColor" stroke-width="7.5"
              ></ellipse>
              <rect x="68.25" y="19" width="7.5" height="106" rx="3.75" fill="currentColor"></rect>
            </g>
          </svg>
        </div>
      </main>

      <ul class="facts rise" style="animation-delay:360ms">
        <li>
          <h2 class="fact-label">Satu panel</h2>
          <p>Produk, stok, pesanan, pelanggan, diskon, sampai laporan. Tanpa aplikasi tambahan.</p>
        </li>
        <li>
          <h2 class="fact-label">Bayar &amp; kirim</h2>
          <p>QRIS, e-wallet, transfer bank, COD, dan kurir dalam negeri. Tinggal diaktifkan.</p>
        </li>
        <li>
          <h2 class="fact-label">Bahasa kita</h2>
          <p>Antarmuka Bahasa Indonesia, rupiah tanpa sen, pajak sudah ikut dihitung.</p>
        </li>
      </ul>

      <footer class="rise shell-foot" style="animation-delay:420ms">
        <p>&copy; {year} TokoΦ</p>
        <p>tokophi.com</p>
      </footer>
    </div>
  </body>
</html>
