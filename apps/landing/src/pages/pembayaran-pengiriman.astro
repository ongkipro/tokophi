---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageHero from "../components/PageHero.astro";
import FinalCta from "../components/FinalCta.astro";

const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "https://app.tokophi.com/daftar";
const title = "Pembayaran dan pengiriman toko online | TokoΦ";
const description = "Pahami dukungan QRIS, transfer bank, COD, dan alur pengiriman dalam negeri yang tersedia melalui Tokophi.";
---

<MarketingLayout {title} {description} path="/pembayaran-pengiriman/">
  <PageHero eyebrow="Pembayaran dan pengiriman" title="Transaksi dan pemenuhan dalam konteks pesanan." description="Seller tidak perlu menyiapkan akun payment gateway atau akun kurir terpisah untuk menggunakan layanan yang disediakan melalui Tokophi." primaryHref={signupUrl} primaryLabel="Buat toko" secondaryHref="/faq/" secondaryLabel="Baca FAQ" />
  <section class="section-block" aria-labelledby="payment-title">
    <div class="section-heading-wide" data-motion-reveal><h2 id="payment-title">Pilihan pembayaran untuk pembeli.</h2><p>Kanal yang tersedia dikelola melalui Tokophi. Pilihan pada checkout mengikuti layanan dan pengaturan yang berlaku.</p></div>
    <div class="content-grid" data-motion-stagger>
      <article class="content-card" data-motion-item><p class="label">Digital</p><h3>QRIS</h3><p>Pembeli dapat menyelesaikan pembayaran melalui QRIS ketika kanal tersebut tersedia pada checkout.</p></article>
      <article class="content-card" data-motion-item><p class="label">Perbankan</p><h3>Transfer bank</h3><p>Detail pembayaran ditampilkan dalam alur checkout sesuai metode yang dipilih pembeli.</p></article>
      <article class="content-card" data-motion-item><p class="label">Bayar di tujuan</p><h3>COD</h3><p>Pembeli melakukan pembayaran saat paket diterima untuk pesanan yang menggunakan COD.</p></article>
      <article class="content-card" data-motion-item><p class="label">Transparansi</p><h3>Rincian sebelum konfirmasi</h3><p>Pembeli perlu melihat komponen pembayaran pada checkout sebelum menyelesaikan pesanan.</p></article>
    </div>
  </section>
  <section class="section-block" aria-labelledby="shipping-title">
    <div class="section-heading-wide" data-motion-reveal><h2 id="shipping-title">Pengiriman mengikuti detail pesanan.</h2><p>Seller memeriksa alamat, layanan yang dipilih, dan status pesanan sebelum melanjutkan pemenuhan.</p></div>
    <ol class="numbered-flow" data-motion-stagger>
      <li data-motion-item><h3>Periksa pesanan</h3><p>Pastikan barang, penerima, dan pilihan pengiriman sesuai dengan detail pesanan.</p></li>
      <li data-motion-item><h3>Siapkan paket</h3><p>Seller menyiapkan barang sebelum melanjutkan tahapan pengiriman.</p></li>
      <li data-motion-item><h3>Lanjutkan pengiriman</h3><p>Gunakan alur yang tersedia pada pesanan untuk memproses pengiriman dalam negeri.</p></li>
    </ol>
  </section>
  <aside class="policy-note"><strong>Catatan publikasi biaya</strong><p>Rincian biaya, settlement, dan potongan tidak dipublikasikan di halaman ini sampai kebijakan final telah disetujui dan diterapkan.</p></aside>
  <FinalCta {signupUrl} />
</MarketingLayout>

<style>
  .policy-note { display: grid; grid-template-columns: minmax(10rem, .4fr) minmax(0, 1fr); gap: 1rem 2rem; margin-bottom: clamp(3rem, 7vw, 6rem); padding: 1.25rem; border: 1px solid var(--color-hairline); border-left: 3px solid var(--color-primary); border-radius: .75rem; background: var(--color-primary-soft); }
  .policy-note strong { font-size: .875rem; }
  .policy-note p { color: var(--color-muted); font-size: .875rem; line-height: 1.65; }
  @media (max-width: 560px) { .policy-note { grid-template-columns: 1fr; } }
</style>
