---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Screen from "../components/Screen.astro";
import Closing from "../components/home/Closing.astro";
import { PRICE } from "../lib/offer";

const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "https://app.tokophi.com/daftar";
const demoUrl = import.meta.env.PUBLIC_DEMO_URL || "https://batiknusantara.tokophi.id";
const host = new URL(demoUrl).host;
const title = "Demo Toko Online TokoΦ: Coba Belanja sebagai Pembeli di Ponsel";
const description = "Buka Batik Nusantara, toko demo yang berjalan di TokoΦ. Lihat beranda, halaman produk, keranjang, dan checkout dari ponsel sebelum membuat toko sendiri.";

const tries = [
  { title: "Beranda dan kategori", body: "Halaman yang disusun dengan Store Builder, lengkap dengan logo dan warna toko." },
  { title: "Halaman produk", body: "Galeri foto, harga, pilihan variasi, dan tombol tambah ke keranjang." },
  { title: "Keranjang dan checkout", body: "Isi alamat sampai kecamatan dan lihat ongkir dari beberapa kurir dihitung langsung." },
  { title: "Pilihan pembayaran", body: "QRIS dan Virtual Account, serta COD bila tersedia untuk alamat tujuan." },
] as const;
---

<MarketingLayout {title} {description} path="/demo/">
  <PageIntro
    title="Coba sendiri sebagai pembeli."
    lede="Batik Nusantara adalah toko demo yang berjalan di TokoΦ. Buka dari ponsel Anda dan jelajahi seperti pembeli biasa, dari beranda sampai checkout."
    primary={{ href: demoUrl, label: `Buka ${host}` }}
    secondary={{ href: signupUrl, label: `Coba gratis ${PRICE.trialDays} hari` }}
  />

  <section class="band band-white" aria-labelledby="try-title">
    <div class="section try">
      <div class="try-media">
        <div data-settle><Screen name="storefront-beranda-mobile" kind="phone" alt="Beranda toko demo Batik Nusantara di ponsel" sizes="(min-width: 1024px) 260px, 72vw" /></div>
        <div data-settle><Screen name="storefront-produk-mobile" kind="phone" alt="Halaman produk Celana Kulot Wide Leg di toko demo: foto, harga, stok, pilihan warna dan ukuran" sizes="(min-width: 1024px) 260px, 72vw" /></div>
      </div>
      <div class="try-copy">
        <h2 id="try-title" class="h2">Yang bisa dicoba.</h2>
        <ol class="try-list">
          {tries.map((t) => (
            <li>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ol>
        <p class="try-note">Toko demo untuk dilihat-lihat. Mohon tidak menyelesaikan pembayaran.</p>
        <p class="try-link"><a class="text-link" href={demoUrl} rel="noopener">Buka {host}</a></p>
      </div>
    </div>
  </section>

  <Closing {signupUrl} />
</MarketingLayout>

<style>
  .try { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 5.5rem); align-items: center; }
  .try-media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2rem); align-items: start; }
  /* The second phone sits lower, so the pair reads as two moments of one visit, not a grid. */
  .try-media > :last-child { margin-top: clamp(2rem, 6vw, 4.5rem); }
  .try-list { margin-top: clamp(1.5rem, 3vw, 2rem); counter-reset: try; }
  .try-list li { padding-block: 1rem; border-top: 1px solid var(--color-line); counter-increment: try; }
  .try-list h3 { font-size: var(--fs-item); font-weight: 650; }
  .try-list h3::before { content: counter(try) ". "; color: var(--color-primary-ink); }
  .try-list p { margin-top: 0.3rem; color: var(--color-muted); font-size: 0.9375rem; line-height: 1.6; text-wrap: pretty; }
  .try-note { margin-top: 1rem; color: var(--color-muted); font-size: 0.875rem; }
  .try-link { margin-top: 1rem; }
  @media (max-width: 899px) {
    .try { grid-template-columns: 1fr; }
    .try-copy { order: -1; }
  }
  /* Two phones side by side would be ~165px wide on a phone, too small to read: stack them. */
  @media (max-width: 599px) {
    .try-media { grid-template-columns: 1fr; justify-items: center; }
    .try-media :global(.screen-phone) { width: min(17rem, 72vw); }
    .try-media > :last-child { margin-top: 0; }
  }
</style>
