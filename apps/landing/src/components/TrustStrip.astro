---
interface Props {
  trialDays: number;
}

const { trialDays } = Astro.props;
---

<section class="trust-strip" aria-label="Dukungan operasional TokoΦ">
  <p class="trust-intro">Gratis {trialDays} hari untuk mulai</p>

  <ul class="trust-list">
    <li>Bahasa Indonesia</li>
    <li>Transaksi dalam rupiah</li>
    <li>QRIS, transfer bank, dan COD</li>
    <li>Pengiriman dalam negeri</li>
  </ul>
</section>

<style>
  .trust-strip {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-block: 1px solid var(--color-line);
  }

  .trust-intro {
    max-width: 17rem;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .trust-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-list li {
    min-width: 0;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 550;
    line-height: 1.45;
  }

  @media (min-width: 56rem) {
    .trust-strip {
      grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 2.25fr);
      align-items: center;
      gap: 2rem;
    }

    .trust-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .trust-list {
      grid-template-columns: 1fr;
    }
  }
</style>
