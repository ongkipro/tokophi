---
interface Props {
  demoUrl: string;
}

const { demoUrl } = Astro.props;
---

<section class="demo-section" id="demo" aria-labelledby="demo-title">
  <div class="demo-copy" data-motion-reveal>
    <p class="section-kicker">Toko demo</p>
    <h2 id="demo-title">Coba pengalaman belanja di toko Tokophi.</h2>
    <p>
      Jelajahi produk, tambahkan ke keranjang, dan lihat alur checkout melalui toko demo
      Batik Nusantara.
    </p>
    <a
      class="btn btn-ghost"
      href={demoUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Jelajahi toko demo di tab baru"
    >
      Jelajahi toko demo
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <figure class="demo-proof" data-motion-reveal data-motion-depth>
    <img
      src="/storefront-demo-mobile.webp"
      width="390"
      height="844"
      loading="lazy"
      decoding="async"
      alt="Tampilan mobile toko demo Batik Nusantara dengan koleksi Batik Modern untuk Hari-Harimu."
    />
    <figcaption>
      <span class="demo-label">Toko demo publik</span>
      <strong>Batik Nusantara</strong>
      <span class="demo-address">batik-nusantara.tokophi.id</span>
      <span class="demo-note">Produk, keranjang, dan alur checkout dapat diperiksa langsung.</span>
    </figcaption>
  </figure>
</section>

<style>
  .demo-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-line);
  }

  .demo-copy {
    max-width: 34rem;
  }

  .section-kicker,
  .demo-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-ink);
  }

  h2 {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.45rem + 2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-wrap: balance;
  }

  p:not(.section-kicker) {
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .btn {
    margin-top: 1.5rem;
    gap: 0.55rem;
  }

  .demo-proof {
    display: grid;
    grid-template-columns: minmax(8rem, 0.72fr) minmax(12rem, 1.28fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background:
      linear-gradient(145deg, transparent 40%, var(--color-primary-soft)),
      var(--color-surface);
    box-shadow: 0 30px 70px -48px rgba(20, 21, 42, 0.45);
  }

  .demo-proof img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    box-shadow: 0 20px 40px -28px rgba(20, 21, 42, 0.5);
  }

  .demo-proof figcaption {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .demo-proof strong {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.35rem + 1.3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.018em;
  }

  .demo-address {
    margin-top: 0.35rem;
    color: var(--color-primary-ink);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.8vw, 0.875rem);
    overflow-wrap: anywhere;
  }

  .demo-note {
    max-width: 28rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 767px) {
    .demo-section {
      grid-template-columns: 1fr;
    }

    .demo-proof {
      grid-template-columns: minmax(7rem, 0.75fr) minmax(9rem, 1.25fr);
      padding: 1.25rem;
    }
  }

  @media (max-width: 420px) {
    .demo-proof {
      grid-template-columns: 1fr;
    }

    .demo-proof img {
      width: min(100%, 15rem);
      margin-inline: auto;
    }
  }
</style>
