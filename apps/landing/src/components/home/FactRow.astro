---
import Icon from "../Icon.astro";
import { COD, COURIER_COUNT, COURIER_NAMES, VA_BANKS } from "../../lib/offer";

// Four facts a seller checks first, each true on production today (DESIGN.md "Claim sources").
const facts = [
  { icon: "qr-code", title: "QRIS dan Virtual Account", body: `VA ${VA_BANKS.join(", ")}. Dana masuk ke saldo toko Anda.` },
  { icon: "truck", title: `${COURIER_COUNT} kurir, ongkir otomatis`, body: `${COURIER_NAMES.slice(0, 5).join(", ")}, dan ${COURIER_COUNT - 5} lainnya. Ongkir dari alamat gudang Anda.` },
  { icon: "banknote", title: `COD lewat ${COD.courier}`, body: `Bisa Anda aktifkan untuk ${COD.provinces.length} provinsi di Jawa, sampai ${COD.cap} per pesanan.` },
  { icon: "receipt-text", title: "Tanpa komisi penjualan", body: "Biaya Anda hanya langganan. Hasil penjualan barang tidak dipotong." },
] as const;
---

<section class="facts" aria-label="Yang sudah termasuk">
  <ul>
    {facts.map((f) => (
      <li>
        <Icon name={f.icon} size={22} />
        <div>
          <h2>{f.title}</h2>
          <p>{f.body}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .facts ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--color-line);
  }
  .facts li {
    display: flex;
    gap: 0.85rem;
    padding: 1.6rem 1.5rem 1.6rem 0;
  }
  .facts li + li { padding-left: 1.5rem; }
  .facts :global(svg) { flex: none; margin-top: 0.1rem; color: var(--color-primary-ink); }
  .facts h2 { font-size: 0.975rem; font-weight: 650; line-height: 1.35; }
  .facts p { margin-top: 0.35rem; color: var(--color-muted); font-size: 0.875rem; line-height: 1.55; text-wrap: pretty; }

  @media (max-width: 1023px) {
    .facts ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts li:nth-child(3) { padding-left: 0; }
    .facts li:nth-child(n + 3) { border-top: 1px solid var(--color-line); }
  }
  @media (max-width: 599px) {
    .facts ul { grid-template-columns: 1fr; }
    .facts li, .facts li + li { padding: 1.25rem 0; border-left: 0; }
    .facts li + li { border-top: 1px solid var(--color-line); }
  }
</style>
