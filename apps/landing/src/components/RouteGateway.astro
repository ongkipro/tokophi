---
const routes = [
  { href: "/fitur/", index: "01", title: "Fitur", copy: "Lihat ruang kerja untuk katalog, pesanan, pelanggan, promosi, dan ringkasan toko." },
  { href: "/cara-kerja/", index: "02", title: "Cara kerja", copy: "Ikuti alur dari menyiapkan toko sampai memproses dan mengirim pesanan." },
  { href: "/pembayaran-pengiriman/", index: "03", title: "Pembayaran dan pengiriman", copy: "Pahami kanal pembayaran dan langkah pemenuhan pesanan yang tersedia." },
  { href: "/demo/", index: "04", title: "Demo toko", copy: "Periksa contoh storefront publik dari sudut pandang pembeli." },
] as const;
---

<section class="route-gateway" aria-labelledby="gateway-heading">
  <div class="gateway-heading" data-motion-reveal>
    <p>Jelajahi Tokophi</p>
    <h2 id="gateway-heading">Masuk lewat kebutuhan Anda.</h2>
  </div>
  <ol data-motion-stagger>
    {routes.map((route) => (
      <li data-motion-item>
        <a href={route.href}>
          <span class="route-index">{route.index}</span>
          <span class="route-copy"><strong>{route.title}</strong><span>{route.copy}</span></span>
          <span class="route-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .route-gateway { padding-block: clamp(4rem, 9vw, 8rem); }
  .gateway-heading { display: grid; gap: 0.75rem; max-width: 38rem; }
  .gateway-heading > p { color: var(--color-primary-ink); font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  h2 { font-family: var(--font-serif); font-size: clamp(2rem, 1.5rem + 2vw, 3.4rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.05; text-wrap: balance; }
  ol { margin-top: clamp(2rem, 5vw, 4rem); border-top: 1px solid var(--color-line); list-style: none; }
  li { border-bottom: 1px solid var(--color-line); }
  a { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: start; gap: 1rem; padding-block: clamp(1.35rem, 3vw, 2rem); color: inherit; }
  .route-index { padding-top: 0.2rem; color: var(--color-primary-ink); font-family: var(--font-mono); font-size: 0.75rem; }
  .route-copy { display: grid; grid-template-columns: minmax(10rem, 0.55fr) minmax(0, 1fr); gap: 1.5rem; }
  .route-copy strong { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem); font-weight: 650; }
  .route-copy > span { max-width: 35rem; color: var(--color-muted); font-size: 0.9375rem; line-height: 1.65; }
  .route-arrow { color: var(--color-primary-ink); font-size: 1.25rem; transition: transform 0.18s ease; }
  a:hover .route-arrow { transform: translate(0.2rem, -0.2rem); }
  @media (max-width: 640px) {
    a { grid-template-columns: 2rem minmax(0, 1fr) auto; }
    .route-copy { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .route-arrow { transition: none; } }
</style>
