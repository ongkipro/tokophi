---
interface Props {
  signupUrl: string;
  trialDays: number;
  demoUrl?: string;
}

const { signupUrl, trialDays, demoUrl = "#demo" } = Astro.props;
---

<section class="landing-hero" aria-labelledby="hero-title" data-motion-hero>
  <div class="hero-content">
    <p class="hero-kicker" data-motion-hero-item>Platform toko online untuk seller Indonesia</p>
    <h1 id="hero-title" data-motion-hero-item>Buka toko online. Kelola operasionalnya dari satu panel.</h1>
    <p class="hero-support" data-motion-hero-item>
      Atur produk dan stok, pantau pesanan, terima pembayaran, lalu proses pengiriman tanpa berpindah-pindah sistem.
    </p>
    <div class="hero-actions" data-motion-hero-item>
      <a href={signupUrl} class="btn btn-primary">Mulai gratis {trialDays} hari</a>
      <a href={demoUrl} class="btn btn-ghost">Lihat toko demo</a>
    </div>
  </div>

  <figure class="hero-proof" data-motion-hero-item>
    <div class="proof-frame">
      <img 
        src="/storefront-demo-mobile.webp" 
        width="390" 
        height="844" 
        alt="Tampilan toko online Tokophi di layar handphone" 
        loading="eager" 
        decoding="sync"
      />
    </div>
  </figure>
</section>

<style>
  .landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
    min-height: min(43rem, calc(100dvh - 10rem));
    padding-block: clamp(3rem, 8vw, 6.75rem);
  }

  .hero-content {
    min-width: 0;
    max-width: 39rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-primary-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 2rem + 3.3vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero-support {
    max-width: 34rem;
    margin-top: 1.35rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .hero-proof {
    min-width: 0;
    margin: 0;
  }

  .proof-frame {
    display: flex;
    justify-content: center;
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem) 0;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-primary-soft);
  }


  .proof-frame img {
    display: block;
    width: min(100%, 21rem);
    height: auto;
    max-height: 32rem;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--color-line);
    border-bottom: 0;
    border-radius: 0.9rem 0.9rem 0 0;
    box-shadow: 0 24px 48px -32px rgba(20, 21, 42, 0.45);
  }

  @media (max-width: 800px) {
    .landing-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: clamp(3rem, 12vw, 5rem);
    }
    .proof-frame {
      max-width: 24rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: clamp(2rem, 9vw, 3.3rem);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero-actions .btn {
      padding-inline: 0.75rem;
    }
  }
</style>
