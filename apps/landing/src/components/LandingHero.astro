---
interface Props {
  signupUrl: string;
  demoUrl?: string;
}

const { signupUrl, demoUrl = "#demo" } = Astro.props;
---

<section class="landing-hero" aria-labelledby="hero-title" data-motion-hero>
  <div class="hero-content">
    <p class="hero-kicker" data-motion-hero-item>Untuk penjual Indonesia</p>
    <h1 id="hero-title" data-motion-hero-item>Bangun toko online. Kelola semuanya.</h1>
    <p class="hero-support" data-motion-hero-item>
      Kelola produk, pesanan, pembayaran, dan pengiriman dari satu tempat yang dirancang untuk penjual Indonesia.
    </p>
    <div class="hero-actions" data-motion-hero-item>
      <a href={signupUrl} class="btn btn-primary">Buat toko</a>
      <a href={demoUrl} class="btn btn-ghost">Lihat demo</a>
    </div>
  </div>

  {/* Replace this honest abstract signature only after a current, privacy-reviewed product capture exists. */}
  <figure class="proof-slot" data-motion-hero-item>
    <div class="proof-art" aria-hidden="true">
      <svg viewBox="0 0 233 144" role="presentation" focusable="false">
        <g class="proof-grid">
          <rect x="144" y="0" width="89" height="89" class="proof-fill"></rect>
          <rect x="0" y="0" width="144" height="144"></rect>
          <rect x="144" y="0" width="89" height="89"></rect>
          <rect x="178" y="89" width="55" height="55"></rect>
          <rect x="144" y="110" width="34" height="34"></rect>
          <rect x="144" y="89" width="21" height="21"></rect>
          <rect x="165" y="89" width="13" height="13"></rect>
          <rect x="170" y="102" width="8" height="8"></rect>
        </g>
        <g class="proof-mark">
          <ellipse cx="72" cy="72" rx="31" ry="39"></ellipse>
          <path d="M72 19v106"></path>
        </g>
      </svg>
    </div>
    <figcaption>Produk, pesanan, pembayaran, dan pengiriman dalam satu alur.</figcaption>
  </figure>
</section>

<style>
  .landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(17rem, 0.97fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
    min-height: min(43rem, calc(100dvh - 10rem));
    padding-block: clamp(3rem, 8vw, 6.75rem);
  }

  .hero-content {
    min-width: 0;
    max-width: 39rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-primary-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 2rem + 3.3vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .hero-support {
    max-width: 34rem;
    margin-top: 1.35rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .proof-slot {
    min-width: 0;
    margin: 0;
  }

  .proof-art {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow:
      0 1px 2px rgba(20, 21, 42, 0.04),
      0 30px 70px -38px rgba(20, 21, 42, 0.32);
  }

  .proof-art svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-primary);
  }

  .proof-grid rect {
    fill: none;
    stroke: var(--color-hairline);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .proof-grid .proof-fill {
    fill: var(--plate-fill);
    stroke: none;
  }

  .proof-mark ellipse,
  .proof-mark path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 7.5;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 800px) {
    .landing-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: clamp(3rem, 12vw, 5rem);
    }

    .proof-slot {
      width: min(100%, 34rem);
    }
  }

  @media (max-width: 480px) {
    h1 {
      font-size: clamp(2rem, 9vw, 3.3rem);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero-actions .btn {
      padding-inline: 0.75rem;
    }
  }
</style>
