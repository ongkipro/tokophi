---
import { IDENTITY } from "../lib/identity";
import { MARKETING_ROUTES } from "../lib/navigation";
import { PRICE } from "../lib/offer";

interface Props {
  class?: string;
  loginUrl?: string;
  signupUrl?: string;
}

const {
  class: className = "",
  loginUrl = "https://app.tokophi.com/login",
  signupUrl = "https://app.tokophi.com/daftar",
} = Astro.props;
const demoUrl = import.meta.env.PUBLIC_DEMO_URL || "https://batiknusantara.tokophi.id";
const year = new Date().getFullYear();
---

{/* The page ends on the same ink as the pricing band: a closed frame, so the last screen does not
    read as one more pale section. Facts only (no invented badges, no social icons we do not run). */}
<footer class:list={["site-footer", "band", className]}>
  <div class="footer-top">
    <div class="footer-lead">
      <a href="/" class="wordmark" aria-label="TokoΦ, halaman utama">
        <span class="wordmark-text">Toko<span class="wordmark-phi">Φ</span></span>
      </a>
      <p>Toko online dengan QRIS, Virtual Account, COD, dan 10 kurir, diatur dari satu Dashboard Seller.</p>
      <p class="footer-price">Uji coba {PRICE.trialDays} hari, lalu {PRICE.firstMonth} bulan pertama dan {PRICE.monthly}/bulan. Tanpa komisi penjualan.</p>
      <a href={signupUrl} class="btn btn-primary footer-cta">Coba gratis {PRICE.trialDays} hari</a>
    </div>

    <nav class="footer-group" aria-label="Produk">
      <p>Produk</p>
      <ul>{MARKETING_ROUTES.map((route) => <li><a href={route.href}>{route.label}</a></li>)}</ul>
    </nav>

    <nav class="footer-group" aria-label="Akun">
      <p>Akun</p>
      <ul>
        <li><a href={loginUrl}>Masuk seller</a></li>
        <li><a href={signupUrl}>Daftar toko baru</a></li>
        <li><a href={demoUrl} rel="noopener">Toko demo</a></li>
      </ul>
    </nav>

    <nav class="footer-group" aria-label="Informasi">
      <p>Informasi</p>
      <ul>
        <li><a href="/kontak/">Kontak</a></li>
        <li><a href="/privasi/">Kebijakan Privasi</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} {IDENTITY.legalName ?? "TokoΦ"}</p>
    <p>Setiap toko beralamat <span class="host">namatoko.tokophi.id</span></p>
  </div>
</footer>

<style>
  .site-footer {
    --footer-ink: #14152a;
    margin-top: clamp(1rem, 3vw, 2.5rem);
    /* Flush with the viewport bottom: cancel the shell's bottom padding. */
    margin-bottom: calc(-1 * clamp(0.9rem, 2.6vh, 2.5rem));
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 1.75rem;
    background: var(--footer-ink);
    color: #e7e9fb;
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 0.6fr));
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .footer-lead .wordmark-text { color: #fff; }
  .footer-lead .wordmark-phi { color: #a9b0ff; }
  .footer-lead p { max-width: 26rem; margin-top: 1rem; color: #b9bede; font-size: 0.9375rem; line-height: 1.7; }
  .footer-lead .footer-price { color: #e7e9fb; font-weight: 550; }
  .footer-cta { margin-top: 1.5rem; }

  .footer-group > p { color: #fff; font-size: var(--fs-small); font-weight: 700; }
  .footer-group ul { display: grid; gap: 0.15rem; margin-top: 0.75rem; }
  .footer-group a {
    display: inline-block;
    padding-block: 0.35rem;
    color: #b9bede;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
  }
  .footer-group a:hover { color: #fff; text-decoration-color: #a9b0ff; }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #9298c4;
    font-size: 0.8125rem;
  }
  .host { color: #d6d9f5; font-family: var(--font-mono); font-size: 0.8rem; }

  .site-footer :global(*:focus-visible) { outline-color: #a9b0ff; }

  @media (max-width: 1023px) {
    .footer-top { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .footer-lead { grid-column: 1 / -1; }
  }
  @media (max-width: 559px) {
    .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2rem; }
    .footer-cta { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-group a { transition: none; }
  }
</style>
