---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<header class="page-hero" data-motion-hero>
  <p class="page-eyebrow" data-motion-hero-item>{eyebrow}</p>
  <h1 data-motion-hero-item>{title}</h1>
  <p class="page-lede" data-motion-hero-item>{description}</p>
  {(primaryHref || secondaryHref) && (
    <div class="page-actions" data-motion-hero-item>
      {primaryHref && primaryLabel && <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>}
      {secondaryHref && secondaryLabel && <a class="btn btn-ghost" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  )}
</header>

<style>
  .page-hero {
    max-width: 55rem;
    padding-block: clamp(4rem, 10vw, 8.5rem) clamp(3.5rem, 7vw, 6rem);
  }
  .page-eyebrow {
    color: var(--color-primary-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 16ch;
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.65rem, 1.8rem + 3.8vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .page-lede {
    max-width: 43rem;
    margin-top: 1.4rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.2rem);
    line-height: 1.7;
    text-wrap: pretty;
  }
  .page-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.8rem; }
  @media (max-width: 420px) {
    .page-actions { display: grid; grid-template-columns: 1fr; }
  }
</style>
