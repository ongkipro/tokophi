---
import PhiOrnament from "./PhiOrnament.astro";

// Opening of every inner sales page: the page's own H1 and the one sentence that says what the page
// answers, then the same two actions as the homepage. Left-aligned on the shell column like the
// homepage hero, without a screenshot: each inner page shows its screens in the sections below.
interface Props {
  title: string;
  lede: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const { title, lede, primary, secondary } = Astro.props;
---

<section class="intro" aria-labelledby="intro-title">
  <PhiOrnament class="intro-phi" />
  <h1 id="intro-title" class="intro-title">{title}</h1>
  <p class="intro-lede">{lede}</p>
  <div class="intro-actions">
    <a href={primary.href} class="btn btn-primary btn-lg">{primary.label}</a>
    {secondary && <a href={secondary.href} class="btn btn-ghost btn-lg">{secondary.label}</a>}
  </div>
  <slot />
</section>

<style>
  .intro { position: relative; isolation: isolate; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); }
  /* Fills the right half the left-aligned intro leaves empty on wide screens; gone below 1024px. */
  .intro :global(.intro-phi) {
    position: absolute;
    z-index: -1;
    top: clamp(2rem, 5vw, 4rem);
    right: 0;
    width: min(32rem, 40%);
    color: var(--color-primary);
    opacity: 0.18;
  }
  @media (max-width: 1023px) { .intro :global(.intro-phi) { display: none; } }
  .intro-title {
    max-width: 40rem;
    font-family: var(--font-serif);
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .intro-lede {
    margin-top: 1.25rem;
    max-width: 40rem;
    color: var(--color-muted);
    font-size: var(--fs-lede);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .intro-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 479px) { .intro-actions :global(.btn) { flex: 1 1 100%; } }
</style>
