# TokoΦ landing (tokophi.com apex + www) — STATIC, NO DATABASE.
# This app must never read DATABASE_URL: it has to stay servable even when the DB/admin is down.
#
# The two live links are baked in at BUILD time (static output → PUBLIC_* only).
# Omit both and the production values below are used as the defaults.
PUBLIC_LOGIN_URL="https://app.tokophi.com/login"
PUBLIC_SIGNUP_URL="https://app.tokophi.com/daftar"

# Local dev pointing at the admin on :3000
# PUBLIC_LOGIN_URL="http://localhost:3000/login"
# PUBLIC_SIGNUP_URL="http://localhost:3000/daftar"
