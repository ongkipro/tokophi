# Storefront reads the shared Postgres at REQUEST time (SSR). `astro build` never touches the DB.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/tokophi"

# --- Multi-tenancy (ADR 0009 / PROD_PLAN §5) — one deploy serves every store ---
# The store is resolved from the request's Host header:
#   1. custom domain            (seam — not wired yet, needs stores.custom_domain)
#   2. <slug>.$STOREFRONT_BASE_DOMAIN     e.g. batik-nusantara.toko.tokophi.com
#   3. first label of the host            e.g. batik-nusantara.203.0.113.10.sslip.io
#   4. this fallback slug, when the host names no store (localhost, bare IP, apex domain)
STORE_SLUG="batik-nusantara"          # alias: DEFAULT_STORE_SLUG
# STOREFRONT_BASE_DOMAIN="toko.tokophi.com"
# Per-store catalog cache TTL, ms (default 15000; 0 = no cache, always hit Postgres).
# STOREFRONT_CACHE_TTL_MS="15000"

# Platform shipping proxy for live checkout ongkir (KiriminAja). Defaults to the local admin.
# In prod, point this at the platform's public shipping endpoint.
PUBLIC_ONGKIR_API="http://localhost:3000/api/public/ongkir"
PUBLIC_PAY_API="http://localhost:3000/api/public/pay"
PUBLIC_ORDER_API="http://localhost:3000/api/public/order"
