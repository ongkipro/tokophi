---
// Jurnal (blog index). Was a hardcoded array of 4 fake articles with `href="#"` — the merchant's
// real articles, written in the admin's Blog editor, had no way to reach a shopper at all. Now it
// reads the DB (published only) and links to /blog/<handle>.
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { breadcrumbLd, ldScript, type Crumb } from "../../lib/breadcrumb";
import RevealGrid from "../../components/RevealGrid.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { Newspaper } from "@lucide/astro";
import { getArticles } from "../../data/content";

const { store } = Astro.locals;
const articles = await getArticles(store.id);

const CRUMBS: Crumb[] = [
  { name: "Beranda", href: "/" },
  { name: "Jurnal" },
];
const HEAD = ldScript(breadcrumbLd(CRUMBS, Astro.locals.origin));

// og:image — the newest article that HAS a cover (getArticles is ordered published_at desc). This
// page passed none, so every /blog link shared to WhatsApp fell back to the store logo: a grey tile
// where the merchant's own editorial photo was sitting one field away. No article has a cover → no
// image → Layout falls back to the logo exactly as before. Layout absolutises it (`new URL(src,
// origin)`), same as produk/[handle] passing `product.image` — nothing is made absolute here.
const OG_IMAGE = articles.find((a) => a.imageUrl)?.imageUrl ?? undefined;
---

<!-- Was "tips fashion, perawatan kain, dan inspirasi gaya busana wanita" — the demo's vertical, shipped
     to Google by every tenant. A journal is a journal whatever the shop sells; say that and stop. -->
<Layout
  head={HEAD}
  title="Jurnal"
  description={`Artikel, tips, dan kabar terbaru dari ${store.name}.`}
  image={OG_IMAGE}
>
  <PageHeader
    crumbs={CRUMBS}
    eyebrow="Jurnal"
    title="Cerita & Inspirasi"
    dek={`Tips merawat kain, inspirasi padu padan, dan kisah di balik koleksi ${store.name}.`}
  />

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    {
      articles.length === 0 ? (
        // Was a bare centred <p> while the product listing next door had icon + heading + copy + CTA.
        // Same component now — and the CTA points at /produk, not the homepage: a shopper who came
        // looking for reading and found none is still a shopper.
        <EmptyState
          icon={Newspaper}
          title="Belum ada tulisan"
          body="Cerita pertama dari kami sedang disiapkan. Sementara itu, lihat-lihat koleksinya dulu, yuk."
          ctaHref="/produk"
          ctaLabel="Lihat koleksi"
        />
      ) : (
        <RevealGrid rows={3} unit="tulisan">
        <div data-reveal-grid class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {/* The tile lives in ArticleCard.astro — the homepage's Jurnal section renders the same
              one. It used to be 40 lines of markup inline here, which is how this tile and
              ProductCard drifted apart the first time (see 3ce6d6c). `level={2}`: this page's <h1>
              is above, so each tile is an <h2>. */}
          {articles.map((a) => (
            <ArticleCard article={a} level={2} />
          ))}
        </div>
        </RevealGrid>
      )
    }
  </section>
</Layout>
