---
// Article detail — Medium-style reading layout.
//
// Anatomy (top → bottom): topic chip · big title · subtitle · author row (avatar, name, read time,
// date) · hairline action bar · 3:2 feature image · body · "Baca juga".
//
// One column, no coloured hero band: the point of this layout is that nothing competes with the
// text. Body type is the `article` scale in Prose.astro (larger, looser) — a shopper reading a
// 900-word guide is doing something different from a shopper skimming Syarat & Ketentuan.
//
// Deliberately NOT copied from Medium: clap/comment counters. `articles.comments` exists in the DB
// and is seeded (8, 12, …) but there is NO comment system — rendering a count nobody can open would
// promise a feature that doesn't exist. The action bar carries share actions that actually work.
//
// A draft 404s (getArticle hard-filters status='terbit'): unreleased work must not be reachable by
// guessing its handle.
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
import ProductCard from "../../components/ProductCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ShareBar from "../../components/ShareBar.astro";
import { breadcrumbLd, ldScript, type Crumb } from "../../lib/breadcrumb";
import { getArticle, getArticles, formatDate, readMinutes } from "../../data/content";
import { mediaUrl, imageSrcSet } from "../../data/catalog";

// `sizes` for the two article images, each derived from ITS OWN box (Task 6.12):
//   FEATURE — the <figure> is `max-w-4xl px-4 sm:px-6` and the img is `w-full`:
//     <640  100vw − 32 · 640–895  100vw − 48 · ≥896  896 − 48 = 848
//   RELATED — "Baca juga" is `max-w-7xl px-4 sm:px-6` holding `grid-cols-1 gap-6 sm:grid-cols-3`:
//     <640  100vw − 32 · 640–1279  (100vw − 48 − 2·24) / 3 = (100vw − 96) / 3 · ≥1280  (1280 − 96) / 3 = 394,67 → 395
const FEATURE_SIZES = "(min-width: 896px) 848px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)";
const RELATED_SIZES = "(min-width: 1280px) 395px, (min-width: 640px) calc((100vw - 96px) / 3), calc(100vw - 32px)";

const { store, catalog } = Astro.locals;
const { handle } = Astro.params;

const article = handle ? await getArticle(store.id, handle) : null;
if (!article) return new Response(null, { status: 404, statusText: "Not Found" });

// "Baca juga" — newest other posts. Cheap: the listing is already cached per store.
const others = (await getArticles(store.id)).filter((a) => a.handle !== article.handle).slice(0, 3);

// Promoted products under the article. "Random" — but NOT `randomProducts()` (which is Math.random):
// a reload would reshuffle the same article's picks, which reads as broken and makes the page
// uncacheable. Seeding the rotation on the handle gives the actual goal — a different set per
// article — while staying stable for a given article. Rotating (not sampling) also guarantees no
// duplicates.
const pool = catalog.products;
const seed = [...article.handle].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const start = pool.length ? seed % pool.length : 0;
const promoted = [...pool.slice(start), ...pool.slice(0, start)].slice(0, 4);

// No author avatars exist (articles.author is a bare text name), so we draw an initial instead of
// shipping a broken <img> or a stock silhouette.
const initial = (article.author ?? store.name).trim().charAt(0).toUpperCase();

// ── SEO ──────────────────────────────────────────────────────────────────────────────────────────
// This was the ONLY content page with neither structured data nor a breadcrumb: the PDP emits
// Product + BreadcrumbList and /kategori emits BreadcrumbList, so Google saw a hierarchy everywhere
// except the one page type built to be linked to from outside.
const ORIGIN = Astro.locals.origin;
const abs = (u: string) => new URL(u, ORIGIN).href;
const PAGE_URL = abs(`/blog/${article.handle}`);

// ONE array drives the visible trail AND the schema — the same rule as produk/[handle], which had
// them typed out separately until the schema started claiming a crumb the screen never showed.
const CRUMBS: Crumb[] = [
  { name: "Beranda", href: "/" },
  { name: "Jurnal", href: "/blog" },
  { name: article.title },
];

// EVERY field below is a value this page ALREADY has and already renders. Nothing is manufactured:
//  · `author` is emitted ONLY when articles.author is set. A merchant who left it blank does not get
//    the shop name pushed in as a person — that is inventing a byline, and the visible author row is
//    conditional for exactly the same reason.
//  · `datePublished` only when published_at exists. A fabricated date is worse than no date: it is
//    the field Google uses to decide how stale the piece is.
//  · `image` only when the article has a cover. `description`/`articleSection` likewise.
// DELIBERATELY ABSENT: `dateModified` (the read layer loads no updated_at — see data/content.ts),
// `commentCount`/`interactionStatistic` (articles.comments is seeded but there IS no comment system,
// so the count describes nothing), and `wordCount` (derivable, but nothing on the page states it).
const articleLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  url: PAGE_URL,
  mainEntityOfPage: { "@type": "WebPage", "@id": PAGE_URL },
  publisher: {
    "@type": "Organization",
    name: store.name,
    // `mediaUrl()` first: `store.logoUrl` is the ADMIN app's `/api/uploads/<name>`, so absolutising it
    // against the storefront origin published a 404 in every article's schema (SF-3). Same rule, same
    // helper as the og:image in Layout.astro and the LOGO in index.astro — `abs()` alone was wrong.
    ...(store.logoUrl ? { logo: { "@type": "ImageObject", url: abs(mediaUrl(store.logoUrl)) } } : {}),
  },
};
if (article.excerpt.trim()) articleLd.description = article.excerpt.trim();
if (article.imageUrl) articleLd.image = [abs(article.imageUrl)];
if (article.publishedAt) articleLd.datePublished = article.publishedAt.toISOString();
if (article.author) articleLd.author = { "@type": "Person", name: article.author };
if (article.blog) articleLd.articleSection = article.blog;

const HEAD = [articleLd, breadcrumbLd(CRUMBS, ORIGIN)].map(ldScript).join("");
---

{/* ⚠️ The comment that used to sit here said "Layout emits no OG/Twitter tags at all today, so an
     article's imageUrl has nowhere to go" — and it had been FALSE since Layout gained the full og:/
     twitter: set (Layout.astro). The comment outlived the fact and then justified the gap it described:
     every article shared to WhatsApp — the cheapest channel these merchants have — showed the store
     LOGO instead of the article's own hero photo. `type="article"` for the same reason: it was
     defaulting to "website" on a page that is unambiguously an article. */}
<Layout
  title={article.seoTitle || article.title}
  description={article.seoDesc || article.excerpt}
  image={article.imageUrl ?? undefined}
  type="article"
  head={HEAD}
>
  <article class="mx-auto max-w-2xl px-4 pb-4 pt-10 sm:px-6 sm:pt-14">
    <Breadcrumb items={CRUMBS} class="mb-6" />

    {/* Topic chip. Medium shows several tags; we have exactly one axis that is real — the blog the
         article belongs to (Berita Toko / Tips & Panduan). */}
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <a
        href="/blog"
        class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium tracking-wide text-brand-700 ring-1 ring-brand-100 transition-colors hover:bg-brand-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        {article.blog ?? "Jurnal"}
      </a>
    </div>

    {/* Medium's 42px works on a geometric sans; our `font-display` is a high-contrast serif, which
         reads noticeably heavier at the same size. Dialled back to 28/36px, and to `semibold` — the
         title should lead the page, not shout over the subtitle it sits above. */}
    <h1 class="mt-5 font-display text-[1.75rem] font-semibold leading-[1.2] text-balance text-ink sm:text-[2.25rem]">
      {article.title}
    </h1>

    {
      article.excerpt && (
        <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">{article.excerpt}</p>
      )
    }

    {/* Author row */}
    <div class="mt-8 flex items-center gap-3">
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-100 font-display text-lg font-semibold text-brand-700"
        aria-hidden="true"
      >
        {initial}
      </span>
      <div class="min-w-0 text-sm">
        {article.author && <p class="font-medium text-ink">{article.author}</p>}
        <p class="flex flex-wrap items-center gap-x-2 text-muted">
          <span>{readMinutes(article.body)} menit baca</span>
          {
            article.publishedAt && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={article.publishedAt.toISOString()}>
                  {formatDate(article.publishedAt)}
                </time>
              </>
            )
          }
        </p>
      </div>
    </div>

    {/* Action bar. Hairline top + bottom, exactly where Medium puts the clap/share row.
         The left slot used to hold a "← Jurnal" back-link; the breadcrumb at the top of the page now
         does that job, and the slot is a label instead. That is not cosmetic: the share buttons grew
         from 36px to 44px tap targets, and back-link + five 44px targets overflowed a 320px viewport.
         Share markup itself lives in components/ShareBar.astro — the PDP renders the same one. */}
    <div class="mt-8 flex items-center justify-between border-y border-line py-2.5">
      <span class="text-sm text-muted">Bagikan</span>
      <ShareBar
        url={PAGE_URL}
        title={article.title}
        image={article.imageUrl ? abs(article.imageUrl) : undefined}
      />
    </div>
  </article>

  {/* Feature image — LOCKED 3:2. The ratio is fixed, not the photo's: merchant art comes in every
       shape (our seed reuses portrait product shots), and letting each article set the page's rhythm
       makes the Jurnal look broken. object-cover crops to the frame; a missing image renders no
       frame at all rather than an empty box.
       Nearly square corners and NO shadow: in an editorial layout the photo is content, not a card.
       A raised, heavily-rounded frame reads as UI chrome and competes with the text — which is the
       one thing this page exists to get out of the way of. */}
  {
    article.imageUrl && (
      <figure class="mx-auto mt-8 max-w-4xl px-4 sm:px-6">
        {/* BREAKOUT — the hero is wider than the 42rem reading column (a `max-w-4xl` centred on the
            same axis). On a desktop the same-width photo looked undersized against all that margin; a
            wider feature image gives the article a proper lead without touching the text measure. On a
            phone it is edge-to-edge either way. Ratio stays a fixed 3:2 (merchant art arrives in every
            shape); flat, barely-rounded, no shadow — the photo is content, not card chrome. */}
        <img
          src={article.imageUrl}
          srcset={imageSrcSet(article.imageUrl)}
          sizes={imageSrcSet(article.imageUrl) ? FEATURE_SIZES : undefined}
          alt=""
          width="1500"
          height="1000"
          fetchpriority="high"
          class="aspect-[3/2] w-full rounded-sm bg-brand-50 object-cover"
        />
      </figure>
    )
  }

  <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-14">
    {
      article.body.trim() ? (
        <Prose body={article.body} size="article" />
      ) : (
        <p class="text-muted">Tulisan ini belum memiliki isi.</p>
      )
    }
  </div>

  {/* Promoted products. Sits between the body and "Baca juga" ON PURPOSE: a reader who finished the
       article is at peak intent, and the next thing they meet should be something to buy — "Baca
       juga" pulls them back into reading, so it goes after.
       Labelled "Dari koleksi kami", NOT "Bersponsor": these are the merchant's OWN products. In
       Indonesian, "bersponsor" signals a PAID third-party placement — using it for a store's own
       goods would be an ad-disclosure lie, and if TokoΦ ever sells real placements the word has to
       still mean something. */}
  {
    promoted.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-14">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading eyebrow="Dari koleksi kami" title="Mungkin kamu suka ini" />
            <a
              href="/produk"
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
            >
              Lihat semua produk
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4 fill-none stroke-current"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          {/* `grid="2-4"`: this grid skips the 3-col sm tier, so a card is HALF the viewport from
              640-1023 where the default shape assumes a third. Must match the classes above. */}
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14 lg:grid-cols-4">
            {promoted.map((p) => (
              <ProductCard product={p} grid="2-4" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="border-t border-line bg-white/60">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
          <SectionHeading title="Baca juga" />
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {others.map((a) => (
              /* Editorial, not card-chrome: the same restraint as the feature image (flat, barely
                   rounded, no shadow). The article page is the one place the shop's card language
                   would fight the reading. */
              <a
                href={`/blog/${a.handle}`}
                class="group flex flex-col overflow-hidden rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
              >
                {/* Same 3:2 lock as the feature image, so the cards and the article agree. */}
                <div class="aspect-[3/2] overflow-hidden rounded-sm bg-brand-50">
                  {a.imageUrl && (
                    <img
                      src={a.imageUrl}
                      srcset={imageSrcSet(a.imageUrl)}
                      sizes={imageSrcSet(a.imageUrl) ? RELATED_SIZES : undefined}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col pt-4">
                  <p class="text-xs font-medium uppercase tracking-[0.15em] text-brand-600">
                    {formatDate(a.publishedAt)}
                  </p>
                  <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-brand-700">
                    {a.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

