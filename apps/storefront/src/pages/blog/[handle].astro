---
// Article detail — NEW. `/blog` listed articles but this route did not exist, so nothing a merchant
// wrote in the admin's Blog editor was ever readable by a shopper.
//
// A draft 404s (getArticle hard-filters status='terbit'): unreleased work must not be reachable by
// guessing its handle.
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
import { getArticle, getArticles, formatDate, readMinutes } from "../../data/content";

const { store } = Astro.locals;
const { handle } = Astro.params;

const article = handle ? await getArticle(store.id, handle) : null;
if (!article) return new Response(null, { status: 404, statusText: "Not Found" });

// "Baca juga" — newest other posts. Cheap: the listing is already cached per store.
const others = (await getArticles(store.id)).filter((a) => a.handle !== article.handle).slice(0, 3);
---

<!-- No `image` prop: Layout emits no OG/Twitter tags at all today, so an article's imageUrl has
     nowhere to go. Passing it would be a prop that silently does nothing. Social cards for the
     storefront are a separate gap (the landing app has them; the storefront doesn't). -->
<Layout
  title={article.seoTitle || article.title}
  description={article.seoDesc || article.excerpt}
>
  <article>
    <header class="bg-brand-50">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
        <nav class="text-sm text-muted">
          <a href="/" class="transition-colors hover:text-brand-600">Beranda</a>
          <span class="mx-2 text-line">/</span>
          <a href="/blog" class="transition-colors hover:text-brand-600">Jurnal</a>
        </nav>

        {
          article.blog && (
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">
              {article.blog}
            </p>
          )
        }
        <h1 class="mt-2 font-display text-3xl font-semibold leading-tight text-balance text-ink sm:text-4xl">
          {article.title}
        </h1>
        {article.excerpt && <p class="mt-4 text-lg leading-relaxed text-muted">{article.excerpt}</p>}

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
          {article.author && <span class="font-medium text-ink">{article.author}</span>}
          {article.author && article.publishedAt && <span class="text-line">·</span>}
          {
            article.publishedAt && (
              <time datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt)}</time>
            )
          }
          <span class="text-line">·</span>
          <span>{readMinutes(article.body)} menit baca</span>
        </div>
      </div>
    </header>

    {
      article.imageUrl && (
        <div class="mx-auto max-w-5xl px-4 sm:px-6">
          <img
            src={article.imageUrl}
            alt=""
            width="1600"
            height="900"
            fetchpriority="high"
            class="-mt-8 aspect-[16/9] w-full rounded-2xl object-cover shadow-lg ring-1 ring-line"
          />
        </div>
      )
    }

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-14">
      {
        article.body.trim() ? (
          <Prose body={article.body} />
        ) : (
          <p class="text-muted">Tulisan ini belum memiliki isi.</p>
        )
      }

      <div class="mt-12 border-t border-line pt-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 transition-colors hover:text-brand-600"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Kembali ke Jurnal
        </a>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="border-t border-line bg-white/60">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink">Baca juga</h2>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {others.map((a) => (
              <a
                href={`/blog/${a.handle}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
              >
                <div class="aspect-[4/3] overflow-hidden bg-brand-50">
                  {a.imageUrl && (
                    <img
                      src={a.imageUrl}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <p class="text-xs font-medium uppercase tracking-[0.15em] text-brand-500">
                    {formatDate(a.publishedAt)}
                  </p>
                  <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-brand-700">
                    {a.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
