---
import Layout from "../../layouts/Layout.astro";
import CategoryHero from "../../components/CategoryHero.astro";
import { breadcrumbLd, ldScript, type Crumb } from "../../lib/breadcrumb";
import ProductListing from "../../components/ProductListing.astro";
import SectionRenderer from "../../components/sections/SectionRenderer.astro";
import type { Product, VirtualCollectionHandle } from "../../data/catalog";

// `imageUrl` is optional because the VIRTUAL collections (Terlaris, Baru, …) are computed lists with
// no row behind them — there is nothing for a merchant to upload a cover to. Real collections carry
// whatever they set in the Kategori editor; "" means they set nothing.
type ResolvedCollection = { name: string; blurb: string; imageUrl?: string };

// SSR: tenant from the Host header (src/middleware.ts), collection from the handle param.
const { store, catalog } = Astro.locals;
const PRODUCTS = catalog.products;
const { handle } = Astro.params;

// Virtual (non-catalog) collections used by the nav — computed views over THIS store's products, so
// every tenant can serve them whether or not they have a `collections` row of that handle.
//
// They take precedence over `findCollection()`, and `catalog.collections` excludes their handles for
// that reason (see VIRTUAL_COLLECTION_HANDLES in data/catalog.ts — the `Record` key type below is
// that same list, so adding a virtual route here without declaring it there is a type error).
// `produk-terlaris` once had no entry at all, so the hero's own default CTA ("Lihat Produk
// Terlaris", @tokophi/sections registry) shipped pointing at a 404.
const VIRTUAL: Record<VirtualCollectionHandle, ResolvedCollection & { products: Product[] }> = {
  semua: {
    name: "Semua Produk",
    blurb: `Semua koleksi ${store.name}`,
    products: PRODUCTS,
  },
  // `promo-gajian` and `produk-terlaris` USED TO BE HERE, and that was the bug. Both are real
  // collections with real membership — "Promo Gajian" is a MANUAL one, 8 products the merchant
  // hand-picked in the Kategori editor. This file rendered `filter(p => p.compareAt || p.bestseller)`
  // instead: a guess, overriding the merchant's own curation, on a page advertising a promo. They now
  // resolve from the DB like every other collection (see byCollection in data/catalog.ts).
};

// `/kategori/semua` is PERMANENTLY MOVED to `/produk`, not merely de-indexed.
//
// It first shipped as `noindex,follow`, which was the cautious call and the weaker one: noindex stops
// a URL being indexed but ABANDONS whatever authority it already earned, while a 301 hands that
// authority to the page that replaces it. Same duplicate solved; one keeps the equity, one throws it
// away. There is no case where noindex is the better SEO answer for a URL that has a true successor.
//
// The reason it was not a 301 on day one was a real risk, since removed: `/kategori/semua` renders
// the merchant's DEFAULT CATEGORY template, and `/produk` did not — so redirecting would have
// silently replaced a merchant's designed layout with a plain grid. `/produk` now resolves the same
// `categoryTemplate("semua")`, so the two render identically and the redirect costs nothing.
//
// 301 and not 302: this is permanent, and only a 301 consolidates. Merchant-built menu items pointing
// here keep working — the shopper is simply moved, mid-journey, to the canonical URL.
if (handle === "semua") return Astro.redirect("/produk", 301);

let collection: ResolvedCollection;
let products: Product[];
const virtual = handle ? (VIRTUAL as Record<string, (typeof VIRTUAL)[VirtualCollectionHandle]>)[handle] : undefined;
if (virtual) {
  collection = { name: virtual.name, blurb: virtual.blurb };
  products = virtual.products;
} else {
  const real = handle ? catalog.findCollection(handle) : undefined;
  if (!real) return new Response(null, { status: 404, statusText: "Not Found" });
  collection = { name: real.name, blurb: real.blurb, imageUrl: real.imageUrl };
  products = catalog.byCollection(real.handle);
}

// ADR 0009 — Store Builder: this collection's own template → the store's default `category`
// template → null = the hand-built layout below (unchanged). Virtual collections have no row,
// so they pick up the store default.
const TEMPLATE = handle ? catalog.categoryTemplate(handle) : null;

const CRUMBS: Crumb[] = [
  { name: "Beranda", href: "/" },
  { name: collection.name },
];
// BreadcrumbList existed on the PDP only, so Google saw a hierarchy for products and a flat site for
// every category above them. Built from CRUMBS — the same array the visible trail renders.
const HEAD = ldScript(breadcrumbLd(CRUMBS, Astro.locals.origin));

// A VIRTUAL collection is not a category — it is a computed view with no row behind it, so it must
// not compete in search with the real categories beside it.
//
// ⚠️ Today this is UNREACHABLE and that is fine: `semua` is the only virtual handle and it 301s to
// /produk above, so `virtual` is never truthy by the time we get here. It stays because
// `VIRTUAL_COLLECTION_HANDLES` is a list, not a constant — the next computed view added to it lands
// here needing exactly this, and re-deriving the rule then is how it would come back wrong.
// `follow`, not `nofollow`: every product link on such a page is real.
const NOINDEX = virtual ? "noindex,follow" : undefined;
---

<!-- Was "Koleksi busana wanita di …" — the demo's vertical on every tenant's category page. `blurb` is
     `description ?? ""` upstream, so interpolating it raw also produced a stray " — . " on any category
     the merchant left blank. Both gone: the merchant's own blurb when written, the category name when not. -->
<!-- og:image — the merchant's own category cover, the same `imageUrl` PageHeader renders 20 lines
     below. It was in scope and thrown away, so every category link shared to WhatsApp showed the
     store logo instead of the collection's photo. Virtual collections have no row and no cover →
     undefined → Layout falls back to the logo, unchanged. Passed RAW, not absolutised here: Layout
     does `new URL(src, origin)` on it, which is also how produk/[handle] passes `product.image`
     (its local `abs()` helper exists for the JSON-LD, which Layout never sees). -->
<Layout
  head={HEAD}
  robots={NOINDEX}
  image={collection.imageUrl}
  title={collection.name}
  description={
    collection.blurb?.trim()
      ? // The merchant's blurb is free text and most do not end it with a full stop — "Dress harian
        // sampai acara spesial" ran straight into "Tersedia di …". Punctuate only when they didn't.
        `${collection.name} — ${collection.blurb.trim().replace(/[.!?]?$/, ".")} Tersedia di ${store.name}.`
      : `Koleksi ${collection.name} di ${store.name}.`
  }
>
  {/* CategoryHero: centred minimal header when there is no cover (the normal case), a full-bleed
      immersive banner when the merchant uploaded one. `imageUrl` is already absolute (mediaUrl).

      ⚠️ ALWAYS RENDERED — including when a template exists. A `category` template used to REPLACE
      this whole block, so building one cost the page its `<h1>`, its breadcrumb and its cover while
      the BreadcrumbList JSON-LD above kept publishing a trail nobody could see. The template is the
      page's BODY, not the page. (`produk/index.astro` already worked this way; the two sibling
      listing routes had simply diverged.) */}
  <CategoryHero
    crumbs={CRUMBS}
    eyebrow="Koleksi"
    title={collection.name}
    dek={collection.blurb}
    imageUrl={collection.imageUrl}
    imageAlt={`Koleksi ${collection.name}`}
  />

  {
    TEMPLATE ? (
      <SectionRenderer
        data={TEMPLATE}
        context={{ kind: "category", collectionHandle: handle!, collectionName: collection.name }}
      />
    ) : (
      <ProductListing products={products} />
    )
  }
</Layout>
