---
import Layout from "../../layouts/Layout.astro";
import { PackageOpen } from "@lucide/astro";
import ProductCard from "../../components/ProductCard.astro";
import RevealGrid from "../../components/RevealGrid.astro";
import SectionRenderer from "../../components/sections/SectionRenderer.astro";
import type { Product, VirtualCollectionHandle } from "../../data/catalog";

type ResolvedCollection = { name: string; blurb: string };

// SSR: tenant from the Host header (src/middleware.ts), collection from the handle param.
const { store, catalog } = Astro.locals;
const PRODUCTS = catalog.products;
const { handle } = Astro.params;

// Virtual (non-catalog) collections used by the nav — computed views over THIS store's products, so
// every tenant can serve them whether or not they have a `collections` row of that handle.
//
// They take precedence over `findCollection()`, and `catalog.collections` excludes their handles for
// that reason (see VIRTUAL_COLLECTION_HANDLES in data/catalog.ts — the `Record` key type below is
// that same list, so adding a virtual route here without declaring it there is a type error).
// `produk-terlaris` once had no entry at all, so the hero's own default CTA ("Lihat Produk
// Terlaris", @tokophi/sections registry) shipped pointing at a 404.
const VIRTUAL: Record<VirtualCollectionHandle, ResolvedCollection & { products: Product[] }> = {
  semua: {
    name: "Semua Produk",
    blurb: `Semua koleksi ${store.name}`,
    products: PRODUCTS,
  },
  // `promo-gajian` and `produk-terlaris` USED TO BE HERE, and that was the bug. Both are real
  // collections with real membership — "Promo Gajian" is a MANUAL one, 8 products the merchant
  // hand-picked in the Kategori editor. This file rendered `filter(p => p.compareAt || p.bestseller)`
  // instead: a guess, overriding the merchant's own curation, on a page advertising a promo. They now
  // resolve from the DB like every other collection (see byCollection in data/catalog.ts).
};

let collection: ResolvedCollection;
let products: Product[];
const virtual = handle ? (VIRTUAL as Record<string, (typeof VIRTUAL)[VirtualCollectionHandle]>)[handle] : undefined;
if (virtual) {
  collection = { name: virtual.name, blurb: virtual.blurb };
  products = virtual.products;
} else {
  const real = handle ? catalog.findCollection(handle) : undefined;
  if (!real) return new Response(null, { status: 404, statusText: "Not Found" });
  collection = { name: real.name, blurb: real.blurb };
  products = catalog.byCollection(real.handle);
}

// ADR 0009 — Store Builder: this collection's own template → the store's default `category`
// template → null = the hand-built layout below (unchanged). Virtual collections have no row,
// so they pick up the store default.
const TEMPLATE = handle ? catalog.categoryTemplate(handle) : null;
---

<Layout
  title={collection.name}
  description={`${collection.name} — ${collection.blurb}. Koleksi busana wanita di ${store.name}.`}
>
  {
    TEMPLATE ? (
      <SectionRenderer
        data={TEMPLATE}
        context={{ kind: "category", collectionHandle: handle!, collectionName: collection.name }}
      />
    ) : (
      <Fragment>
  <section class="bg-brand-50">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
      <nav class="text-sm text-muted">
        <a href="/" class="transition-colors hover:text-brand-600">Beranda</a>
        <span class="mx-2 text-line">/</span>
        <span class="text-ink">{collection.name}</span>
      </nav>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Koleksi</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-ink">
        {collection.name}
      </h1>
      <p class="mt-3 max-w-xl leading-relaxed text-muted">{collection.blurb}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    {
      products.length > 0 ? (
        <>
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-5">
            <p class="text-sm text-muted">
              <span class="font-medium text-ink tabular-nums">{products.length}</span> produk
            </p>
            <label class="flex items-center gap-2 text-sm text-muted">
              <span class="hidden sm:inline">Urutkan</span>
              <select
                id="sort-select"
                class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
              >
                <option value="terbaru">Terbaru</option>
                <option value="termurah">Harga terendah</option>
                <option value="termahal">Harga tertinggi</option>
              </select>
            </label>
          </div>

          <RevealGrid rows={3} unit="produk">
            <div
              id="product-grid"
              data-reveal-grid
              class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4"
            >
              {products.map((p, i) => (
                <div class="product-item" data-price={p.price} data-index={i}>
                  <ProductCard product={p} />
                </div>
              ))}
            </div>
          </RevealGrid>
        </>
      ) : (
        <div class="rounded-2xl border border-dashed border-line bg-white py-20 text-center">
          <PackageOpen class="mx-auto h-10 w-10 text-brand-400" stroke-width={1.5} aria-hidden="true" />
          <h2 class="mt-4 font-display text-2xl font-semibold text-ink">Belum ada produk</h2>
          <p class="mt-2 text-muted">Koleksi ini sedang dalam perjalanan. Cek koleksi lainnya, yuk.</p>
          <a
            href="/"
            class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
          >
            Kembali ke Beranda
          </a>
        </div>
      )
    }
  </section>
      </Fragment>
    )
  }
</Layout>

<script is:inline>
  (function () {
    var select = document.getElementById("sort-select");
    var grid = document.getElementById("product-grid");
    if (!select || !grid) return;
    select.addEventListener("change", function () {
      var mode = select.value;
      var items = Array.prototype.slice.call(grid.querySelectorAll(".product-item"));
      items.sort(function (a, b) {
        var pa = Number(a.getAttribute("data-price"));
        var pb = Number(b.getAttribute("data-price"));
        var ia = Number(a.getAttribute("data-index"));
        var ib = Number(b.getAttribute("data-index"));
        if (mode === "termurah") return pa - pb;
        if (mode === "termahal") return pb - pa;
        return ia - ib;
      });
      items.forEach(function (el) {
        grid.appendChild(el);
      });
    });
  })();
</script>
