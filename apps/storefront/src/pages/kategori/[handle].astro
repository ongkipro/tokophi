---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { COLLECTIONS, byCollection, type Collection } from "../../data/catalog";

export function getStaticPaths() {
  return COLLECTIONS.map((collection) => ({
    params: { handle: collection.handle },
    props: { collection },
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const products = byCollection(collection.handle);
---

<Layout
  title={collection.name}
  description={`${collection.name} — ${collection.blurb}. Koleksi busana wanita di Batik Nusantara.`}
>
  <section class="bg-brand-50">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <nav class="text-sm text-muted">
        <a href="/" class="hover:text-brand-600">Beranda</a>
        <span class="mx-1">/</span>
        <span class="text-ink">{collection.name}</span>
      </nav>
      <h1 class="mt-4 font-display text-4xl font-semibold text-ink sm:text-5xl">
        <span class="mr-2">{collection.emoji}</span>{collection.name}
      </h1>
      <p class="mt-3 max-w-xl text-muted">{collection.blurb}</p>
      <p class="mt-2 text-sm text-muted">{products.length} produk</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    {
      products.length > 0 ? (
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {products.map((p) => <ProductCard product={p} />)}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-line bg-white py-20 text-center">
          <p class="text-4xl">🛍️</p>
          <h2 class="mt-4 font-display text-2xl font-semibold text-ink">Belum ada produk</h2>
          <p class="mt-2 text-muted">Koleksi ini sedang dalam perjalanan. Cek koleksi lainnya, yuk.</p>
          <a
            href="/"
            class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Kembali ke Beranda
          </a>
        </div>
      )
    }
  </section>
</Layout>
