---
// Cart — Shopify-shaped: line items on the left, a STICKY order-summary card on the right, and a
// recommendation strip below. The old page was a single narrow column with the total buried at the
// bottom, so on a phone the checkout button sat below the fold of an already-scrolled list.
//
// The cart itself lives in localStorage (there is no shopper account, ADR/§storefront), so the line
// items must be rendered client-side. Everything that does NOT depend on the cart — headings, the
// summary shell, trust copy, recommendations — is server-rendered instead of built in JS strings:
// less layout shift, and the markup stays reviewable.
//
// Deliberately NOT copied from Shopify: the "spend Rp X more for free shipping" progress bar. There
// is no free-shipping threshold anywhere in our data (a `gratis_ongkir` discount has no minimum), so
// the bar would be inventing a promise the checkout would not honour.
import { ShoppingCart, ShieldCheck, Truck, RotateCcw, ArrowRight, ArrowLeft } from "@lucide/astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { type Crumb } from "../lib/breadcrumb";
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getPages } from "../data/content";

const { store, catalog } = Astro.locals;
// The return-policy trust line linked to /halaman/kebijakan-pengembalian and asserted "7 hari" — both
// hardcoded: the link 404s on any store that hasn't published that page, and the store may have no such
// policy at all. Show the line only when the page is really published, and use its own title.
const returnPage = (await getPages(store.id)).find((p) => p.handle === "kebijakan-pengembalian");
// The 4 most-sold. The top-up from the rest of the catalogue is GONE: it existed only because
// `bestsellers()` returned "whatever the merchant flagged" (3 in the seed), leaving a hole in this
// 4-up row. It now sorts the whole catalogue by units_sold, so the first 4 are always there and are
// actually the top 4 — the workaround was treating the symptom.
const recommended = catalog.bestsellers().slice(0, 4);

const CRUMBS: Crumb[] = [
  { name: "Beranda", href: "/" },
  { name: "Keranjang" },
];
---

<!-- `noindex,follow` — this was asymmetric with /checkout, which has carried it since day one. The cart
     is per-shopper and empty for a crawler: there is nothing here worth a SERP slot. robots.txt already
     disallows /keranjang, but that is NOT the same guarantee and is in some ways weaker — a disallowed
     URL can still be indexed URL-only from an inbound link, and the crawler that is forbidden from
     fetching it can never read the `noindex` that would have kept it out. `follow`, so the links out of
     an abandoned-cart share still pass to the catalogue. -->
<Layout
  title="Keranjang"
  description={`Keranjang belanja di ${store.name}.`}
  robots="noindex,follow"
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <Breadcrumb items={CRUMBS} />

    <div class="mt-5 flex flex-wrap items-baseline justify-between gap-3">
      <h1 class="font-display text-3xl font-semibold text-ink">Keranjang Belanja</h1>
      <a
        href="/kategori/semua"
        class="inline-flex items-center gap-1.5 rounded-sm text-sm font-medium text-brand-700 transition-colors hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        <ArrowLeft class="h-4 w-4" stroke-width={2} aria-hidden="true" />
        Lanjut belanja
      </a>
    </div>

    <!-- Empty state -->
    <div
      id="cart-empty"
      hidden
      class="mt-8 py-20 text-center"
    >
      <ShoppingCart class="mx-auto h-10 w-10 text-brand-400" stroke-width={1.5} aria-hidden="true" />
      <h2 class="mt-4 font-display text-2xl font-semibold text-ink">Keranjangmu masih kosong</h2>
      <p class="mt-2 text-muted">Yuk jelajahi koleksi dan temukan busana favoritmu.</p>
      <a
        href="/kategori/semua"
        class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
      >
        Mulai Belanja
      </a>
    </div>

    <!-- Cart body -->
    <div id="cart-body" hidden class="mt-8 grid gap-8 lg:grid-cols-[1fr_21rem] lg:items-start">
      <div class="rounded-2xl border border-line bg-white">
        <!-- Column headers: desktop only. On a phone each row is a card, and headers for a
             one-column list are noise. -->
        <div
          class="hidden grid-cols-[1fr_auto_7rem] gap-4 border-b border-line px-5 py-3 text-xs font-semibold uppercase tracking-[0.14em] text-muted sm:grid"
        >
          <span>Produk</span>
          <span class="text-center">Jumlah</span>
          <span class="text-right">Total</span>
        </div>
        <div id="cart-items"></div>
      </div>

      <!-- Order summary. `sticky` is the point of the two-column layout: on a long cart the
           checkout button must never scroll out of reach. -->
      <aside class="rounded-2xl border border-line bg-white p-5 lg:sticky lg:top-24">
        <h2 class="font-display text-lg font-semibold text-ink">Ringkasan pesanan</h2>

        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-muted">Subtotal (<span id="cart-count-label">0</span> item)</dt>
            <dd class="font-medium text-ink tabular-nums" id="cart-subtotal">—</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted">Ongkos kirim</dt>
            <!-- Honest: ongkir is a live courier quote keyed on the destination (KiriminAja), so it
                 genuinely cannot be known until the address is entered. Say that, don't show "Rp0". -->
            <dd class="text-muted">Dihitung saat checkout</dd>
          </div>
        </dl>

        <div class="mt-4 flex items-baseline justify-between border-t border-line pt-4">
          <span class="font-medium text-ink">Total sementara</span>
          <span
            class="font-display text-2xl font-semibold text-ink tabular-nums"
            id="cart-total"
            aria-live="polite">—</span
          >
        </div>

        <a
          href="/checkout"
          class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-all hover:-translate-y-0.5 hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream motion-reduce:transition-none motion-reduce:hover:translate-y-0"
        >
          Lanjut ke Checkout
          <ArrowRight class="h-4 w-4" stroke-width={2} aria-hidden="true" />
        </a>

        <ul class="mt-5 space-y-2 border-t border-line pt-4 text-xs text-muted">
          <li class="flex items-start gap-2">
            <ShieldCheck class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" stroke-width={1.75} aria-hidden="true" />
            <span>Pembayaran lewat kanal resmi — transfer bank &amp; QRIS.</span>
          </li>
          <li class="flex items-start gap-2">
            <Truck class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" stroke-width={1.75} aria-hidden="true" />
            <span>Dikirim se-Indonesia lewat kurir terpercaya.</span>
          </li>
          {returnPage && (
          <li class="flex items-start gap-2">
            <RotateCcw class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" stroke-width={1.75} aria-hidden="true" />
            <span>
              Pengembalian mudah — lihat{" "}
              <a
                href="/halaman/kebijakan-pengembalian"
                class="underline transition-colors hover:text-brand-700"
              >
                {returnPage.title}
              </a>.
            </span>
          </li>
          )}
        </ul>
      </aside>
    </div>
  </section>

  <!-- Recommendations. Shown whether the cart is full or empty: an empty cart is exactly when a
       shopper most needs somewhere to go. -->
  {
    recommended.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink">Produk terlaris</h2>
          <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {recommended.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script is:inline>
  (function () {
    var itemsEl = document.getElementById("cart-items");
    var bodyEl = document.getElementById("cart-body");
    var emptyEl = document.getElementById("cart-empty");
    if (!itemsEl || !bodyEl || !emptyEl) return;

    var subtotalEl = document.getElementById("cart-subtotal");
    var totalEl = document.getElementById("cart-total");
    var countEl = document.getElementById("cart-count-label");

    var idr = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    });

    function readCart() {
      try {
        var c = JSON.parse(localStorage.getItem("cart") || "[]");
        return Array.isArray(c) ? c : [];
      } catch (e) {
        return [];
      }
    }
    function writeCart(cart) {
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
    }
    // Cart contents come from localStorage — attacker-writable in principle, and merchant text in
    // practice. It is interpolated into HTML below, so it MUST be escaped.
    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    function row(item, idx) {
      var sub = item.price * item.qty;
      var variant = item.variant || item.size || "";
      // The title links to the product. In the old cart it was dead text — a shopper who wanted to
      // re-check a size or the fabric had to navigate out and search for it again.
      var href = item.handle ? "/produk/" + encodeURIComponent(item.handle) : null;
      var title = esc(item.name);

      // ONE stepper and ONE remove button per line, placed into the right cell by grid at each
      // breakpoint. Rendering a mobile copy and a desktop copy would double every interactive
      // control — two elements sharing an index, two click handlers, and a hidden duplicate that
      // still sits in the tab order. Only the line-total TEXT is duplicated (static, no handler).
      return (
        '<div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 border-b border-line p-4 last:border-b-0 sm:grid-cols-[auto_1fr_auto_8rem] sm:items-center sm:px-5">' +
        // The thumbnail duplicates the title link that sits right next to it, so it is hidden from
        // assistive tech and taken out of the tab order rather than given a second, identical name —
        // two adjacent links reading the same thing is its own bug. Without this the link had NO
        // accessible name at all ("link, blank") on every line of the cart.
        (href
          ? '<a href="' + href + '" tabindex="-1" aria-hidden="true" class="row-span-3 shrink-0 rounded-lg sm:row-span-1">'
          : '<span class="row-span-3 shrink-0 sm:row-span-1">') +
        '<img src="' + esc(item.image) + '" alt="" loading="lazy" class="h-24 w-20 rounded-lg bg-brand-50 object-cover" />' +
        (href ? "</a>" : "</span>") +
        // Product info
        '<div class="min-w-0">' +
        (href
          ? '<a href="' + href + '" class="rounded-sm font-medium text-ink transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">' + title + "</a>"
          : '<p class="font-medium text-ink">' + title + "</p>") +
        (variant
          ? '<p class="mt-1 inline-flex rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-700">' + esc(variant) + "</p>"
          : "") +
        '<p class="mt-1 text-sm text-muted tabular-nums">' + idr.format(item.price) + " / item</p>" +
        "</div>" +
        // Qty — under the title on mobile, its own column on desktop.
        '<div class="col-start-2 flex items-center justify-between gap-4 sm:col-start-3 sm:justify-center">' +
        stepper(idx, item.qty) +
        '<span class="font-semibold text-ink tabular-nums sm:hidden">' + idr.format(sub) + "</span>" +
        "</div>" +
        // Line total + remove.
        '<div class="col-start-2 sm:col-start-4 sm:text-right">' +
        '<p class="hidden font-semibold text-ink tabular-nums sm:block">' + idr.format(sub) + "</p>" +
        '<button type="button" data-remove="' + idx + '" class="rounded-sm text-sm text-muted underline transition-colors hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 sm:mt-1">Hapus</button>' +
        "</div>" +
        "</div>"
      );
    }

    function stepper(idx, qty) {
      return (
        '<div class="inline-flex items-center rounded-full border border-line">' +
        '<button type="button" data-dec="' + idx + '" class="flex h-9 w-9 items-center justify-center rounded-l-full text-muted transition-colors hover:bg-brand-50 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400" aria-label="Kurangi jumlah">−</button>' +
        '<span class="w-9 text-center text-sm font-medium tabular-nums" aria-live="polite">' + qty + "</span>" +
        '<button type="button" data-inc="' + idx + '" class="flex h-9 w-9 items-center justify-center rounded-r-full text-muted transition-colors hover:bg-brand-50 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400" aria-label="Tambah jumlah">+</button>' +
        "</div>"
      );
    }

    function render() {
      var cart = readCart();

      emptyEl.hidden = cart.length > 0;
      bodyEl.hidden = cart.length === 0;
      if (!cart.length) {
        itemsEl.innerHTML = "";
        return;
      }

      var subtotal = 0;
      var count = 0;
      itemsEl.innerHTML = cart
        .map(function (item, i) {
          subtotal += item.price * item.qty;
          count += item.qty;
          return row(item, i);
        })
        .join("");

      if (subtotalEl) subtotalEl.textContent = idr.format(subtotal);
      // "Total sementara" — ongkir is still unknown here, so this is deliberately not called "Total".
      if (totalEl) totalEl.textContent = idr.format(subtotal);
      if (countEl) countEl.textContent = String(count);

      itemsEl.querySelectorAll("[data-remove]").forEach(function (b) {
        b.addEventListener("click", function () {
          var c = readCart();
          c.splice(Number(b.getAttribute("data-remove")), 1);
          writeCart(c);
          render();
        });
      });
      itemsEl.querySelectorAll("[data-inc]").forEach(function (b) {
        b.addEventListener("click", function () {
          var c = readCart();
          var i = Number(b.getAttribute("data-inc"));
          c[i].qty = Math.min(99, c[i].qty + 1);
          writeCart(c);
          render();
        });
      });
      itemsEl.querySelectorAll("[data-dec]").forEach(function (b) {
        b.addEventListener("click", function () {
          var c = readCart();
          var i = Number(b.getAttribute("data-dec"));
          // At 1, decrementing removes the line — the Shopify behaviour, and it avoids a stepper
          // that appears to do nothing.
          if (c[i].qty <= 1) c.splice(i, 1);
          else c[i].qty -= 1;
          writeCart(c);
          render();
        });
      });
    }

    render();
    window.addEventListener("cart:updated", render);
  })();
</script>
