---
// The unified PROMO hub (PROMO P4) — ONE page that gathers every live deal in the store: the flash sale
// (with a countdown), the voucher codes a shopper can copy, automatic free shipping, and the grid of
// everything currently discounted. It reads the SAME sources the checkout/order API price from, so the
// page can never advertise a deal the till won't honour:
//   · flash + markdowns → catalog.products (price/compareAt/flashEndsAt folded in by getCatalog)
//   · vouchers          → activeVouchers() over the discounts table (same "usable now" test as applyDiscount)
//   · free ongkir       → storeFreeShip() (same columns /api/public/order re-reads)
// lazy: banner copy is defaulted here; the merchant-configurable title/banner lands in P4b (promo_hub).
import Layout from "../../layouts/Layout.astro";
// Plain ProductCard grids, NOT ProductListing: the hub shows two curated sections, and ProductListing
// owns the page's `?sort=`/`?page=` URL state + a count/sort toolbar — using it twice would make the two
// sections fight over one sort param and render two redundant toolbars.
import ProductCard from "../../components/ProductCard.astro";
import { Tag, Truck, Zap } from "@lucide/astro";
import { IDR } from "@tokophi/lib/format";
import { activeVouchers, storeFreeShip, promoHub, mediaUrl, imageSrcSet, type VoucherPromo } from "../../data/catalog";

const { store, catalog } = Astro.locals;

// Discounted products, split so the flash ones can carry urgency (countdown) and the rest read as a
// standing sale. `compareAt > price` is the single truth "this is cheaper than usual" everywhere else.
const discounted = catalog.products.filter((p) => p.compareAt && p.compareAt > p.price);
const flashProducts = discounted.filter((p) => p.flashEndsAt);
const markdownProducts = discounted.filter((p) => !p.flashEndsAt);

// The flash sale ends when its SOONEST product does — that is the number the countdown races to.
const flashEndsAt =
  flashProducts.reduce<string | null>((min, p) => (!min || p.flashEndsAt! < min ? p.flashEndsAt! : min), null);

const [vouchers, freeShip, hub] = await Promise.all([activeVouchers(store.id), storeFreeShip(store.id), promoHub(store.id)]);

// Merchant-configurable banner (P4b), with defaults so the page always reads well.
const hubTitle = hub.title?.trim() || "Semua Promo, Satu Halaman";
const hubSubtitle = hub.subtitle?.trim() || `Flash sale, kode voucher, dan gratis ongkir dari ${store.name} — semuanya di sini.`;
const hubBanner = hub.bannerUrl?.trim() ? mediaUrl(hub.bannerUrl.trim()) : null;
// The banner is `absolute inset-0` in a full-bleed section — its box IS the viewport (Task 6.12).
const BANNER_SIZES = "100vw";

// Human label for a voucher chip. `gratis_ongkir` value is unused; persen is %, nominal is rupiah off.
function voucherLabel(v: VoucherPromo): string {
  const base =
    v.kind === "persen" ? `Diskon ${v.value}%`
    : v.kind === "gratis_ongkir" ? "Gratis Ongkir"
    : `Potongan ${IDR(v.value)}`;
  return v.minPurchaseIdr > 0 ? `${base} · min. ${IDR(v.minPurchaseIdr)}` : base;
}

const hasAnything = discounted.length > 0 || vouchers.length > 0 || freeShip.enabled;
// Just the page name — Layout appends " — {store.name}" itself (Layout.astro). Passing the store name
// here too doubled it: "Promo — Batik Nusantara — Batik Nusantara".
const TITLE = "Promo";
---

<Layout
  title={TITLE}
  description={`Flash sale, kode voucher, dan gratis ongkir di ${store.name}. Semua promo dalam satu halaman.`}
  robots="index,follow"
>
  {/* HERO — merchant banner image if set (overlaid), else the brand gradient */}
  {/* REDESIGN C (owner 2026-11-05): no dark gradient slab with a low-contrast "PROMO SPESIAL" kicker.
      A merchant who uploaded a promo banner gets it as a short photo band; everyone else gets the same
      quiet title header as every other listing. */}
  {hubBanner ? (
    <section class="relative isolate overflow-hidden bg-ink text-white">
      <img
        src={hubBanner}
        srcset={imageSrcSet(hubBanner)}
        sizes={imageSrcSet(hubBanner) ? BANNER_SIZES : undefined}
        alt=""
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/80 via-ink/40 to-ink/10"></div>
      <div class="mx-auto flex min-h-[200px] max-w-7xl flex-col justify-end px-4 py-6 sm:min-h-[260px] sm:px-6 sm:py-8">
        <h1 class="font-display text-[1.625rem] font-semibold leading-tight tracking-[-0.01em] sm:text-4xl">{hubTitle}</h1>
        <p class="mt-1.5 max-w-xl text-[0.9375rem] text-white/90">{hubSubtitle}</p>
      </div>
    </section>
  ) : (
    <section>
      <div class="mx-auto max-w-7xl px-4 pb-2 pt-5 sm:px-6 sm:pt-8">
        <h1 class="font-display text-[1.625rem] font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-4xl">{hubTitle}</h1>
        <p class="mt-1.5 max-w-xl text-[0.9375rem] text-muted">{hubSubtitle}</p>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-7xl space-y-12 px-4 pb-10 pt-6 sm:px-6">

    {/* FREE SHIPPING */}
    {freeShip.enabled && (
      <div class="flex items-start gap-3 rounded-lg bg-mist px-4 py-3.5">
        <Truck class="mt-0.5 size-5 shrink-0 text-ink" stroke-width={1.75} aria-hidden="true" />
        <div class="text-sm">
          <p class="font-medium text-ink">
            {freeShip.minIdr > 0 ? <Fragment>Gratis ongkir untuk belanja mulai {IDR(freeShip.minIdr)}</Fragment> : "Gratis ongkir untuk semua pesanan"}
          </p>
          <p class="mt-0.5 text-muted">Potongan ongkir otomatis berlaku saat checkout.</p>
        </div>
      </div>
    )}

    {/* VOUCHERS */}
    {vouchers.length > 0 && (
      <section>
        <h2 class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-[1.75rem]">Kode voucher</h2>
        <p class="mt-1.5 text-[0.9375rem] text-muted">Ketik kodenya di halaman checkout untuk memakainya.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {vouchers.map((v) => (
            <div class="flex items-center justify-between gap-3 rounded-lg border border-line bg-white p-4">
              <div class="min-w-0">
                <p class="text-base font-semibold tracking-wide text-ink">{v.code}</p>
                <p class="mt-0.5 text-xs text-muted">{voucherLabel(v)}</p>
              </div>
              <button
                type="button"
                class="voucher-copy inline-flex min-h-10 shrink-0 items-center rounded-lg border border-ink px-3.5 text-sm font-medium text-ink transition-colors hover:bg-ink hover:text-white"
                data-code={v.code}
              >Salin</button>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* FLASH SALE */}
    {flashProducts.length > 0 && (
      <section>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="flex items-center gap-2 font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-[1.75rem]">
            <Zap class="size-5 fill-current" stroke-width={0} aria-hidden="true" />
            Flash sale
          </h2>
          {flashEndsAt && (
            <div class="flex items-center gap-2 text-sm text-ink">
              <span class="text-muted">Berakhir dalam</span>
              <span
                class="flash-countdown rounded-md bg-ink px-2.5 py-1 font-semibold tabular-nums text-white"
                data-ends={flashEndsAt}
              >—</span>
            </div>
          )}
        </div>
        <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-y-12 lg:grid-cols-4">
          {flashProducts.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}

    {/* STANDING MARKDOWNS */}
    {markdownProducts.length > 0 && (
      <section>
        <h2 class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-[1.75rem]">Sedang diskon</h2>
        <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-y-12 lg:grid-cols-4">
          {markdownProducts.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}

    {/* EMPTY */}
    {!hasAnything && (
      <div class="rounded-lg bg-mist py-16 text-center">
        <Tag class="mx-auto size-7 text-muted" stroke-width={1.5} aria-hidden="true" />
        <p class="mt-3 font-semibold text-ink">Belum ada promo aktif</p>
        <p class="mt-1 text-sm text-muted">Pantau terus halaman ini — promo baru bisa muncul kapan saja.</p>
        <a href="/" class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700">Lihat semua produk</a>
      </div>
    )}
  </div>
</Layout>

<script is:inline>
  // Copy a voucher code to the clipboard; flip the button label briefly so the tap is acknowledged.
  document.querySelectorAll(".voucher-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.getAttribute("data-code") || "";
      try { await navigator.clipboard.writeText(code); } catch { /* clipboard blocked — no-op */ }
      const prev = btn.textContent;
      btn.textContent = "Tersalin";
      setTimeout(() => { btn.textContent = prev; }, 1400);
    });
  });

  // Flash-sale countdown → "N hari HH:MM:SS", or "HH:MM:SS" inside a day. Ticks each second; at zero it
  // shows "Berakhir" (the order API already stops honouring the price, so the page just stops promising).
  (function () {
    var el = document.querySelector(".flash-countdown");
    if (!el) return;
    var ends = new Date(el.getAttribute("data-ends")).getTime();
    var p2 = function (n) { return String(n).padStart(2, "0"); };
    function tick() {
      var ms = ends - Date.now();
      if (ms <= 0) { el.textContent = "Berakhir"; return; }
      var s = Math.floor(ms / 1000);
      var d = Math.floor(s / 86400); s -= d * 86400;
      var h = Math.floor(s / 3600); s -= h * 3600;
      var m = Math.floor(s / 60); s -= m * 60;
      el.textContent = (d > 0 ? d + " hari " : "") + p2(h) + ":" + p2(m) + ":" + p2(s);
      requestAnimationFrame(function () { setTimeout(tick, 1000); });
    }
    tick();
  })();
</script>
