---
import Layout from "../layouts/Layout.astro";
const store = Astro.locals.store;

const waHref = `https://wa.me/${store.whatsapp}`;
const email = "halo@batiknusantara.id";
---

<Layout
  title="Kontak"
  description={`Hubungi ${store.name} — pertanyaan seputar produk, pesanan, dan kerja sama.`}
>
  <section class="bg-brand-50">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
      <nav class="text-sm text-muted">
        <a href="/" class="transition-colors hover:text-brand-600">Beranda</a>
        <span class="mx-2 text-line">/</span>
        <span class="text-ink">Kontak</span>
      </nav>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Kontak</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-ink">Hubungi Kami</h1>
      <p class="mt-3 max-w-xl leading-relaxed text-muted">
        Ada pertanyaan seputar produk, ukuran, atau pesanan? Tim {store.name} senang membantu.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
      <!-- Store info -->
      <div class="flex flex-col gap-6">
        <div class="rounded-2xl border border-line bg-white/70 p-6 shadow-sm">
          <h2 class="font-display text-2xl font-semibold text-ink">{store.name}</h2>
          <p class="mt-1 text-sm text-muted">{store.tagline}</p>

          <dl class="mt-6 flex flex-col gap-4 text-sm">
            <div class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 fill-none stroke-brand-500" stroke-width="1.8" aria-hidden="true">
                <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="2.4" />
              </svg>
              <div>
                <dt class="font-medium text-ink">Lokasi</dt>
                <dd class="text-muted">{store.city}, Indonesia</dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 fill-none stroke-brand-500" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3.5 6.5 12 13l8.5-6.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <dt class="font-medium text-ink">Email</dt>
                <dd><a href={`mailto:${email}`} class="text-brand-700 hover:underline">{email}</a></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 fill-none stroke-brand-500" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.5 2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <dt class="font-medium text-ink">Jam Operasional</dt>
                <dd class="text-muted">Senin–Jumat 09.00–17.00 WIB</dd>
                <dd class="text-muted">Sabtu 09.00–14.00 WIB</dd>
              </div>
            </div>
          </dl>

          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.12c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.14.07-1.84-.11-.42-.13-.97-.31-1.66-.61-2.92-1.26-4.83-4.2-4.98-4.4-.14-.19-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.65.5.24.58.83 2.01.9 2.16.07.14.12.31.02.5-.09.19-.14.31-.29.48-.14.17-.3.38-.43.51-.14.14-.29.29-.12.58.17.29.74 1.22 1.59 1.98 1.09.98 2.01 1.28 2.3 1.42.29.14.46.12.63-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.65-.14.26.09 1.69.8 1.98.94.29.14.48.22.55.34.07.12.07.68-.17 1.36z" />
            </svg>
            Hubungi via WhatsApp
          </a>
        </div>
      </div>

      <!-- Contact form -->
      <div class="rounded-2xl border border-line bg-white/70 p-6 shadow-sm">
        <h2 class="font-display text-2xl font-semibold text-ink">Kirim Pesan</h2>
        <p class="mt-1 text-sm text-muted">Isi formulir di bawah, kami akan membalas secepatnya.</p>

        <form id="contact-form" class="mt-6 flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="nama" class="text-sm font-medium text-ink">Nama</label>
            <input id="nama" name="nama" type="text" required placeholder="Nama lengkap"
              class="rounded-lg border border-line bg-white px-3.5 py-2.5 text-sm outline-none transition-colors focus:border-brand-400 focus-visible:ring-2 focus-visible:ring-brand-400/40" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-medium text-ink">Email</label>
            <input id="email" name="email" type="email" required placeholder="nama@email.com"
              class="rounded-lg border border-line bg-white px-3.5 py-2.5 text-sm outline-none transition-colors focus:border-brand-400 focus-visible:ring-2 focus-visible:ring-brand-400/40" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="pesan" class="text-sm font-medium text-ink">Pesan</label>
            <textarea id="pesan" name="pesan" rows="5" required placeholder="Tulis pesan Anda…"
              class="resize-y rounded-lg border border-line bg-white px-3.5 py-2.5 text-sm outline-none transition-colors focus:border-brand-400 focus-visible:ring-2 focus-visible:ring-brand-400/40"></textarea>
          </div>
          <button type="submit"
            class="mt-1 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-cream transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream">
            Kirim
          </button>
          <p id="contact-note" class="hidden rounded-lg bg-brand-50 px-4 py-3 text-center text-sm text-brand-700">
            Terima kasih! Pesan Anda sudah kami terima — tim kami akan segera membalas. 🙂
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById("contact-form");
    var note = document.getElementById("contact-note");
    if (!form || !note) return;
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      note.classList.remove("hidden");
      form.reset();
    });
  })();
</script>
