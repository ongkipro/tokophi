---
import { ShoppingCart, Banknote, MapPin, Truck, ChevronDown } from "@lucide/astro";
import PayIcon from "../components/PayIcon.astro";
import Layout from "../layouts/Layout.astro";
import { enabledPaymentChannels, mediaUrl, storeCodPolicy } from "../data/catalog";
import { db, schema } from "@tokophi/db";
import { and, eq } from "drizzle-orm";
import { verifyRecoveryToken } from "../lib/recovery";

// ADR 0009 §4 — checkout is LOCKED (not part of the Store Builder); its only per-store variance is
// branding read from the store profile: the logo (stores.logo_url) + the brand colour (already
// injected as CSS vars by Layout.astro). Store itself is resolved per-request from the Host header.
const store = Astro.locals.store;
const catalog = Astro.locals.catalog;
const LOGO = store.logoUrl ? mediaUrl(store.logoUrl) : null; // null → wordmark fallback

// Platform shipping proxy (admin) + this store's origin city.
//
// RUNTIME env (process.env), NOT import.meta.env. `import.meta.env.PUBLIC_*` is replaced at BUILD time,
// and the Docker image is built WITHOUT env — so those bake in as `undefined` and fall back to
// `http://localhost:3000`, a host the SHOPPER's browser cannot reach in production. The kecamatan
// search, the order POST and the payment call would all silently fail. This value is read per-request
// on the server and handed to the client via define:vars below (the store resolver uses the same
// pattern — src/data/store.ts).
const ONGKIR_API = process.env.PUBLIC_ONGKIR_API || "http://localhost:3000/api/public/ongkir";
const ORDER_API = process.env.PUBLIC_ORDER_API || "http://localhost:3000/api/public/order";
const ORIGIN_CITY = store.city || "Yogyakarta";
const STORE_SLUG = store.slug;

// Payment channels = whatever the platform (super-admin) enabled (platform_payment_channels),
// read per request. Brand hidden — generic method labels only.
const payDesc = (kind: string, label: string) =>
  kind === "qris" ? "Scan dari semua e-wallet & m-banking"
  : kind === "va" ? "Bayar via ATM / m-banking"
  : kind === "ewallet" ? `Bayar pakai saldo ${label}`
  : kind === "retail" ? `Bayar tunai di gerai ${label}`
  : "Bayar online";
const PAYMENTS = (await enabledPaymentChannels()).map((c) => ({ id: c.code, label: c.label, kind: c.kind, desc: payDesc(c.kind, c.label) }));

// Group by kind. A flat list of 6 radios made the five Virtual Accounts look like five unrelated
// choices, so the shopper had to read every row to find their bank. Grouping is the whole job of this
// screen: pick a FAMILY first (I'll scan a QR / I'll transfer / I'll pay at a minimart), then a bank.
// Order is by how Indonesians actually pay, not alphabetically.
const KIND_ORDER = ["qris", "va", "ewallet", "retail"] as const;
const KIND_META: Record<string, { title: string; hint: string }> = {
  qris: { title: "QRIS", hint: "Scan dari e-wallet atau m-banking mana pun" },
  va: { title: "Transfer Bank (Virtual Account)", hint: "Bayar lewat ATM, m-banking, atau internet banking" },
  ewallet: { title: "E-Wallet", hint: "Bayar pakai saldo dompet digital" },
  retail: { title: "Gerai Retail", hint: "Bayar tunai di minimarket" },
};
// Inside a group, a channel is shown by what DISTINGUISHES it. The five VA labels all read "Virtual
// Account <Bank>" under a heading that already says Virtual Account — so the shopper reads the same
// two words five times to find one that differs. Strip the prefix and only the bank remains.
const shortLabel = (label: string, kind: string) =>
  kind === "va" ? label.replace(/^Virtual Account\s+/i, "") : label;

const PAY_GROUPS = KIND_ORDER.map((kind) => ({
  kind,
  ...KIND_META[kind],
  items: PAYMENTS.filter((p) => p.kind === kind).map((p) => ({ ...p, short: shortLabel(p.label, p.kind) })),
})).filter((g) => g.items.length > 0);

// COD is NOT a payment channel like the others — it is a merchant switch (store_settings.cod_enabled,
// migration 0038, default OFF) narrowed further by the PLATFORM's risk limits (platform_cod: a max
// order amount + a province allow-list) and a per-service allowance. So:
//   · store (or platform) switched COD off → the option is not rendered at all (below)
//   · switched on → the option is rendered but stays hidden until ALL of these hold live:
//       – the shopper picked a shipping service whose rate came back cod:true (the ongkir API
//         returns the EFFECTIVE flag: courier capability × platform codAllowed × store switch)
//       – subtotal + ongkir ≤ platform_cod.max_amount_idr
//       – the province is on platform_cod.allowed_provinces (when that list is non-empty). It is now
//         DERIVED from the chosen kecamatan, not typed, so it can no longer disagree with the
//         district the parcel is actually booked against.
//     Any of them failing → the row disappears. NOT a greyed-out row with an excuse: a COD we would
//     reject has no business being on screen at all.
// Either way /api/public/order re-checks all of it and rejects a COD order it should not accept —
// this is UX, that is the boundary (apps/admin/lib/cod.ts).
const COD = await storeCodPolicy(store.id);
const COD_ENABLED = COD.enabled;
const COD_MAX = COD.maxAmountIdr; // 0 = no cap
const COD_PROVINCES = COD.allowedProvinces; // [] = every province

// ── Recovery link (?r=<signed token>) ────────────────────────────────────────────────────────────
// The merchant's WhatsApp "kamu meninggalkan keranjang" message links here. The token is an HS256
// JWT bound to (session id, store id) with a 7-day life (src/lib/recovery.ts) — NOT a raw session
// id, which would hand anyone who sees the URL a stranger's name, phone and address.
//
// A valid token restores: the basket (from the snapshot in checkout_sessions.items — the price the
// shopper actually saw, not today's price) and everything they had typed. The session id is handed
// to the client too, so the shopper's continued edits keep updating the SAME row — and so the order,
// when it finally happens, can flip THAT row to `pulih`. Without that, the rescue would be invisible.
//
// A bad/expired/other-tenant token is simply ignored → the ordinary empty checkout, never an error.
const rToken = Astro.url.searchParams.get("r");
type RecoverItem = { handle: string | null; name: string | null; variant: string | null; qty: number; price: number };
let RECOVER: {
  sessionId: string;
  items: { handle: string; name: string; variant: string; qty: number; price: number; image: string }[];
  name: string; phone: string; email: string; address: string;
  city: string; province: string; postcode: string; destId: number | null;
} | null = null;

if (rToken) {
  const sid = await verifyRecoveryToken(rToken, store.id);
  if (sid) {
    const [row] = await db
      .select()
      .from(schema.checkoutSessions)
      .where(and(eq(schema.checkoutSessions.storeId, store.id), eq(schema.checkoutSessions.sessionId, sid)))
      .limit(1);
    // `pulih` = already bought. Re-hydrating that cart would push the shopper to buy it twice.
    if (row && row.status !== "pulih") {
      const snap = (Array.isArray(row.items) ? row.items : []) as RecoverItem[];
      RECOVER = {
        sessionId: sid,
        // The image is NOT in the snapshot (that stays the documented {handle,name,variant,qty,price}
        // shape) — it is re-resolved from the live catalog, so a re-shot photo shows up correctly.
        items: snap
          .filter((i) => i?.name && i.qty > 0)
          .map((i) => ({
            handle: i.handle ?? "",
            name: i.name ?? "",
            variant: i.variant ?? "",
            qty: i.qty,
            price: i.price,
            image: (i.handle && catalog.findProduct(i.handle)?.image) || "",
          })),
        name: row.name ?? "",
        phone: row.phone ?? "",
        email: row.email ?? "",
        address: row.address ?? "",
        city: row.city ?? "",
        province: row.province ?? "",
        postcode: row.postcode ?? "",
        destId: row.districtId ?? null,
      };
    }
  }
}
---

<Layout title="Checkout" description={`Selesaikan pesananmu di ${store.name}.`}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav class="text-sm text-muted">
      <a href="/keranjang" class="hover:text-brand-600">Keranjang</a>
      <span class="mx-1">/</span>
      <span class="text-ink">Checkout</span>
    </nav>

    <!-- Merchant branding (ADR 0009 §4): the merchant's logo, or their name as a wordmark when
         stores.logo_url is null. -->
    <div class="mt-4 flex items-center gap-3 border-b border-line pb-5">
      {
        LOGO ? (
          <img
            src={LOGO}
            alt={store.name}
            class="h-11 w-auto max-w-[12rem] object-contain"
            data-store-logo
          />
        ) : (
          <span class="font-display text-2xl font-semibold tracking-tight text-ink" data-store-logo>
            {store.name}
          </span>
        )
      }
      <span class="ml-auto inline-flex items-center gap-1.5 text-xs font-medium text-muted">
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
          <path d="M12 3l7 3v5.5c0 4.2-2.9 7.9-7 9-4.1-1.1-7-4.8-7-9V6l7-3Z" stroke-linejoin="round" />
          <path d="M9 12.2l2.1 2.1L15 10.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Pembayaran aman
      </span>
    </div>

    <h1 class="mt-5 font-display text-3xl font-semibold text-ink">Checkout</h1>
    <p class="mt-1 text-sm text-muted">
      Kolom bertanda <span class="text-red-500">*</span> wajib diisi.
    </p>

    {
      RECOVER && (
        <p class="mt-4 rounded-xl border border-brand-600/30 bg-brand-50 px-4 py-3 text-sm text-ink">
          Selamat datang kembali{RECOVER.name ? `, ${RECOVER.name.split(" ")[0]}` : ""}! Keranjang dan datamu sudah
          kami simpan — tinggal lanjut bayar.
        </p>
      )
    }

    <div id="checkout-empty" class="mt-10 hidden rounded-2xl border border-dashed border-line bg-white py-20 text-center">
      <ShoppingCart class="mx-auto h-10 w-10 text-brand-400" stroke-width={1.5} aria-hidden="true" />
      <h2 class="mt-4 font-display text-2xl font-semibold text-ink">Keranjangmu masih kosong</h2>
      <p class="mt-2 text-muted">Tambahkan produk dulu sebelum checkout.</p>
      <a href="/" class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700">Mulai Belanja</a>
    </div>

    <form id="checkout-form" class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <!-- LEFT: form -->
      <div class="space-y-8">
        <!-- Kontak -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Kontak</legend>
          <label class="block">
            <span class="text-sm font-medium text-ink">Email <span class="font-normal text-muted">(opsional)</span></span>
            <input
              type="email"
              name="email"
              placeholder="nama@email.com"
              class="mt-1.5 w-full rounded-lg border border-line bg-cream px-3.5 py-2.5 text-sm text-ink outline-none transition-colors focus:border-brand-400 focus:bg-white"
            />
            {/* There is NO mailer AND no order-notification of any kind in this codebase. So neither
                email nor WhatsApp may be promised as the confirmation channel. The email is collected
                for a future account / promo use only. Do NOT re-add "kami kirim struk ke email" or
                "konfirmasi dikirim lewat WhatsApp" unless something actually sends them. */}
            <span class="mt-1.5 block text-xs text-muted">
              {/* An HTML comment here would SHIP to the browser — use a JSX comment.
                  The old copy promised, in bold, that an order confirmation is sent over WhatsApp.
                  Nothing sends it: /api/public/order dispatches no notification of any kind, and the
                  only WhatsApp code in the repo is a MERCHANT-initiated wa.me link for abandoned
                  carts. It was the last thing a shopper read before paying — they paid, then waited
                  for a message that never came. */}
              Untuk info promo &amp; kalau kami perlu menghubungimu soal pesanan ini.
            </span>
          </label>
        </fieldset>

        <!-- Alamat pengiriman -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Alamat Pengiriman</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-medium text-ink">Nama Lengkap <span class="text-red-500" aria-hidden="true">*</span></span>
              <input type="text" name="nama" required autocomplete="name" class="input-field" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">No. WhatsApp <span class="text-red-500" aria-hidden="true">*</span></span>
              <input type="tel" name="whatsapp" required inputmode="tel" placeholder="08xxxxxxxxxx" autocomplete="tel" class="input-field" />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-ink">Alamat Lengkap <span class="text-red-500" aria-hidden="true">*</span></span>
              <textarea name="alamat" required rows="2" placeholder="Nama jalan, no. rumah, RT/RW, patokan" class="input-field resize-none"></textarea>
            </label>
            <!-- Kecamatan comes FIRST, and it drives Kota + Provinsi.
                 Before: the shopper typed Kota, Provinsi and Kode Pos by hand AND then separately
                 searched a kecamatan for the ongkir quote — re-keying an address the aggregator
                 already knows, with nothing keeping the two in agreement.
                 It also closes a real hole. `apps/admin/lib/data/areas.ts` puts it plainly: a typed
                 province is a CLAIM, not a fact — the backend already refuses to trust it and derives
                 the province from the district id when gating COD. Deriving the visible fields from
                 the same id means the form can no longer disagree with what ships. -->
            <div class="sm:col-span-2">
              <label class="block">
                <span class="text-sm font-medium text-ink">
                  Kecamatan Tujuan <span class="text-red-500" aria-hidden="true">*</span>
                </span>
                <input type="text" id="dest-search" autocomplete="off" placeholder="Ketik kecamatan / kota, mis. Semarang" class="input-field" />
                <input type="hidden" name="dest_id" id="dest-id" />
                <input type="hidden" name="dest_text" id="dest-text" />
                <div id="dest-results" class="mt-1 hidden max-h-48 overflow-y-auto rounded-xl border border-line bg-white shadow-sm"></div>
              </label>

              <!-- KOTA + PROVINSI ARE DERIVED, SO THEY ARE SHOWN, NOT ASKED.
                   They used to be two readonly boxes the shopper could not fill in anyway — two more
                   columns of chrome for values that are a pure function of the district id. They are
                   still SUBMITTED (hidden inputs, same `name`s, same FormData / capture payload), but
                   they are now displayed as a quiet derived line: "Kota Semarang · Jawa Tengah".
                   The hidden inputs remain the single source the payload + the COD province gate read
                   (codProvinceOk), so nothing downstream changed. -->
              <input type="hidden" name="kota" id="kota" />
              <input type="hidden" name="provinsi" id="provinsi" />
              <p id="area-derived" hidden class="mt-1.5 flex items-center gap-1.5 text-xs text-muted">
                <MapPin class="h-3.5 w-3.5 shrink-0 text-brand-600" stroke-width={1.75} aria-hidden="true" />
                <span id="area-derived-text" class="min-w-0 truncate"></span>
              </p>
            </div>

            <!-- Kelurahan + Kode Pos, ONE ROW: picking a kelurahan is what fills the kodepos, so the
                 cause sits next to its effect instead of a screen apart. Stacks to one column below
                 `sm` (the sub-grid is grid-cols-1 by default) — on a 320px phone they are never
                 squeezed side by side.

                 Kelurahan is the level a KODEPOS is actually assigned at. A kecamatan cannot give us
                 one: 17% of them span several kodepos, and those are the dense urban ones where the
                 orders are (Semarang Tengah alone has 11). Shown only once a kecamatan is chosen, and
                 only for districts we have kelurahan for (~96% of KiriminAja's list); for the rest the
                 kelurahan row stays hidden, Kode Pos widens to the full row and is TYPED — that path
                 must never block the order. See packages/db/scripts/build-kelurahan.mjs. -->
            <div class="grid gap-4 sm:col-span-2 sm:grid-cols-2">
              <label id="kel-wrap" hidden class="block">
                <span class="text-sm font-medium text-ink">
                  Kelurahan / Desa <span class="font-normal text-muted">(opsional)</span>
                </span>
                <select name="kelurahan" id="kel-select" class="input-field">
                  <option value="">Pilih kelurahan…</option>
                </select>
              </label>

              <label id="kodepos-wrap" class="block sm:col-span-2">
                <span class="text-sm font-medium text-ink">Kode Pos <span class="font-normal text-muted">(opsional)</span></span>
                <input type="text" name="kodepos" id="kodepos" inputmode="numeric" autocomplete="postal-code" placeholder="mis. 50241" class="input-field" />
              </label>

              <!-- Shown ONLY for the 18% of districts that really do span several postcodes: there the
                   kelurahan is the question, so say why we are asking it. -->
              <p id="kel-note" hidden class="text-xs text-muted sm:col-span-2">
                Kecamatan ini punya beberapa kode pos — pilih kelurahan agar kode posnya terisi benar.
              </p>
            </div>
          </div>
        </fieldset>

        <!-- Pengiriman -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Pengiriman</legend>
          <p id="ship-hint" class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">
            Pilih <b>kecamatan tujuan</b> di atas untuk melihat ongkir real-time.
          </p>

          <!-- PROGRESSIVE DISCLOSURE (user's design). One `op=rates` call already prices EVERY service
               in one round-trip, so the shopper sees the sensible default (SPX Reguler) immediately and
               the other ~8-19 rows stay behind "Pilih ekspedisi lain" — grouped by KiriminAja's own
               `group` field, never by guessing at names. Revealing them is instant: nothing is fetched
               on click (a second call would only make the click slower). -->
          <div id="ship-express-group" class="hidden">
            <div id="ship-express" class="space-y-2"></div>
            <p id="ship-default-note" hidden class="mt-2 text-xs text-muted"></p>

            <button
              type="button"
              id="ship-more-btn"
              hidden
              aria-expanded="false"
              aria-controls="ship-more"
              class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-xl border border-line px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-brand-400 hover:bg-brand-50 sm:w-auto"
            >
              <Truck class="h-4 w-4 shrink-0 text-brand-600" stroke-width={1.75} aria-hidden="true" />
              <span id="ship-more-label">Pilih ekspedisi lain</span>
              <ChevronDown id="ship-more-caret" class="h-4 w-4 shrink-0 transition-transform" stroke-width={2} aria-hidden="true" />
            </button>

            <div id="ship-more" hidden class="mt-4 space-y-5"></div>
          </div>
        </fieldset>

        <!-- Pembayaran -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Pembayaran</legend>

          <div class="space-y-4">
            {PAY_GROUPS.map((group) => (
              <div>
                {/* A group with ONE channel is rendered as a single selectable row, not a header with
                    one item under it: QRIS was appearing twice — once as the group title and once as
                    its only row. And a multi-channel group's rows show only the BANK NAME, because
                    the group hint already says how you pay; repeating "Bayar via ATM / m-banking"
                    five times is noise a shopper has to read past. */}
                {group.items.length === 1 ? (
                  <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition-colors hover:border-brand-400 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                    <input
                      type="radio"
                      name="payment"
                      value={group.items[0].id}
                      data-label={group.items[0].label}
                      required
                      class="h-4 w-4 shrink-0 accent-brand-600"
                    />
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 ring-1 ring-brand-100">
                      <PayIcon kind={group.kind} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-medium text-ink">{group.title}</span>
                      <span class="block text-xs text-muted">{group.hint}</span>
                    </span>
                  </label>
                ) : (
                  <>
                    <div class="mb-2 flex items-center gap-3 px-1">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 ring-1 ring-brand-100">
                        <PayIcon kind={group.kind} />
                      </span>
                      <div class="min-w-0">
                        <p class="text-sm font-semibold text-ink">{group.title}</p>
                        <p class="text-xs text-muted">{group.hint}</p>
                      </div>
                    </div>
                    <div class="space-y-2">
                      {group.items.map((pm) => (
                        <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-2.5 transition-colors hover:border-brand-400 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                          <input
                            type="radio"
                            name="payment"
                            value={pm.id}
                            data-label={pm.label}
                            required
                            class="h-4 w-4 shrink-0 accent-brand-600"
                          />
                          <span class="min-w-0 flex-1 text-sm font-medium text-ink">{pm.short}</span>
                        </label>
                      ))}
                    </div>
                  </>
                )}
              </div>
            ))}

            {/* COD is HIDDEN until it is genuinely available: the chosen courier must support it, the
                total must sit under the platform cap, and the province (derived from the kecamatan,
                not typed) must be on the allow-list. A greyed-out row with an excuse would be worse —
                a COD we would reject has no business being on screen at all. */}
            {COD_ENABLED && (
              <div id="cod-option" hidden>
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition-colors hover:border-brand-400 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                  <input
                    type="radio"
                    name="payment"
                    value="cod"
                    data-label="COD (Bayar di Tempat)"
                    disabled
                    class="h-4 w-4 shrink-0 accent-brand-600"
                  />
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-50 ring-1 ring-brand-100">
                    <Banknote class="h-4 w-4 text-brand-600" stroke-width={1.75} aria-hidden="true" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-ink">Bayar di Tempat (COD)</span>
                    <span class="block text-xs text-muted">Bayar tunai ke kurir saat paket tiba</span>
                  </span>
                </label>
              </div>
            )}
          </div>

          <p class="mt-4 text-xs text-muted">Pembayaran diproses aman — disediakan TokoΦ.</p>
        </fieldset>
      </div>

      <!-- RIGHT: order summary -->
      <aside class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <h2 class="font-display text-lg font-semibold text-ink">Ringkasan Pesanan</h2>

          <div id="summary-items" class="mt-4 space-y-4"></div>

          <div class="mt-6 space-y-2 border-t border-line pt-4 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-muted">Subtotal</span>
              <span id="summary-subtotal" class="font-medium text-ink tabular-nums">Rp0</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">Ongkir</span>
              <span id="summary-shipping" class="font-medium text-ink tabular-nums">Rp0</span>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-line pt-4">
            <span class="text-base font-medium text-ink">Total</span>
            <span id="summary-total" class="font-display text-2xl font-semibold text-ink tabular-nums">Rp0</span>
          </div>

          <button
            type="submit"
            id="pay-btn"
            class="mt-6 w-full rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-colors hover:bg-brand-700"
          >
            Bayar Sekarang
          </button>
          <p id="form-error" class="mt-3 hidden text-center text-sm font-medium text-brand-700"></p>
          <a href="/keranjang" class="mt-3 block text-center text-sm text-muted underline hover:text-brand-600">Kembali ke keranjang</a>
        </div>
      </aside>
    </form>
  </section>
</Layout>

<style is:global>
  .input-field {
    margin-top: 0.375rem;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-cream);
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .input-field:focus {
    border-color: var(--color-brand-400);
    background: #fff;
  }
</style>

<script is:inline define:vars={{ ONGKIR_API, ORDER_API, ORIGIN_CITY, STORE_SLUG, COD_ENABLED, COD_MAX, COD_PROVINCES, RECOVER }}>
  (function () {
    var idr = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    });

    function readCart() {
      try {
        return JSON.parse(localStorage.getItem("cart") || "[]");
      } catch (e) {
        return [];
      }
    }

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    // ---- The funnel session id (Analytics.astro, sessionStorage "tphi:sid") ----
    // The SAME id, deliberately: the cart must join to its own journey. A recovery link arrives in a
    // BRAND-NEW browser session (they clicked from WhatsApp, hours later), so it overwrites the id
    // with the recovered one — otherwise the rescued shopper would open a second, orphan row and the
    // original abandoned one would never flip to `pulih`.
    var SID_KEY = "tphi:sid";
    function sid() {
      try {
        var v = sessionStorage.getItem(SID_KEY);
        if (v) return v;
        v = crypto && crypto.randomUUID ? crypto.randomUUID() : "s-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 10);
        sessionStorage.setItem(SID_KEY, v);
        return v;
      } catch (e) {
        return "";
      }
    }
    if (RECOVER && RECOVER.sessionId) {
      try { sessionStorage.setItem(SID_KEY, RECOVER.sessionId); } catch (e) {}
      // Restore the basket from the server-side snapshot BEFORE it is read below (the price the
      // shopper saw, not today's).
      if (RECOVER.items && RECOVER.items.length) {
        try {
          localStorage.setItem(
            "cart",
            JSON.stringify(RECOVER.items.map(function (i) {
              return { handle: i.handle, name: i.name, price: i.price, image: i.image, variant: i.variant, size: i.variant, qty: i.qty };
            })),
          );
          // The header badge already read localStorage (it was empty — this is a fresh browser).
          // DOMContentLoaded, because Header.astro's listener is registered by a deferred module.
          document.addEventListener("DOMContentLoaded", function () {
            window.dispatchEvent(new Event("cart:updated"));
          });
        } catch (e) {}
      }
    }
    var SESSION_ID = sid();

    // ═══ INPUT RULES — A MIRROR OF @tokophi/lib/validate, AND ONLY THAT ═══════════════════════════
    // These exist so the shopper sees the mistake while their hands are still on the keyboard. They
    // decide NOTHING: /api/public/order re-normalises and re-validates every one of these fields and
    // is the only thing that can reject an order (same relationship as normProvince() below — the
    // storefront is an inline script and cannot import from the package, so the rules are restated
    // here; the API's copy is the one that counts). Keep the two in step.
    //
    // Normalise generously, reject narrowly: over-validation is itself a bug. A rule that refuses a
    // real name (`Nur'aini`, `M. Rizky`), a brand-new carrier prefix, or an unusual address costs a
    // sale and nobody ever finds out — the shopper just leaves.
    function normalizePhone(raw) {
      var d = String(raw == null ? "" : raw).replace(/\D+/g, "");
      if (!d) return null;
      if (d.slice(0, 3) === "620") d = d.slice(3);
      else if (d.slice(0, 2) === "62") d = d.slice(2);
      else if (d[0] === "0") d = d.replace(/^0+/, "");
      if (d[0] !== "8") return null;              // Indonesian mobiles are 8xx — no prefix table
      if (d.length < 9 || d.length > 12) return null;
      return "62" + d;
    }
    function fieldError(nameAttr, value) {
      var v = String(value == null ? "" : value).trim();
      if (nameAttr === "nama") {
        var n = v.replace(/\s+/g, " ");
        if (!n) return "Nama lengkap wajib diisi.";
        if (n.length < 2) return "Nama terlalu pendek.";
        if (n.length > 80) return "Nama terlalu panjang (maks. 80 karakter).";
        if (/\d/.test(n)) return "Nama tidak boleh mengandung angka.";
        if (!/^[\p{L}\p{M}][\p{L}\p{M} .'’\-]*$/u.test(n)) return "Nama hanya boleh berisi huruf, spasi, titik, apostrof, dan tanda hubung.";
        return "";
      }
      if (nameAttr === "whatsapp") {
        if (!v) return "Nomor WhatsApp wajib diisi.";
        if (!normalizePhone(v)) return "Nomor WhatsApp tidak valid. Contoh: 08123456789.";
        return "";
      }
      if (nameAttr === "email") {
        // Optional, shape only, and NO domain whitelist — a gmail/yahoo allow-list would reject
        // corporate, university and self-hosted addresses, i.e. the higher-value buyers.
        if (!v) return "";
        if (v.length > 254) return "Email terlalu panjang.";
        if (!/^[^\s@,;:<>()[\]\\"]+@[^\s@.,;:<>()[\]\\"]+(\.[^\s@.,;:<>()[\]\\"]+)+$/u.test(v.toLowerCase())) return "Format email tidak valid. Contoh: nama@email.com.";
        return "";
      }
      if (nameAttr === "alamat") {
        var a = v.replace(/\r\n?/g, "\n").replace(/[^\S\n]+/g, " ").replace(/\s*\n+\s*/g, ", ").trim();
        if (!a) return "Alamat lengkap wajib diisi.";
        if (a.length < 10) return "Alamat terlalu pendek — tulis nama jalan, no. rumah, RT/RW.";
        if (a.length > 300) return "Alamat terlalu panjang (maks. 300 karakter).";
        if (/[\u0000-\u001F\u007F\u200B-\u200D\uFEFF]/.test(a) || /\p{Extended_Pictographic}/u.test(a)) return "Alamat mengandung karakter yang tidak didukung.";
        var distinct = new Set(a.replace(/\s+/g, "").toLowerCase()).size;
        if (distinct < 4) return "Alamat tidak valid — tulis alamat lengkapmu.";
        if ((a.match(/\p{L}/gu) || []).length < 4) return "Alamat tidak valid — tulis alamat lengkapmu.";
        return "";
      }
      if (nameAttr === "kodepos") {
        if (!v) return ""; // optional — the ~4% of districts with no kelurahan data type it by hand
        if (!/^\d{5}$/.test(v)) return "Kode pos harus 5 angka.";
        return "";
      }
      return "";
    }

    var cart = readCart();
    var form = document.getElementById("checkout-form");
    var empty = document.getElementById("checkout-empty");

    if (!cart.length) {
      if (form) form.classList.add("hidden");
      if (empty) empty.classList.remove("hidden");
      return;
    }

    // ---- Restore what they had already typed ----
    if (RECOVER) {
      var pre = { email: RECOVER.email, nama: RECOVER.name, whatsapp: RECOVER.phone, alamat: RECOVER.address, kota: RECOVER.city, provinsi: RECOVER.province, kodepos: RECOVER.postcode };
      Object.keys(pre).forEach(function (k) {
        var el = form.querySelector('[name="' + k + '"]');
        if (el && pre[k]) el.value = pre[k];
      });
    }

    var subtotal = 0;
    var itemsHtml = cart
      .map(function (item) {
        var sub = item.price * item.qty;
        subtotal += sub;
        return (
          '<div class="flex items-center gap-3">' +
          '<div class="relative shrink-0">' +
          '<img src="' + esc(item.image) + '" alt="' + esc(item.name) + '" class="h-16 w-14 rounded-lg object-cover bg-brand-50" loading="lazy" />' +
          '<span class="absolute -right-2 -top-2 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-ink px-1 text-xs font-semibold text-cream">' + item.qty + "</span>" +
          "</div>" +
          '<div class="min-w-0 flex-1">' +
          '<p class="truncate text-sm font-medium text-ink">' + esc(item.name) + "</p>" +
          ((item.variant || item.size) ? '<p class="text-xs text-muted">Varian: ' + esc(item.variant || item.size) + "</p>" : "") +
          "</div>" +
          '<span class="text-sm font-medium text-ink tabular-nums">' + idr.format(sub) + "</span>" +
          "</div>"
        );
      })
      .join("");

    document.getElementById("summary-items").innerHTML = itemsHtml;
    document.getElementById("summary-subtotal").textContent = idr.format(subtotal);

    function selectedShipping() {
      var el = form.querySelector('input[name="shipping"]:checked');
      return el ? Number(el.getAttribute("data-price")) : 0;
    }

    // ---- COD availability — the same five conditions the order API enforces ----
    // The two global switches (platform_cod.enabled × store_settings.cod_enabled) already decided
    // server-side whether #cod-option exists in the DOM at all. The other three are per-ORDER, so
    // they are re-evaluated on every change:
    //   · service — the ongkir API stamps each rate with the EFFECTIVE cod flag → data-cod on the radio
    //   · amount  — subtotal + ongkir must be ≤ COD_MAX (platform_cod.max_amount_idr; 0 = no cap)
    //   · region  — the province (derived from the kecamatan) must be on COD_PROVINCES (empty = anywhere)
    // Any of them failing → the row is hidden AND the radio disabled (a disabled-but-visible row is
    // the same lie in a nicer font). /api/public/order re-checks all of it regardless — this is UX.
    var codOption = document.getElementById("cod-option");
    var codRadio = codOption ? codOption.querySelector('input[name="payment"]') : null;
    var provinsiEl = form.querySelector('input[name="provinsi"]');

    // Must match normProvince() in apps/admin/lib/cod.ts — the buyer TYPES their province (the
    // datalist only suggests), so "DI Yogyakarta" / "Daerah Istimewa Yogyakarta" / "prov. jawa barat"
    // all have to land on the same key. Duplicated because the storefront (Astro, inline script)
    // cannot import from the admin app; the API's copy is the one that decides.
    function normProvince(s) {
      return String(s || "")
        .toLowerCase()
        .normalize("NFKD")
        .replace(/\b(provinsi|prov\.?|daerah istimewa|daerah khusus ibukota|d\.?k\.?i\.?|d\.?i\.?y?\.?)\b/g, " ")
        .replace(/[^a-z0-9]+/g, "");
    }

    function codProvinceOk() {
      if (!COD_PROVINCES || !COD_PROVINCES.length) return true; // no allow-list = anywhere
      var p = normProvince(provinsiEl ? provinsiEl.value : "");
      if (!p) return false;
      return COD_PROVINCES.some(function (x) { return normProvince(x) === p; });
    }

    function syncCod() {
      if (!codOption || !codRadio) return;
      var shipEl = form.querySelector('input[name="shipping"]:checked');
      var total = subtotal + selectedShipping();
      var allowed =
        !!COD_ENABLED &&
        !!shipEl &&
        shipEl.getAttribute("data-cod") === "1" &&
        (!COD_MAX || total <= COD_MAX) &&
        codProvinceOk();
      if (allowed) {
        codOption.hidden = false;
        codRadio.disabled = false;
        return;
      }
      if (codRadio.checked) {
        codRadio.checked = false;
        var first = form.querySelector('input[name="payment"]:not([disabled])');
        if (first) first.checked = true;
      }
      codRadio.disabled = true;
      codOption.hidden = true;
    }

    function recompute() {
      var ship = selectedShipping();
      document.getElementById("summary-shipping").textContent = idr.format(ship);
      document.getElementById("summary-total").textContent = idr.format(subtotal + ship);
      syncCod();
    }

    // NOTE: the province is no longer typed (it is a hidden, derived field), so there is nothing to
    // listen to — applyArea()/clearArea() call syncCod() at the only moments it can change.

    function bindShipping() {
      form.querySelectorAll('input[name="shipping"]').forEach(function (el) {
        el.addEventListener("change", recompute);
      });
      recompute();
    }
    bindShipping();

    // ---- Live KiriminAja ongkir (via platform proxy on the admin) ----
    // ONGKIR_API + ORIGIN_CITY injected via define:vars (env-driven, per-store origin)
    var destSearch = document.getElementById("dest-search");
    var destResults = document.getElementById("dest-results");
    var destId = document.getElementById("dest-id");
    var destText = document.getElementById("dest-text");
    var shipHint = document.getElementById("ship-hint");
    var expressGroup = document.getElementById("ship-express-group");
    var expressBox = document.getElementById("ship-express");
    var defaultNote = document.getElementById("ship-default-note");
    var moreBox = document.getElementById("ship-more");
    var moreBtn = document.getElementById("ship-more-btn");
    var moreLabel = document.getElementById("ship-more-label");
    var moreCaret = document.getElementById("ship-more-caret");

    // Reveal, do not re-fetch: every service is already in the DOM (one `op=rates` call prices them
    // all). Clicking this is instant.
    if (moreBtn) {
      moreBtn.addEventListener("click", function () {
        var open = moreBox.hidden;
        moreBox.hidden = !open;
        moreBtn.setAttribute("aria-expanded", open ? "true" : "false");
        if (moreCaret) moreCaret.classList.toggle("rotate-180", open);
        if (moreLabel) {
          var n = moreBox.querySelectorAll('input[name="shipping"]').length;
          moreLabel.textContent = open ? "Tutup pilihan lain" : "Pilih ekspedisi lain (" + n + ")";
        }
      });
    }

    function api(payload) {
      return fetch(ONGKIR_API, {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      }).then(function (r) { return r.json(); });
    }

    var searchTimer;
    // Kota + Provinsi are DERIVED from the chosen kecamatan — the shopper never types them. They are
    // readonly in the markup, so this is the only writer.
    var kotaEl = form.querySelector('input[name="kota"]');
    var kodeposEl = document.getElementById("kodepos");
    var kodeposWrap = document.getElementById("kodepos-wrap");
    var kelWrap = document.getElementById("kel-wrap");
    var kelNote = document.getElementById("kel-note");
    var kelSelect = document.getElementById("kel-select");
    var areaLine = document.getElementById("area-derived");
    var areaText = document.getElementById("area-derived-text");

    // The derived line IS the display of the hidden kota/provinsi inputs — it renders from them, so
    // it can never say something different from what is submitted.
    function showArea() {
      if (!areaLine || !areaText) return;
      var parts = [kotaEl && kotaEl.value, provinsiEl && provinsiEl.value].filter(Boolean);
      if (!parts.length) { areaLine.hidden = true; areaText.textContent = ""; return; }
      areaText.textContent = parts.join(" · ");
      areaLine.hidden = false;
    }

    function applyArea(city, province) {
      if (kotaEl && city) kotaEl.value = city;
      if (provinsiEl && province) provinsiEl.value = province;
      showArea();
      // COD eligibility is province-gated — recheck it now that the province actually exists.
      syncCod();
      captureSoon();
    }
    function clearArea() {
      if (kotaEl) kotaEl.value = "";
      if (provinsiEl) provinsiEl.value = "";
      showArea();
      resetKelurahan();
      syncCod();
    }

    // ---- Kelurahan → kodepos -------------------------------------------------------------------
    // A kodepos belongs to a kelurahan, not to a kecamatan, so it cannot be filled from the district
    // the shopper picked for ongkir. Ask for the kelurahan and take the kodepos from it.
    function setKodeposManual(manual) {
      if (!kodeposEl) return;
      kodeposEl.readOnly = !manual;
      kodeposEl.classList.toggle("cursor-not-allowed", !manual);
      kodeposEl.classList.toggle("bg-brand-50/60", !manual);
      kodeposEl.classList.toggle("text-muted", !manual);
    }

    function resetKelurahan() {
      if (kelWrap) kelWrap.hidden = true;
      if (kelNote) kelNote.hidden = true;
      if (kelSelect) kelSelect.innerHTML = '<option value="">Pilih kelurahan…</option>';
      if (kodeposEl) kodeposEl.value = "";
      // No kelurahan next to it → Kode Pos takes the whole row instead of sitting in a half-width
      // column with a hole beside it.
      if (kodeposWrap) kodeposWrap.classList.add("sm:col-span-2");
      // Back to a plain typed field until a district tells us otherwise.
      setKodeposManual(true);
    }

    // ── THE KODEPOS FILLS ITSELF WHENEVER IT HONESTLY CAN ────────────────────────────────────────
    // Measured on the real table (78.764 kelurahan across 6.735 of KiriminAja's 7.030 districts):
    //   · 5.520 districts (82,0%) have exactly ONE postcode across every kelurahan in them. For those
    //     the kelurahan choice cannot change the answer — so the kodepos is filled the moment the
    //     district is picked, and the kelurahan row is not shown at all. Zero extra interaction.
    //   · 1.215 districts (18,0%) genuinely span several postcodes (the dense urban ones — Semarang
    //     Tengah has 11). There the kelurahan IS the question, so it is asked, and the kodepos fills
    //     on that pick.
    //   ·   295 districts (4,2% of all) have no kelurahan data → the kodepos stays typed by hand.
    // Never guessed: a postcode is only auto-filled when every candidate agrees on it.
    function loadKelurahan(districtId) {
      if (!kelWrap || !kelSelect || !districtId) return;
      api({ op: "kelurahan", destinationId: Number(districtId) }).catch(function () {
        // Lookup unreachable → fall back to a typed kodepos rather than leaving the field readonly and
        // empty, which would make the form unsubmittable with no way for the shopper to fix it.
        return { ok: true, kelurahan: [] };
      }).then(function (res) {
        var list = (res && res.ok && res.kelurahan) || [];
        if (!list.length) {
          // No kelurahan data for this district. Degrade to a typed kodepos rather than inventing
          // one — this number gets printed on a real parcel.
          resetKelurahan();
          return;
        }

        var codes = [];
        list.forEach(function (k) { if (k.postcode && codes.indexOf(k.postcode) < 0) codes.push(k.postcode); });

        if (codes.length === 1) {
          // One postcode for the whole district → answer it for them.
          resetKelurahan();                       // hides the kelurahan row, kodepos full width
          if (kodeposEl) kodeposEl.value = codes[0];
          setKodeposManual(false);                // derived, not typed
          if (kelNote) kelNote.hidden = true;
          captureSoon();
          return;
        }

        kelSelect.innerHTML =
          '<option value="">Pilih kelurahan…</option>' +
          list
            .map(function (k) {
              return '<option value="' + esc(k.postcode) + '">' + esc(k.name) + " — " + esc(k.postcode) + "</option>";
            })
            .join("");
        kelWrap.hidden = false;
        // Kelurahan is back → the two share the row (Kelurahan | Kode Pos).
        if (kodeposWrap) kodeposWrap.classList.remove("sm:col-span-2");
        if (kelNote) kelNote.hidden = false;
        // The kodepos now comes from the picker, so stop it being typed — and leave it EMPTY until a
        // kelurahan is actually chosen. Pre-filling the first one would silently ship a wrong code.
        if (kodeposEl) kodeposEl.value = "";
        setKodeposManual(false);
      });
    }

    if (kelSelect) {
      kelSelect.addEventListener("change", function () {
        if (kodeposEl) kodeposEl.value = kelSelect.value;
        captureSoon();
      });
    }

    if (destSearch) {
      destSearch.addEventListener("input", function () {
        // Editing the search box invalidates the selection — so the derived city/province must go
        // too, or the form would keep showing an address the district id no longer matches.
        destId.value = "";
        clearArea();
        clearTimeout(searchTimer);
        var q = destSearch.value.trim();
        if (q.length < 3) { destResults.classList.add("hidden"); return; }
        searchTimer = setTimeout(function () {
          // A .catch() is not optional here. Without one, a hiccup in the ongkir proxy made this an
          // UNHANDLED REJECTION and the shopper saw NOTHING: no dropdown, no spinner, no error — they
          // typed a kecamatan, nothing happened, and "Bayar Sekarang" then silently did nothing either.
          // A dead checkout with no explanation. The rates call at the bottom of this file already
          // degrades properly; these two just never followed it.
          api({ op: "search", q: q }).then(function (res) {
            if (!res.ok || !res.results.length) { destResults.classList.add("hidden"); return; }
            destResults.innerHTML = res.results.slice(0, 8).map(function (a) {
              // data-city / data-province ride along so picking a result can fill the form without a
              // second round-trip. They may be absent (the live-API fallback can't always be parsed),
              // in which case applyArea() leaves those inputs alone rather than blanking them.
              return '<button type="button" data-id="' + a.id + '" data-text="' + esc(a.text) + '" data-city="' + esc(a.city || "") + '" data-province="' + esc(a.province || "") + '" class="block w-full border-b border-line px-4 py-2 text-left text-sm last:border-0 hover:bg-brand-50">' + esc(a.text) + "</button>";
            }).join("");
            destResults.classList.remove("hidden");
          }).catch(function () {
            destResults.innerHTML = '<p class="px-4 py-3 text-sm text-muted">Gagal mencari kecamatan. Periksa koneksi lalu coba lagi.</p>';
            destResults.classList.remove("hidden");
          });
        }, 300);
      });
      destResults.addEventListener("click", function (e) {
        var btn = e.target.closest("button[data-id]");
        if (!btn) return;
        destId.value = btn.getAttribute("data-id");
        destText.value = btn.getAttribute("data-text");
        destSearch.value = btn.getAttribute("data-text");
        destResults.classList.add("hidden");
        applyArea(btn.getAttribute("data-city"), btn.getAttribute("data-province"));
        loadKelurahan(destId.value);
        loadRates();
      });
    }

    function loadRates() {
      if (!destId.value) return;
      if (shipHint) shipHint.classList.add("hidden");
      expressGroup.classList.remove("hidden");
      expressBox.innerHTML = '<p class="px-4 py-3 text-sm text-muted">Menghitung ongkir…</p>';
      // The cart lines go to the server and the SERVER weighs them (Σ product_variants.weight_grams).
      // This used to post `weight: totalQty * 500` — a fabricated 500 g per item that quoted a 670 g
      // apparel cart as 1.500 g, i.e. 3x the true postage. A weight is a price input: the client does
      // not get to state it.
      var rateItems = cart.map(function (l) { return { handle: l.handle, variant: l.variant, qty: l.qty }; });
      api({ op: "rates", storeSlug: STORE_SLUG, destinationId: Number(destId.value), items: rateItems, itemValue: subtotal }).then(function (res) {
        if (!res.ok || !res.rates.length) {
          expressBox.innerHTML = '<p class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">' + esc(res.error || "Tidak ada layanan untuk rute ini.") + "</p>";
          recompute();
          return;
        }
        // SORT BY PRICE. The API returns whatever order KiriminAja felt like, and the old code both
        // rendered that order AND auto-checked `i === 0` — so a shopper's DEFAULT ongkir was
        // "whichever service happened to come back first", which on this route was Rp26.000 sitting
        // above a Rp9.000 one.
        var rates = res.rates.slice().sort(function (a, b) { return a.cost - b.cost; });

        // "Tercepat" = the smallest number in the ETD string ("1-2" → 1, "2-4" → 2). Ties go to the
        // cheaper one, which is already first after the sort. Both badges are computed across ALL
        // rates, not just the visible one — a "Termurah" badge that only ranks what you can see is a
        // lie the moment the list expands.
        var etdMin = function (e) { var m = String(e || "").match(/\d+/); return m ? Number(m[0]) : 99; };
        var cheapest = rates[0];
        var fastest = rates.reduce(function (best, s) { return etdMin(s.etd) < etdMin(best.etd) ? s : best; }, rates[0]);

        // ── THE DEFAULT IS SPX REGULER ─────────────────────────────────────────────────────────────
        // Not "whatever is cheapest": the merchant's own default courier is a product decision, so it
        // is named (spx / service_type "1" — "SPX Standard"). If the route does not offer it, or the
        // seller switched it off, we fall back to the cheapest AND SAY SO — a different courier
        // silently sitting in the default slot is exactly the substitution the shopper would not
        // notice until the parcel arrives with someone else's label.
        var preferred = rates.filter(function (s) { return s.code === "spx" && s.type === "1"; })[0];
        var def = preferred || cheapest;

        function row(s, checked) {
          // s.cod is the EFFECTIVE flag from the API (KiriminAja capability × platform per-service
          // allowance × this store's cod_enabled) — never the raw courier capability. The regrouping
          // does not touch it: syncCod() still reads data-cod off whichever radio is checked.
          var tags = "";
          if (s === cheapest) tags += ' <span class="ml-1 rounded bg-brand-100 px-1.5 py-px text-[10px] font-semibold text-brand-700">Termurah</span>';
          if (s === fastest) tags += ' <span class="ml-1 rounded bg-sky-100 px-1.5 py-px text-[10px] font-semibold text-sky-700">Tercepat</span>';
          if (s.cod) tags += ' <span class="ml-1 rounded bg-emerald-100 px-1.5 py-px text-[10px] font-semibold text-emerald-700">COD</span>';
          return '<label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition-colors hover:border-brand-400 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">' +
            '<input type="radio" name="shipping" value="' + esc(s.code + "-" + s.type) + '" data-price="' + s.cost + '" data-label="' + esc(s.name) + '" data-cod="' + (s.cod ? "1" : "0") + '" data-svc-code="' + esc(s.code) + '" data-svc-type="' + esc(s.type) + '"' + (checked ? " checked" : "") + ' required class="h-4 w-4 shrink-0 accent-brand-600" />' +
            '<span class="min-w-0 flex-1"><span class="block text-sm font-medium text-ink">' + esc(s.name) + tags + '</span><span class="block text-xs text-muted">Estimasi ' + esc(s.etd) + ' hari</span></span>' +
            '<span class="shrink-0 text-sm font-semibold text-ink tabular-nums">' + idr.format(s.cost) + "</span></label>";
        }

        // The default row is the ONLY thing rendered up front.
        expressBox.innerHTML = row(def, true);

        if (defaultNote) {
          if (preferred) {
            defaultNote.hidden = true;
          } else {
            defaultNote.textContent = "SPX Reguler tidak tersedia untuk rute ini — kami pilihkan ongkir termurah.";
            defaultNote.hidden = false;
          }
        }

        // ── THE REST, GROUPED BY KIRIMINAJA'S OWN `group` ─────────────────────────────────────────
        // GROUPS is exhaustive over what the API returns (regular / economy / next_day / one_day /
        // cargo), and anything unrecognised lands in "Lainnya" rather than being dropped: a service
        // KiriminAja prices but the checkout hides is a service the shopper cannot buy.
        var GROUPS = [
          { label: "1 Hari", keys: ["next_day", "one_day"] },
          { label: "Reguler", keys: ["regular"] },
          { label: "Ekonomi", keys: ["economy"] },
          { label: "Kargo", keys: ["cargo"] },
        ];
        var others = rates.filter(function (s) { return s !== def; });
        var taken = [];
        var html = "";
        GROUPS.forEach(function (g) {
          var list = others.filter(function (s) { return g.keys.indexOf(String(s.group || "")) >= 0; });
          list.forEach(function (s) { taken.push(s); });
          if (!list.length) return; // an empty group is not rendered — no headers over nothing
          html += '<div><p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">' + esc(g.label) + '</p><div class="space-y-2">' +
            list.map(function (s) { return row(s, false); }).join("") + "</div></div>";
        });
        var rest = others.filter(function (s) { return taken.indexOf(s) < 0; });
        if (rest.length) {
          html += '<div><p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">Lainnya</p><div class="space-y-2">' +
            rest.map(function (s) { return row(s, false); }).join("") + "</div></div>";
        }

        moreBox.innerHTML = html;
        moreBox.hidden = true;
        if (moreBtn) {
          moreBtn.hidden = others.length === 0; // one service on the route → nothing to reveal
          moreBtn.setAttribute("aria-expanded", "false");
          if (moreLabel) moreLabel.textContent = "Pilih ekspedisi lain (" + others.length + ")";
          if (moreCaret) moreCaret.classList.remove("rotate-180");
        }
        bindShipping();
      }).catch(function () {
        expressBox.innerHTML = '<p class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">Gagal memuat ongkir. Coba lagi.</p>';
      });
    }

    // ---- Recovered destination → re-quote ongkir straight away ----
    // The district id is restored (it is what the ongkir/COD checks are actually booked against), but
    // the RATE is not: prices move. Re-fetching is the honest option.
    if (RECOVER && RECOVER.destId) {
      destId.value = String(RECOVER.destId);
      if (destSearch && !destSearch.value) destSearch.value = RECOVER.city || "";
      // kota/provinsi were restored into the hidden inputs above → render the derived line for them,
      // otherwise a returning shopper sees a district with no city/province under it.
      showArea();
      // Restore the kelurahan picker as well, then put the saved kodepos back — loadKelurahan()
      // deliberately blanks it, and a recovered checkout must not lose what the shopper had chosen.
      var savedPostcode = RECOVER.postcode || "";
      loadKelurahan(RECOVER.destId);
      setTimeout(function () {
        if (kodeposEl && savedPostcode) {
          kodeposEl.value = savedPostcode;
          if (kelSelect) kelSelect.value = savedPostcode;
        }
      }, 600);
      loadRates();
    }

    // ═══ PROGRESSIVE CAPTURE (checkout_sessions) ══════════════════════════════════════════════
    // There is no "abandon" event to hook — abandonment is the ABSENCE of an order. So the row is
    // written AS THEY TYPE and judged later by what never happened to it. Debounced (~1.2s of quiet,
    // NOT per keystroke), plus an immediate flush on blur / radio change / leaving the page.
    //
    // Everything below is fire-and-forget and wrapped: a capture failure must never break a checkout.
    var CAPTURE_API = "/api/checkout-session"; // same-origin → the store comes from the Host header
    var STEPS = ["keranjang", "kontak", "alamat", "pengiriman", "pembayaran"];
    var furthest = 0; // monotonic: the furthest step REACHED, never the current one
    var paymentTouched = !!(RECOVER && RECOVER.destId); // a returning shopper is already deep in
    var settled = false; // set once the order exists → stop writing to a row that is now `pulih`

    function currentStep() {
      var v = function (n) { var el = form.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ""; };
      var i = 0;
      if (v("email") || v("nama") || v("whatsapp")) i = 1; // kontak
      if (v("alamat") && v("kota") && v("provinsi")) i = 2; // alamat
      if (form.querySelector('input[name="shipping"]:checked')) i = 3; // pengiriman
      if (paymentTouched) i = 4; // pembayaran
      if (i > furthest) furthest = i;
      return STEPS[furthest];
    }

    function capturePayload() {
      var v = function (n) { var el = form.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ""; };
      return {
        sessionId: SESSION_ID, // NO store id — the server takes that from the Host header
        name: v("nama"),
        phone: v("whatsapp"), // the WhatsApp number: in Indonesia this IS the recovery channel
        email: v("email"),
        address: v("alamat"),
        city: v("kota"),
        province: v("provinsi"),
        postcode: v("kodepos"),
        districtId: destId && destId.value ? Number(destId.value) : null,
        items: cart.map(function (i) {
          return { handle: i.handle, name: i.name, variant: i.variant || i.size || "", qty: i.qty, price: i.price };
        }),
        subtotal: subtotal,
        shipping: selectedShipping(),
        step: currentStep(),
      };
    }

    var lastSent = "";
    function capture(force) {
      if (settled || !SESSION_ID) return;
      try {
        var payload = capturePayload();
        var body = JSON.stringify(payload);
        if (!force && body === lastSent) return; // nothing actually changed
        lastSent = body;
        if (force && navigator.sendBeacon) {
          // survives the unload that "Bayar Sekarang" / closing the tab causes
          if (navigator.sendBeacon(CAPTURE_API, new Blob([body], { type: "application/json" }))) return;
        }
        fetch(CAPTURE_API, { method: "POST", headers: { "Content-Type": "application/json" }, body: body, keepalive: true }).catch(function () {});
      } catch (e) {}
    }

    var captureTimer;
    function captureSoon() {
      clearTimeout(captureTimer);
      captureTimer = setTimeout(function () { capture(false); }, 1200); // ~1.2s of quiet, not per keystroke
    }
    function captureNow() {
      clearTimeout(captureTimer);
      capture(false);
    }

    // ---- Field-level feedback: show the problem where the problem is ----
    // On blur, not on keystroke: telling someone their email is invalid while they are still typing
    // the "@" is nagging, not help. The WhatsApp number is also REWRITTEN to what we will actually
    // store (`0812…` → `62812…`) so the shopper can see the number we will message them on — no
    // silent transformation between the field and the database.
    var VALIDATED = ["nama", "whatsapp", "email", "alamat", "kodepos"];
    function checkField(el) {
      if (!el || VALIDATED.indexOf(el.name) < 0) return "";
      var msg = fieldError(el.name, el.value);
      el.setCustomValidity(msg);
      return msg;
    }
    VALIDATED.forEach(function (n) {
      var el = form.querySelector('[name="' + n + '"]');
      if (!el) return;
      el.addEventListener("blur", function () {
        if (el.name === "whatsapp") {
          var canon = normalizePhone(el.value);
          if (canon) el.value = canon;
        }
        var msg = checkField(el); // always recorded → submit still refuses an empty required field
        // …but only SHOWN when they actually typed something. Popping "Nama wajib diisi" the instant
        // someone tabs past an empty field is nagging, and reportValidity() drags the focus back —
        // a shopper who meant to fill it in last gets trapped in it. Empty is not yet a mistake.
        if (msg && el.value.trim()) el.reportValidity();
      });
      // Typing again clears the stale message — otherwise the browser keeps refusing a field the
      // shopper has already fixed.
      el.addEventListener("input", function () { el.setCustomValidity(""); });
    });

    form.addEventListener("input", captureSoon);
    form.addEventListener("change", function (e) {
      var t = e.target;
      if (t && t.name === "payment") paymentTouched = true;
      captureNow(); // a radio/step change is a decision, not a keystroke → flush immediately
    });
    form.addEventListener("blur", captureNow, true); // leaving a field = they finished typing it
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") capture(true); // tab hidden = maybe gone for good
    });
    window.addEventListener("pagehide", function () { capture(true); });

    // The cart itself is already worth a row (an anonymous cart is still a cart), so write one on
    // arrival — a shopper who opens checkout and vanishes without typing anything still counts.
    capture(false);

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var err = document.getElementById("form-error");

      // Our own rules run BEFORE checkValidity(), so the message the browser shows is ours (nama /
      // whatsapp / email / alamat / kodepos). The API re-checks all of them anyway — this is only
      // here so the shopper is not told "something is wrong" by a server round-trip.
      for (var vi = 0; vi < VALIDATED.length; vi++) {
        var vel = form.querySelector('[name="' + VALIDATED[vi] + '"]');
        if (vel && checkField(vel)) { vel.reportValidity(); vel.focus(); return; }
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // Kota/Provinsi are readonly, and a readonly input is BARRED from constraint validation — so
      // `required` on them never fired and checkValidity() would happily pass with no destination at
      // all. The real rule is "a kecamatan was chosen"; enforce it here, where it runs.
      if (!destId.value) {
        if (destSearch) {
          destSearch.setCustomValidity("Pilih kecamatan tujuan dari daftar.");
          destSearch.reportValidity();
          destSearch.setCustomValidity("");
          destSearch.focus();
        }
        return;
      }
      if (err) err.classList.add("hidden");

      var fd = new FormData(form);
      var shipEl = form.querySelector('input[name="shipping"]:checked');
      var payEl = form.querySelector('input[name="payment"]:checked');
      var ship = shipEl ? Number(shipEl.getAttribute("data-price")) : 0;
      if (!payEl) {
        if (err) { err.textContent = "Pilih metode pembayaran."; err.classList.remove("hidden"); }
        return;
      }

      var order = {
        createdAt: new Date().toISOString(),
        contact: { email: fd.get("email") },
        shippingAddress: {
          nama: fd.get("nama"),
          whatsapp: fd.get("whatsapp"),
          alamat: fd.get("alamat"),
          kota: fd.get("kota"),
          provinsi: fd.get("provinsi"),
          kodepos: fd.get("kodepos"),
        },
        shipping: {
          id: shipEl ? shipEl.value : "",
          label: shipEl ? shipEl.getAttribute("data-label") : "",
          price: ship,
        },
        payment: {
          id: payEl ? payEl.value : "",
          label: payEl ? payEl.getAttribute("data-label") : "",
        },
        items: cart,
        subtotal: subtotal,
        total: subtotal + ship,
      };

      function finish() {
        try { localStorage.setItem("lastOrder", JSON.stringify(order)); } catch (e2) {}
        window.location.href = "/checkout/sukses";
      }
      function fail(msg) {
        if (err) { err.textContent = msg; err.classList.remove("hidden"); }
        if (btn) { btn.disabled = false; btn.textContent = "Bayar Sekarang"; }
      }

      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = "Memproses pesanan…"; }

      // Last capture BEFORE the order: the row must exist (with everything typed, at step
      // "pembayaran") for the order API to find and flip to `pulih`. If the payment then fails, this
      // is exactly the session worth chasing — a shopper who got all the way to the pay button.
      paymentTouched = true;
      captureNow();

      fetch(ORDER_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          storeSlug: STORE_SLUG,
          // The checkout session this order came from → /api/public/order marks it `pulih` with
          // recovered_order_id. "Recovered" = THIS session became THAT order; anything else is a guess.
          sessionId: SESSION_ID,
          items: cart.map(function (i) { return { handle: i.handle, name: i.name, price: i.price, variant: i.variant || i.size || "", qty: i.qty }; }),
          // The phone goes up CANONICAL (62…) — the API normalises it again regardless; sending the
          // shape we store means the two can never quietly disagree.
          customer: { name: order.shippingAddress.nama, phone: normalizePhone(order.shippingAddress.whatsapp) || order.shippingAddress.whatsapp, email: order.contact.email },
          // kota/provinsi ride along for the abandoned-cart snapshot only — the API DERIVES both from
          // destId (kiriminaja_areas) and ignores what is sent here. A typed province is a claim.
          address: { alamat: order.shippingAddress.alamat, kota: order.shippingAddress.kota, provinsi: order.shippingAddress.provinsi, kodepos: order.shippingAddress.kodepos },
          // service/serviceType identify WHICH service the shopper picked (a label cannot). There is
          // deliberately NO `cost` here any more: the order API RE-QUOTES the ongkir server-side and
          // writes its own number. A price posted by the browser is a price the browser gets to
          // choose — `cost: 0` bought free shipping and the merchant paid the courier the difference.
          shipping: {
            label: order.shipping.label,
            service: shipEl ? shipEl.getAttribute("data-svc-code") || undefined : undefined,
            serviceType: shipEl ? shipEl.getAttribute("data-svc-type") || undefined : undefined,
            // The KiriminAja district this quote was issued for. The order API resolves the province
            // from THIS, not from the province the buyer typed — that field is a claim (a client can
            // put "DKI Jakarta" and ship to Papua, walking through allowed_provinces). The district
            // is what the parcel is actually booked against, so it cannot lie about the destination.
            destId: (function () {
              var d = document.getElementById("dest-id");
              return d && d.value ? Number(d.value) : undefined;
            })(),
          },
          channelCode: payEl.value,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.ok) {
            fail(res.error || "Gagal memproses pesanan.");
            // The API tells us WHICH field it refused — put the cursor there instead of making the
            // shopper hunt for it.
            var fel = res.field ? form.querySelector('[name="' + res.field + '"]') : null;
            if (fel && fel.focus) fel.focus();
            return;
          }
          settled = true; // the session is now `pulih` — the pagehide beacon must not touch it again
          order.number = res.orderNumber;
          // The ongkir + total the SERVER priced (it re-quotes; it does not take ours). The success
          // page must show what the order actually says, not what this tab last calculated.
          if (typeof res.shipping === "number") order.shipping.price = res.shipping;
          if (typeof res.total === "number") order.total = res.total;
          if (res.payment) order.payment.instruction = res.payment;
          finish();
        })
        .catch(function () { fail("Gagal terhubung ke server."); });
    });
  })();
</script>
