---
import Layout from "../layouts/Layout.astro";
import { STORE } from "../data/catalog";

// Platform shipping proxy (admin) + this store's origin city — env-driven for per-client prod.
const ONGKIR_API = import.meta.env.PUBLIC_ONGKIR_API || "http://localhost:3000/api/public/ongkir";
const ORDER_API = import.meta.env.PUBLIC_ORDER_API || "http://localhost:3000/api/public/order";
const ORIGIN_CITY = STORE.city || "Yogyakarta";
const STORE_SLUG = STORE.slug || "batik-nusantara";

const PROVINCES = [
  "DKI Jakarta",
  "Jawa Barat",
  "Jawa Tengah",
  "DI Yogyakarta",
  "Jawa Timur",
  "Banten",
  "Bali",
  "Sumatera Utara",
  "Sumatera Barat",
  "Sulawesi Selatan",
  "Kalimantan Timur",
];

// Payment channels (platform-managed PSP; brand hidden — generic bank/method labels only).
// Must mirror the ACTIVE channels in @tokophi/lib PAYMENT_CHANNELS (verified live rc=00).
// BSI + DANA are NOT active on the platform account → excluded so checkout never fails.
const PAYMENTS = [
  { id: "QRIS", label: "QRIS", desc: "Scan dari semua e-wallet & m-banking" },
  { id: "VABCA", label: "Virtual Account BCA", desc: "Bayar via ATM / m-banking BCA" },
  { id: "VAMANDIRI", label: "Virtual Account Mandiri", desc: "Bayar via ATM / Livin'" },
  { id: "VABNI", label: "Virtual Account BNI", desc: "Bayar via ATM / m-banking BNI" },
  { id: "VABRI", label: "Virtual Account BRI", desc: "Bayar via ATM / BRImo" },
  { id: "VAPERMATA", label: "Virtual Account Permata", desc: "Bayar via ATM / PermataMobile" },
  { id: "cod", label: "COD (Bayar di Tempat)", desc: "Bayar tunai saat paket tiba" },
];
---

<Layout title="Checkout" description={`Selesaikan pesananmu di ${STORE.name}.`}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav class="text-sm text-muted">
      <a href="/keranjang" class="hover:text-brand-600">Keranjang</a>
      <span class="mx-1">/</span>
      <span class="text-ink">Checkout</span>
    </nav>
    <h1 class="mt-3 font-display text-3xl font-semibold text-ink">Checkout</h1>

    <div id="checkout-empty" class="mt-10 hidden rounded-2xl border border-dashed border-line bg-white py-20 text-center">
      <p class="text-4xl">🛒</p>
      <h2 class="mt-4 font-display text-2xl font-semibold text-ink">Keranjangmu masih kosong</h2>
      <p class="mt-2 text-muted">Tambahkan produk dulu sebelum checkout.</p>
      <a href="/" class="mt-6 inline-block rounded-full bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700">Mulai Belanja</a>
    </div>

    <form id="checkout-form" class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <!-- LEFT: form -->
      <div class="space-y-8">
        <!-- Kontak -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Kontak</legend>
          <label class="block">
            <span class="text-sm font-medium text-ink">Email</span>
            <input
              type="email"
              name="email"
              required
              placeholder="nama@email.com"
              class="mt-1.5 w-full rounded-lg border border-line bg-cream px-3.5 py-2.5 text-sm text-ink outline-none transition-colors focus:border-brand-400 focus:bg-white"
            />
          </label>
        </fieldset>

        <!-- Alamat pengiriman -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Alamat Pengiriman</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-medium text-ink">Nama Lengkap</span>
              <input type="text" name="nama" required autocomplete="name" class="input-field" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">No. WhatsApp</span>
              <input type="tel" name="whatsapp" required inputmode="tel" placeholder="08xxxxxxxxxx" autocomplete="tel" class="input-field" />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-ink">Alamat Lengkap</span>
              <textarea name="alamat" required rows="2" placeholder="Nama jalan, no. rumah, RT/RW, patokan" class="input-field resize-none"></textarea>
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">Kota / Kabupaten</span>
              <input type="text" name="kota" required autocomplete="address-level2" class="input-field" />
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">Provinsi</span>
              <input type="text" name="provinsi" required list="provinsi-list" autocomplete="address-level1" class="input-field" />
              <datalist id="provinsi-list">
                {PROVINCES.map((p) => <option value={p} />)}
              </datalist>
            </label>
            <label class="block">
              <span class="text-sm font-medium text-ink">Kode Pos</span>
              <input type="text" name="kodepos" required inputmode="numeric" autocomplete="postal-code" class="input-field" />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-ink">Kecamatan Tujuan <span class="font-normal text-muted">(untuk hitung ongkir)</span></span>
              <input type="text" id="dest-search" autocomplete="off" placeholder="Ketik kecamatan / kota, mis. Semarang" class="input-field" />
              <input type="hidden" name="dest_id" id="dest-id" />
              <input type="hidden" name="dest_text" id="dest-text" />
              <div id="dest-results" class="mt-1 hidden max-h-48 overflow-y-auto rounded-xl border border-line bg-white shadow-sm"></div>
            </label>
          </div>
        </fieldset>

        <!-- Pengiriman -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Pengiriman</legend>
          <p id="ship-hint" class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">
            Pilih <b>kecamatan tujuan</b> di atas untuk melihat ongkir real-time.
          </p>

          <!-- Group: Ekspedisi (reguler / express) -->
          <div id="ship-express-group" class="hidden">
            <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
              <span>📦 Ekspedisi</span><span class="h-px flex-1 bg-line"></span>
            </div>
            <div id="ship-express" class="space-y-2"></div>
          </div>

          <!-- Group: Kirim Instan (same-day) -->
          <div id="ship-instant-group" class="mt-4 hidden">
            <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
              <span>⚡ Kirim Instan (hari ini)</span><span class="h-px flex-1 bg-line"></span>
            </div>
            <div id="ship-instant" class="space-y-2"></div>
          </div>

          <button type="button" id="instant-btn" class="mt-4 inline-flex items-center gap-1.5 rounded-xl border border-brand-600 px-4 py-2 text-sm font-medium text-brand-600 transition-colors hover:bg-brand-50">
            ⚡ Cek kirim instan (pakai lokasiku)
          </button>
          <p id="instant-note" class="mt-1 hidden text-xs text-muted"></p>
        </fieldset>

        <!-- Pembayaran -->
        <fieldset class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <legend class="px-2 font-display text-lg font-semibold text-ink">Pembayaran</legend>
          <div class="space-y-3">
            {
              PAYMENTS.map((p, i) => (
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                  <input
                    type="radio"
                    name="payment"
                    value={p.id}
                    data-label={p.label}
                    checked={i === 0}
                    required
                    class="h-4 w-4 accent-brand-600"
                  />
                  <span class="flex-1">
                    <span class="block text-sm font-medium text-ink">{p.label}</span>
                    <span class="block text-xs text-muted">{p.desc}</span>
                  </span>
                </label>
              ))
            }
          </div>
          <p class="mt-4 text-xs text-muted">Pembayaran diproses aman — disediakan TokoΦ.</p>
        </fieldset>
      </div>

      <!-- RIGHT: order summary -->
      <aside class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <h2 class="font-display text-lg font-semibold text-ink">Ringkasan Pesanan</h2>

          <div id="summary-items" class="mt-4 space-y-4"></div>

          <div class="mt-6 space-y-2 border-t border-line pt-4 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-muted">Subtotal</span>
              <span id="summary-subtotal" class="font-medium text-ink tabular-nums">Rp0</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-muted">Ongkir</span>
              <span id="summary-shipping" class="font-medium text-ink tabular-nums">Rp0</span>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-line pt-4">
            <span class="text-base font-medium text-ink">Total</span>
            <span id="summary-total" class="font-display text-2xl font-semibold text-ink tabular-nums">Rp0</span>
          </div>

          <button
            type="submit"
            id="pay-btn"
            class="mt-6 w-full rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-colors hover:bg-brand-700"
          >
            Bayar Sekarang
          </button>
          <p id="form-error" class="mt-3 hidden text-center text-sm font-medium text-brand-700"></p>
          <a href="/keranjang" class="mt-3 block text-center text-sm text-muted underline hover:text-brand-600">Kembali ke keranjang</a>
        </div>
      </aside>
    </form>
  </section>
</Layout>

<style is:global>
  .input-field {
    margin-top: 0.375rem;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-cream);
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    color: var(--color-ink);
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .input-field:focus {
    border-color: var(--color-brand-400);
    background: #fff;
  }
</style>

<script is:inline define:vars={{ ONGKIR_API, ORDER_API, ORIGIN_CITY, STORE_SLUG }}>
  (function () {
    var idr = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    });

    function readCart() {
      try {
        return JSON.parse(localStorage.getItem("cart") || "[]");
      } catch (e) {
        return [];
      }
    }

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    var cart = readCart();
    var form = document.getElementById("checkout-form");
    var empty = document.getElementById("checkout-empty");

    if (!cart.length) {
      if (form) form.classList.add("hidden");
      if (empty) empty.classList.remove("hidden");
      return;
    }

    var subtotal = 0;
    var itemsHtml = cart
      .map(function (item) {
        var sub = item.price * item.qty;
        subtotal += sub;
        return (
          '<div class="flex items-center gap-3">' +
          '<div class="relative shrink-0">' +
          '<img src="' + esc(item.image) + '" alt="' + esc(item.name) + '" class="h-16 w-14 rounded-lg object-cover bg-brand-50" loading="lazy" />' +
          '<span class="absolute -right-2 -top-2 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-ink px-1 text-xs font-semibold text-cream">' + item.qty + "</span>" +
          "</div>" +
          '<div class="min-w-0 flex-1">' +
          '<p class="truncate text-sm font-medium text-ink">' + esc(item.name) + "</p>" +
          ((item.variant || item.size) ? '<p class="text-xs text-muted">Varian: ' + esc(item.variant || item.size) + "</p>" : "") +
          "</div>" +
          '<span class="text-sm font-medium text-ink tabular-nums">' + idr.format(sub) + "</span>" +
          "</div>"
        );
      })
      .join("");

    document.getElementById("summary-items").innerHTML = itemsHtml;
    document.getElementById("summary-subtotal").textContent = idr.format(subtotal);

    function selectedShipping() {
      var el = form.querySelector('input[name="shipping"]:checked');
      return el ? Number(el.getAttribute("data-price")) : 0;
    }

    function recompute() {
      var ship = selectedShipping();
      document.getElementById("summary-shipping").textContent = idr.format(ship);
      document.getElementById("summary-total").textContent = idr.format(subtotal + ship);
    }

    function bindShipping() {
      form.querySelectorAll('input[name="shipping"]').forEach(function (el) {
        el.addEventListener("change", recompute);
      });
      recompute();
    }
    bindShipping();

    // ---- Live KiriminAja ongkir (via platform proxy on the admin) ----
    // ONGKIR_API + ORIGIN_CITY injected via define:vars (env-driven, per-store origin)
    var totalQty = cart.reduce(function (a, i) { return a + i.qty; }, 0) || 1;
    var destSearch = document.getElementById("dest-search");
    var destResults = document.getElementById("dest-results");
    var destId = document.getElementById("dest-id");
    var destText = document.getElementById("dest-text");
    var shipHint = document.getElementById("ship-hint");
    var expressGroup = document.getElementById("ship-express-group");
    var expressBox = document.getElementById("ship-express");
    var instantGroup = document.getElementById("ship-instant-group");
    var instantBox = document.getElementById("ship-instant");

    function api(payload) {
      return fetch(ONGKIR_API, {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      }).then(function (r) { return r.json(); });
    }

    var searchTimer;
    if (destSearch) {
      destSearch.addEventListener("input", function () {
        destId.value = "";
        clearTimeout(searchTimer);
        var q = destSearch.value.trim();
        if (q.length < 3) { destResults.classList.add("hidden"); return; }
        searchTimer = setTimeout(function () {
          api({ op: "search", q: q }).then(function (res) {
            if (!res.ok || !res.results.length) { destResults.classList.add("hidden"); return; }
            destResults.innerHTML = res.results.slice(0, 8).map(function (a) {
              return '<button type="button" data-id="' + a.id + '" data-text="' + esc(a.text) + '" class="block w-full border-b border-line px-4 py-2 text-left text-sm last:border-0 hover:bg-brand-50">' + esc(a.text) + "</button>";
            }).join("");
            destResults.classList.remove("hidden");
          });
        }, 300);
      });
      destResults.addEventListener("click", function (e) {
        var btn = e.target.closest("button[data-id]");
        if (!btn) return;
        destId.value = btn.getAttribute("data-id");
        destText.value = btn.getAttribute("data-text");
        destSearch.value = btn.getAttribute("data-text");
        destResults.classList.add("hidden");
        loadRates();
      });
    }

    function loadRates() {
      if (!destId.value) return;
      if (shipHint) shipHint.classList.add("hidden");
      expressGroup.classList.remove("hidden");
      expressBox.innerHTML = '<p class="px-4 py-3 text-sm text-muted">Menghitung ongkir…</p>';
      api({ op: "rates", originCity: ORIGIN_CITY, destinationId: Number(destId.value), weight: totalQty * 500, itemValue: subtotal }).then(function (res) {
        if (!res.ok || !res.rates.length) {
          expressBox.innerHTML = '<p class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">' + esc(res.error || "Tidak ada layanan untuk rute ini.") + "</p>";
          recompute();
          return;
        }
        var anyChecked = !!form.querySelector('input[name="shipping"]:checked');
        expressBox.innerHTML = res.rates.map(function (s, i) {
          var cod = s.cod ? ' <span class="ml-1 rounded bg-emerald-100 px-1 text-[10px] font-semibold text-emerald-700">COD</span>' : "";
          return '<label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-4 py-3 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">' +
            '<input type="radio" name="shipping" value="' + esc(s.code + "-" + s.type) + '" data-price="' + s.cost + '" data-label="' + esc(s.name) + '"' + (i === 0 && !anyChecked ? " checked" : "") + ' required class="h-4 w-4 accent-brand-600" />' +
            '<span class="flex-1"><span class="block text-sm font-medium text-ink">' + esc(s.name) + cod + '</span><span class="block text-xs text-muted">Estimasi ' + esc(s.etd) + ' hari</span></span>' +
            '<span class="text-sm font-semibold text-ink tabular-nums">' + idr.format(s.cost) + "</span></label>";
        }).join("");
        bindShipping();
      }).catch(function () {
        expressBox.innerHTML = '<p class="rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">Gagal memuat ongkir. Coba lagi.</p>';
      });
    }

    // ---- Kirim Instan (same-day) — uses the shopper's geolocation ----
    var instantBtn = document.getElementById("instant-btn");
    var instantNote = document.getElementById("instant-note");
    function showInstantNote(msg) { instantNote.textContent = msg; instantNote.classList.remove("hidden"); }
    if (instantBtn) {
      instantBtn.addEventListener("click", function () {
        if (!navigator.geolocation) { showInstantNote("Browser tidak mendukung lokasi."); return; }
        instantBtn.disabled = true; instantBtn.textContent = "⚡ Mengambil lokasi…";
        instantNote.classList.add("hidden");
        navigator.geolocation.getCurrentPosition(function (pos) {
          window.__instantLat = pos.coords.latitude; window.__instantLng = pos.coords.longitude;
          instantBtn.textContent = "⚡ Menghitung ongkir instan…";
          api({ op: "instant", storeSlug: STORE_SLUG, destLat: pos.coords.latitude, destLng: pos.coords.longitude, weight: totalQty * 500, itemValue: subtotal }).then(function (res) {
            instantBtn.disabled = false; instantBtn.textContent = "⚡ Perbarui kirim instan";
            if (!res.ok || !res.instant || !res.instant.length) { showInstantNote(res.error || "Tidak ada layanan instan untuk lokasimu."); return; }
            if (shipHint) shipHint.classList.add("hidden");
            instantGroup.classList.remove("hidden");
            instantBox.innerHTML = res.instant.map(function (s) {
              return '<label class="flex cursor-pointer items-center gap-3 rounded-xl border border-brand-600/40 bg-brand-50/30 px-4 py-3 transition-colors has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">' +
                '<input type="radio" name="shipping" value="instant-' + esc(s.code) + '-' + esc(s.serviceType) + '" data-price="' + s.cost + '" data-label="' + esc(s.name) + '" data-inst-service="' + esc(s.code) + '" data-inst-type="' + esc(s.serviceType) + '" data-inst-cost="' + s.shippingCosts + '" required class="h-4 w-4 accent-brand-600" />' +
                '<span class="flex-1"><span class="block text-sm font-medium text-ink">⚡ ' + esc(s.name) + '</span><span class="block text-xs text-muted">' + esc(s.etd) + (res.distanceKm ? " · " + res.distanceKm + " km" : "") + '</span></span>' +
                '<span class="text-sm font-semibold text-ink tabular-nums">' + idr.format(s.cost) + "</span></label>";
            }).join("");
            bindShipping();
          }).catch(function () { instantBtn.disabled = false; instantBtn.textContent = "⚡ Cek kirim instan (pakai lokasiku)"; showInstantNote("Gagal memuat ongkir instan."); });
        }, function () {
          instantBtn.disabled = false; instantBtn.textContent = "⚡ Cek kirim instan (pakai lokasiku)";
          showInstantNote("Izin lokasi ditolak — kirim instan butuh lokasimu.");
        });
      });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var err = document.getElementById("form-error");

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (err) err.classList.add("hidden");

      var fd = new FormData(form);
      var shipEl = form.querySelector('input[name="shipping"]:checked');
      var payEl = form.querySelector('input[name="payment"]:checked');
      var ship = shipEl ? Number(shipEl.getAttribute("data-price")) : 0;

      var order = {
        createdAt: new Date().toISOString(),
        contact: { email: fd.get("email") },
        shippingAddress: {
          nama: fd.get("nama"),
          whatsapp: fd.get("whatsapp"),
          alamat: fd.get("alamat"),
          kota: fd.get("kota"),
          provinsi: fd.get("provinsi"),
          kodepos: fd.get("kodepos"),
        },
        shipping: {
          id: shipEl ? shipEl.value : "",
          label: shipEl ? shipEl.getAttribute("data-label") : "",
          price: ship,
        },
        payment: {
          id: payEl ? payEl.value : "",
          label: payEl ? payEl.getAttribute("data-label") : "",
        },
        items: cart,
        subtotal: subtotal,
        total: subtotal + ship,
      };

      function finish() {
        try { localStorage.setItem("lastOrder", JSON.stringify(order)); } catch (e2) {}
        window.location.href = "/checkout/sukses";
      }
      function fail(msg) {
        if (err) { err.textContent = msg; err.classList.remove("hidden"); }
        if (btn) { btn.disabled = false; btn.textContent = "Bayar Sekarang"; }
      }

      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = "Memproses pesanan…"; }
      fetch(ORDER_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          storeSlug: STORE_SLUG,
          items: cart.map(function (i) { return { handle: i.handle, name: i.name, price: i.price, variant: i.variant || i.size || "", qty: i.qty }; }),
          customer: { name: order.shippingAddress.nama, phone: order.shippingAddress.whatsapp, email: order.contact.email },
          address: { alamat: order.shippingAddress.alamat, kota: order.shippingAddress.kota, provinsi: order.shippingAddress.provinsi, kodepos: order.shippingAddress.kodepos },
          shipping: { label: order.shipping.label, cost: ship },
          channelCode: payEl ? payEl.value : "cod",
          instant: (shipEl && shipEl.getAttribute("data-inst-service")) ? {
            service: shipEl.getAttribute("data-inst-service"),
            serviceType: shipEl.getAttribute("data-inst-type"),
            shippingCosts: Number(shipEl.getAttribute("data-inst-cost")),
            destLat: window.__instantLat, destLng: window.__instantLng,
          } : undefined,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res.ok) { fail(res.error || "Gagal memproses pesanan."); return; }
          order.number = res.orderNumber;
          if (res.payment) order.payment.instruction = res.payment;
          finish();
        })
        .catch(function () { fail("Gagal terhubung ke server."); });
    });
  })();
</script>
