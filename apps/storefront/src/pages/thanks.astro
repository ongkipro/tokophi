---
// Post-checkout THANK-YOU page for the /promo funnel. The order is ALREADY committed server-side by
// /api/public/order — this page is confirmation UI, so order-specific numbers come from the query
// string (display-only, like the reference funnel's /thanks). Product identity (name, photo,
// description, list price) is looked up from the catalog by the `lp` handle — authoritative and keeps
// the URL short. Standalone layout — no site nav, same as the landing it came from.
import LandingLayout from "../layouts/LandingLayout.astro";
import { Check, MessageCircle, ImageOff } from "@lucide/astro";
import { IDR } from "@tokophi/lib/format";
import { productImages, imageSrcSet } from "../data/catalog";

const { store, catalog } = Astro.locals;
const q = Astro.url.searchParams;
const get = (k: string) => (q.get(k) ?? "").trim();
const num = (k: string) => {
  const n = Number(get(k));
  return Number.isFinite(n) ? n : 0;
};

const order = get("order");
// ⚠️ NAME, PHONE AND ADDRESS ARE NOT IN THE URL, deliberately. They used to be: the funnel redirected
// to `/thanks?name=<full name>&phone=<62…>&address=<street>` — a shopper's identity and home address in
// browser history, in every server access log, and in any link they forward. It also blocked conversion
// tracking on this page outright: Meta prohibits PII in event parameters (and disables pixels for it),
// and `event_source_url` / `page_location` / `page.url` all carry the URL verbatim.
// They now travel in `sessionStorage` (same tab, same origin, never sent anywhere) and are filled in by
// the small script at the foot of this file. Everything below is order data, not personal data.
const variant = get("variant"); // e.g. "Hitam / S"
const qty = Math.max(1, num("qty") || 1);
const subtotal = num("subtotal"); // price × qty (what was actually charged for the goods)
const shipping = num("shipping");
const total = num("total") || subtotal + shipping;
const isCod = (get("pm") || "cod") === "cod";

const product = get("lp") ? catalog.findProduct(get("lp")) : undefined;
const image = product ? productImages(product)[0] : undefined;
// The thumbnail box is `h-20 w-20 shrink-0` = 80 px at every viewport (its 1 px border leaves the
// img 78 — `sizes` errs upward, never down). Task 6.12.
const THUMB_SIZES = "80px";

const perUnit = subtotal / qty;
const listTotal = product?.compareAt && product.compareAt > perUnit ? product.compareAt * qty : subtotal;
const discount = Math.max(0, listTotal - subtotal);

const waText = encodeURIComponent(
  `Halo ${store.name}, saya baru pesan${order ? ` (No. ${order})` : ""}${product ? ` — ${product.name}` : ""}. Mohon dikonfirmasi ya.`,
);
const waHref = store.whatsapp ? `https://wa.me/${store.whatsapp}?text=${waText}` : null;

const STEPS = [
  { title: "Pesanan diterima", note: "Data order berhasil masuk.", state: "done" },
  { title: "Verifikasi admin", note: "Konfirmasi WhatsApp membantu proses lebih cepat.", state: "current" },
  { title: "Packing & pengiriman", note: "Paket dikirim setelah data valid.", state: "todo" },
];
---

<LandingLayout title="Terima kasih — pesanan diterima" robots="noindex,nofollow">
  {/* White sheet on a grey page so its edges read as a distinct card, not merged into the background. */}
  <div class="min-h-screen bg-stone-100">
    <div class="mx-auto min-h-screen max-w-lg border-x border-line bg-white sm:my-8 sm:min-h-0 sm:overflow-hidden sm:rounded-2xl sm:border sm:shadow-sm">
      {/* Top bar — store identity only. It used to carry a green "ADMIN ONLINE" pill, static markup
          on every render: nothing on this platform knows whether a merchant is at their desk, and a
          shopper who messages at 02:00 on the strength of that dot is owed an answer we cannot make
          them give. Same class as the hard-coded opening hours dropped from /kontak (SF-4). A real
          presence signal needs a fact behind it (last seen, business hours the merchant SET). */}
      <header class="flex items-center border-b border-line bg-white px-5 py-4">
      <span class="text-lg font-extrabold uppercase tracking-tight text-ink">{store.name}</span>
    </header>

    <main class="space-y-8 px-5 pb-12">
      {/* Success */}
      <div class="flex flex-col items-center pt-8 text-center">
        <div class="flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500 text-white shadow-md">
            <Check class="h-8 w-8" />
          </div>
        </div>
        <h1 class="mt-5 text-2xl font-bold text-ink">Pesanan berhasil dibuat</h1>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone-600">
          Pesanan sudah kami terima. Konfirmasi ke admin agar proses verifikasi dan pengiriman lebih cepat.
        </p>
      </div>

      {/* Payment highlight band */}
      <div class="rounded-2xl border border-line bg-stone-50 py-6 text-center">
        <div class="text-xs font-semibold uppercase tracking-wide text-stone-400">
          {isCod ? "Bayar saat paket tiba" : "Total pembayaran"}
        </div>
        <div class="mt-1 text-4xl font-extrabold text-ink">{IDR(total)}</div>
        {isCod && (
          <span class="mt-3 inline-block rounded-full bg-amber-100 px-4 py-1.5 text-xs font-bold text-amber-800">
            COD · BAYAR DI TEMPAT
          </span>
        )}
      </div>

      {/* Produk dipesan */}
      {product && (
        <section>
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-bold text-ink">Produk dipesan</h2>
            <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-medium text-stone-500">Qty {qty}</span>
          </div>
          <div class="flex gap-3 rounded-2xl border border-line p-4">
            <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl border border-line bg-stone-50">
              {image ? (
                <img
                  src={image}
                  srcset={imageSrcSet(image)}
                  sizes={imageSrcSet(image) ? THUMB_SIZES : undefined}
                  alt={product.name}
                  class="h-full w-full object-cover"
                  width="80"
                  height="80"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-stone-300"><ImageOff class="h-6 w-6" /></div>
              )}
            </div>
            <div class="min-w-0">
              <div class="font-semibold text-ink">{product.name}</div>
              {variant && <div class="text-sm font-medium text-emerald-600">{variant}</div>}
              {product.description && <p class="mt-0.5 line-clamp-2 text-sm text-stone-500">{product.description}</p>}
            </div>
          </div>
        </section>
      )}

      {/* Ringkasan pembayaran */}
      <section>
        <h2 class="mb-3 font-bold text-ink">Ringkasan pembayaran</h2>
        <div class="overflow-hidden rounded-2xl border border-line">
          <dl class="divide-y divide-line text-sm">
            <div class="flex justify-between px-4 py-3">
              <dt class="text-stone-600">Harga produk</dt>
              <dd class="font-medium text-ink">{IDR(listTotal)}</dd>
            </div>
            {discount > 0 && (
              <div class="flex justify-between px-4 py-3">
                <dt class="text-stone-600">Diskon promo</dt>
                <dd class="font-medium text-rose-600">-{IDR(discount)}</dd>
              </div>
            )}
            <div class="flex justify-between px-4 py-3">
              <dt class="text-stone-600">Ongkos kirim</dt>
              <dd class="font-medium text-ink">{shipping > 0 ? IDR(shipping) : "Gratis"}</dd>
            </div>
            <div class="flex items-center justify-between bg-stone-50 px-4 py-4">
              <div>
                <div class="font-bold text-ink">Total {isCod ? "COD" : ""}</div>
                {isCod && <div class="text-[11px] font-semibold uppercase tracking-wide text-amber-600">Siapkan uang pas saat kurir tiba</div>}
              </div>
              <div class="text-xl font-extrabold text-emerald-600">{IDR(total)}</div>
            </div>
          </dl>
        </div>
      </section>

      {/* Data pengiriman — the three personal rows start hidden and are filled from sessionStorage. */}
      {order && (
        <section>
          <h2 class="mb-3 font-bold text-ink">Data pengiriman</h2>
          <dl class="divide-y divide-line rounded-2xl border border-line text-sm">
            <div class="flex justify-between gap-4 px-4 py-3"><dt class="text-stone-500">No. Pesanan</dt><dd class="text-right font-medium text-ink">#{order}</dd></div>
            <div class="flex justify-between gap-4 px-4 py-3" data-row="name" hidden><dt class="text-stone-500">Nama</dt><dd class="text-right font-medium text-ink" data-val="name"></dd></div>
            <div class="flex justify-between gap-4 px-4 py-3" data-row="phone" hidden><dt class="text-stone-500">WhatsApp</dt><dd class="text-right font-medium text-ink" data-val="phone"></dd></div>
            <div class="flex justify-between gap-4 px-4 py-3" data-row="address" hidden><dt class="shrink-0 text-stone-500">Alamat</dt><dd class="text-right font-medium text-ink" data-val="address"></dd></div>
          </dl>
        </section>
      )}

      {/* Status pesanan */}
      <section>
        <h2 class="mb-3 font-bold text-ink">Status pesanan</h2>
        <ol class="space-y-4 rounded-2xl border border-line p-5">
          {STEPS.map((s) => (
            <li class="flex gap-3">
              <span
                class:list={[
                  "mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2",
                  s.state === "done" && "border-emerald-500 bg-emerald-500",
                  s.state === "current" && "border-emerald-500 bg-white",
                  s.state === "todo" && "border-stone-200 bg-stone-100",
                ]}
              >
                {s.state === "done" && <Check class="h-2.5 w-2.5 text-white" />}
              </span>
              <div>
                <div class:list={["text-sm font-semibold", s.state === "todo" ? "text-stone-400" : "text-ink"]}>{s.title}</div>
                <div class="text-xs text-stone-500">{s.note}</div>
              </div>
            </li>
          ))}
        </ol>
      </section>

      {/* Catatan pembayaran COD */}
      {isCod && (
        <section class="rounded-2xl border border-amber-200 bg-amber-50/70 p-5">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="font-bold text-ink">Catatan pembayaran COD</h2>
            <span class="rounded-full bg-amber-200 px-2.5 py-0.5 text-[11px] font-bold text-amber-800">WAJIB DIBACA</span>
          </div>
          <ul class="space-y-2.5 text-sm text-stone-700">
            <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span><span>Siapkan uang tunai sesuai total tagihan: <strong class="text-ink">{IDR(total)}</strong>.</span></li>
            <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span><span>Pastikan nomor WhatsApp <strong class="text-ink" data-val="phone"></strong> tetap aktif untuk konfirmasi admin atau kurir.</span></li>
            <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span><span>Mohon terima paket saat kurir datang. Jika alamat sulit ditemukan, kurir dapat menghubungi nomor tersebut.</span></li>
          </ul>
        </section>
      )}

      {/* Langkah berikutnya — konfirmasi ke admin */}
      <section class="text-center">
        <div class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Langkah berikutnya</div>
        <h2 class="mt-1 text-xl font-bold text-ink">Konfirmasi ke admin</h2>
        <p class="mx-auto mt-1 max-w-xs text-sm text-stone-600">
          Kirim pesan konfirmasi supaya admin segera validasi order dan menyiapkan pengiriman.
        </p>
        {waHref && (
          <a
            href={waHref}
            class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3.5 font-bold text-white transition hover:bg-emerald-700"
          >
            <MessageCircle class="h-5 w-5" /> Konfirmasi via WhatsApp
          </a>
        )}
      </section>
    </main>
    </div>
  </div>

  {/* Fill the personal rows from sessionStorage — the funnel wrote them there instead of into the URL.
      Keyed by order number, so a stale entry from an earlier order never shows under a new one, and
      cleared straight after reading: this page is the only consumer. Fails silent by design (private
      mode, a forwarded link, a direct visit) — the rows simply stay hidden. */}
  <script is:inline>
    (function () {
      try {
        var order = new URLSearchParams(location.search).get("order") || "";
        var raw = sessionStorage.getItem("tphi:thanks");
        if (!raw) return;
        var d = JSON.parse(raw);
        if (!d || d.order !== order) {
          // Belongs to a DIFFERENT order — drop it, it is stale.
          sessionStorage.removeItem("tphi:thanks");
          return;
        }
        // Kept, not consumed: a reload of this page must still show the shipping confirmation. The
        // URL-param version survived a refresh and the first sessionStorage version did not, which was a
        // regression nobody would have noticed until a shopper pulled to refresh. sessionStorage dies
        // with the tab, so this is not retention — it is the same lifetime the page has.
        ["name", "phone", "address"].forEach(function (k) {
          var v = (d[k] || "").toString().slice(0, 200);
          if (!v) return;
          document.querySelectorAll('[data-val="' + k + '"]').forEach(function (el) { el.textContent = v; });
          var row = document.querySelector('[data-row="' + k + '"]');
          if (row) row.hidden = false;
        });
      } catch (e) {}
    })();
  </script>
</LandingLayout>
