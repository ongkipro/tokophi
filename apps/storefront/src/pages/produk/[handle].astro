---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { Banknote, CalendarDays, Check, ChevronDown, ChevronRight, ImageOff, MessageCircle, RotateCcw, ShoppingBag, Truck, Wallet, X, Zap } from "@lucide/astro";
import Stars from "../../components/Stars.astro";
import ReviewItem from "../../components/ReviewItem.astro";
import SectionRenderer from "../../components/sections/SectionRenderer.astro";
import { IDR, num } from "@tokophi/lib/format";
import { imageSrcSet, inStock, paymentKindWords, productImages, storeCodPolicy, type Product } from "../../data/catalog";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ShareBar from "../../components/ShareBar.astro";
import { catalogSpecs } from "../../lib/product-feed";
import { breadcrumbLd, ldScript, type Crumb } from "../../lib/breadcrumb";
import { itemGroupId, retailerId, type CatalogIdScheme } from "@tokophi/lib/tracking-ids";
import { resolveGalleryAspect } from "@tokophi/lib/theme";

// SSR: tenant from the Host header (src/middleware.ts), product from the handle param.
const { store, catalog } = Astro.locals;
const { handle } = Astro.params;
const product = handle ? catalog.findProduct(handle) : undefined;
if (!product) return new Response(null, { status: 404, statusText: "Not Found" });

// The related row is not "whatever the DB returned first". Rank the category's other products so the
// four shown are the four worth showing: in-stock first (a sold-out recommendation wastes the slot),
// then the best-sellers by real units sold. Fewer than 4 in the category is fine; 0 omits the whole
// section (guarded at render). Selection only; the catalogue itself is untouched.
//
// `inStock` now comes from `data/catalog.ts`. It used to be re-declared here AND again at the buy box
// below — two identical copies, and the product CARD was about to add a third.
const home = catalog.homeCollection(product);
const related = (home ? catalog.byCollection(home.handle) : [])
  .filter((p) => p.handle !== product.handle)
  .sort((a, b) => Number(inStock(b)) - Number(inStock(a)) || b.unitsSold - a.unitsSold)
  .slice(0, 4);

// `price === 0` in this data means "belum diberi harga / tanya penjual", NOT free — so IDR(0) → "Rp0"
// reads as broken on a fashion product. An unpriced product shows "Hubungi untuk harga" and does NOT
// offer the cart: the cart is client-side and adding a Rp0 line would let it be "bought" for nothing
// (only the order API re-prices, and if the variant is unpriced too there is nothing to re-price to).
// It routes to the merchant instead — which is what "Hubungi untuk harga" promises.
// lazy: the real backstop is server-side — /api/public/order should reject a 0-priced line item;
// tracked as a checkout follow-up, out of scope for this display fix.
const unpriced = product.price <= 0;
// Where "Tanya Harga" goes: the store's WhatsApp when set (the channel these shops actually sell on),
// else the /kontak page which always exists. Matches Chat.astro's wa.me shape.
const askHref = store.whatsapp
  ? `https://wa.me/${store.whatsapp}?text=${encodeURIComponent(`Halo ${store.name}, saya mau tanya harga ${product.name}.`)}`
  : "/kontak";

// A price cut is nonsense on an unpriced product (compareAt over a 0 base computes a bogus -100%), so
// the struck price + discount badge only exist when there IS a price.
const discount =
  !unpriced && product.compareAt && product.compareAt > product.price
    ? Math.round(((product.compareAt - product.price) / product.compareAt) * 100)
    : 0;

const gallery = productImages(product);

// Gallery layout is a store-wide Tema setting (stores.product_gallery_layout): the thumbnail rail
// sits BESIDE the main image ('thumbnail-left'), UNDER it ('thumbnail-bottom'), or every image is laid
// out in a 2-column grid with no main/thumbnail split ('grid'). The switcher script is a no-op in
// grid mode (there is no #gallery-main / #gallery-thumbs to bind).
const galleryLayout = store.productGalleryLayout;
const galleryIsGrid = galleryLayout === "grid";
const thumbsBeside = galleryLayout === "thumbnail-left"; // vertical rail on sm+ vs. a row underneath
// MAIN-image aspect (owner request 2026-08-24) — a Tema setting in `stores.theme` jsonb, validated
// by resolveGalleryAspect (unknown ⇒ "1:1", the historical shape). LITERAL classes only: Tailwind
// cannot see an interpolated `aspect-[${x}]`. Thumbnails stay square deliberately — the rail is a
// picker, not a display, and square keeps 4+ of them on one row at every width.
const GALLERY_ASPECT_CLASS: Record<string, string> = {
  "1:1": "aspect-square",
  "4:5": "aspect-[4/5]",
  "2:3": "aspect-[2/3]",
};
const galleryAspectClass = GALLERY_ASPECT_CLASS[resolveGalleryAspect(store.theme)] ?? "aspect-square";

// Specifications — built ONLY from attributes the merchant actually filled in, so the table never
// shows a blank row. Kategori = the merchant's label (catalog.ts falls back to the collection), else omitted. `sizes` is deliberately NOT
// shown here either: it is the legacy display-only column that used to be the Ukuran picker in the buy
// box, and it names sizes this shop cannot actually pick or ship separately (see the picker note
// below). Gender is mapped to a shopper-facing word, not the feed code ("female").
// Specifications = the SAME facts the Google/Meta/TikTok feed sends (lib/product-feed.ts
// `catalogSpecs`), in Indonesian — one derivation, so the PDP can never claim what the catalogue does not.
const specs = catalogSpecs(product, store.name);

// Pengiriman & pembayaran lines — ONE short line each (owner 2026-11-05), and only what this store
// really offers: payment kinds from its enabled channels, COD only when the store + platform allow it.
const [payWords, cod] = await Promise.all([paymentKindWords("sentence"), storeCodPolicy(store.id)]);
const payLine = (() => {
  const kinds = payWords.slice(0, 2).map((w) => w.replace(/^transfer bank$/i, "transfer"));
  if (cod.enabled) kinds.push("COD");
  if (!kinds.length) return null;
  return `Bisa bayar lewat ${kinds.length > 1 ? `${kinds.slice(0, -1).join(", ")}, atau ${kinds[kinds.length - 1]}` : kinds[0]}`;
})();

// ── `sizes` for the main gallery image — derived from the real classes ────────────────────────────
//
// Redesign C (DESIGN.md C3): below `md` the gallery is FULL-BLEED (`-mx-4 sm:-mx-6`, no rail — the
// thumbnails only exist from md up), so the image box IS the viewport: `100vw` is arithmetic there.
// From md the two-column grid is unchanged:
//   column   `md:grid-cols-2 lg:gap-14` inside `max-w-7xl px-6`, minus the 5rem rail + gap-4 (96px)
//   768-1279 (100vw - 48 - 56)/2 - 96                       = calc(50vw - 148px)
//   >=1280   (1280 - 48 - 56)/2 - 96                        = 492px
// thumbnail-bottom has no rail beside it, so those two rows under-declare by 96px there — the
// tighter of the two layouts, kept deliberately (never over-claim the LCP image).
const GALLERY_SIZES = "(min-width: 1280px) 492px, (min-width: 768px) calc(50vw - 148px), 100vw";
// `undefined` for seeded /products/*.webp and impossible to reach when the gallery is empty — the
// no-photo branch below renders the tinted ImageOff frame and no <img> at all.
const mainSrcSet = gallery.length > 0 ? imageSrcSet(gallery[0]) : undefined;

// ── `sizes` for the THUMBNAIL rail ─────────────────────────────────────────────────────────────────
// Thumbnails render from `md` up only (phones swipe the full-bleed strip instead, DESIGN.md C3). There
// the rail beside the image is a fixed `md:w-20` (80px) column, and the row under it caps every tile
// at `max-w-[7rem]` (112px) — declaring the cap is the true maximum, never an under-claim.
const THUMB_SIZES = thumbsBeside ? "80px" : "112px";

// `null` = no published reviews. The page then shows no stars and no review block at all — see
// data/catalog.ts: the old code invented "4.8 · 187 ulasan" on a catalog holding 5 published reviews.
const rating = catalog.productRating(product);
const breakdown = rating ? catalog.ratingHistogram(product) : [];   // real counts, 5★→1★
const maxBucket = Math.max(...breakdown, 1);
// The written testimonials (reviews with text), newest first. Each is a real buyer who received a
// `selesai` order for this product — see packages/db/src/seed-reviews.ts.
const reviews = rating ? catalog.productReviews(product) : [];
const REVIEWS_ON_PAGE = 3;
// The page shows the three BEST (owner 2026-11-05): highest stars, then the fullest text (a sentence
// beats "Mantap"), then the newest. The dialog keeps the honest order — newest first, every review.
const bestReviews = [...reviews]
  .sort((a, b) => b.rating - a.rating || b.body.length - a.body.length || a.daysAgo - b.daysAgo)
  .slice(0, REVIEWS_ON_PAGE);
// Star chips for the dialog — only stars that actually have reviews, plus "Semua".
const REVIEW_CHIPS = [
  { value: "all", label: "Semua", count: reviews.length },
  ...[5, 4, 3, 2, 1]
    .map((n) => ({ value: String(n), label: `${n} ★`, count: reviews.filter((r) => Math.round(r.rating) === n).length }))
    .filter((c) => c.count > 0),
];

// ADR 0009 — Store Builder: this product's own template → the store's default `product` template
// → null = today's page, unchanged.
//
// A product template REPLACES THE TAIL of the page (the hand-built "Rekomendasi" strip), not the
// whole page: the buy box (gallery, price, varian, Tambah ke Keranjang) and the real Ulasan block
// are commerce-critical and NO section in the registry can render them — none of the 8 sections is
// a product-detail section. So the merchant composes what comes AFTER the buy box (story, promo
// banner, testimoni, a Grid Produk that is auto-scoped to this product's category — see
// components/sections/context.ts), and the buy box always stays.
const TEMPLATE = catalog.productTemplate(product);

// ── SEO: schema.org Product ──────────────────────────────────────────────────────────────────────
// Every field below is ALREADY loaded and already rendered visually on this page — it was simply
// being thrown away instead of also being handed to Google. A PDP with valid Product markup gets the
// price, stock and star rating drawn straight into the search result, which on a mobile SERP in a
// category this visual is the largest free CTR lever there is.
//
// Prices come from the real variant rows when they exist (an AggregateOffer is the truthful shape for
// a product whose variants differ in price), and availability from real stock — never a guess.
const ORIGIN = Astro.locals.origin;
const abs = (u: string) => new URL(u, ORIGIN).href;
const PAGE_URL = abs(`/produk/${product.handle}`);

// The catalog id this page reports to the merchant's pixels (ADR 0013). Computed HERE, server-side,
// with the same helper the feed and the Conversions API use — the browser cannot derive it (the id no
// longer lives in the URL) and must never guess it: a `content_ids` value that is not a real catalog
// item matches nothing, silently.
//
// The DEFAULT is the FIRST variant's exact item id, because that is what the page actually shows: the
// picker pre-selects the first value of every option group and prices/stock-checks it at load, and a
// product with no option groups has exactly one variant. An earlier version defaulted to the GROUP id
// here — which under the `number` scheme is never null, so a product with no picker (nothing to
// correct it) reported `product_group` on AddToCart for good. Meta forbids exactly that, and Google
// has no group concept at all.
//
// The group survives as `catalogGroup`, used ONLY as the fallback when no variant row resolves.
const catalogScheme: CatalogIdScheme = store.catalogIdScheme === "number" ? "number" : "handle";
const variantCount = product.variants?.length ?? 1;
const catalogId = retailerId(catalogScheme, product, {
  seq: product.variants?.[0]?.seq ?? 1,
  index: 0,
  count: variantCount,
});
const catalogType = "product";
const catalogGroup = itemGroupId(catalogScheme, product, variantCount);
// A store on the legacy `handle` scheme has no group id for a single-variant product — fall back to the
// item id rather than emit nothing, so the sparse-matrix branch always has something valid to report.
const catalogGroupId = catalogGroup ?? catalogId;
const catalogGroupType = catalogGroup ? "product_group" : "product";
// Each variant's EXACT catalog item id, computed HERE by the shared helper and shipped with the picker.
// It is what AddToCart / InitiateCheckout / Purchase must report: Meta documents plainly that
// `product_group` must NOT be used with AddToCart or Purchase ("people buy specific products"), Google
// has no group concept at all (`item_id` has to equal a Merchant Center offer id), and TikTok
// recommends the `sku_id`. Composing `number + "-" + seq` in the browser instead would be a second
// definition of the id rule — and under the legacy `handle` scheme it would produce a string that
// exists in no catalog, which matches nothing, silently.
const variantCatalogIds = (product.variants ?? []).map((v, i) =>
  retailerId(catalogScheme, product, { seq: v.seq, index: i, count: variantCount }),
);

// ⚠️ CAP against the live flash price. `variants[].price` is capped by `data/catalog.ts` only when
// `onSale` — i.e. only when the sale beats the POSITION-0 variant — so a flash priced between
// variant 0 and a dearer one left `highPrice` at the uncapped figure while `/api/public/order`
// charges the cap. Structured data is the one surface a shopper never sees and Google always does;
// advertising a price the till will not take is the worst place to be wrong.
// Every other surface consults `product.flashPrice`; this one did not.
const capFlash = (n: number) => (product.flashPrice != null ? Math.min(n, product.flashPrice) : n);
const variantPrices = (product.variants ?? []).map((v) => capFlash(v.price)).filter((n) => n > 0);
const available = inStock(product);
// Units on hand for the DEFAULT variant — what the picker's JS would write for it. Only used when the
// product has no options and therefore no picker to write it.
const stockCount = Number((product.variants ?? [])[0]?.stock ?? 0);
const offers =
  variantPrices.length > 1 && Math.min(...variantPrices) !== Math.max(...variantPrices)
    ? {
        "@type": "AggregateOffer",
        priceCurrency: "IDR",
        lowPrice: Math.min(...variantPrices),
        highPrice: Math.max(...variantPrices),
        offerCount: variantPrices.length,
        availability: `https://schema.org/${available ? "InStock" : "OutOfStock"}`,
        url: abs(`/produk/${product.handle}`),
        // When the sale lapses this price stops being true. The feed already says so
        // (`g:sale_price_effective_date`); without it here, rich results keep advertising the sale
        // figure indefinitely. Omitted entirely when there is no sale — an invented expiry is worse
        // than none.
        ...(product.flashEndsAt ? { priceValidUntil: product.flashEndsAt.slice(0, 10) } : {}),
      }
    : {
        "@type": "Offer",
        priceCurrency: "IDR",
        price: product.price,
        availability: `https://schema.org/${available ? "InStock" : "OutOfStock"}`,
        url: abs(`/produk/${product.handle}`),
        ...(product.flashEndsAt ? { priceValidUntil: product.flashEndsAt.slice(0, 10) } : {}),
      };

// A description-less product must not feed an empty string to <meta name="description"> or the JSON-LD
// `description` — an empty meta description is worse than a generated one. When the merchant wrote none
// (`description` is `?? ""` upstream), build a sentence from what the page HAS (name + category +
// store), matching the voice /kategori/[handle] uses for a blank blurb ("Koleksi <name> di <store>.").
// The VISIBLE <p> below stays empty-guarded — this fallback is for the crawler, not the shopper.
const metaDescription =
  product.seoDesc?.trim() ||
  product.description.trim() ||
  `${product.name}${product.category ? ` — ${product.category}` : ""} di ${store.name}.`;
// SEO title override (merchant-set, ≤70 chars); falls back to the product name.
const seoTitle = product.seoTitle?.trim() || product.name;

const productLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: metaDescription,
  image: gallery.map(abs),
  sku: product.handle,
  brand: { "@type": "Brand", name: store.name },
  offers,
};
// aggregateRating is emitted ONLY when the rating is REAL. `rating` is null when the product has no
// published reviews (data/catalog.ts) — and Google penalises invented review markup, so a store with
// no reviews must not claim stars in its structured data either.
if (rating && rating.count > 0) {
  productLd.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue: rating.value,
    reviewCount: rating.count,
  };
}

// ONE array drives the visible trail AND the schema — they used to be typed out separately, and the
// schema claimed a third crumb (the product name) that the trail on screen never showed.
// The middle crumb is the product's real collection (`homeCollection`), or absent — never the label
// text slugified into a `/kategori/…` URL that may not exist.
// Always THREE levels — Beranda › Kategori › Judul (owner 2026-11-05). A product outside every
// collection used to drop the middle crumb, so the trail jumped from Beranda straight to a 90-char
// title. Middle crumb, in order: its home collection; else the merchant's own category label, linked to
// the search for it (a `/kategori/<label>` page need not exist); else the full catalogue.
const middleCrumb: Crumb = home
  ? { name: home.name, href: `/kategori/${home.handle}` }
  : product.category
    ? { name: product.category, href: `/cari?q=${encodeURIComponent(product.category)}` }
    : { name: "Produk", href: "/produk" };
const CRUMBS: Crumb[] = [{ name: "Beranda", href: "/" }, middleCrumb, { name: product.name }];

const HEAD = [productLd, breadcrumbLd(CRUMBS, ORIGIN)].map(ldScript).join("");
---

<Layout
  title={seoTitle}
  description={metaDescription}
  image={product.image}
  type="product"
  head={HEAD}
>
  <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 md:py-12">
    {/* `grid-cols-1` is not decoration. Without an explicit template below `md`, the single column
         is an IMPLICIT `auto` track — and an auto track is sized from its CONTENT, so it may exceed
         the container. The gallery's thumbnail strip made it do exactly that and the page scrolled
         sideways on a 320-360px phone. `grid-cols-1` = `1fr`, bounded by the available space. */}
    <div class="flex flex-col gap-6 md:grid md:grid-cols-2 md:items-start md:gap-10 lg:gap-14">
      {/* Two columns on md+: LEFT = gallery + reviews, RIGHT = buy box + the long Deskripsi Produk (the
          reference's shape — reviews under the thumbnail, the description filling the column beside them).
          `md:items-start` is load-bearing: without it the grid stretched the gallery to match the taller
          right column, forcing the 3:4 main image to ~1:1.9 (the "memanjang" bug).
          On MOBILE the columns collapse to a single flow via `contents`, and `order-*` interleaves the
          four blocks into the right reading order — gallery → buy box → description → reviews — so the buy
          actions are never buried under the reviews. */}
      <div class="contents md:flex md:flex-col md:gap-14">
      {/* Gallery — layout picked in Tema (thumbnail-left / thumbnail-bottom / grid) */}
      {galleryIsGrid ? (
        /* GRID — every image in a 2-column grid, no main/thumbnail split (the reference #17 shape).
           An empty gallery still shows the one tinted placeholder tile. */
        <div class="order-1 grid grid-cols-2 gap-3 md:order-none">
          {gallery.length > 0 ? (
            gallery.map((src, i) => (
              <div class:list={["relative overflow-hidden rounded-sm bg-mist", galleryAspectClass]}>
                <img
                  src={src}
                  srcset={imageSrcSet(src)}
                  sizes="(min-width: 768px) 25vw, 45vw"
                  alt={`${product.name}${i === 0 ? "" : ` — tampilan ${i + 1}`}`}
                  width="900"
                  height="1200"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding="async"
                  class="h-full w-full object-cover"
                />
                {i === 0 && product.badge && (
                  <span class="absolute left-3 top-3 rounded-sm bg-ink px-2 py-0.5 text-xs font-semibold text-white">
                    {product.badge}
                  </span>
                )}
              </div>
            ))
          ) : (
            <div class="relative col-span-2 flex aspect-[3/2] items-center justify-center rounded-lg bg-mist" aria-hidden="true">
              <ImageOff class="size-12 text-muted" stroke-width={1.5} />
            </div>
          )}
        </div>
      ) : (
        <div class:list={["order-1 -mx-4 flex flex-col gap-4 sm:-mx-6 md:order-none md:mx-0", thumbsBeside && "md:flex-row-reverse"]}>
          {/* Main image */}
          <div class:list={["relative flex-1 overflow-hidden bg-mist md:rounded-sm", galleryAspectClass]}>
            {/* PHONES: a swipeable strip of every photo (scroll-snap, no library) — the Horizon PDP.
                Image 0 is `#gallery-main`, which the md+ thumbnail switcher keeps driving; images 1..n
                are phone-only (`md:hidden`) and lazy, so desktop never downloads them twice. */}
            <div id="gallery-strip" class="no-scrollbar absolute inset-0 flex snap-x snap-mandatory overflow-x-auto md:overflow-hidden">
            {/* This is the LCP element of the most important page in the shop and it had no priority
                hint at all — while the thumbnails BELOW it were `loading="lazy"`, i.e. backwards.
                `width`/`height` describe the intrinsic ratio; the `aspect-square` wrapper does the
                layout, so these prevent nothing from shifting but do let the browser reserve correctly
                if the CSS is slow.
                And the gallery can now be EMPTY: `catalog.ts` stopped guessing a filename for products
                with no media, so a merchant product without a photo gets the tinted frame instead of a
                broken image. */}
            {gallery.length > 0 ? (
              <Fragment>
              <img
                id="gallery-main"
                src={gallery[0]}
                srcset={mainSrcSet}
                sizes={mainSrcSet ? GALLERY_SIZES : undefined}
                alt={product.name}
                width="900"
                height="1200"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full shrink-0 snap-center object-cover transition-opacity duration-200"
              />
              {gallery.slice(1).map((src, i) => (
                <img
                  src={src}
                  srcset={imageSrcSet(src)}
                  sizes={imageSrcSet(src) ? "100vw" : undefined}
                  alt={`${product.name} — tampilan ${i + 2}`}
                  width="900"
                  height="1200"
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                  class="h-full w-full shrink-0 snap-center object-cover md:hidden"
                />
              ))}
              </Fragment>
            ) : (
              <div class="flex h-full w-full items-center justify-center" aria-hidden="true">
                <ImageOff class="size-12 text-muted" stroke-width={1.5} />
              </div>
            )}
            </div>
            {gallery.length > 1 && (
              <div id="gallery-dots" class="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center gap-1.5 md:hidden" aria-hidden="true">
                {gallery.map((_, i) => (
                  <span data-dot={i} class:list={["size-1.5 rounded-full transition-colors", i === 0 ? "bg-ink" : "bg-ink/25"]} />
                ))}
              </div>
            )}
            {
              product.badge && (
                <span class="absolute left-3 top-3 rounded-sm bg-ink px-2 py-0.5 text-xs font-semibold text-white">
                  {product.badge}
                </span>
              )
            }
          </div>

          {/* Thumbnails — a vertical rail beside the image (thumbnail-left) or a scrollable row under it */}
          <div
            id="gallery-thumbs"
            class:list={["hidden gap-3 overflow-visible pb-1 md:flex", thumbsBeside && "md:w-20 md:flex-col md:pb-0"]}
          >
            {
              gallery.map((src, i) => (
                <button
                  type="button"
                  data-thumb={i}
                  data-src={src}
                  data-srcset={imageSrcSet(src)}
                  aria-label={`Gambar ${i + 1}`}
                  aria-pressed={i === 0 ? "true" : "false"}
                  class:list={[
                    // 1:1 SQUARE thumbs for a uniform, precise strip. Horizontal row (mobile, and
                    // thumbnail-bottom on every size): each GROWS to fill the width evenly (flex-1 basis-0)
                    // so the strip is exactly as wide as the main image; `max-w` caps a few thumbs.
                    // Selection state is driven entirely by `aria-pressed` (the switcher JS only flips that):
                    // clean minimalist — no border at rest, a subtle brand ring on hover, and an offset
                    // brand ring when active (the Shopify-pro selected look).
                    "gallery-thumb relative aspect-square min-w-0 flex-1 basis-0 max-w-[7rem] overflow-hidden rounded-sm bg-mist ring-1 ring-transparent transition-shadow aria-[pressed=false]:hover:ring-line aria-[pressed=true]:ring-2 aria-[pressed=true]:ring-ink aria-[pressed=true]:ring-offset-2 aria-[pressed=true]:ring-offset-cream",
                    // thumbnail-left on sm+: fixed vertical rail (fills the w-20 column, no grow).
                    thumbsBeside && "md:w-full md:max-w-none md:flex-none md:basis-auto",
                  ]}
                >
                  <img
                    src={src}
                    srcset={imageSrcSet(src)}
                    sizes={imageSrcSet(src) ? THUMB_SIZES : undefined}
                    alt={`${product.name} — tampilan ${i + 1}`}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </button>
              ))
            }
          </div>
        </div>
      )}

        {/* Ulasan — in the LEFT column beneath the gallery (the reference's shape) so the long Deskripsi
            Produk fills the right column beside it, instead of the reviews running full-width and leaving
            the left side blank under a short gallery. Rendered ONLY when real published reviews exist: the
            score + histogram are COUNTED from verified-purchase reviews (seed-reviews.ts), never fitted to
            a seed column — a product with no reviews shows no section (a new product is not a bad one). */}
        {rating && (
          <div id="ulasan" class="order-4 scroll-mt-24 rule-fade-top pt-10 md:order-none">
            {/* Centred on mobile (the review summary reads as a unit under the gallery), left-aligned from
                sm+ where it sits beside the histogram. */}
            <SectionHeading title="Apa kata pelanggan" />

            {/* SUMMARY (owner 2026-11-05, "rapikan"): one compact row at every width — the score with its
                stars and count on the left, a thin five-row histogram on the right. No "/ 5,0" (the five
                stars already say out of what), no centred hero number. */}
            <div class="mt-5 grid grid-cols-[auto_minmax(0,1fr)] items-center gap-6 sm:gap-10">
              <div>
                <p class="text-[2.5rem] font-semibold leading-none tracking-[-0.02em] text-ink tabular-nums">{rating.value.toFixed(1).replace(".", ",")}</p>
                <Stars value={rating.value} size="sm" showValue={false} class="mt-2" />
                <p class="mt-1.5 text-sm text-muted">{rating.count} ulasan</p>
              </div>
              <div class="space-y-1.5" role="img" aria-label={`Sebaran bintang: ${breakdown.map((n, i) => `${5 - i} bintang ${n}`).join(", ")}`}>
                {breakdown.map((n, i) => (
                  <div class="flex items-center gap-2.5 text-xs text-muted" aria-hidden="true">
                    <span class="w-3 shrink-0 text-right tabular-nums">{5 - i}</span>
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-mist-strong">
                      <div class="h-full rounded-full bg-ink" style={`width:${maxBucket ? (n / maxBucket) * 100 : 0}%`} />
                    </div>
                    <span class="w-4 shrink-0 tabular-nums">{n}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* REVIEWS (owner 2026-11-05): the five newest on the page; the rest one tap away in a dialog
                that scrolls inside itself, with star chips to narrow it. Both lists are the SAME
                <ReviewItem>, so a review never reads differently in the two places. */}
            {reviews.length > 0 && (
              <ul class="mt-8 space-y-7">
                {bestReviews.map((rev) => <ReviewItem rev={rev} />)}
              </ul>
            )}
            {reviews.length > REVIEWS_ON_PAGE && (
              <Fragment>
                {/* No frame (owner 2026-11-05): a stack of reviewer initials + a text link — social proof
                    that reads as "more people said this", not as another button competing with Beli. */}
                <button type="button" data-reviews-open class="group mt-8 inline-flex min-h-11 items-center gap-3 rounded-sm text-[0.9375rem] font-medium text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">
                  <span class="flex -space-x-2" aria-hidden="true">
                    {reviews.slice(REVIEWS_ON_PAGE, REVIEWS_ON_PAGE + 4).map((r) => (
                      <span class="flex size-8 items-center justify-center rounded-full bg-mist-strong text-xs font-semibold text-ink ring-2 ring-cream">{r.author.trim().charAt(0).toUpperCase()}</span>
                    ))}
                  </span>
                  <span class="underline-offset-4 group-hover:underline">Lihat semua {reviews.length} ulasan</span>
                  <ChevronRight class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" stroke-width={2} aria-hidden="true" />
                </button>
                <dialog data-reviews-dialog aria-labelledby="reviews-title" class="m-0 h-[100dvh] max-h-none w-full max-w-none bg-cream p-0 text-ink sm:m-auto sm:h-auto sm:max-h-[85vh] sm:max-w-2xl sm:rounded-lg sm:shadow-[0_24px_48px_-24px_rgb(0_0_0/0.35)]">
                  <div class="flex h-full max-h-[inherit] flex-col">
                    <div class="shrink-0 px-5 pb-3 pt-4 sm:px-6">
                      <div class="flex items-center justify-between gap-3">
                        <p id="reviews-title" class="text-base font-semibold">Ulasan pembeli</p>
                        <button type="button" data-reviews-close aria-label="Tutup" class="-mr-2 inline-flex size-11 items-center justify-center rounded-full hover:bg-mist">
                          <X class="size-5" stroke-width={1.8} aria-hidden="true" />
                        </button>
                      </div>
                      <div class="mt-1 flex items-center gap-2 text-sm">
                        <Stars value={rating.value} size="sm" showValue={false} />
                        <span class="font-semibold tabular-nums">{rating.value.toFixed(1).replace(".", ",")}</span>
                        <span class="text-muted">· {reviews.length} ulasan</span>
                      </div>
                      <div class="no-scrollbar -mx-5 mt-3 flex gap-2 overflow-x-auto px-5 sm:-mx-6 sm:px-6" role="group" aria-label="Saring menurut bintang">
                        {REVIEW_CHIPS.map((c) => (
                          <button type="button" data-review-filter={c.value} aria-pressed={c.value === "all" ? "true" : "false"} class="inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-full border border-line px-3.5 text-sm text-ink transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-white">
                            {c.label}
                            <span class="tabular-nums opacity-70">{c.count}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                    <ul data-reviews-list class="min-h-0 flex-1 space-y-7 overflow-y-auto overscroll-contain px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-3 sm:px-6">
                      {reviews.map((rev) => <ReviewItem rev={rev} />)}
                    </ul>
                  </div>
                </dialog>
              </Fragment>
            )}
          </div>
        )}
      </div>

      {/* RIGHT COLUMN — buy box + the full Deskripsi Produk below it. `contents md:block`: on md it is a
          normal block column; on mobile it dissolves so its two children (buy box, description) rejoin the
          single flow and take their order slots (2 and 3), between the gallery (1) and the reviews (4). */}
      <div class="contents md:block">
        <div class="order-2 md:order-none">
        {/* Desktop only: on a phone the gallery runs flush under the header (C3) and the breadcrumb's
            job is done by the header + back gesture. Its JSON-LD stays in <head> for every width. */}
        <div class="hidden md:block"><Breadcrumb items={CRUMBS} /></div>

        {/* No category eyebrow above the title — the breadcrumb right above already names the category, and
            stacking a second near-identical label on top of it was pure repetition.
            A MARKETPLACE title, not a blog headline. Sellers legitimately stuff the name to the 100-char
            cap for on-page keywords, and a 36px display heading turned that into a five-line wall that
            dominated the buy box. A moderate 24/28px + `text-pretty` (no orphan last word) lets a long
            title wrap into a tidy 2-4 lines while a short one still reads as the page's heading. The
            FULL name always shows — this is the product's identity, so it is never clamped here (cards
            and the breadcrumb clamp/truncate; the PDP does not). */}
        <h1 class="font-display text-[1.375rem] font-semibold leading-snug text-pretty text-ink sm:text-[1.75rem] md:mt-4">{product.name}</h1>

        {/* Rating + sold count on ONE line under the title (C3) — the two numbers that make a cold ad
            visitor believe the photo. "terjual" moved here from the grid cards: beside the reviews it
            is evidence, on every card it was noise. Either half renders only when it is real. */}
        {(rating || product.unitsSold > 0) && (
          <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
            {rating && (
              <a href="#ulasan" class="inline-flex min-h-6 items-center gap-1.5 transition-colors hover:text-brand-700">
                <Stars value={rating.value} size="sm" showValue={false} />
                <span class="font-semibold text-ink tabular-nums">{rating.value.toFixed(1).replace(".", ",")}</span>
                <span class="text-muted underline decoration-line underline-offset-4">({rating.count} ulasan)</span>
              </a>
            )}
            {rating && product.unitsSold > 0 && <span class="text-muted" aria-hidden="true">·</span>}
            {product.unitsSold > 0 && <span class="text-muted tabular-nums">{num(product.unitsSold)} terjual</span>}
          </div>
        )}

        {/* FLASH SALE — shown only while a sale is live (catalog sets product.flashEndsAt, and already
            makes product.price the sale price with compareAt = the original). This banner adds the
            branding + a live countdown; the price row below shows the numbers. When the timer hits zero
            the banner hides itself (the server re-checks on the next load / the order API re-prices). */}
        {product.flashEndsAt && (
          <div id="flash-banner" class="mt-5 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-lg bg-gradient-to-r from-brand-600 to-brand-500 px-4 py-2.5 text-white">
            <span class="inline-flex items-center gap-1.5 text-sm font-bold uppercase tracking-wide">
              <Zap class="size-4 fill-current" stroke-width={0} /> Flash Sale
            </span>
            <span class="inline-flex items-center gap-1.5 text-sm">
              <span class="text-white/80">Berakhir dalam</span>
              <span id="flash-countdown" data-ends={product.flashEndsAt} class="rounded bg-white/20 px-1.5 py-0.5 font-semibold tabular-nums">--:--:--</span>
            </span>
          </div>
        )}

        {/* `flex-wrap`: price + struck-through price + the discount badge are three items on one
             line, and together they exceed the 288px of content a 320px phone has. Without wrapping,
             the badge pushed the page sideways. */}
        <div class:list={["flex flex-wrap items-center gap-x-3 gap-y-2", product.flashEndsAt ? "mt-3" : "mt-5"]}>
          {/* Unpriced → "Hubungi untuk harga" (not "Rp0"). NOT `tabular-nums`/`text-3xl` here since it
              is a phrase, not a figure. The variant-picker JS keeps this honest too — see below. */}
          {/* `data-catalog-id` lives HERE, on an element every PDP renders. It used to sit on the buy-box
               row, which a price-on-request product does not render at all — so no ViewContent fired for
               a page a shopper is very much viewing. The buy BUTTONS carry their own copy, kept in step
               with the variant picker; the pixel prefers those and falls back to this one. */}
          <span id="pdp-price" data-catalog-id={catalogId} data-catalog-type={catalogType} class:list={["font-semibold text-ink", unpriced ? "text-xl sm:text-2xl" : "text-[1.625rem] tabular-nums sm:text-3xl"]}>{unpriced ? "Hubungi untuk harga" : IDR(product.price)}</span>
          {/* Both are ALWAYS in the DOM, hidden when they do not apply, so the variant picker can
              reveal them for a variant that carries a cut the base one does not. Rendering them
              conditionally meant JS had nothing to show and the shopper saw a price drop with no
              "was" beside it. `unpriced` still suppresses them entirely — a percentage off nothing
              is nonsense. */}
          {!unpriced && (
            <span
              id="pdp-compare"
              class="text-base text-muted line-through tabular-nums"
              style={product.compareAt ? undefined : "display:none"}
            >
              {product.compareAt ? IDR(product.compareAt) : ""}
            </span>
          )}
          {!unpriced && (
            <span
              id="pdp-discount"
              class="rounded-sm bg-ink px-2 py-0.5 text-xs font-semibold text-white tabular-nums"
              style={discount > 0 ? undefined : "display:none"}
            >
              -{discount}%
            </span>
          )}
        </div>
        {/* Server-rendered, not left to JS. `updateVariant()` is the only thing that ever wrote this
            line and it is reachable ONLY through #variant-picker — so a product with variants but no
            `product_options` rows (no picker) showed no availability at all and kept an enabled buy
            button, letting a shopper add a sold-out item that /api/public/order then refuses. JS now
            only REFINES this per variant. `role="status"` so a variant change is announced. */}
        {/* ⚠️ Server-render the POSITIVE case too. This said `available ? "" : "Stok habis"` and left
            the rest to the variant picker's JS — but a product with no `product_options` has no
            picker, so a single-variant item in stock said nothing at all, while a 4-variant one said
            "Stok tersedia (17)". Scarcity is a reason to buy; silence is not. */}
        <p
          id="pdp-stock"
          role="status"
          class:list={["mt-2 text-sm", available ? "text-emerald-700" : "text-muted"]}
        >
          {available ? (stockCount > 0 ? `Stok tersedia (${stockCount})` : "Stok tersedia") : "Stok habis"}
        </p>

        {/* SHORT DESCRIPTION — the one-line hook, next to the price and ABOVE the buy actions so they
            stay high on the page. The FULL story moved to "Deskripsi Produk" below the buy box (a long
            description used to push Ukuran + Tambah ke Keranjang under the fold). Empty = nothing here;
            the crawler still gets a real sentence from `metaDescription`. */}
        {product.shortDescription && (
          <p class="mt-4 text-base leading-relaxed text-ink/80">{product.shortDescription}</p>
        )}

        {/* Variant picker (real product_variants: Warna, Ukuran).
             ⚠️ THERE IS NO FALLBACK PICKER, AND THERE MUST NOT BE ONE AGAIN. `products.sizes` is a
             legacy display-only jsonb column (`["All Size"]`, `["S","M","L"]`) that was NEVER
             reconciled with `product_variants`, and this block used to render it as an "Ukuran"
             picker whenever a product had no `product_options` rows. `addToCart` then parked the
             SIZE STRING in `cart.variant` — but `/api/public/order` requires an exact
             `product_variants.title` match (the anti-substitution rule, deliberately), and every one
             of those products has exactly ONE variant, titled `Default`. So the cart said "All Size",
             the database said "Default", and the order was refused at the last step with
             `Varian "All Size" … Muat ulang halaman produk.` — advice that cannot help, because
             reloading leaves the same string in the cart. Measured on production 2026-08-03:
             **10 of batik-nusantara's 22 active products were unbuyable, with 0 line items ever sold
             between them** against 170 for the other 12.
             The size was fiction in the other direction too: the order's line title comes from the DB
             (`match.title === "Default" ? prod.title : …`), so the string never reached the parcel.
             A product with no option rows has no variant to NAME — the storefront cannot map a size
             to a `product_variants.title`, and guessing is exactly what the API refuses to do. If a
             merchant wants per-size stock, that is real variants in the Seller editor (which always
             writes `product_options` alongside them), not a text column. */}
        {
          product.options && product.options.length > 0 ? (
            <div id="variant-picker" class="mt-6 flex flex-col gap-5" data-variants={JSON.stringify((product.variants ?? []).map((v, i) => ({ option1: v.option1, option2: v.option2, price: v.price, compareAt: v.compareAt, stock: v.stock, catalogId: variantCatalogIds[i] })))}>
              {product.options.map((opt, oi) => (
                <div>
                  <p class="text-sm font-medium text-ink">
                    {opt.name}: <span class="text-muted" data-opt-label={oi}>{opt.values[0]}</span>
                  </p>
                  <div class="opt-group mt-2 flex flex-wrap gap-2" data-opt={oi}>
                    {opt.values.map((val, vi) => (
                      <button
                        type="button"
                        data-opt={oi}
                        data-value={val}
                        aria-pressed={vi === 0 ? "true" : "false"}
                        class:list={[
                          "opt-btn min-h-11 min-w-11 rounded-lg border bg-white px-4 text-sm font-medium text-ink transition-colors",
                          vi === 0 ? "border-ink ring-1 ring-ink" : "border-line hover:border-muted",
                        ]}
                      >
                        {val}
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ) : null
        }

        {/* Quantity */}
        <div class="mt-5">
          <p class="text-sm font-medium text-ink">Jumlah</p>
          <div class="mt-2 inline-flex items-center rounded-lg border border-line bg-white">
            <button type="button" id="qty-dec" class="min-h-11 min-w-11 text-lg text-muted hover:text-ink" aria-label="Kurangi">−</button>
            <span id="qty-val" class="w-10 text-center text-sm font-medium tabular-nums">1</span>
            <button type="button" id="qty-inc" class="min-h-11 min-w-11 text-lg text-muted hover:text-ink" aria-label="Tambah">+</button>
          </div>
        </div>

        {/* Actions. An unpriced product does NOT get "Tambah ke Keranjang"/"Beli Sekarang" at all —
             see the `unpriced` note above: there is no price to cart, so it routes to the merchant
             ("Tanya Harga") instead, which is what "Hubungi untuk harga" promised.
            ONE filled action (redesign C): Beli Sekarang is the primary — first in the DOM, so it is
            first on a phone and, with `sm:flex-row-reverse`, on the right from sm up. The cart is the
            outlined secondary. `#buy-actions` is what the sticky bar at the foot of the page watches. */}
        {unpriced ? (
          <div class="mt-8">
            <a
              href={askHref}
              target={store.whatsapp ? "_blank" : undefined}
              rel={store.whatsapp ? "noopener" : undefined}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-brand-600 px-6 text-[0.9375rem] font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream sm:w-auto"
            >
              Tanya Harga
            </a>
          </div>
        ) : (
        <div id="buy-actions" class="mt-6 flex flex-col gap-2 sm:flex-row-reverse sm:gap-3">
          <button
            type="button"
            id="buy-now"
            disabled={!available}
            data-handle={product.handle}
            data-catalog-id={catalogId}
            data-catalog-type={catalogType}
            data-name={product.name}
            data-price={product.price}
            data-image={product.image}
            class="inline-flex min-h-12 flex-1 items-center justify-center rounded-lg bg-brand-600 px-6 text-[0.9375rem] font-semibold text-white transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-brand-600"
          >
            Beli Sekarang
          </button>
          <button
            type="button"
            id="add-to-cart"
            disabled={!available}
            data-handle={product.handle}
            data-catalog-id={catalogId}
            data-catalog-type={catalogType}
            data-name={product.name}
            data-price={product.price}
            data-image={product.image}
            class="inline-flex min-h-12 flex-1 items-center justify-center rounded-lg border border-ink px-6 text-[0.9375rem] font-semibold text-ink transition-colors enabled:hover:bg-ink enabled:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream disabled:cursor-not-allowed disabled:opacity-50"
          >
            Tambah ke Keranjang
          </button>
        </div>
        )}

        <p id="cart-toast" role="status" class="fixed inset-x-4 bottom-20 z-30 hidden rounded-lg bg-ink px-4 py-3 text-sm font-medium text-white shadow-lg md:static md:mt-4 md:bg-mist md:text-brand-700 md:shadow-none">
          <Check class="inline h-4 w-4" stroke-width={2.5} aria-hidden="true" /> Ditambahkan ke keranjang.
          <a href="/keranjang" class="ml-1 underline">Lihat keranjang</a>
        </p>

        {/* Share. This bar existed ONLY on the blog, which was exactly the wrong way round:
             forwarding a dress into a WhatsApp group is how these shops actually get customers, and a
             shopper who wants a second opinion before buying had nothing to tap but the address bar.
             Below the buy buttons on purpose — it is the second thing you might do here, never the
             first. Pinterest gets the main gallery image (absolute, as it requires); a product with
             no photo passes none and the Pinterest button is simply not rendered. */}
        <div class="mt-6 flex items-center gap-2">
          <span class="text-sm text-muted">Bagikan</span>
          <ShareBar
            url={PAGE_URL}
            title={product.name}
            image={gallery.length > 0 ? abs(gallery[0]) : undefined}
          />
        </div>

        {/* DESKRIPSI PRODUK — IN the buy-box column, BELOW the buy actions (the Shopify Dawn shape).
            After the buttons so it never pushes them under the fold, contextual to the buy box, and it
            fills the tall right column against the gallery — the two-column layout the reference asks
            for, without the empty right column a short description would leave in a sustained grid. The
            short hook by the price is still the above-the-fold summary. */}
        </div>{/* end buy box */}

        {/* Product detail — ONE consistent accordion group (the Shopify/#18 shape): every part is a
            <details> with the same summary + chevron, so Deskripsi, Spesifikasi and Pengiriman read as
            siblings, not one-off blocks. Deskripsi + Spesifikasi ship OPEN (primary content, and open
            keeps them visible for SEO — the copy stays in the DOM either way); Pengiriman folds. A single
            hairline per row is the only rule; nothing is boxed. `pdp-acc` styles the reveal in one place. */}
        <div class="order-3 rule-fade-top md:order-none md:mt-10">
          {product.description.trim() && (
            <details open class="pdp-acc group rule-fade">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.9375rem] font-semibold text-ink transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden">
                Deskripsi
                <ChevronDown class="size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180" />
              </summary>
              {/* Three lines that fade out, then "Selengkapnya" (owner 2026-11-05). The clamp is added by
                  the script only when the text is really longer than three lines, so with JS off — or a
                  short description — everything simply shows. The copy stays in the DOM for search. */}
              <div data-desc class="desc-body space-y-4 leading-relaxed text-muted">
                {product.description
                  .split(/\n{2,}/)
                  .map((para) => para.trim())
                  .filter(Boolean)
                  .map((para) => (
                    <p class="whitespace-pre-line">{para}</p>
                  ))}
              </div>
              <button type="button" data-desc-toggle hidden aria-expanded="false" class="mb-6 mt-2 inline-flex min-h-9 items-center gap-1 text-sm font-medium text-ink underline underline-offset-4">
                Selengkapnya
              </button>
              <div class="pb-6" data-desc-pad></div>
            </details>
          )}

          {specs.length > 0 && (
            <details class="pdp-acc group rule-fade">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.9375rem] font-semibold text-ink transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden">
                Spesifikasi
                <ChevronDown class="size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180" />
              </summary>
              {/* Zebra rows, no borders — the frameless table in the reference. */}
              <dl class="overflow-hidden rounded-lg pb-6 text-sm">
                {specs.map((s, i) => (
                  <div class:list={["grid grid-cols-[7rem_1fr] gap-4 px-3 py-2.5", i % 2 === 0 && "bg-mist/70"]}>
                    <dt class="text-muted">{s.label}</dt>
                    <dd class="font-medium text-ink">{s.value}</dd>
                  </div>
                ))}
              </dl>
            </details>
          )}

          <details open class="pdp-acc group rule-fade">
            <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.9375rem] font-semibold text-ink transition-colors hover:text-brand-700 [&::-webkit-details-marker]:hidden">
              Pengiriman &amp; Pengembalian
              <ChevronDown class="size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180" />
            </summary>
            <ul class="space-y-2.5 pb-6 text-sm text-muted">
              <li class="flex items-start gap-2.5"><Truck class="mt-0.5 size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />Ongkir dihitung dari alamat dan berat paket</li>
              <li class="flex items-start gap-2.5"><CalendarDays class="mt-0.5 size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />Pesanan tidak diproses pada hari libur</li>
              {payLine && <li class="flex items-start gap-2.5"><Wallet class="mt-0.5 size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />{payLine}</li>}
              {cod.enabled && <li class="flex items-start gap-2.5"><Banknote class="mt-0.5 size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />Biaya &amp; ketersediaan COD dicek di checkout</li>}
              <li class="flex items-start gap-2.5"><RotateCcw class="mt-0.5 size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />Ingin tukar atau retur? Hubungi kami</li>
            </ul>
          </details>
        </div>
      </div>
    </div>

    {/* Related — hand-built tail; a product template takes this slot instead (below). */}
    {
      !TEMPLATE && related.length > 0 && (
        <div class="mt-20 border-t border-line pt-14">
          <SectionHeading title="Kamu mungkin suka" />
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14 sm:grid-cols-3 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      )
    }
  </section>

  {
    TEMPLATE && (
      <SectionRenderer data={TEMPLATE} context={{ kind: "product", product }} />
    )
  }
  {/* STICKY BUY BAR — phones only (DESIGN.md C4). Appears once the real buy buttons have scrolled up
      out of view, so a shopper reading the description or the reviews is one tap from buying. It owns
      NO logic: each button forwards a click to `#buy-now` / `#add-to-cart`, so the variant check, the
      quantity, the cart write and the marketing pixel all run through exactly the code they always did.
      Unpriced products have no buy buttons, so they get no bar. Chat lives here (owner 2026-11-05),
      replacing the floating bubble. */}
  {!unpriced && (
    <Fragment>
      <div class="h-20 md:hidden" aria-hidden="true"></div>
      <div
        id="sticky-buy"
        class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-line bg-cream px-4 pb-[calc(0.5rem+env(safe-area-inset-bottom))] pt-2 transition-[transform,visibility] duration-200 ease-out motion-reduce:transition-none invisible md:hidden data-[show]:visible data-[show]:translate-y-0"
        inert
      >
        <div class="flex items-center gap-2">
          <p id="sticky-price" class="min-w-0 flex-1 whitespace-nowrap text-[0.9375rem] font-semibold text-ink tabular-nums">{IDR(product.price)}</p>
          <button
            type="button"
            data-chat-open
            aria-expanded="false"
            aria-controls="chat-panel"
            aria-label={`Chat dengan ${store.name}`}
            class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-lg border border-ink text-ink transition-colors hover:bg-ink hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          >
            <MessageCircle class="size-5" stroke-width={1.8} aria-hidden="true" />
            <span data-chat-dot class="absolute right-1.5 top-1.5 hidden size-2.5 rounded-full bg-brand-600 ring-2 ring-cream"><span class="sr-only">Ada balasan baru</span></span>
          </button>
          <button
            type="button"
            data-proxy="add-to-cart"
            aria-label="Tambah ke Keranjang"
            class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg border border-ink text-ink transition-colors enabled:hover:bg-ink enabled:hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 disabled:opacity-50"
          >
            <ShoppingBag class="size-5" stroke-width={1.8} aria-hidden="true" />
          </button>
          <button
            type="button"
            data-proxy="buy-now"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-brand-600 px-4 text-[0.9375rem] font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream disabled:opacity-50"
          >
            Beli Sekarang
          </button>
        </div>
      </div>
    </Fragment>
  )}
</Layout>

<style is:global>
  /* Accordion reveal for the product-detail sections. Animates height + fade where the browser can
     interpolate to `auto` (::details-content + interpolate-size); everywhere else the rule is ignored
     or block-size:auto simply applies without a tween — the content always shows when open, so this is
     pure progressive enhancement, never a way to hide copy. */
  :root {
    interpolate-size: allow-keywords;
  }
  .pdp-acc::details-content {
    block-size: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      block-size 0.28s ease,
      opacity 0.28s ease,
      content-visibility 0.28s allow-discrete;
  }
  .pdp-acc[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-acc::details-content {
      transition: none;
    }
  }
</style>

{/* The GROUP id is passed in rather than re-derived: it is the fallback when a variant combination
     has no row, and it must be the exact string the shared helper produced server-side. */}
<script is:inline define:vars={{ GROUP_CATALOG_ID: catalogGroupId, GROUP_CATALOG_TYPE: catalogGroupType, FLASH_PRICE: product.flashPrice ?? null }}>
  (function () {
    // Flash-sale countdown — ticks to `data-ends` (ISO). Hides the whole banner at zero; the price stays
    // (server re-prices on the next load, and /api/public/order re-validates).
    var fc = document.getElementById("flash-countdown");
    if (fc) {
      var ends = new Date(fc.getAttribute("data-ends")).getTime();
      var pad = function (n) { return String(n).padStart(2, "0"); };
      var tickFlash = function () {
        var diff = ends - Date.now();
        if (isNaN(ends) || diff <= 0) {
          var banner = document.getElementById("flash-banner");
          if (banner) banner.style.display = "none";
          // ⚠️ Hiding the banner is NOT enough. `FLASH_PRICE` was baked in at SSR, so the picker keeps
          // capping at the EXPIRED price for the life of this tab, the price row keeps showing the
          // sale figure, and `/api/public/order` — which reads the live window — will charge the real
          // one. Re-fetch instead: the server is the only thing that knows whether the sale is over.
          // Guarded on `isNaN` so a malformed date never puts the page in a reload loop.
          if (!isNaN(ends)) location.reload();
          return false;
        }
        var s = Math.floor(diff / 1000);
        var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        fc.textContent = (d > 0 ? d + " hari " : "") + pad(h) + ":" + pad(m) + ":" + pad(sec);
        return true;
      };
      if (tickFlash()) {
        var flashTimer = setInterval(function () { if (!tickFlash()) clearInterval(flashTimer); }, 1000);
      }
    }

    // Gallery
    var main = document.getElementById("gallery-main");
    var thumbs = document.getElementById("gallery-thumbs");
    if (main && thumbs) {
      thumbs.addEventListener("click", function (e) {
        var btn = e.target.closest(".gallery-thumb");
        if (!btn) return;
        main.style.opacity = "0";
        var src = btn.getAttribute("data-src");
        // The srcset MUST be swapped alongside the src, not left behind. A stale srcset WINS over a
        // freshly-set src — the browser re-runs candidate selection against the old list and keeps
        // showing the previous photo, so clicking a thumbnail would appear to do nothing at all.
        // Absent (seeded/static image) → remove the attribute rather than set it to "".
        var srcset = btn.getAttribute("data-srcset");
        setTimeout(function () {
          if (srcset) main.setAttribute("srcset", srcset);
          else main.removeAttribute("srcset");
          main.src = src;
          main.style.opacity = "1";
        }, 120);
        // Selection is CSS-driven off aria-pressed (see the thumb class list) — just flip the flag.
        thumbs.querySelectorAll(".gallery-thumb").forEach(function (b) {
          b.setAttribute("aria-pressed", "false");
        });
        btn.setAttribute("aria-pressed", "true");
      });
    }

    var addBtn = document.getElementById("add-to-cart");
    var buyBtn = document.getElementById("buy-now");
    var priceEl = document.getElementById("pdp-price");
    // The struck price and the % badge are rendered once, server-side, from PRODUCT-level values —
    // so without these they stayed on the base variant's numbers while the price above them moved.
    // Three numbers describing one price must never be able to disagree.
    var compareEl = document.getElementById("pdp-compare");
    var discountEl = document.getElementById("pdp-discount");
    var stockEl = document.getElementById("pdp-stock");
    // Must match the server's IDR() (Intl currency, id-ID) EXACTLY — that one emits "Rp 199.000" with
    // a non-breaking space. Hand-rolling "Rp" + toLocaleString produced "Rp199.000", so the price
    // silently reflowed the moment JS touched it, right next to a struck compare-at still in the
    // spaced form. Same formatter, same string.
    var idrFmt = new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 });
    var fmt = function (n) { return idrFmt.format(Number(n)); };

    // ---- real variant picker (Warna, Ukuran) ----
    var picker = document.getElementById("variant-picker");
    var variants = [];
    var selected = [];
    if (picker) {
      try { variants = JSON.parse(picker.dataset.variants || "[]"); } catch (e) { variants = []; }
      picker.querySelectorAll(".opt-group").forEach(function (g) {
        var oi = Number(g.dataset.opt);
        var first = g.querySelector(".opt-btn[aria-pressed='true']") || g.querySelector(".opt-btn");
        selected[oi] = first ? first.dataset.value : null;
      });
      picker.addEventListener("click", function (e) {
        var btn = e.target.closest(".opt-btn");
        if (!btn) return;
        var g = btn.closest(".opt-group");
        g.querySelectorAll(".opt-btn").forEach(function (b) {
          b.classList.remove("border-ink", "ring-1", "ring-ink");
          b.classList.add("border-line", "hover:border-muted");
          b.setAttribute("aria-pressed", "false");
        });
        // Selected = an ink outline, not a filled chip: the page keeps ONE filled control, Beli Sekarang.
        btn.classList.add("border-ink", "ring-1", "ring-ink");
        btn.classList.remove("border-line", "hover:border-muted");
        btn.setAttribute("aria-pressed", "true");
        selected[Number(btn.dataset.opt)] = btn.dataset.value;
        var lbl = picker.querySelector("[data-opt-label='" + btn.dataset.opt + "']");
        if (lbl) lbl.textContent = btn.dataset.value;
        updateVariant();
      });
    }

    function resolveVariant() {
      if (!variants.length) return null;
      return variants.find(function (v) {
        var m1 = v.option1 == null || v.option1 === selected[0];
        var m2 = v.option2 == null || v.option2 === selected[1];
        return m1 && m2;
      }) || null;
    }
    function variantLabel() { return selected.filter(Boolean).join(" / "); }
    function updateVariant() {
      var v = resolveVariant();
      if (!v) {
        // No row for this combination. Say so and refuse the sale: leaving the previous variant's price
        // and an enabled button lets a shopper add something `/api/public/order` will reject at the last
        // step, and reports it to three ad platforms at the wrong SKU's price on the way. The id drops
        // back to the GROUP so nothing stale is ever reported, and the variant label follows the pick
        // rather than staying on the last resolvable one — the page said "Beige / L" while the cart
        // line said "Hitam / L".
        if (stockEl) { stockEl.textContent = "Kombinasi ini tidak tersedia"; stockEl.className = "mt-2 text-sm font-medium text-red-700"; }
        // Hide the price furniture too — a struck price and a "-43%" over a combination that cannot
        // be bought is an advertisement for something that does not exist.
        if (compareEl) compareEl.style.display = "none";
        if (discountEl) discountEl.style.display = "none";
        [addBtn, buyBtn].forEach(function (b) {
          if (!b) return;
          b.disabled = true;
          b.classList.add("opacity-50", "cursor-not-allowed");
          b.dataset.catalogId = GROUP_CATALOG_ID;
          b.dataset.catalogType = GROUP_CATALOG_TYPE;
          b.dataset.variant = variantLabel();
          // Cleared too, or the button announces the GROUP id at the PREVIOUS variant's price. The
          // comment above promises "nothing stale is ever reported"; leaving one field behind is one
          // removed `if (btn.disabled) return` away from making that promise false.
          b.dataset.price = "";
        });
        return;
      }
      // Mirror the server-side truth: a 0-priced variant is "not priced yet", never "Rp0". Keeps the
      // JS-driven price in step with the static "Hubungi untuk harga" the frontmatter renders.
      // Same expression the order endpoint uses: a flash sale CAPS each variant's price, it does not
      // scale it. Without this the picker overwrote the sale price the page rendered with the raw
      // variant price — so the shopper saw, and the pixel reported, more than the checkout charges.
      var eff = FLASH_PRICE != null ? Math.min(v.price, FLASH_PRICE) : v.price;
      if (priceEl) priceEl.textContent = eff > 0 ? fmt(eff) : "Hubungi untuk harga";
      // `was` is THIS variant's own pre-sale price (data/catalog.ts writes it when a flash sale caps
      // the variant), never the product-level base — striking the base against a dearer variant
      // understates the cut, and against a cheaper one would overstate it.
      var was = v.compareAt || 0;
      var cut = was > eff && eff > 0 ? Math.round(((was - eff) / was) * 100) : 0;
      if (compareEl) {
        compareEl.textContent = was > eff ? fmt(was) : "";
        compareEl.style.display = was > eff ? "" : "none";
      }
      if (discountEl) {
        discountEl.textContent = "-" + cut + "%";
        discountEl.style.display = cut > 0 ? "" : "none";
      }
      var stock = v.stock || 0;
      if (stockEl) {
        // -600 → -700 on all THREE states. Measured against the cream page (#faf6f2): emerald-600 was
        // 3.40:1, red-600 4.44:1, amber-600 **2.98:1** — every one below AA's 4.5. The -700s are
        // 5.10 / 5.97 / 4.68 and read as the same three colours.
        //
        // ⚠️ Lighthouse only ever caught the emerald one, because these classes are applied FROM JS and
        // only the in-stock branch runs on an in-stock product. The other two are reachable only by
        // picking a low/out-of-stock variant, so no page-load audit will ever see them — and the worst
        // offender was the amber: "Sisa 3 — segera habis" is the most urgent line on the page and was
        // the least readable thing on it. Found by computing the palette, not by re-running the audit.
        if (stock <= 0) { stockEl.textContent = "Stok habis untuk varian ini"; stockEl.className = "mt-2 text-sm font-medium text-red-700"; }
        else if (stock <= 5) { stockEl.textContent = "Sisa " + stock + " — segera habis"; stockEl.className = "mt-2 text-sm font-medium text-amber-700"; }
        else { stockEl.textContent = "Stok tersedia (" + stock + ")"; stockEl.className = "mt-2 text-sm text-emerald-700"; }
      }
      var out = stock <= 0;
      [addBtn, buyBtn].forEach(function (b) {
        if (!b) return;
        b.disabled = out;
        b.classList.toggle("opacity-50", out);
        b.classList.toggle("cursor-not-allowed", out);
        b.dataset.price = eff;
        b.dataset.variant = variantLabel();
        // The EXACT item id for the variant now selected. The picker pre-selects the first value of
        // every option group and this runs at load, so a specific variant is always resolved — the
        // "shopper has not chosen yet" case simply does not exist on this page.
        if (v.catalogId) { b.dataset.catalogId = v.catalogId; b.dataset.catalogType = "product"; }
      });
    }
    if (picker) updateVariant();

    var qty = 1;
    var qtyVal = document.getElementById("qty-val");
    // Mirror the stepper onto the buy buttons. The marketing pixel reads it from the clicked button, so
    // an AddToCart for 3 pieces reports 3 — it used to always report 1, which understates the event's
    // value to every ad platform.
    function publishQty() {
      [addBtn, buyBtn].forEach(function (b) { if (b) b.dataset.qty = String(qty); });
    }
    publishQty();
    document.getElementById("qty-dec")?.addEventListener("click", function () {
      qty = Math.max(1, qty - 1);
      if (qtyVal) qtyVal.textContent = String(qty);
      publishQty();
    });
    document.getElementById("qty-inc")?.addEventListener("click", function () {
      qty = Math.min(99, qty + 1);
      if (qtyVal) qtyVal.textContent = String(qty);
      publishQty();
    });

    function addToCart(d, go) {
      var cart = [];
      try { cart = JSON.parse(localStorage.getItem("cart") || "[]"); } catch (e) { cart = []; }
      // `d.variant` is written by `updateVariant()` and is a REAL `product_variants.title` ("Hitam / L").
      // Empty when the product has no option groups — and empty is the right answer, not a gap to fill:
      // `/api/public/order` reads an unnamed line as "take the position-0 variant", which for a product
      // with one `Default` variant is the only thing it could ever have meant. The old
      // `|| selectedSize` filled it with a legacy SIZE string the database has never heard of; see the
      // note above the picker markup.
      var variant = d.variant || "";
      var existing = cart.find(function (i) { return i.handle === d.handle && (i.variant || i.size || "") === variant; });
      if (existing) { existing.qty += qty; }
      // `catalogId` rides along so InitiateCheckout can report real catalog ids (ADR 0013) — the cart's
      // handle is not one under the number scheme. Carts already in a shopper's localStorage have no
      // such field; the pixel falls back to sending no ids rather than a value that matches nothing.
      else { cart.push({ handle: d.handle, catalogId: d.catalogId || "", catalogType: d.catalogType || "product", name: d.name, price: Number(d.price), image: d.image, variant: variant, size: variant, qty: qty }); }
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
      if (go) { window.location.href = "/checkout"; return; }
      var toast = document.getElementById("cart-toast");
      if (toast) {
        toast.classList.remove("hidden");
        clearTimeout(toast._t);
        toast._t = setTimeout(function () { toast.classList.add("hidden"); }, 4000);
      }
    }

    // ---- description: clamp to three lines only when it is longer -------------------------------
    var desc = document.querySelector("[data-desc]");
    var descBtn = document.querySelector("[data-desc-toggle]");
    var descPad = document.querySelector("[data-desc-pad]");
    if (desc && descBtn) {
      var line = parseFloat(getComputedStyle(desc).lineHeight) || 26;
      if (desc.scrollHeight > line * 3 + 4) {
        desc.classList.add("is-clamped");
        descBtn.hidden = false;
        if (descPad) descPad.hidden = true;
        descBtn.addEventListener("click", function () {
          var open = desc.classList.toggle("is-clamped") === false;
          descBtn.setAttribute("aria-expanded", open ? "true" : "false");
          descBtn.textContent = open ? "Lebih sedikit" : "Selengkapnya";
        });
      }
    }

    // ---- all reviews: native modal <dialog> (focus trap, Esc, inert page) + star chips ---------
    var rvDialog = document.querySelector("[data-reviews-dialog]");
    var rvOpen = document.querySelector("[data-reviews-open]");
    if (rvDialog && rvOpen && rvDialog.showModal) {
      rvOpen.addEventListener("click", function () { rvDialog.showModal(); });
      rvDialog.querySelectorAll("[data-reviews-close]").forEach(function (b) { b.addEventListener("click", function () { rvDialog.close(); }); });
      rvDialog.addEventListener("click", function (e) { if (e.target === rvDialog) rvDialog.close(); }); // backdrop
      var rvList = rvDialog.querySelector("[data-reviews-list]");
      rvDialog.querySelectorAll("[data-review-filter]").forEach(function (chip) {
        chip.addEventListener("click", function () {
          var want = chip.getAttribute("data-review-filter");
          rvDialog.querySelectorAll("[data-review-filter]").forEach(function (c) { c.setAttribute("aria-pressed", c === chip ? "true" : "false"); });
          rvList.querySelectorAll("li[data-rating]").forEach(function (li) { li.hidden = want !== "all" && li.getAttribute("data-rating") !== want; });
          rvList.scrollTop = 0;
        });
      });
    }

    // ---- phone gallery strip: dots follow the swipe -------------------------------------------
    var strip = document.getElementById("gallery-strip");
    var dotsWrap = document.getElementById("gallery-dots");
    if (strip && dotsWrap) {
      var dots = dotsWrap.querySelectorAll("[data-dot]");
      var lastDot = 0;
      strip.addEventListener("scroll", function () {
        var i = Math.round(strip.scrollLeft / Math.max(1, strip.clientWidth));
        if (i === lastDot || !dots[i]) return;
        dots[lastDot].classList.replace("bg-ink", "bg-ink/25");
        dots[i].classList.replace("bg-ink/25", "bg-ink");
        lastDot = i;
      }, { passive: true });
    }

    // ---- sticky buy bar (phones): show once #buy-actions has scrolled ABOVE the viewport ------
    var bar = document.getElementById("sticky-buy");
    var actions = document.getElementById("buy-actions");
    if (bar && actions && "IntersectionObserver" in window) {
      var stickyPrice = document.getElementById("sticky-price");
      var proxies = bar.querySelectorAll("[data-proxy]");
      var syncBar = function () {
        if (stickyPrice && priceEl) stickyPrice.textContent = priceEl.textContent;
        proxies.forEach(function (p) {
          var target = document.getElementById(p.getAttribute("data-proxy"));
          p.disabled = !target || target.disabled;
        });
      };
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        var past = !e.isIntersecting && e.boundingClientRect.top < 0;
        if (past) { syncBar(); bar.setAttribute("data-show", ""); bar.removeAttribute("inert"); }
        else { bar.removeAttribute("data-show"); bar.setAttribute("inert", ""); }
      }).observe(actions);
      proxies.forEach(function (p) {
        p.addEventListener("click", function () {
          var target = document.getElementById(p.getAttribute("data-proxy"));
          if (target && !target.disabled) target.click();
        });
      });
      // The variant picker re-prices and re-enables the real buttons; keep the bar in step.
      if (buyBtn) new MutationObserver(syncBar).observe(buyBtn, { attributes: true, attributeFilter: ["disabled"] });
      if (priceEl) new MutationObserver(syncBar).observe(priceEl, { childList: true, characterData: true, subtree: true });
    }
    addBtn?.addEventListener("click", function () { if (addBtn.disabled) return; addToCart(addBtn.dataset, false); });
    buyBtn?.addEventListener("click", function () { if (buyBtn.disabled) return; addToCart(buyBtn.dataset, true); });
  })();
</script>
