---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { IDR } from "@indostore/lib/format";
import { PRODUCTS, STORE, byCollection, productImages, type Product } from "../../data/catalog";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const related = byCollection(product.categoryHandle)
  .filter((p) => p.handle !== product.handle)
  .slice(0, 4);

const discount =
  product.compareAt && product.compareAt > product.price
    ? Math.round(((product.compareAt - product.price) / product.compareAt) * 100)
    : 0;

const gallery = productImages(product);
---

<Layout title={product.name} description={product.description}>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2">
      <!-- Gallery -->
      <div class="flex flex-col gap-4 sm:flex-row-reverse">
        <!-- Main image -->
        <div class="relative aspect-[3/4] flex-1 overflow-hidden rounded-xl bg-brand-50 ring-1 ring-line">
          <img
            id="gallery-main"
            src={gallery[0]}
            alt={product.name}
            class="h-full w-full object-cover transition-opacity duration-200"
          />
          {
            product.badge && (
              <span class="absolute left-4 top-4 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
                {product.badge}
              </span>
            )
          }
        </div>

        <!-- Thumbnails -->
        <div
          id="gallery-thumbs"
          class="flex gap-3 overflow-x-auto pb-1 sm:w-20 sm:flex-col sm:overflow-visible sm:pb-0"
        >
          {
            gallery.map((src, i) => (
              <button
                type="button"
                data-thumb={i}
                data-src={src}
                aria-label={`Gambar ${i + 1}`}
                aria-pressed={i === 0 ? "true" : "false"}
                class:list={[
                  "gallery-thumb relative aspect-[3/4] w-16 shrink-0 overflow-hidden rounded-lg bg-brand-50 ring-2 transition-all sm:w-full",
                  i === 0 ? "ring-brand-600" : "ring-transparent hover:ring-brand-300",
                ]}
              >
                <img src={src} alt={`${product.name} — tampilan ${i + 1}`} class="h-full w-full object-cover" loading="lazy" />
              </button>
            ))
          }
        </div>
      </div>

      <!-- Info -->
      <div class="md:sticky md:top-24 md:self-start">
        <nav class="text-sm text-muted">
          <a href="/" class="hover:text-brand-600">Beranda</a>
          <span class="mx-1">/</span>
          <a href={`/kategori/${product.categoryHandle}`} class="hover:text-brand-600">{product.category}</a>
        </nav>

        <h1 class="mt-3 font-display text-3xl font-semibold leading-tight text-ink">{product.name}</h1>

        <div class="mt-4 flex items-center gap-3">
          <span class="text-2xl font-semibold text-ink tabular-nums">{IDR(product.price)}</span>
          {
            product.compareAt && (
              <span class="text-lg text-muted line-through tabular-nums">{IDR(product.compareAt)}</span>
            )
          }
          {
            discount > 0 && (
              <span class="rounded-full bg-brand-100 px-2 py-0.5 text-xs font-semibold text-brand-700">
                -{discount}%
              </span>
            )
          }
        </div>

        <p class="mt-5 leading-relaxed text-muted">{product.description}</p>

        <!-- Size selector -->
        <div class="mt-8">
          <p class="text-sm font-medium text-ink">Ukuran</p>
          <div id="size-options" class="mt-3 flex flex-wrap gap-2">
            {
              product.sizes.map((s, i) => (
                <button
                  type="button"
                  data-size={s}
                  class:list={[
                    "size-btn rounded-lg border px-4 py-2 text-sm font-medium transition-colors",
                    i === 0
                      ? "border-brand-600 bg-brand-600 text-white"
                      : "border-line bg-white text-ink hover:border-brand-400",
                  ]}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {s}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Quantity -->
        <div class="mt-6">
          <p class="text-sm font-medium text-ink">Jumlah</p>
          <div class="mt-3 inline-flex items-center rounded-lg border border-line bg-white">
            <button type="button" id="qty-dec" class="px-4 py-2 text-lg text-muted hover:text-ink" aria-label="Kurangi">−</button>
            <span id="qty-val" class="w-10 text-center text-sm font-medium tabular-nums">1</span>
            <button type="button" id="qty-inc" class="px-4 py-2 text-lg text-muted hover:text-ink" aria-label="Tambah">+</button>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            id="add-to-cart"
            data-handle={product.handle}
            data-name={product.name}
            data-price={product.price}
            data-image={product.image}
            class="flex-1 rounded-full bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-colors hover:bg-brand-700"
          >
            Tambah ke Keranjang
          </button>
          <button
            type="button"
            id="buy-now"
            data-handle={product.handle}
            data-name={product.name}
            data-price={product.price}
            data-image={product.image}
            class="flex-1 rounded-full border border-brand-600 px-6 py-3.5 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
          >
            Beli Sekarang
          </button>
        </div>

        <p id="cart-toast" class="mt-4 hidden rounded-lg bg-brand-50 px-4 py-3 text-sm font-medium text-brand-700">
          ✓ Ditambahkan ke keranjang.
          <a href="/keranjang" class="ml-1 underline">Lihat keranjang</a>
        </p>
      </div>
    </div>

    <!-- Related -->
    {
      related.length > 0 && (
        <div class="mt-20">
          <h2 class="font-display text-2xl font-semibold text-ink">Kamu mungkin suka</h2>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</Layout>

<script is:inline>
  (function () {
    // Gallery
    var main = document.getElementById("gallery-main");
    var thumbs = document.getElementById("gallery-thumbs");
    if (main && thumbs) {
      thumbs.addEventListener("click", function (e) {
        var btn = e.target.closest(".gallery-thumb");
        if (!btn) return;
        main.style.opacity = "0";
        var src = btn.getAttribute("data-src");
        setTimeout(function () {
          main.src = src;
          main.style.opacity = "1";
        }, 120);
        thumbs.querySelectorAll(".gallery-thumb").forEach(function (b) {
          b.classList.remove("ring-brand-600");
          b.classList.add("ring-transparent", "hover:ring-brand-300");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("ring-brand-600");
        btn.classList.remove("ring-transparent", "hover:ring-brand-300");
        btn.setAttribute("aria-pressed", "true");
      });
    }

    var selectedSize =
      (document.querySelector(".size-btn[aria-pressed='true']") || {}).dataset?.size || null;

    var sizeWrap = document.getElementById("size-options");
    if (sizeWrap) {
      sizeWrap.addEventListener("click", function (e) {
        var btn = e.target.closest(".size-btn");
        if (!btn) return;
        sizeWrap.querySelectorAll(".size-btn").forEach(function (b) {
          b.classList.remove("border-brand-600", "bg-brand-600", "text-white");
          b.classList.add("border-line", "bg-white", "text-ink", "hover:border-brand-400");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("border-brand-600", "bg-brand-600", "text-white");
        btn.classList.remove("border-line", "bg-white", "text-ink", "hover:border-brand-400");
        btn.setAttribute("aria-pressed", "true");
        selectedSize = btn.dataset.size;
      });
    }

    var qty = 1;
    var qtyVal = document.getElementById("qty-val");
    document.getElementById("qty-dec")?.addEventListener("click", function () {
      qty = Math.max(1, qty - 1);
      if (qtyVal) qtyVal.textContent = String(qty);
    });
    document.getElementById("qty-inc")?.addEventListener("click", function () {
      qty = Math.min(99, qty + 1);
      if (qtyVal) qtyVal.textContent = String(qty);
    });

    var addBtn = document.getElementById("add-to-cart");
    addBtn?.addEventListener("click", function () {
      var d = addBtn.dataset;
      var cart = [];
      try {
        cart = JSON.parse(localStorage.getItem("cart") || "[]");
      } catch (e) {
        cart = [];
      }
      var size = selectedSize || "";
      var existing = cart.find(function (i) {
        return i.handle === d.handle && i.size === size;
      });
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({
          handle: d.handle,
          name: d.name,
          price: Number(d.price),
          image: d.image,
          size: size,
          qty: qty,
        });
      }
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));

      var toast = document.getElementById("cart-toast");
      if (toast) {
        toast.classList.remove("hidden");
        clearTimeout(toast._t);
        toast._t = setTimeout(function () {
          toast.classList.add("hidden");
        }, 4000);
      }
    });

    var buyBtn = document.getElementById("buy-now");
    buyBtn?.addEventListener("click", function () {
      var d = buyBtn.dataset;
      var cart = [];
      try { cart = JSON.parse(localStorage.getItem("cart") || "[]"); } catch (e) { cart = []; }
      var size = selectedSize || "";
      var existing = cart.find(function (i) { return i.handle === d.handle && i.size === size; });
      if (existing) { existing.qty += qty; }
      else { cart.push({ handle: d.handle, name: d.name, price: Number(d.price), image: d.image, size: size, qty: qty }); }
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart:updated"));
      window.location.href = "/checkout";
    });
  })();
</script>
