---
// /produk — THE product listing. It did not exist: only `produk/[handle].astro` did, so a shopper who
// truncated a PDP URL (people do this constantly — it is how you get "up a level") and any nav or
// footer link labelled "Produk" landed on a 404.
//
// The catalogue was reachable only at `/kategori/semua`, a VIRTUAL collection: a list of EVERY
// product served from a URL that says "this is one category". That is bad IA (there is no such
// category; the merchant cannot see it, edit it or delete it) and bad SEO (the store's single most
// important listing page ranks under a path that describes it wrongly, and it competes with the real
// categories that sit beside it).
//
// `/kategori/semua` now **301s here**. It shipped as `noindex,follow` for one commit — the cautious
// call, and the weaker one: noindex stops a URL being indexed but ABANDONS the authority it already
// earned, while a 301 hands that authority to its successor. What made the 301 unsafe at first was
// that `/kategori/semua` rendered the merchant's default CATEGORY TEMPLATE and this page did not, so
// redirecting would have silently swapped a merchant's designed layout for a plain grid. This page
// now resolves the same `categoryTemplate("semua")`, so the two render identically and the redirect
// costs nothing. Merchant-built menu items pointing at the old URL keep working.
// One list, one canonical URL, and the equity follows it.
//
// The listing itself is components/ProductListing.astro, the exact component /kategori/[handle]
// renders: same grid, same sort control, same empty state. Forking it was the thing to avoid.
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProductListing from "../../components/ProductListing.astro";
import CategoryNav from "../../components/sections/CategoryNav.astro";
import SectionRenderer from "../../components/sections/SectionRenderer.astro";
import { breadcrumbLd, ldScript, type Crumb } from "../../lib/breadcrumb";

// SSR: tenant from the Host header (src/middleware.ts) — never a query param.
const { store, catalog } = Astro.locals;
const products = catalog.products;

// ADR 0009 — this page honours the merchant's DEFAULT CATEGORY template, exactly as
// `/kategori/semua` did. That is not a nicety, it is what makes the 301 below safe: a merchant who
// designed a category layout would otherwise have watched it disappear the moment their "Semua
// Produk" link started redirecting here. Resolved through the same `categoryTemplate("semua")` path,
// so the two routes cannot drift into rendering the store differently.
const TEMPLATE = catalog.categoryTemplate("semua");

const CRUMBS: Crumb[] = [
  { name: "Beranda", href: "/" },
  { name: "Produk" },
];
const HEAD = ldScript(breadcrumbLd(CRUMBS, Astro.locals.origin));

// Built from the merchant's own data, never from the demo's vertical: the store name, the real
// product count, and their real category names. Layout clamps to 155 chars on a word boundary.
const catNames = catalog.collections.map((c) => c.name).filter(Boolean);
const categoryCount = catalog.collections.length;
const DESCRIPTION = [
  `Semua produk ${store.name}`,
  products.length ? `${products.length} produk siap kirim.` : null,
  catNames.length ? `Kategori: ${catNames.slice(0, 4).join(", ")}.` : null,
]
  .filter(Boolean)
  .join(" — ")
  .replace(/—\s*$/, "")
  .trim();
---

<Layout head={HEAD} title="Semua Produk" description={DESCRIPTION}>
  <PageHeader
    crumbs={CRUMBS}
    eyebrow="Katalog"
    title="Semua Produk"
    dek={`Seluruh koleksi ${store.name}, kirim ke seluruh Indonesia.`}
  >
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="inline-flex min-h-10 items-center rounded-full border border-line bg-white/75 px-4 text-sm font-medium text-ink backdrop-blur">
        {products.length} produk tersedia
      </span>
      <span class="inline-flex min-h-10 items-center rounded-full border border-line bg-white/60 px-4 text-sm text-muted backdrop-blur">
        {categoryCount} kategori aktif
      </span>
      <span class="inline-flex min-h-10 items-center rounded-full border border-brand-200 bg-brand-50 px-4 text-sm text-brand-700">
        12 produk per halaman
      </span>
    </div>
  </PageHeader>

  <CategoryNav items={[]} />

  {
    TEMPLATE ? (
      <SectionRenderer
        data={TEMPLATE}
        context={{ kind: "category", collectionHandle: "semua", collectionName: "Semua Produk" }}
      />
    ) : (
      <ProductListing
        products={products}
        emptyText="Katalog belum diisi. Cek lagi sebentar lagi, ya."
      />
    )
  }
</Layout>
