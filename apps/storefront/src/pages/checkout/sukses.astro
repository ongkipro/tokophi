---
import Layout from "../../layouts/Layout.astro";
const store = Astro.locals.store;
---

<Layout title="Pesanan Berhasil" description={`Terima kasih telah berbelanja di ${store.name}.`}>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <div class="rounded-2xl border border-line bg-white p-6 text-center sm:p-10">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-100">
        <svg viewBox="0 0 24 24" class="h-9 w-9 fill-none stroke-brand-600" stroke-width="2.5" aria-hidden="true">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h1 class="mt-5 font-display text-3xl font-semibold text-ink">Terima kasih! Pesanan kamu diterima</h1>
      <p class="mt-2 text-muted">
        Kami sudah menerima pesananmu. Detail konfirmasi akan dikirim ke emailmu.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">
        No. Pesanan: <span id="order-number" class="font-semibold tabular-nums">—</span>
      </p>
    </div>

    <!-- Payment instruction (VA / QRIS / e-wallet) -->
    <div id="pay-instruction" class="mt-6 hidden"></div>

    <!-- Order summary -->
    <div id="order-summary" class="mt-6"></div>

    <div id="order-note" class="mt-6 hidden rounded-2xl border border-line bg-white p-5 text-sm sm:p-6"></div>

    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-block rounded-full bg-brand-600 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-200/50 transition-colors hover:bg-brand-700"
      >
        Lanjut Belanja
      </a>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var idr = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    });

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    // Clear the cart on arrival at success.
    try {
      localStorage.removeItem("cart");
    } catch (e) {}
    window.dispatchEvent(new Event("cart:updated"));

    // Generate a client-side order number.
    var num =
      "INV-" +
      new Date().getFullYear() +
      "-" +
      String(Math.floor(1000 + Math.random() * 9000));
    var numEl = document.getElementById("order-number");
    if (numEl) numEl.textContent = num;

    var order = null;
    try {
      order = JSON.parse(localStorage.getItem("lastOrder") || "null");
    } catch (e) {
      order = null;
    }

    // Prefer the real DB order number (WEB-…) over the client-side placeholder.
    if (order && order.number && numEl) numEl.textContent = order.number;

    var summary = document.getElementById("order-summary");
    if (!order || !order.items || !order.items.length) {
      if (summary) {
        summary.innerHTML =
          '<div class="rounded-2xl border border-line bg-white p-6 text-center text-muted">Detail pesanan tidak tersedia.</div>';
      }
      return;
    }

    var rows = order.items
      .map(function (item) {
        var sub = item.price * item.qty;
        return (
          '<div class="flex items-center gap-3 border-b border-line py-3 last:border-0">' +
          '<div class="relative shrink-0">' +
          '<img src="' + esc(item.image) + '" alt="' + esc(item.name) + '" class="h-16 w-14 rounded-lg object-cover bg-brand-50" loading="lazy" />' +
          '<span class="absolute -right-2 -top-2 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-ink px-1 text-xs font-semibold text-cream">' + item.qty + "</span>" +
          "</div>" +
          '<div class="min-w-0 flex-1">' +
          '<p class="truncate text-sm font-medium text-ink">' + esc(item.name) + "</p>" +
          (item.size ? '<p class="text-xs text-muted">Ukuran: ' + esc(item.size) + "</p>" : "") +
          "</div>" +
          '<span class="text-sm font-medium text-ink tabular-nums">' + idr.format(sub) + "</span>" +
          "</div>"
        );
      })
      .join("");

    var shipPrice = order.shipping ? order.shipping.price || 0 : 0;

    summary.innerHTML =
      '<div class="rounded-2xl border border-line bg-white p-5 sm:p-6">' +
      '<h2 class="font-display text-lg font-semibold text-ink">Ringkasan Pesanan</h2>' +
      '<div class="mt-4">' + rows + "</div>" +
      '<div class="mt-4 space-y-2 border-t border-line pt-4 text-sm">' +
      '<div class="flex items-center justify-between"><span class="text-muted">Subtotal</span><span class="font-medium text-ink tabular-nums">' + idr.format(order.subtotal || 0) + "</span></div>" +
      '<div class="flex items-center justify-between"><span class="text-muted">Ongkir</span><span class="font-medium text-ink tabular-nums">' + idr.format(shipPrice) + "</span></div>" +
      "</div>" +
      '<div class="mt-4 flex items-center justify-between border-t border-line pt-4">' +
      '<span class="text-base font-medium text-ink">Total</span>' +
      '<span class="font-display text-2xl font-semibold text-ink tabular-nums">' + idr.format(order.total || 0) + "</span>" +
      "</div>" +
      "</div>";

    var pay = order.payment && order.payment.instruction ? order.payment.instruction : null;
    var payBox = document.getElementById("pay-instruction");
    if (pay && payBox) {
      var lines = "";
      if (pay.virtualAccount) lines += '<div class="flex items-center justify-between gap-3"><span class="text-muted">Nomor Virtual Account</span><span class="font-mono text-lg font-bold tracking-wide text-ink">' + esc(pay.virtualAccount) + "</span></div>";
      if (pay.qr) lines += '<div><p class="mb-1 text-muted">Kode QRIS</p><p class="break-all rounded-lg bg-brand-50 p-2 font-mono text-xs text-ink">' + esc(pay.qr) + "</p></div>";
      if (pay.paymentCode) lines += '<div class="flex items-center justify-between gap-3"><span class="text-muted">Kode Pembayaran</span><span class="font-mono font-bold text-ink">' + esc(pay.paymentCode) + "</span></div>";
      if (pay.url) lines += '<a href="' + esc(pay.url) + '" class="inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Buka aplikasi pembayaran</a>';
      payBox.classList.remove("hidden");
      payBox.innerHTML =
        '<div class="rounded-2xl border-2 border-brand-600 bg-white p-5 sm:p-6">' +
        '<h2 class="font-display text-lg font-semibold text-ink">Selesaikan Pembayaran' + (pay.channel ? " — " + esc(pay.channel.label) : "") + "</h2>" +
        '<p class="mt-1 text-xs text-muted">Bayar sebelum kedaluwarsa. Pesanan otomatis terkonfirmasi setelah pembayaran diterima.</p>' +
        '<div class="mt-4 space-y-3 text-sm">' + lines +
        '<div class="flex items-center justify-between border-t border-line pt-3"><span class="text-muted">Total bayar</span><span class="font-display text-xl font-bold text-ink tabular-nums">' + idr.format(pay.total || order.total || 0) + "</span></div>" +
        "</div></div>";
    }

    var noteEl = document.getElementById("order-note");
    if (noteEl) {
      var addr = order.shippingAddress || {};
      var addrLine = [addr.alamat, addr.kota, addr.provinsi, addr.kodepos]
        .filter(Boolean)
        .join(", ");
      noteEl.classList.remove("hidden");
      noteEl.innerHTML =
        '<div class="grid gap-4 sm:grid-cols-2">' +
        '<div><p class="text-xs font-semibold uppercase tracking-wide text-muted">Pembayaran</p>' +
        '<p class="mt-1 text-ink">' + esc(order.payment ? order.payment.label : "—") + "</p>" +
        '<p class="mt-1 text-xs text-muted">Instruksi pembayaran dikirim ke email — disediakan TokoΦ.</p></div>' +
        '<div><p class="text-xs font-semibold uppercase tracking-wide text-muted">Pengiriman</p>' +
        '<p class="mt-1 text-ink">' + esc(order.shipping ? order.shipping.label : "—") + "</p>" +
        '<p class="mt-1 text-xs text-muted">' + esc(addr.nama || "") + (addrLine ? " — " + esc(addrLine) : "") + "</p></div>" +
        "</div>";
    }
  })();
</script>
