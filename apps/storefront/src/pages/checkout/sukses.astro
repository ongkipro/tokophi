---
// CheckoutLayout, not Layout: this is the last screen of the tunnel, and for a VA/QRIS order the
// payment has NOT happened yet — the instruction (the VA number, the QR) is on this very page. A mega
// menu here invites the shopper to browse away from a number they still have to act on.
// The one exit is deliberate and earned: the "Lanjut Belanja" button at the bottom.
import CheckoutLayout from "../../layouts/CheckoutLayout.astro";
const store = Astro.locals.store;
---

<CheckoutLayout title="Pesanan Berhasil" description={`Terima kasih telah berbelanja di ${store.name}.`}>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <!-- Both states of this page are rendered here and one is hidden on arrival. This page is
         reachable by simply typing the URL (and by a refresh long after the order), so it must NOT
         assert "pesanan diterima" unless there is actually an order in localStorage to show. -->
    <div class="rounded-lg border border-[var(--co-line)] bg-white p-6 text-center sm:p-10">
      <div id="ok-icon" class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[var(--co-accent-weak)]">
        <svg viewBox="0 0 24 24" class="h-9 w-9 fill-none stroke-[var(--co-accent)]" stroke-width="2.5" aria-hidden="true">
          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h1 id="ok-title" class="mt-5 text-3xl font-semibold text-ink">Terima kasih! Pesanan kamu diterima</h1>
      <!-- No email is sent (the platform has no mailer): the payment instruction is on THIS page,
           and the order number is what identifies the order to the merchant. Promising an email
           that never arrives is how a paid-for order turns into a support ticket. -->
      <p id="ok-sub" class="mt-2 text-[var(--co-muted)]">
        Simpan nomor pesanan di bawah — sebutkan saat menghubungi {store.name}.
      </p>
      <!-- The order number comes from the order API (`orders.number`, e.g. WEB-…). If it is not
           there, the row is HIDDEN. It is never invented — a made-up "INV-2026-4112" is a number
           that exists in no system, and the shopper would quote it to a merchant who cannot find it. -->
      <p id="order-number-row" class="mt-4 hidden items-center gap-2 rounded-full bg-[var(--co-accent-weak)] px-4 py-1.5 text-sm font-medium text-[var(--co-accent-hover)]">
        No. Pesanan: <span id="order-number" class="font-semibold tabular-nums"></span>
      </p>
    </div>

    <!-- Payment instruction (VA / QRIS / e-wallet) -->
    <div id="pay-instruction" class="mt-6 hidden"></div>

    <!-- Order summary -->
    <div id="order-summary" class="mt-6"></div>

    <div id="order-note" class="mt-6 hidden rounded-lg border border-[var(--co-line)] bg-white p-5 text-sm sm:p-6"></div>

    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-block rounded-lg bg-[var(--co-accent)] px-8 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--co-accent-hover)]"
      >
        Lanjut Belanja
      </a>
    </div>
  </section>
</CheckoutLayout>

<script is:inline>
  (function () {
    var idr = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    });

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    // Clear the cart on arrival at success.
    try {
      localStorage.removeItem("cart");
    } catch (e) {}
    window.dispatchEvent(new Event("cart:updated"));

    var numEl = document.getElementById("order-number");
    var numRow = document.getElementById("order-number-row");

    var order = null;
    try {
      order = JSON.parse(localStorage.getItem("lastOrder") || "null");
    } catch (e) {
      order = null;
    }

    var summary = document.getElementById("order-summary");

    // No order on this device → this is somebody who typed the URL, or refreshed on a new machine.
    // Say that, instead of congratulating them on a purchase we have no evidence of.
    if (!order || !order.items || !order.items.length) {
      var icon = document.getElementById("ok-icon");
      var title = document.getElementById("ok-title");
      var sub = document.getElementById("ok-sub");
      if (icon) icon.classList.add("hidden");
      if (title) title.textContent = "Tidak ada pesanan untuk ditampilkan";
      if (sub) {
        sub.textContent =
          "Detail pesanan tidak tersimpan di perangkat ini. Kalau kamu baru saja memesan, nomor pesanan ada di halaman yang terbuka setelah checkout.";
      }
      if (summary) {
        summary.innerHTML =
          '<div class="rounded-lg border border-[var(--co-line)] bg-white p-6 text-center text-[var(--co-muted)]">' +
          'Belum ada pesanan. <a href="/keranjang" class="text-[var(--co-accent)] underline">Lihat keranjang</a>.' +
          "</div>";
      }
      return;
    }

    // The REAL order number (orders.number from /api/public/order) or nothing at all.
    if (order.number && numEl && numRow) {
      numEl.textContent = order.number;
      numRow.classList.remove("hidden");
      numRow.classList.add("inline-flex");
    }

    var rows = order.items
      .map(function (item) {
        var sub = item.price * item.qty;
        return (
          '<div class="flex items-center gap-3 border-b border-[var(--co-line)] py-3 last:border-0">' +
          '<div class="relative shrink-0">' +
          '<img src="' + esc(item.image) + '" alt="' + esc(item.name) + '" class="h-16 w-14 rounded-lg object-cover bg-[var(--co-accent-weak)]" loading="lazy" />' +
          '<span class="absolute -right-2 -top-2 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-ink px-1 text-xs font-semibold text-white">' + item.qty + "</span>" +
          "</div>" +
          '<div class="min-w-0 flex-1">' +
          '<p class="truncate text-sm font-medium text-ink">' + esc(item.name) + "</p>" +
          // A cart line carries a VARIANT ("Dusty Blue / L"), not a size — labelling it "Ukuran"
          // printed the colour as if it were the size. /keranjang and /checkout both say "Varian".
          ((item.variant || item.size) ? '<p class="text-xs text-[var(--co-muted)]">Varian: ' + esc(item.variant || item.size) + "</p>" : "") +
          "</div>" +
          '<span class="text-sm font-medium text-ink tabular-nums">' + idr.format(sub) + "</span>" +
          "</div>"
        );
      })
      .join("");

    var shipPrice = order.shipping ? order.shipping.price || 0 : 0;
    var tax = order.tax || 0;
    // ⚠️ THE DISCOUNT MUST BE ON SCREEN. It was computed by the server, returned as `res.discount`,
    // stored on `order` — and rendered nowhere. So an order with automatic free shipping printed
    // "Subtotal 300.000 · Ongkir 25.000 · Total 300.000" and 25rb simply vanished, with no line to
    // explain it. On the COD panel that missing number is the cash a courier will ask for.
    var disc = order.discount || 0;
    var codFeeBeforeVat = order.codFeeBeforeVat || 0;
    var codFeeVat = order.codFeeVat || 0;
    var codFee = order.codFee || (codFeeBeforeVat + codFeeVat);
    var gatewayFee = order.paymentFee || 0;
    var buyerPayable = order.buyerPayable || order.total || 0;
    var orderBaseTotal = Math.max(0, (order.total || 0) - codFee);
    var taxExclusive = tax > 0 && Math.round((order.subtotal || 0) + shipPrice + tax - disc) === Math.round(orderBaseTotal);

    summary.innerHTML =
      '<div class="rounded-lg border border-[var(--co-line)] bg-white p-5 sm:p-6">' +
      '<h2 class="text-lg font-semibold text-ink">Ringkasan Pesanan</h2>' +
      '<div class="mt-4">' + rows + "</div>" +
      '<div class="mt-4 space-y-2 border-t border-[var(--co-line)] pt-4 text-sm">' +
      '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">Subtotal</span><span class="font-medium text-ink tabular-nums">' + idr.format(order.subtotal || 0) + "</span></div>" +
      '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">Ongkir</span><span class="font-medium text-ink tabular-nums">' + idr.format(shipPrice) + "</span></div>" +
      (disc > 0 ? '<div class="flex items-center justify-between text-emerald-600"><span>Diskon</span><span class="font-medium tabular-nums">−' + idr.format(disc) + "</span></div>" : "") +
      (taxExclusive ? '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">PPN</span><span class="font-medium text-ink tabular-nums">' + idr.format(tax) + "</span></div>" : "") +
      (tax > 0 && !taxExclusive ? '<div class="flex items-center justify-between text-xs"><span class="text-[var(--co-muted)]">Termasuk PPN</span><span class="text-[var(--co-muted)] tabular-nums">' + idr.format(tax) + "</span></div>" : "") +
      (codFeeBeforeVat > 0 ? '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">Biaya COD</span><span class="font-medium text-ink tabular-nums">' + idr.format(codFeeBeforeVat) + "</span></div>" : "") +
      (codFeeVat > 0 ? '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">PPN biaya COD</span><span class="font-medium text-ink tabular-nums">' + idr.format(codFeeVat) + "</span></div>" : "") +
      (gatewayFee > 0 ? '<div class="flex items-center justify-between"><span class="text-[var(--co-muted)]">Biaya pembayaran</span><span class="font-medium text-ink tabular-nums">' + idr.format(gatewayFee) + "</span></div>" : "") +
      "</div>" +
      '<div class="mt-4 flex items-center justify-between border-t border-[var(--co-line)] pt-4">' +
      '<span class="text-base font-medium text-ink">Total dibayar</span>' +
      '<span class="text-2xl font-semibold text-ink tabular-nums">' + idr.format(buyerPayable) + "</span>" +
      "</div>" +
      "</div>";

    // ── THE TWO PATHS ARE GENUINELY DIFFERENT, AND THE PAGE MUST SAY SO ───────────────────────────
    // AutoLaris (VA/QRIS/e-wallet): the money has NOT moved. This page IS the invoice — nothing is
    // emailed (there is no mailer), so the number they must act on is the whole point of the screen.
    // COD: there is no payment step at all. Rendering "Selesaikan Pembayaran" there would invent a
    // task that does not exist; leaving it blank (what it did) tells a shopper holding a Rp393.000
    // order nothing about what to hand the courier.
    var isCod = !!(order.payment && order.payment.id === "cod");
    var pay = order.payment && order.payment.instruction ? order.payment.instruction : null;
    var payBox = document.getElementById("pay-instruction");

    function panel(title, sub, body, tone) {
      return (
        '<div class="overflow-hidden rounded-lg border ' +
        (tone === "accent" ? "border-[var(--co-accent)]" : "border-[var(--co-line)]") +
        ' bg-white">' +
        '<div class="border-b border-[var(--co-line)] px-5 py-4 sm:px-6">' +
        '<h2 class="text-base font-semibold text-ink">' + title + "</h2>" +
        (sub ? '<p class="mt-0.5 text-sm text-[var(--co-muted)]">' + sub + "</p>" : "") +
        "</div>" +
        '<div class="px-5 py-4 sm:px-6">' + body + "</div></div>"
      );
    }
    /** A label/value row — the shape the whole invoice is built from, so it cannot drift line to line. */
    function kv(label, value, mono) {
      return (
        '<div class="flex items-center justify-between gap-3 py-1.5">' +
        '<span class="text-sm text-[var(--co-muted)]">' + label + "</span>" +
        '<span class="' + (mono ? "font-mono text-base font-bold tracking-wide" : "text-sm font-medium") +
        ' text-ink tabular-nums">' + value + "</span></div>"
      );
    }

    if (payBox && isCod) {
      // COD — an invoice, not a payment task. The one thing a COD buyer needs is the exact amount to
      // have in hand when the rider knocks, so that is the biggest thing in the box.
      payBox.classList.remove("hidden");
      payBox.innerHTML = panel(
        "Bayar di Tempat (COD)",
        "Tidak ada pembayaran online untuk pesanan ini.",
        '<p class="text-sm text-[var(--co-muted)]">Siapkan uang tunai sejumlah</p>' +
          '<p class="mt-1 text-3xl font-semibold text-ink tabular-nums">' + idr.format(order.total || 0) + "</p>" +
          '<p class="mt-3 text-sm text-[var(--co-muted)]">Serahkan ke kurir saat paket tiba. ' +
          "Rinciannya ada di bawah.</p>",
        "accent",
      );
    } else if (payBox && pay) {
      var lines = "";
      if (pay.virtualAccount) lines += kv("Nomor Virtual Account", esc(pay.virtualAccount), true);
      if (pay.paymentCode) lines += kv("Kode Pembayaran", esc(pay.paymentCode), true);
      if (pay.qr) {
        var qrImage = typeof pay.qrImage === "string" && pay.qrImage.indexOf("data:image/png;base64,") === 0
          ? '<img src="' + esc(pay.qrImage) + '" alt="Kode QRIS untuk pembayaran pesanan ' + esc(order.number || "") + '" width="320" height="320" class="mx-auto h-auto w-full max-w-[320px] bg-white" />'
          : '<p class="rounded border border-amber-500/30 bg-amber-500/5 p-3 text-sm text-amber-800">Gambar QR tidak tersedia. Salin payload QRIS di bawah ke aplikasi pembayaran.</p>';
        lines +=
          '<div class="py-2"><p class="text-sm font-medium text-ink">Scan QRIS</p>' +
          '<div class="mt-2 rounded-lg bg-white p-4">' + qrImage + "</div>" +
          '<label class="mt-3 block text-xs text-[var(--co-muted)]" for="qris-payload">Payload QRIS (fallback)</label>' +
          '<textarea id="qris-payload" readonly rows="3" class="mt-1 w-full resize-none break-all rounded border border-[var(--co-line)] bg-[var(--co-panel)] p-2 font-mono text-xs text-ink">' +
          esc(pay.qr) + "</textarea>" +
          '<button type="button" data-copy-qr class="mt-2 rounded-lg border border-[var(--co-line)] px-3 py-2 text-xs font-medium text-ink">Salin payload QRIS</button></div>';
      }
      // ⚠️ THE GATEWAY'S ADMIN FEE IS ADDED AFTER THE SHOPPER AGREED TO THE TOTAL, and both numbers
      // sit on this one screen: the summary above says `order.total`, this box says `pay.total`, which
      // is `amount + admin`. A shopper who transfers the number they remember UNDERPAYS the virtual
      // account, no callback ever fires, and the order sits unpaid with nobody able to explain why.
      // Name the fee instead of letting two totals argue silently. (`orders`/`payments` keep the
      // pre-fee amount, which is correct — the fee is the gateway's, not the merchant's revenue.)
      var payTotal = pay.total || buyerPayable;
      var adminFee = Math.max(0, Number(pay.admin ?? gatewayFee));
      lines +=
        '<div class="mt-1 border-t border-[var(--co-line)] pt-3">' +
        (adminFee > 0
          ? kv("Subtotal pesanan", '<span class="tabular-nums">' + idr.format(order.total || 0) + "</span>") +
            kv("Biaya admin", '<span class="tabular-nums">' + idr.format(adminFee) + "</span>")
          : "") +
        kv("Total bayar", '<span class="text-xl font-bold">' + idr.format(payTotal) + "</span>") +
        (adminFee > 0
          ? '<p class="mt-2 text-xs text-[var(--co-muted)]">Transfer <span class="font-medium text-ink">persis</span> sejumlah Total bayar di atas — kurang atau lebih membuat pembayaran tidak terdeteksi otomatis.</p>'
          : "") +
        "</div>";
      if (pay.expiresAt) {
        var expiry = new Date(pay.expiresAt);
        if (!Number.isNaN(expiry.getTime())) {
          lines += '<p class="mt-3 text-xs text-[var(--co-muted)]">Berlaku sampai ' +
            esc(new Intl.DateTimeFormat("id-ID", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Jakarta" }).format(expiry)) +
            " WIB.</p>";
        }
      }
      if (pay.url) {
        lines +=
          '<a href="' + esc(pay.url) +
          '" class="mt-3 block rounded-lg bg-[var(--co-accent)] px-4 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-[var(--co-accent-hover)]">Buka aplikasi pembayaran</a>';
      }
      payBox.classList.remove("hidden");
      payBox.innerHTML = panel(
        "Selesaikan Pembayaran" + (pay.channel ? " — " + esc(pay.channel.label) : ""),
        "Bayar sebelum kedaluwarsa. Pesanan otomatis terkonfirmasi setelah pembayaran diterima.",
        lines,
        "accent",
      );
      var copyQr = payBox.querySelector("[data-copy-qr]");
      if (copyQr) {
        copyQr.addEventListener("click", function () {
          navigator.clipboard.writeText(String(pay.qr || "")).then(function () {
            copyQr.textContent = "Payload tersalin";
          }).catch(function () {
            var payload = document.getElementById("qris-payload");
            if (payload) { payload.focus(); payload.select(); }
          });
        });
      }
    }

    var noteEl = document.getElementById("order-note");
    if (noteEl) {
      var addr = order.shippingAddress || {};
      var addrLine = [addr.alamat, addr.kota, addr.provinsi, addr.kodepos]
        .filter(Boolean)
        .join(", ");
      // What is TRUE about the payment, per case. Nothing is emailed — there is no mailer on the
      // platform — so the old "Instruksi pembayaran dikirim ke email" sent the shopper to an inbox
      // that stays empty while their VA number sits unread on this very page.
      // Neither line repeats the panel above it. COD's panel already states the amount and the
      // hand-over; what it does NOT say is that nothing is owed now — which is the question a shopper
      // stares at a "Pesanan diterima" screen asking.
      var payHint = isCod
        ? "Tidak ada yang perlu dibayar sekarang."
        : pay
          ? "Instruksi pembayaran ada di halaman ini — tidak dikirim lewat email."
          : "";
      noteEl.classList.remove("hidden");
      noteEl.innerHTML =
        '<div class="grid gap-4 sm:grid-cols-2">' +
        '<div><p class="text-xs font-semibold uppercase tracking-wide text-[var(--co-muted)]">Pembayaran</p>' +
        '<p class="mt-1 text-ink">' + esc(order.payment ? order.payment.label : "—") + "</p>" +
        (payHint ? '<p class="mt-1 text-xs text-[var(--co-muted)]">' + esc(payHint) + "</p>" : "") +
        "</div>" +
        '<div><p class="text-xs font-semibold uppercase tracking-wide text-[var(--co-muted)]">Pengiriman</p>' +
        '<p class="mt-1 text-ink">' + esc(order.shipping ? order.shipping.label : "—") + "</p>" +
        '<p class="mt-1 text-xs text-[var(--co-muted)]">' + esc(addr.nama || "") + (addrLine ? " — " + esc(addrLine) : "") + "</p></div>" +
        "</div>";
    }
  })();
</script>
