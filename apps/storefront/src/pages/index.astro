---
// Icons: Lucide, not emoji. Emoji render as full-colour glyphs from the OS font — they ignore the
// brand palette, look different on every device, and read as decoration. A stroked icon inherits
// `currentColor`, so it sits inside the brand scale like everything else.
import { Truck, Banknote, ShieldCheck, QrCode } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SectionRenderer from "../components/sections/SectionRenderer.astro";
import Hero from "../components/sections/Hero.astro";
import { heroSlides, type HeroConfig } from "@tokophi/sections";
import { storeCodEnabled, enabledPaymentChannels, mediaUrl } from "../data/catalog";
import { ldScript } from "../lib/breadcrumb";

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;

// Don't promise COD on a store that has it switched off (store_settings.cod_enabled) — the
// checkout won't offer it and the order API rejects it, so the badge would be a lie.
const COD_ENABLED = await storeCodEnabled(store.id);

// ── THE PAYMENT BADGE IS DERIVED, NOT WRITTEN ────────────────────────────────────────────────────
//
// It read "QRIS & E-Wallet" as a hardcoded string. Every one of the five `kind='ewallet'` rows is
// `enabled=f, active=f` — and `enabledPaymentChannels`'s own comment records the live gateway probe
// that refused them ("rc=07 — DANA, ShopeePay, LinkAja, GoPay"). So the homepage advertised a method
// the platform has MEASURED being refused, while the COD badge two lines above is properly gated on
// real data. It was also silent about Virtual Account, which is 5 of the 6 channels that DO work.
//
// Derived from the same list checkout offers, so the two can never drift apart.
const KIND_LABEL: Record<string, string> = {
  qris: "QRIS",
  va: "Transfer Bank",
  ewallet: "E-Wallet",
  retail: "Gerai Retail",
};
const PAY_KINDS = [...new Set((await enabledPaymentChannels()).map((c) => c.kind))]
  .map((k) => KIND_LABEL[k] ?? null)
  .filter((l): l is string => !!l);
// No live channel ⇒ no claim. The badge falls back to the one thing that is true regardless.
const PAY_BADGE = PAY_KINDS.length
  ? { Icon: QrCode, title: PAY_KINDS.join(" & "), text: "Bayar praktis, tanpa ribet." }
  : { Icon: ShieldCheck, title: "Transaksi Aman", text: "Pembayaran lewat kanal resmi." };
const HOMEPAGE_TEMPLATE = catalog.homepageTemplate;

// `.slice(0, 4)` — bestsellers() now returns the WHOLE catalogue sorted by units_sold, so the
// fallback homepage must say how many of them it wants. One row of four.
const best = catalog.bestsellers().slice(0, 4);

// ── FALLBACK HOMEPAGE — the store has not built one in the Store Builder ─────────────────────────
//
// THE RULE: every word below is either a NEUTRAL PLATFORM VERB or a value the MERCHANT wrote
// (stores.name, stores.tagline). Nothing may be invented on their behalf. This file used to seed the
// hero from `SECTION_DEFAULTS.hero`, which conflated two different jobs:
//   · the BUILDER SEED — placeholder copy a merchant sees after dragging a Hero onto the canvas and
//     is about to edit. Batik-flavoured copy is harmless there.
//   · THIS — what a real SHOPPER sees on a store that never opened the builder.
// Nothing distinguished them, so every store on the platform served Batik Nusantara's homepage
// wearing its own name: "Gadget Murah ID" (electronics, Jakarta) rendered a photo of a woman in
// batik, the headline "Batik Modern untuk Hari-Harimu", a "Lihat Koleksi Dress" button pointing at a
// /kategori/dress it does not have — and a brand story in quote marks SIGNED "Gadget Murah ID —
// Jakarta". That last one is the reason this is a bug and not a matter of taste: we were putting
// words into a real merchant's mouth about a business that is not theirs.
//
// No image on purpose. The merchant has given us no hero photo, and a 600×600 product shot stretched
// across a 42rem full-bleed frame is not a hero — it is a crop of a garment on a backdrop. An empty
// imageUrl now renders the brand-tinted panel (Hero.astro), so the fallback is at least THEIR colour.
const HERO: HeroConfig = {
  slides: [
    {
      imageUrl: "",
      heading: store.name,
      subheading: store.tagline ?? "",
      ctaLabel: "Mulai belanja",
      ctaHref: "/produk", // the real product listing every store always has — never /kategori/dress
      focal: "center",
    },
  ],
  intervalMs: 0, // one slide → no autoplay, no dots (Hero drops the carousel chrome below 2 slides)
  heading: store.name,
  subheading: store.tagline ?? "",
  imageUrl: "",
  ctaLabel: "Mulai belanja",
  ctaHref: "/produk",
  align: "left",
  badge: "", // no invented "Koleksi 2026" — we do not know that they have one
  ratingText: "",
};

const collections = catalog.collections.map((c) => {
  const items = catalog.byCollection(c.handle);
  return { ...c, image: items[0]?.image, count: items.length };
});

// The meta description is the highest-visibility text this store has — it IS the SERP snippet — so it
// must describe THIS store. It used to be hardcoded to the demo's vertical: "Belanja dress, atasan,
// bawahan, busana muslim & outerwear wanita", which a hardware store also shipped to Google.
// Now it is built from the merchant's own words and their own categories:
//   · `tagline` when written. The type says `null` = "Render NOTHING — never a platform default", and
//     this line was interpolating it raw, so a store without one published the literal string
//     **"null"** into its snippet and its WhatsApp preview card.
//   · the store's real category names, which is exactly what the old sentence was faking.
// Layout clamps to 155 on a word boundary, so the list is capped at 4 to leave room for the tagline.
const catNames = collections.filter((c) => c.count > 0).map((c) => c.name);
const SUMMARY = [
  store.tagline?.trim() ? `${store.name} — ${store.tagline.trim()}` : store.name,
  catNames.length ? `Belanja ${catNames.slice(0, 4).join(", ")}.` : null,
  "Kirim ke seluruh Indonesia.",
]
  .filter(Boolean)
  .join(". ")
  .replace(/\.\s*\./g, ".");

// ── Structured data ───────────────────────────────────────────────────────────────────────────────
// The homepage had NONE, while /produk, /blog and the breadcrumb trails all did. It is the page every
// crawler reaches first and the one that carries the shop's identity, so Organization + WebSite belong
// here and nowhere else. Same `ldScript` (which escapes `<`) the product page uses.
const ORIGIN = Astro.locals.origin;
const LOGO = store.logoUrl ? new URL(mediaUrl(store.logoUrl), ORIGIN).href : undefined;
const HEAD = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: store.name,
    url: ORIGIN,
    ...(LOGO ? { logo: LOGO } : {}),
    ...(store.tagline?.trim() ? { description: store.tagline.trim() } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: store.name,
    url: ORIGIN,
    // The storefront's search is `/cari?q=` — VERIFIED against `pages/cari.astro`, which reads exactly
    // that param. Not `/produk?q=`: ProductListing reads `sort` and `page` only, so that URL would
    // silently render the unfiltered catalogue. A SearchAction pointing somewhere that does not search
    // is worse than no SearchAction.
    potentialAction: {
      "@type": "SearchAction",
      target: { "@type": "EntryPoint", urlTemplate: `${ORIGIN}/cari?q={search_term_string}` },
      "query-input": "required name=search_term_string",
    },
  },
].map(ldScript).join("");

// TITLE. `Layout` appends " - <store name>", so this is the LEADING half — it has to be a phrase, not
// a paragraph. It used to be the literal `"Beranda"`, which spent the most valuable characters in
// search results on a word that describes nothing.
//
// ⚠️ `stores.tagline` is unbounded free text and it is NOT a title. It is 30 chars on the dev store
// and **150 on production** ("Batik Nusantara adalah ragam seni lukis kain khas Indonesia yang
// coraknya sangat dipengaruhi oleh budaya, flora, fauna, dan filosofi lokal."), which rendered a
// ~170-character <title> that Google cuts at ~60. So it is used only when it is already title-shaped;
// otherwise a short honest descriptor. Truncating the tagline mid-sentence was the other option and
// it reads worse than not using it — the tagline still carries the full text in the meta description,
// where the length belongs.
const TAGLINE = store.tagline?.trim() ?? "";
const HOME_TITLE = TAGLINE && TAGLINE.length <= 60 ? TAGLINE : "Belanja Online";

// ── THE <h1> FLOOR ───────────────────────────────────────────────────────────────────────────────
//
// `Hero` is the ONLY section in the registry that emits an `<h1>` (checked: every other one starts at
// `<h2>`, and Multicolumn's mention of `<h1>` is a comment). So a merchant who builds a homepage in
// the Store Builder without dragging a Hero onto it ships the shop's most important page with **no
// top-level heading at all** — no document outline for a screen reader to jump into, and nothing for
// a crawler to read as the page's subject.
//
// Same defect `CategoryHero` had, and the same fix in spirit: the category page now ALWAYS renders
// its header, so a template cannot cost the page its `<h1>`. The homepage has no such component to
// always render — the template IS the page — so the floor is a visually-hidden heading instead. It is
// hidden because the merchant designed this page: injecting a visible headline they did not write
// would be us editing their homepage, which is the thing the fallback-hero comment above refuses to do.
//
// ⚠️ "a hero is present" is NOT the condition — "a hero that actually says something" is. The
// predicate goes through `heroSlides()` for two reasons, and both are live shapes:
//   · a hero saved before the carousel keeps its headline in the legacy flat `heading` field, so
//     reading `props.slides` directly would see an empty carousel on a hero that has a heading;
//   · `heroSlides()` deliberately KEEPS a slide that has an `imageUrl` and no heading, so a purely
//     pictorial hero carries no words at all. Keying on `type === "hero"` would suppress the floor
//     for that page and leave the homepage with no heading — exactly the defect this is here for.
// `Hero` emits its `<h1>` on the first slide that has a heading and none when no slide does, i.e.
// on this same predicate — so the two together always produce exactly one, never zero and never two.
const TEMPLATE_HAS_HEADING = !!HOMEPAGE_TEMPLATE?.content.some(
  (s) => s.type === "hero" && heroSlides(s.props).some((sl) => (sl.heading ?? "").trim() !== ""),
);
---

<Layout title={HOME_TITLE} description={SUMMARY} head={HEAD}>
  {
    HOMEPAGE_TEMPLATE ? (
      /* ADR 0009: merchant-built homepage (Store Builder) */
      <Fragment>
        {!TEMPLATE_HAS_HEADING && <h1 class="sr-only">{store.name}</h1>}
        <SectionRenderer data={HOMEPAGE_TEMPLATE} />
      </Fragment>
    ) : (
      <Fragment>
  {/* Hero — the registry section (see components/sections/Hero.astro), seeded with its defaults */}
  <Hero {...HERO} />

  {/* Trust strip: sits DIRECTLY under the hero (it answers the first objection a shopper has —
       "will it reach me, can I pay how I want") instead of being buried near the footer. */}
  <section class="border-y border-line bg-white/60">
    <div class="mx-auto grid max-w-7xl gap-x-8 gap-y-5 px-4 py-7 sm:grid-cols-3 sm:px-6">
      {
        [
          { Icon: Truck, title: "Kirim se-Indonesia", text: "Lewat kurir terpercaya." },
          COD_ENABLED
            ? { Icon: Banknote, title: "COD Tersedia", text: "Bayar di tempat, area terpilih." }
            : { Icon: ShieldCheck, title: "Transaksi Aman", text: "Pembayaran lewat kanal resmi." },
          PAY_BADGE,
        ].map((v) => (
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 ring-1 ring-brand-100">
              <v.Icon class="h-[18px] w-[18px] text-brand-600" stroke-width={1.75} aria-hidden="true" />
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink">{v.title}</p>
              <p class="truncate text-xs text-muted">{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* Categories. RENDERED ONLY IF THERE ARE ANY: a store with no categories used to get the heading
       "Jelajahi Koleksi", the line "Temukan gaya yang paling kamu banget", and then nothing at all —
       a titled, empty room. An empty section is not a section; it is a bug with a headline. */}
  {collections.length > 0 && (
  <section id="koleksi" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20">
    {/* "Kategori", not "Koleksi"/"gaya" — this container serves a coffee roaster and a phone shop
        as well as a fashion label. Say what the links ARE. */}
    <SectionHeading
      align="center"
      eyebrow="Kategori"
      title="Belanja per Kategori"
      dek="Pilih kategori yang kamu cari."
    />
    {/* `lg:grid-cols-4` to match the product grid below it. Without it the category tiles maxed at 3
        columns while the products went to 4, so two adjacent grids rendered at visibly different
        scales — the tiles ballooned to ~440px at desktop. Same max column count = one rhythm. */}
    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14 sm:grid-cols-3 lg:grid-cols-4">
      {
        collections.map((c) => (
          <a
            href={`/kategori/${c.handle}`}
            class="group relative block aspect-[4/5] overflow-hidden rounded-2xl bg-brand-100 ring-1 ring-line transition-all hover:shadow-xl hover:shadow-brand-200/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          >
            {c.image ? (
              <img
                src={c.image}
                alt={c.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center text-5xl">{c.emoji}</span>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/20 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold text-white sm:text-xl">{c.name}</h3>
              <p class="mt-0.5 text-xs text-white/80">{c.count} produk</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
  )}

  {/* DELETED: the "Cerita Kami" brand story — a quote about designing batik for Indonesian women,
      rendered in quote marks and SIGNED "{store.name} — {store.city}". On every store on the
      platform. A brand story is the one thing a platform can never write for a merchant: it is a
      first-person claim about who they are, attributed to them by name, and it was false for six of
      the seven stores in the database. There is no honest neutral version of it either ("we care
      about quality" signed by a real business is still us speaking as them), so it does not come
      back with softer words — it comes back when the merchant WRITES one, as a rich-text section in
      the Store Builder, which already exists. */}

  {/* Bestsellers. Same guard as the categories above — no products, no titled empty room. */}
  {best.length > 0 && (
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex items-end justify-between gap-4">
      {/* Dek is NOT "minggu ini". `bestsellers()` sorts the whole catalog by ALL-TIME units_sold — it
          does not window by date. The registry already carries this exact warning for the Grid Produk
          heading; the fallback homepage was making the claim anyway. Say only what the data does. */}
      <SectionHeading eyebrow="Favorit" title="Paling Dicari" dek="Produk yang paling banyak dibeli." />
      {/* /produk — the real product listing (pages/produk/index.astro), which every tenant resolves.
          This used to point at `/kategori/semua`, a VIRTUAL collection standing in for a listing page
          that did not exist; before that it pointed at `produk-terlaris`, a REAL but demo-only
          collection that 404s on any store lacking that row. "Lihat semua" means all products. */}
      <a
        href="/produk"
        class="hidden shrink-0 text-sm font-medium text-brand-600 transition-colors hover:text-brand-700 sm:block"
      >
        Lihat semua →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14 sm:grid-cols-3 lg:grid-cols-4">
      {best.map((p) => <ProductCard product={p} />)}
    </div>
    <div class="mt-8 text-center sm:hidden">
      <a href="/produk" class="text-sm font-medium text-brand-600 hover:text-brand-700">
        Lihat semua →
      </a>
    </div>
  </section>
  )}

  {/* Closing CTA. Was "Siap tampil anggun setiap hari?" / "temukan busana yang membuatmu percaya
       diri" — an outfit promise on a phone shop. Neutral, and it is the one section that stays even
       on an empty catalogue, because it is the way OUT of a thin page. */}
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
    <SectionHeading
      align="center"
      title={`Belanja di ${store.name}`}
      dek="Lihat seluruh produk yang tersedia, kirim ke seluruh Indonesia."
    >
      <a
        href="/produk"
        class="mt-8 inline-block rounded-full bg-brand-600 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-200/60 transition-all hover:-translate-y-0.5 hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
      >
        Mulai Belanja
      </a>
    </SectionHeading>
  </section>
      </Fragment>
    )
  }
</Layout>
