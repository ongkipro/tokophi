---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionRenderer from "../components/sections/SectionRenderer.astro";
import Hero from "../components/sections/Hero.astro";
import { SECTION_DEFAULTS } from "@tokophi/sections";
import { storeCodEnabled } from "../data/catalog";

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;

// Don't promise COD on a store that has it switched off (store_settings.cod_enabled) — the
// checkout won't offer it and the order API rejects it, so the badge would be a lie.
const COD_ENABLED = await storeCodEnabled(store.id);
const HOMEPAGE_TEMPLATE = catalog.homepageTemplate;

const best = catalog.bestsellers();

// Fallback (non-Store-Builder) homepage: it renders the SAME registry `hero` section the builder
// places, seeded with SECTION_DEFAULTS — so the hero has exactly one implementation and a store
// that has not built a homepage yet still gets the carousel.
const HERO = SECTION_DEFAULTS.hero;

const collections = catalog.collections.map((c) => {
  const items = catalog.byCollection(c.handle);
  return { ...c, image: items[0]?.image, count: items.length };
});
---

<Layout
  title="Beranda"
  description={`${store.name} — ${store.tagline}. Belanja dress, atasan, bawahan, busana muslim & outerwear wanita. Kirim se-Indonesia.`}
>
  {
    HOMEPAGE_TEMPLATE ? (
      <!-- ADR 0009: merchant-built homepage (Store Builder) -->
      <SectionRenderer data={HOMEPAGE_TEMPLATE} />
    ) : (
      <Fragment>
  <!-- Hero — the registry section (see components/sections/Hero.astro), seeded with its defaults -->
  <Hero {...HERO} />

  <!-- Trust strip: sits DIRECTLY under the hero (it answers the first objection a shopper has —
       "will it reach me, can I pay how I want") instead of being buried near the footer. -->
  <section class="border-y border-line bg-white/60">
    <div class="mx-auto grid max-w-7xl gap-x-8 gap-y-5 px-4 py-7 sm:grid-cols-3 sm:px-6">
      {
        [
          { icon: "🚚", title: "Kirim se-Indonesia", text: "Lewat kurir terpercaya." },
          COD_ENABLED
            ? { icon: "💵", title: "COD Tersedia", text: "Bayar di tempat, area terpilih." }
            : { icon: "🔒", title: "Transaksi Aman", text: "Pembayaran lewat kanal resmi." },
          { icon: "📱", title: "QRIS & E-Wallet", text: "Bayar praktis, tanpa ribet." },
        ].map((v) => (
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-base ring-1 ring-brand-100">
              {v.icon}
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-ink">{v.title}</p>
              <p class="truncate text-xs text-muted">{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Collections -->
  <section id="koleksi" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Koleksi</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Jelajahi Koleksi</h2>
      <p class="mt-3 text-muted">Temukan gaya yang paling kamu banget.</p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        collections.map((c) => (
          <a
            href={`/kategori/${c.handle}`}
            class="group relative block aspect-[4/5] overflow-hidden rounded-2xl bg-brand-100 ring-1 ring-line transition-all hover:shadow-xl hover:shadow-brand-200/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          >
            {c.image ? (
              <img
                src={c.image}
                alt={c.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            ) : (
              <span class="flex h-full w-full items-center justify-center text-5xl">{c.emoji}</span>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/20 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
              <h3 class="font-display text-lg font-semibold text-white sm:text-xl">{c.name}</h3>
              <p class="mt-0.5 text-xs text-white/80">{c.count} produk</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Brand story -->
  <section class="bg-ink">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-200">Cerita Kami</p>
      <blockquote class="mt-5 font-display text-2xl font-medium leading-snug text-cream sm:text-3xl">
        “Setiap helai kami rancang untuk perempuan Indonesia — memadukan warisan batik
        dengan siluet masa kini, agar kamu tampil anggun tanpa kehilangan kenyamanan.”
      </blockquote>
      <p class="mt-6 text-sm text-white/70">{store.name} — {store.city}</p>
    </div>
  </section>

  <!-- Bestsellers -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-500">Favorit</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Paling Dicari</h2>
        <p class="mt-2 text-muted">Favorit pelanggan minggu ini.</p>
      </div>
      <a
        href="/kategori/dress"
        class="hidden shrink-0 text-sm font-medium text-brand-600 transition-colors hover:text-brand-700 sm:block"
      >
        Lihat semua →
      </a>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {best.map((p) => <ProductCard product={p} />)}
    </div>
    <div class="mt-8 text-center sm:hidden">
      <a href="/kategori/dress" class="text-sm font-medium text-brand-600 hover:text-brand-700">
        Lihat semua →
      </a>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
      Siap tampil anggun setiap hari?
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-muted">
      Jelajahi koleksi {store.name} dan temukan busana yang membuatmu percaya diri.
    </p>
    <a
      href="/kategori/dress"
      class="mt-8 inline-block rounded-full bg-brand-600 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-200/60 transition-all hover:-translate-y-0.5 hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
    >
      Mulai Belanja
    </a>
  </section>
      </Fragment>
    )
  }
</Layout>
