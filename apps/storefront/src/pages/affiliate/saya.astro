---
// Affiliate self-view (F-A18, Task 9.13, specs/AFFILIATE_SPEC.md). Interim until affiliates sign in with
// the buyer account (F-A15): opened by a signed link the seller copies from the Seller panel. The token
// binds affiliate + store; the store must be the Host's, the affiliate must still be `aktif` — anything
// else is a bare 404 that says nothing about why. No buyer personal data is read or shown.
import { affiliateLinkSecret, verifyAffiliateLink } from "@tokophi/lib/affiliate-link";
import { IDR } from "@tokophi/lib/format";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { getAffiliateDashboard, type DashboardCommissionState } from "../../data/affiliate";

const store = Astro.locals.store;
const secret = affiliateLinkSecret();
const claim = secret ? verifyAffiliateLink(Astro.url.searchParams.get("t") ?? "", secret, Date.now(), store.id) : null;
const dash = claim ? await getAffiliateDashboard(store.id, claim.affiliateId) : null;
const PRIVATE = { "cache-control": "no-store", "referrer-policy": "no-referrer", "x-robots-tag": "noindex, nofollow" };
if (!dash) return new Response(null, { status: 404, statusText: "Not Found", headers: PRIVATE });
for (const [k, v] of Object.entries(PRIVATE)) Astro.response.headers.set(k, v);

const shareLink = `${Astro.locals.origin}/?ref=${dash.code}`;
const day = (d: Date) => new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" }).format(d);
const STATE: Record<DashboardCommissionState, { label: string; cls: string }> = {
  belum_selesai: { label: "Menunggu pesanan selesai", cls: "bg-slate-100 text-slate-700" },
  ditahan: { label: "Ditahan", cls: "bg-amber-50 text-amber-800" },
  siap: { label: "Siap dibayar", cls: "bg-emerald-50 text-emerald-800" },
  dibayar: { label: "Dibayar", cls: "bg-brand-50 text-brand-700" },
  batal: { label: "Batal", cls: "bg-red-50 text-red-700" },
};
const note = (c: (typeof dash.commissions)[number]) =>
  c.state === "ditahan" && c.eligibleAt ? `sampai ${day(c.eligibleAt)}`
  : c.state === "dibayar" && c.paidAt ? day(c.paidAt)
  : "";
---

<Layout title="Dashboard affiliate" description={`Komisi affiliate ${dash.name} di ${store.name}.`} robots="noindex,nofollow" pixels={false}>
  <PageHeader eyebrow={`Affiliate ${store.name}`} title={`Halo, ${dash.name}`} dek="Komisi dari pesanan lewat link dan kode Anda. Dibayar langsung oleh toko setelah pesanan selesai dan lewat masa tahan." />
  <section class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-8 sm:px-6">
    <div class="rounded-xl border border-line bg-white p-4">
      <p class="text-sm text-muted">Kode Anda</p>
      <p class="mt-1 font-mono text-lg font-semibold text-ink">{dash.code}</p>
      <p class="mt-3 text-sm text-muted">Link untuk dibagikan</p>
      <div class="mt-1 flex items-center gap-2">
        <input id="share-link" readonly value={shareLink} aria-label="Link affiliate" class="min-w-0 flex-1 rounded-lg border border-line bg-white px-3 py-2 font-mono text-xs text-ink" />
        <button type="button" data-copy="share-link" class="shrink-0 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">Salin</button>
      </div>
    </div>

    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-xl border border-line bg-white p-4"><dt class="text-sm text-muted">Siap dibayar</dt><dd class="mt-1 text-xl font-semibold tabular-nums text-ink">{IDR(dash.totals.readyIdr)}</dd></div>
      <div class="rounded-xl border border-line bg-white p-4"><dt class="text-sm text-muted">Masih ditahan</dt><dd class="mt-1 text-xl font-semibold tabular-nums text-ink">{IDR(dash.totals.heldIdr)}</dd></div>
      <div class="rounded-xl border border-line bg-white p-4"><dt class="text-sm text-muted">Sudah dibayar</dt><dd class="mt-1 text-xl font-semibold tabular-nums text-ink">{IDR(dash.totals.paidIdr)}</dd></div>
    </dl>

    <div>
      <h2 class="font-display text-lg font-semibold text-ink">Riwayat komisi</h2>
      {dash.commissions.length === 0 ? (
        <p class="mt-2 text-sm text-muted">Belum ada pesanan lewat link atau kode Anda.</p>
      ) : (
        <ul class="mt-3 flex flex-col divide-y divide-line rounded-xl border border-line bg-white">
          {dash.commissions.map((c) => (
            <li class="flex items-start justify-between gap-3 p-4">
              <div class="min-w-0">
                <p class="font-mono text-sm text-ink">{c.orderNumber}</p>
                <p class="mt-0.5 text-xs text-muted">{day(c.placedAt)} · belanja {IDR(c.baseIdr)}{c.rateNote ? ` · ${c.rateNote}` : ""}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="font-semibold tabular-nums text-ink">{IDR(c.commissionIdr)}</p>
                <span class={`mt-1 inline-block rounded-full px-2 py-0.5 text-xs ${STATE[c.state].cls}`}>{STATE[c.state].label}</span>
                {note(c) && <p class="mt-0.5 text-xs text-muted">{note(c)}</p>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
    <p class="text-xs text-muted">Link ini pribadi — jangan dibagikan. Pertanyaan soal pembayaran komisi: hubungi {store.name}.</p>
  </section>
  <script>
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      b.addEventListener("click", async () => {
        const input = document.getElementById(b.dataset.copy!) as HTMLInputElement;
        try {
          await navigator.clipboard.writeText(input.value);
          b.textContent = "Disalin";
        } catch {
          input.select(); // plain-http origin or blocked clipboard: leave it selected for a manual copy
        }
      });
    }
  </script>
</Layout>
