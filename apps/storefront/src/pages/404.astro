---
// 404 — a branded, Indonesian dead end with a way out.
//
// ── HOW IT GETS REACHED (verified against astro@5.18.2 / @astrojs/node@9.5.5, not assumed) ────────
//
// 1. UNMATCHED URL. `createAppHandler` (node/dist/serve-app.js) finds no route, and with no `next`
//    (standalone mode always calls the app handler as the static handler's fallthrough) it calls
//    `app.render`. `App#render` (astro/dist/core/app/index.js) falls back to
//    `routes.find(r => r.component === "404.astro")` and renders THIS file, with the status forced to
//    404 by `#getDefaultStatusCode` ("if (route.endsWith('/404')) return 404").
//
// 2. `return new Response(null, { status: 404 })` FROM A MATCHED PAGE — what produk/[handle],
//    kategori/[handle] and halaman/[handle] do for a handle that does not resolve. This DOES reach
//    here, and the mechanism is specific enough to be worth writing down, because it is the whole
//    reason those returns did not need rewriting:
//
//        if (REROUTABLE_STATUS_CODES.includes(response.status)   // [404, 500]
//            && response.body === null                            // ← THE BODY-LESS PART IS LOAD-BEARING
//            && response.headers.get(REROUTE_DIRECTIVE_HEADER) !== "no") { … #renderError … }
//
//    ⚠️ `response.body === null` is the condition. A body-less 404 is Astro's signal "I don't handle
//    this, show the error page"; the moment a route returns 404 WITH a body, Astro takes that as the
//    page handling its own 404 and this file is skipped. So do NOT "improve" those routes by giving
//    their 404 responses a body — that is precisely what would disconnect them from this page. Before
//    this file existed the reroute still happened, found no `/404` route, and fell through to a bare
//    `new Response(null, { status })` — which is why a shopper got a blank white screen.
//
//    `#renderError` re-runs the middleware (it only passes NOOP_MIDDLEWARE_FN on a retry after this
//    page itself throws), so `Astro.locals.store` IS populated here and the page renders in the
//    merchant's brand. The guard below matters anyway: on that retry path locals would be empty, and
//    a second throw downgrades the shopper to the bare blank response we are removing.
//
// `noindex,follow`: a soft-404 that Google indexes is worse than the 404 itself. `follow` because
// every link on this page is a real page of the shop.
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

const storeName = Astro.locals.store?.name ?? "Toko";

// A 404 IN A SHOP SHOULD RECOVER THE SALE, not just apologise politely. A shopper who mistyped a URL
// or followed a dead link still came here to buy something; three navigation links and a full stop
// asks them to start over, and most will simply leave. Four real products turn the dead end into a
// browse — and they cost nothing, because the catalog is already loaded for this request.
//
// ⚠️ EVERYTHING HERE IS OPTIONAL-CHAINED. This page also renders on the RETRY path Astro takes when
// the error page itself throws, and on that path the middleware is NOT re-run, so `Astro.locals` is
// empty. A 404 page that throws downgrades the shopper to the bare blank response this file exists to
// remove — so it must survive having no store and no catalog. Never make these reads non-optional.
const catalog = Astro.locals.catalog;
const picks = catalog?.bestsellers?.().slice(0, 4) ?? [];
---

<Layout
  title="Halaman tidak ditemukan"
  description={`Halaman yang kamu cari tidak ada di ${storeName}.`}
  robots="noindex,follow"
>
  {/* py-24 -> py-20, and the tail block below fills what used to be a gulf of empty cream between the
      links and the footer. The old page put a small centred block in a tall viewport and stopped. */}
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-24">
    <p class="font-display text-6xl font-semibold text-brand-600 tabular-nums sm:text-7xl">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-balance text-ink sm:text-4xl">
      Halaman tidak ditemukan
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-muted">
      Mungkin alamatnya salah ketik, atau halamannya sudah dipindahkan. Yuk, lanjut belanja dari sini.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/produk"
        class="inline-block rounded-full bg-brand-600 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-200/60 transition-all hover:-translate-y-0.5 hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream motion-reduce:transition-none motion-reduce:hover:translate-y-0"
      >
        Lihat Semua Produk
      </a>
      <a
        href="/"
        class="inline-block rounded-full border border-line bg-white px-7 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
      >
        Kembali ke Beranda
      </a>
    </div>

    {/* Not a search box: the storefront has no search. Offering one that does nothing on the page a
        lost shopper lands on would be the second dead end in a row. These are the three lists the
        shop actually has. */}
    <nav aria-label="Halaman lain" class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
      <a href="/kategori" class="text-brand-700 underline-offset-4 hover:underline">Kategori</a>
      <a href="/blog" class="text-brand-700 underline-offset-4 hover:underline">Jurnal</a>
      <a href="/kontak" class="text-brand-700 underline-offset-4 hover:underline">Kontak</a>
    </nav>
  </section>

  {
    picks.length > 0 && (
      <section class="border-t border-line bg-white/60">
        <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
          {/* `level={2}` — this page's h1 is "Halaman tidak ditemukan", so the strip's heading is the
              section under it and the cards inside are h3. Without the prop ProductCard defaults to
              h3 anyway, which is right here. */}
          <SectionHeading
            eyebrow="Mungkin ini yang kamu cari"
            title="Produk paling dicari"
            align="center"
          />
          <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14 sm:grid-cols-3 lg:grid-cols-4">
            {picks.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
