---
import { ChevronRight } from "@lucide/astro";
// The visible trail. Pair it with `breadcrumbLd()` from the same array so the schema can never drift
// from what is on screen — see src/lib/breadcrumb.ts.
//
// Fixes carried over from the six hand-copied versions this replaces:
//  · `<nav>` had NO accessible name. A page can hold several navs (header, footer, this) and a screen
//    reader listing landmarks announced three anonymous "navigation"s.
//  · The trail was a bare run of <a>/<span>. It is a LIST — an ordered one — so `<ol>` lets a screen
//    reader say "list, 3 items" and announce the position. That is the whole point of a breadcrumb.
//  · The "/" separators were real text, so they were read out: "Beranda slash Dress slash". They are
//    decoration; `aria-hidden` removes them from the accessible name without touching the visual.
//  · The current page was an unmarked <span>. `aria-current="page"` is what says "you are here".
//  · TRUNCATION, not wrapping (2026-07-24). The old version used `flex-wrap`, so a 100-character
//    product name — the last crumb on a PDP — fell onto a second line and dragged a lone "/" with it,
//    which read as broken. The trail is now ONE line: the parent crumbs (short — "Beranda", a category)
//    stay whole, and only the CURRENT page's crumb truncates with an ellipsis. The full name is still
//    the page's <h1> right below, so nothing is lost — the breadcrumb is a trail, not the title.
import type { Crumb } from "../lib/breadcrumb";

interface Props {
  items: Crumb[];
  /** `light` = white trail for use OVER a dark image (the category banner). Default = the cream-page trail. */
  tone?: "default" | "light";
  class?: string;
}

const { items, tone = "default", class: className } = Astro.props;
const light = tone === "light";
---

<nav aria-label="Breadcrumb" class={className}>
  {/* ONE LINE, always (owner 2026-11-05): no wrap; the trailing crumb (the page) truncates with "…" and
      every earlier crumb keeps its full width. Separator is a chevron, the same on every page. */}
  <ol class:list={["flex min-w-0 flex-nowrap items-center gap-x-1.5 whitespace-nowrap text-sm", light ? "text-white/75" : "text-muted"]}>
    {
      items.map((crumb, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class:list={["flex items-center gap-1.5", isLast ? "min-w-0" : "shrink-0"]}>
            {i > 0 && (
              <ChevronRight aria-hidden="true" class:list={["size-3.5 shrink-0", light ? "text-white/50" : "text-muted"]} stroke-width={2} />
            )}
            {crumb.href && !isLast ? (
              <a
                href={crumb.href}
                class:list={[
                  "shrink-0 rounded-sm transition-colors focus-visible:outline-none focus-visible:ring-2",
                  light ? "hover:text-white focus-visible:ring-white/60" : "hover:text-ink hover:underline hover:underline-offset-4 focus-visible:ring-brand-400",
                ]}
              >
                {crumb.name}
              </a>
            ) : (
              <span class:list={[light ? "text-white" : "text-ink", isLast && "truncate"]} aria-current={isLast ? "page" : undefined}>
                {crumb.name}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
