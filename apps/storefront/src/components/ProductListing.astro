---
// PRODUCT LISTING — filter → sort → paginate → grid, all of it in the URL.
//
// Extracted from kategori/[handle].astro so /produk (the real product index) can BE the same listing
// rather than a second implementation of it. There is exactly one grid, one sort control, one filter
// bar and one empty state for products on this storefront; a fork is how the "Terbaru shows the
// oldest products" bug would have survived in one of two places after being fixed in the other.
//
// The empty state moved OUT of here into EmptyState.astro (same markup, byte for byte) so /blog can
// render the same one instead of the bare centred <p> it had — design audit #16.
//
// SORT IS SERVER-SIDE AND URL-DRIVEN (`?sort=`). It used to be a client-side DOM reorder, which had
// three problems the audit named: the order was not in the URL (unshareable, lost on the back
// button), and the reorder re-fired RevealGrid's MutationObserver. Worse and quieter: the dropdown
// DEFAULTED to "Terbaru" while the initial render showed the prop's oldest-first order — the control
// contradicted the page. Sorting on the server by the same `sort` the control reflects makes the two
// agree, and the whole thing works with JS disabled (it is a GET form).
//
// ── PAGINATION ──────────────────────────────────────────────────────────────────────────────────
//
// The listing used to render EVERY product, every time — invisible on a 14-product demo store, one
// page carrying 300 images on a real merchant. `?page=` fixes that: 12 per page (12 divides the
// 2/3/4-column grid exactly, so no page ends on a ragged half-row), real `<a>` links, out-of-range
// CLAMPED to the last page rather than 404'd or blank.
//
// **RevealGrid is deliberately GONE from this listing.** It is a client-side "Muat lebih banyak" that
// reveals 3 rows at a time. Stacked on real paging a phone showed BOTH it and "Halaman 2" — two
// controls that look alike, mean different things, and only one of which can be linked to. RevealGrid
// still serves /blog and /kategori, which are single-page lists.
//
// ── THE FILTER BAR CAME BACK (2026-08-23), AND THE OLD OBJECTION IS THE SPEC ─────────────────────
//
// A category / price / promo filter bar lived here and was REMOVED by the owner on 2026-07-22:
// "on a category page it collapsed to 'Filter · Harga [min]–[max] · Terapkan', a form-shaped band
// above every grid, earning far less than the weight it added… If filtering comes back, it should
// come back as something a phone can use with one thumb, not as a desktop form row."
//
// That sentence is the design, so read it before changing any of this:
//
//   ① **A FACET RENDERS ONLY IF IT PARTITIONS THIS SET.** Two or more options, and not one of them
//      matching everything. On a 3-product category NOTHING renders and the bar is a count and a
//      sort — which is exactly the case that earned the removal. The bar cannot be a permanent band
//      again, because it is derived, not declared.
//   ② **NO min/max NUMBER PAIR.** Price is preset ranges a thumb can hit, derived from the prices
//      actually present (a fixed "Rp0–100rb" ladder is three dead chips in a shop selling batik at
//      Rp450rb). The BOUNDARY travels in the URL (`?harga=100000-300000`), never a bucket index —
//      `?harga=2` would mean different money on a different page and a shared link would lie.
//   ③ **NO "Terapkan" BUTTON WITH JS ON.** Ticking a chip navigates. The button exists inside
//      <noscript> only, where it is the difference between a control and a decoration.
//   ④ **NO LIBRARY.** This storefront has no React integration (checked: `apps/storefront/package.json`
//      has none), so shadcn/Base UI — which is `packages/ui`, for the two Next apps — cannot render
//      here at all. The disclosure is `<details>`, the chips are `<label>` + a visually-hidden
//      checkbox styled through `peer-checked:`. Zero JS, keyboard-operable, works with JS off. Adding
//      an island to draw eight chips would ship a framework to do what a checkbox already does.
//
// ⚠️ **FILTERED-EMPTY IS NOT EMPTY.** "Belum ada produk" over a category that has twenty of them,
// because the shopper ticked XXL, is the storefront telling them the shop is bare. The two states are
// separate below and only one of them offers a way out.

import ProductCard from "./ProductCard.astro";
import EmptyState from "./EmptyState.astro";
import Pagination from "./Pagination.astro";
import { Check, ChevronDown, PackageOpen, SlidersHorizontal, SearchX, X } from "@lucide/astro";
import { num, IDR } from "@tokophi/lib/format";
import { inStock, type Product } from "../data/catalog";

interface Props {
  products: Product[];
  /** Empty-state body. Defaults to the category wording; /produk passes its own. */
  emptyText?: string;
  class?: string;
}

const {
  products,
  emptyText = "Koleksi ini sedang dalam perjalanan. Cek koleksi lainnya, yuk.",
  class: className,
} = Astro.props;

// 12 fills every breakpoint's rows exactly — the grid is 2 / 3 / 4 columns, and 12 divides by all
// three, so no page ever ends on a ragged half-row.
// lazy: the slice happens in memory because the catalogue is already loaded per request and cached
// per store. Above a few thousand products this becomes "fetch 3000 rows to show 12" and the LIMIT
// belongs in the query (data/catalog.ts) instead.
const PER_PAGE = 12;

const params = Astro.url.searchParams;

// Shopify's sort set, in Indonesian (owner 2026-11-05). DEFAULT = Terlaris: a cold, ad-arrived
// shopper converts fastest on what others already bought; ties (a new shop with no sales) fall back
// to newest, so the default is never arbitrary. The default is dropped from URLs by the script below
// (it reads `data-default-sort`), so `/produk` and `/produk?sort=terlaris` are one page.
const SORTS = {
  terlaris: "Terlaris",
  terbaru: "Terbaru",
  termurah: "Harga terendah",
  termahal: "Harga tertinggi",
  diskon: "Diskon terbesar",
  terlama: "Terlama",
  nama: "Nama A–Z",
} as const;
type SortKey = keyof typeof SORTS;
const DEFAULT_SORT: SortKey = "terlaris";
const rawSort = params.get("sort") ?? "";
const sort: SortKey = rawSort in SORTS ? (rawSort as SortKey) : DEFAULT_SORT;

// ── FILTERS — THE SHOPIFY DEFAULT SET (owner 2026-11-05) ────────────────────────────────────────────
// "Samakan dengan Shopify, dinamis untuk semua toko": only the two filters every catalogue has —
// AVAILABILITY and PRICE. Size and category were removed: size is a fashion attribute a fertiliser or
// a phone shop does not have, and a category page filtering by category is a page arguing with itself.
// Both are DERIVED from the products on this page, so they work unchanged on every tenant.
//   ?stok=tersedia|habis   (repeatable — OR within the facet)
//   ?harga_min=…&harga_max=…   (whole rupiah; garbage is ignored, never a 500)
const selStock: string[] = params.getAll("stok").filter((v) => v === "tersedia" || v === "habis");
const toRupiah = (v: string | null) => {
  if (v === null || v.trim() === "") return null;
  const n = Math.floor(Number(v.replace(/[^\d]/g, "")));
  return Number.isFinite(n) && n >= 0 ? n : null;
};
const priceMin = toRupiah(params.get("harga_min"));
const priceMax = toRupiah(params.get("harga_max"));

const MATCH = {
  stok: (p: Product) => !selStock.length || selStock.some((v) => (v === "tersedia" ? inStock(p) : !inStock(p))),
  harga: (p: Product) => (priceMin === null || p.price >= priceMin) && (priceMax === null || p.price <= priceMax),
} as const;
type FacetKey = keyof typeof MATCH;
const FACET_KEYS = Object.keys(MATCH) as FacetKey[];
const matchesAll = (p: Product) => FACET_KEYS.every((k) => MATCH[k](p));
/** Everything the OTHER facets allow — the honest denominator for this facet's counts. */
const matchesExcept = (p: Product, skip: FacetKey) => FACET_KEYS.every((k) => k === skip || MATCH[k](p));

const showFilters = products.length > 3;
const STOCK_OPTIONS = [
  { value: "tersedia", label: "Tersedia", count: products.filter((p) => matchesExcept(p, "stok") && inStock(p)).length },
  { value: "habis", label: "Stok habis", count: products.filter((p) => matchesExcept(p, "stok") && !inStock(p)).length },
].map((o) => ({ ...o, checked: selStock.includes(o.value) }));
/** "Harga tertinggi" hint — Shopify prints it under the two price fields. */
const highestPrice = products.reduce((m, p) => Math.max(m, p.price), 0);
const priceActive = priceMin !== null || priceMax !== null;
const activeCount = selStock.length + (priceActive ? 1 : 0);

const filtered = products.filter(matchesAll);

// Sort a COPY — never mutate the prop, which a caller may still be reading. `terbaru` = newest first
// (createdAt is epoch ms), so it is the reverse of the oldest-first order the list arrives in.
const discountPct = (p: Product) =>
  typeof p.compareAt === "number" && p.compareAt > p.price && p.price > 0 ? (p.compareAt - p.price) / p.compareAt : 0;
const newestFirst = (a: Product, b: Product) => b.createdAt - a.createdAt;
const COMPARE: Record<SortKey, (a: Product, b: Product) => number> = {
  terlaris: (a, b) => b.unitsSold - a.unitsSold || newestFirst(a, b),
  terbaru: newestFirst,
  termurah: (a, b) => a.price - b.price || newestFirst(a, b),
  termahal: (a, b) => b.price - a.price || newestFirst(a, b),
  diskon: (a, b) => discountPct(b) - discountPct(a) || newestFirst(a, b),
  terlama: (a, b) => a.createdAt - b.createdAt,
  nama: (a, b) => a.name.localeCompare(b.name, "id-ID"),
};
const sorted = [...filtered].sort(COMPARE[sort]);

// CLAMPED, not 404'd and not left blank: `?page=99` after a filter narrowed the list lands on the
// last real page. A shopper who deep-links a page that a restock or a filter has since moved should
// see products, not an explanation.
const totalPages = Math.max(1, Math.ceil(sorted.length / PER_PAGE));
const requested = Number(params.get("page"));
const page = Number.isInteger(requested) && requested >= 1 ? Math.min(requested, totalPages) : 1;
const from = (page - 1) * PER_PAGE;
const visible = sorted.slice(from, from + PER_PAGE);

// The form must re-emit every OTHER query param as a hidden field — above all `q` on /cari, which
// sorting would otherwise drop, turning "urutkan hasil pencarian" into "buang pencarian saya".
//
// ⚠️ **EVERY KEY THIS FORM OWNS AS A CONTROL MUST BE HERE**, or it is submitted twice: once from the
// checkbox and once from the hidden copy, so one tick reads as two and unticking never clears it.
// `page` is deliberately NOT carried: changing the order or the filter returns you to page 1,
// because page 7 of the old set is a different set of products from page 7 of the new one.
const OWNED = new Set<string>(["sort", "page", "stok", "harga_min", "harga_max", "ukuran", "kategori", "harga", "diskon"]);
const carryParams = [...params.entries()].filter(([k]) => !OWNED.has(k));
/** "Hapus filter" — keeps the search query and drops only what this bar owns. */
const clearHref = carryParams.length
  ? `${Astro.url.pathname}?${new URLSearchParams(carryParams).toString()}`
  : Astro.url.pathname;

// Flat by design: a hairline rule under the row, no card. The old bar was a rounded, bordered,
// blurred panel floating above every grid — a frame around two controls.
const DD_SUMMARY =
  "inline-flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-lg px-3 text-sm text-ink transition-colors hover:bg-mist [&::-webkit-details-marker]:hidden";
const DD_PANEL =
  "absolute left-0 top-full z-30 mt-1 w-64 rounded-lg bg-cream p-2 shadow-[0_12px_32px_-12px_rgb(0_0_0/0.25)] ring-1 ring-line";
const DD_HEAD = "flex items-center justify-between gap-3 px-2 pb-2 pt-1 text-sm text-muted";
const DD_ROW = "flex min-h-10 cursor-pointer items-center gap-3 rounded-md px-2 text-sm text-ink hover:bg-mist";
const SHEET_SUMMARY =
  "flex min-h-11 cursor-pointer list-none items-center justify-between text-[0.9375rem] font-medium [&::-webkit-details-marker]:hidden";
const PRICE_BOX =
  "flex min-h-11 min-w-0 flex-1 items-center gap-1.5 rounded-lg border border-line bg-white px-3 text-sm focus-within:border-ink";
// 16px on touch (global.css) so iOS does not zoom; `min-w-0` lets two fields share a 288px sheet row.
// `self-stretch` makes the input itself the 44px-tall target (it measured 82×20 inside the box).
const PRICE_INPUT = "w-full min-w-0 self-stretch border-0 bg-transparent p-0 text-ink tabular-nums placeholder:text-muted focus:outline-none";

/** Removable chips for what is applied — each links to this URL minus that value (page reset). */
const urlWithout = (drop: (k: string, v: string) => boolean) => {
  const next = new URLSearchParams();
  for (const [k, v] of params.entries()) if (k !== "page" && !drop(k, v)) next.append(k, v);
  const qs = next.toString();
  return qs ? `${Astro.url.pathname}?${qs}` : Astro.url.pathname;
};
const activeChips = [
  ...STOCK_OPTIONS.filter((o) => o.checked).map((o) => ({ label: o.label, href: urlWithout((k, v) => k === "stok" && v === o.value) })),
  ...(priceActive
    ? [{
        label: priceMin !== null && priceMax !== null ? `${IDR(priceMin)} – ${IDR(priceMax)}` : priceMin !== null ? `Mulai ${IDR(priceMin)}` : `Sampai ${IDR(priceMax!)}`,
        href: urlWithout((k) => k === "harga_min" || k === "harga_max"),
      }]
    : []),
];
---

<section class:list={["mx-auto max-w-7xl px-4 pb-10 pt-2 sm:px-6", className]}>
  {
    products.length === 0 ? (
      // Nothing arrived at all — no filter can fix that, so no controls are drawn.
      <EmptyState
        icon={PackageOpen}
        title="Belum ada produk"
        body={emptyText}
        ctaHref="/"
        ctaLabel="Kembali ke Beranda"
      />
    ) : (
      <Fragment>
        {/* ONE form for filters AND sort. Two forms would need two copies of the hidden carry
            fields, and the first one to be submitted would silently discard the other's values. */}
        {/* FILTERS, SHOPIFY-STYLE (owner 2026-11-05). ONE GET form, two presentations of the same facets:
            · md+  — a row of dropdowns ("Ukuran ▾", "Harga ▾"…), native <details>, applied on change;
            · phone — "Filter dan urutkan" opens a <dialog> sheet with the facets as accordions, applied
              with one "Lihat N produk" tap (a page load per tick would close the sheet every time).
            Both groups carry the same named inputs; the script disables the group that did NOT submit,
            so a value is never sent twice. No borders on the toolbar: spacing separates it. */}
        <form id="listing-controls" method="get" action={Astro.url.pathname} data-default-sort={DEFAULT_SORT}>
          {carryParams.map(([k, v]) => <input type="hidden" name={k} value={v} />)}

          <div class="flex items-center gap-2">
            {showFilters && (
              <Fragment>
                <button type="button" data-filter-open class="group inline-flex min-h-10 items-center gap-2 rounded-lg border border-ink px-3.5 text-sm font-medium text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white md:hidden">
                  <SlidersHorizontal class="size-4" stroke-width={2} aria-hidden="true" />
                  Filter dan urutkan
                  {activeCount > 0 && <span class="inline-flex size-5 items-center justify-center rounded-full bg-ink text-xs font-semibold text-white tabular-nums group-hover:bg-white group-hover:text-ink">{activeCount}</span>}
                </button>
                <div class="hidden items-center gap-1 md:flex" data-filter-group="dd">
                  <span class="mr-1 text-sm text-muted">Filter:</span>
                  <details class="facet-dd relative" data-facet-dd>
                    <summary class={DD_SUMMARY}>
                      Ketersediaan{selStock.length > 0 && <span class="tabular-nums text-muted">({selStock.length})</span>}
                      <ChevronDown class="facet-chev size-4 text-muted transition-transform duration-200" stroke-width={2} aria-hidden="true" />
                    </summary>
                    <fieldset class={DD_PANEL}>
                      <legend class="sr-only">Ketersediaan</legend>
                      <div class={DD_HEAD}>
                        <span>{selStock.length} dipilih</span>
                        {selStock.length > 0 && <a href={urlWithout((k) => k === "stok")} class="text-ink underline underline-offset-4">Hapus</a>}
                      </div>
                      {STOCK_OPTIONS.map((o) => (
                        <label class:list={[DD_ROW, o.count === 0 && !o.checked && "cursor-not-allowed opacity-40"]}>
                          <input type="checkbox" name="stok" value={o.value} checked={o.checked} disabled={o.count === 0 && !o.checked} class="size-4 rounded-sm accent-[var(--color-ink)]" />
                          <span class="min-w-0 flex-1">{o.label}</span>
                          <span class="text-xs text-muted tabular-nums">{num(o.count)}</span>
                        </label>
                      ))}
                    </fieldset>
                  </details>
                  <details class="facet-dd relative" data-facet-dd>
                    <summary class={DD_SUMMARY}>
                      Harga{priceActive && <span class="text-muted">(1)</span>}
                      <ChevronDown class="facet-chev size-4 text-muted transition-transform duration-200" stroke-width={2} aria-hidden="true" />
                    </summary>
                    <fieldset class:list={[DD_PANEL, "w-80"]}>
                      <legend class="sr-only">Harga</legend>
                      <div class={DD_HEAD}>
                        <span>Harga tertinggi {IDR(highestPrice)}</span>
                        {priceActive && <a href={urlWithout((k) => k === "harga_min" || k === "harga_max")} class="text-ink underline underline-offset-4">Hapus</a>}
                      </div>
                      <div class="flex items-center gap-2 px-2 pb-2">
                        <label class={PRICE_BOX}><span class="text-muted">Rp</span><input type="text" inputmode="numeric" name="harga_min" value={priceMin ?? ""} placeholder="Dari" aria-label="Harga dari" class={PRICE_INPUT} /></label>
                        <span class="text-muted">–</span>
                        <label class={PRICE_BOX}><span class="text-muted">Rp</span><input type="text" inputmode="numeric" name="harga_max" value={priceMax ?? ""} placeholder="Sampai" aria-label="Harga sampai" class={PRICE_INPUT} /></label>
                      </div>
                    </fieldset>
                  </details>
                </div>
              </Fragment>
            )}

            <p class="ml-auto min-w-0 whitespace-nowrap text-sm text-muted">
              {/* The count is the FILTERED total; the range only when there is more than one page. */}
              {totalPages > 1 ? (
                <Fragment>
                  <span class="hidden sm:inline">
                    <span class="text-ink tabular-nums">{num(from + 1)}–{num(from + visible.length)}</span> dari{" "}
                  </span>
                  <span class="text-ink tabular-nums">{num(sorted.length)}</span> produk
                </Fragment>
              ) : (
                <Fragment>
                  <span class="text-ink tabular-nums">{num(sorted.length)}</span> produk
                </Fragment>
              )}
            </p>

            {/* SORT — the same dropdown as the facets (owner 2026-11-05: the native <select> looked like
                another product's control). Radios, applied on change; the open list hugs the right edge. */}
            <details class="facet-dd relative hidden shrink-0 md:block" data-facet-dd data-filter-group="dd">
              <summary class="inline-flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-lg px-3 text-sm text-ink transition-colors hover:bg-mist [&::-webkit-details-marker]:hidden">
                <span class="text-muted">Urutkan:</span> {SORTS[sort]}
                <ChevronDown class="facet-chev size-4 text-muted transition-transform duration-200" stroke-width={2} aria-hidden="true" />
              </summary>
              <fieldset class="absolute right-0 top-full z-30 mt-1 w-56 rounded-lg bg-cream p-2 shadow-[0_12px_32px_-12px_rgb(0_0_0/0.25)] ring-1 ring-line">
                <legend class="sr-only">Urutkan produk</legend>
                {Object.entries(SORTS).map(([k, label]) => (
                  <label class="flex min-h-10 cursor-pointer items-center gap-3 rounded-md px-2 text-sm text-ink hover:bg-mist has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-400">
                    <input type="radio" name="sort" value={k} checked={k === sort} class="peer sr-only" />
                    <span class="min-w-0 flex-1 peer-checked:font-medium">{label}</span>
                    <Check class="size-4 opacity-0 peer-checked:opacity-100" stroke-width={2} aria-hidden="true" />
                  </label>
                ))}
              </fieldset>
            </details>
          </div>

          {activeChips.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-2">
              {activeChips.map((c) => (
                <a href={c.href} class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-mist px-3 text-sm text-ink transition-colors hover:bg-mist-strong">
                  {c.label}
                  <X class="size-3.5" stroke-width={2} aria-hidden="true" />
                  <span class="sr-only">— hapus</span>
                </a>
              ))}
              <a href={clearHref} class="ml-1 text-sm text-ink underline underline-offset-4">Hapus semua</a>
            </div>
          )}

          {showFilters && (
            <dialog data-filter-drawer aria-label="Filter dan urutkan" class="fixed inset-y-0 right-0 m-0 ml-auto h-[100dvh] max-h-none w-full max-w-sm bg-cream p-0 text-ink">
              <div class="flex h-full flex-col" data-filter-group="drawer">
                <div class="flex items-center justify-between px-5 py-4">
                  <p class="text-base font-semibold">Filter dan urutkan</p>
                  <button type="button" data-filter-close aria-label="Tutup" class="-mr-2 inline-flex size-11 items-center justify-center rounded-full hover:bg-mist">
                    <X class="size-5" stroke-width={1.8} aria-hidden="true" />
                  </button>
                </div>
                <div class="min-h-0 flex-1 overflow-y-auto px-5">
                  <details open class="group py-2">
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-[0.9375rem] font-medium [&::-webkit-details-marker]:hidden">
                      Urutkan
                      <ChevronDown class="size-4 text-muted transition-transform group-open:rotate-180" stroke-width={2} aria-hidden="true" />
                    </summary>
                    {Object.entries(SORTS).map(([k, label]) => (
                      <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm">
                        <input type="radio" name="sort-sheet" value={k} checked={k === sort} class="size-4 accent-[var(--color-ink)]" />
                        {label}
                      </label>
                    ))}
                  </details>
                  <details open class="group py-2">
                    <summary class={SHEET_SUMMARY}>
                      Ketersediaan
                      <ChevronDown class="size-4 text-muted transition-transform group-open:rotate-180" stroke-width={2} aria-hidden="true" />
                    </summary>
                    <fieldset>
                      <legend class="sr-only">Ketersediaan</legend>
                      {STOCK_OPTIONS.map((o) => (
                        <label class:list={["flex min-h-11 cursor-pointer items-center gap-3 text-sm", o.count === 0 && !o.checked && "cursor-not-allowed opacity-40"]}>
                          <input type="checkbox" name="stok" value={o.value} checked={o.checked} disabled={o.count === 0 && !o.checked} class="size-4 rounded-sm accent-[var(--color-ink)]" />
                          <span class="min-w-0 flex-1">{o.label}</span>
                          <span class="text-xs text-muted tabular-nums">{num(o.count)}</span>
                        </label>
                      ))}
                    </fieldset>
                  </details>
                  <details open class="group py-2">
                    <summary class={SHEET_SUMMARY}>
                      Harga
                      <ChevronDown class="size-4 text-muted transition-transform group-open:rotate-180" stroke-width={2} aria-hidden="true" />
                    </summary>
                    <fieldset class="pb-2">
                      <legend class="sr-only">Harga</legend>
                      <p class="mb-3 text-sm text-muted">Harga tertinggi {IDR(highestPrice)}</p>
                      <div class="flex items-center gap-2">
                        <label class={PRICE_BOX}><span class="text-muted">Rp</span><input type="text" inputmode="numeric" name="harga_min" value={priceMin ?? ""} placeholder="Dari" aria-label="Harga dari" class={PRICE_INPUT} /></label>
                        <span class="text-muted">–</span>
                        <label class={PRICE_BOX}><span class="text-muted">Rp</span><input type="text" inputmode="numeric" name="harga_max" value={priceMax ?? ""} placeholder="Sampai" aria-label="Harga sampai" class={PRICE_INPUT} /></label>
                      </div>
                    </fieldset>
                  </details>
                </div>
                <div class="flex items-center gap-3 px-5 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-8px_16px_-12px_rgb(0_0_0/0.2)]">
                  <a href={clearHref} class="inline-flex min-h-12 flex-1 items-center justify-center rounded-lg border border-ink text-[0.9375rem] font-semibold text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white">Hapus semua</a>
                  <button type="submit" data-filter-apply class="inline-flex min-h-12 flex-1 items-center justify-center rounded-lg bg-brand-600 text-[0.9375rem] font-semibold text-white hover:bg-brand-700">Terapkan</button>
                </div>
              </div>
            </dialog>
          )}

          {/* JS off: nothing submits on change, so a plain button does (and the sheet cannot open). */}
          <noscript>
            <button type="submit" class="mt-3 min-h-10 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white">Terapkan</button>
          </noscript>
        </form>

        {visible.length > 0 ? (
          <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-x-5 sm:gap-y-12 lg:grid-cols-4 lg:gap-x-6">
            {/* `level={2}` — the card defaults to h3 and this listing sits under the page's h1, so every
                listing surface in the shop went h1 → h3. The prop existed for exactly this and not one
                of the ten call sites passed it. */}
            {visible.map((p) => (
              <ProductCard product={p} level={2} />
            ))}
          </div>
        ) : (
          /* ⚠️ NOT "Belum ada produk". Products arrived; the shopper's own filter excluded them, and
             the only useful thing on this screen is the way back. */
          <EmptyState
            icon={SearchX}
            title="Tidak ada yang cocok"
            body="Coba longgarkan filternya — mungkin ukuran atau rentang harganya terlalu sempit."
            ctaHref={clearHref}
            ctaLabel="Hapus filter"
          />
        )}

        <Pagination page={page} totalPages={totalPages} />
      </Fragment>
    )
  }
</section>

<style>
  .facet-dd[open] .facet-chev { transform: rotate(180deg); }
  [data-filter-drawer]::backdrop { background: rgb(0 0 0 / 0.35); }
  @media (prefers-reduced-motion: reduce) { .facet-chev { transition: none; } }
</style>

<script is:inline>
  // A change-LISTENER, not an inline onchange attribute, to stay clear of any inline-handler CSP.
  (function () {
    var form = document.getElementById("listing-controls");
    if (!form) return;
    var drawer = form.querySelector("[data-filter-drawer]");
    var dds = Array.prototype.slice.call(form.querySelectorAll("[data-facet-dd]"));

    // The facets exist twice (dropdowns + sheet). Before any submit, switch OFF the group that did not
    // submit, so each value is sent once; and drop the default sort, which says nothing in a shared URL.
    function prepare(from) {
      var other = from === "drawer" ? "dd" : "drawer";
      form.querySelectorAll('[data-filter-group="' + other + '"] input').forEach(function (i) { i.disabled = true; });
      // The sheet's sort radios are named `sort-sheet`: two radio sets sharing `sort` in ONE form are ONE
      // group to the browser, and the sheet's (later in the DOM) un-checked the dropdown's. Renamed here,
      // only when the sheet is the one submitting.
      if (from === "drawer") form.querySelectorAll('input[name="sort-sheet"]').forEach(function (i) { i.name = "sort"; });
      form.querySelectorAll('input[name="sort"]:checked:not(:disabled)').forEach(function (i) {
        if (i.value === form.getAttribute("data-default-sort")) i.disabled = true; // the server default
      });
      // An empty price field says nothing; "Rp 150.000" typed with dots is cleaned to digits.
      form.querySelectorAll('input[name="harga_min"], input[name="harga_max"]').forEach(function (i) {
        i.value = i.value.replace(/[^0-9]/g, "");
        if (!i.value) i.disabled = true;
      });
    }

    // Desktop: a tick or a new sort applies at once (Shopify's live filter); the dropdown reloads closed.
    form.addEventListener("change", function (e) {
      var t = e.target;
      if (!t || !t.name) return;
      if (t.closest('[data-filter-group="drawer"]')) return; // the sheet applies with its button
      prepare("dd");
      form.submit(); // ⚠️ form.submit() fires no submit event — prepare() is called by hand above
    });
    // Every NATIVE submit (the sheet's "Terapkan", Enter in a price field, the no-JS button) goes
    // through here; the change handler above calls prepare() itself because form.submit() fires no event.
    form.addEventListener("submit", function () { prepare(drawer && drawer.open ? "drawer" : "dd"); });

    // One dropdown at a time; outside click and Escape close it.
    dds.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (d.open) dds.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      dds.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      dds.forEach(function (d) { if (d.open) { d.open = false; var s = d.querySelector("summary"); if (s) s.focus(); } });
    });

    // Phone sheet: a native modal <dialog> — focus trap, Esc and inert background for free.
    var opener = form.querySelector("[data-filter-open]");
    if (drawer && opener && drawer.showModal) {
      opener.addEventListener("click", function () { drawer.showModal(); });
      drawer.querySelectorAll("[data-filter-close]").forEach(function (b) { b.addEventListener("click", function () { drawer.close(); }); });
      drawer.addEventListener("click", function (e) { if (e.target === drawer) drawer.close(); }); // backdrop
    }
  })();
</script>
