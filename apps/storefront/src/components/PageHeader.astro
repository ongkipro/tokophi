---
// PAGE HEADER — the `bg-mist` band at the top of a non-homepage route.
//
// It existed as hand-copied markup in kategori/[handle], blog/index and kontak (and, minus the
// eyebrow, halaman/[handle]). That is the shape the design audit (#16) flagged: the storefront has no
// shared primitives, so "make the h1 smaller on phones" was five edits and got done in two of them.
//
// ⚠️ THE H1 SIZE WAS THE INCONSISTENCY, and it is fixed here rather than preserved. The copies used
// `text-4xl` FLAT — no responsive step — so a long Indonesian category name ("Busana Muslim &
// Outerwear") wrapped to three lines inside a 360px viewport and shoved the dek below the fold.
// produk/[handle] already used `text-3xl sm:text-4xl`, which is the right shape: identical on a
// laptop, one step calmer on a phone. That is now the only shape.
//
// `text-balance` comes from halaman/[handle] — with a heading this size it is the difference between
// a tidy two-line title and a two-word orphan on line three.
import Breadcrumb from "./Breadcrumb.astro";
import type { Crumb } from "../lib/breadcrumb";

interface Props {
  /** The visible trail. Build it from the SAME array you hand to `breadcrumbLd()` — see lib/breadcrumb.ts. */
  crumbs?: Crumb[];
  title: string;
  /** One-line standfirst under the title. */
  dek?: string;
  /**
   * Optional cover, shown beside the text on ≥sm. Real collections carry whatever the merchant
   * uploaded in the Kategori editor; virtual collections and most other pages have none, and the
   * layout is byte-identical to the no-image case when it is absent.
   * Must already be absolute (`mediaUrl()`).
   */
  imageUrl?: string;
  /** Alt text for `imageUrl`. Decorative covers should pass `""`. */
  imageAlt?: string;
  /**
   * `narrow` (max-w-3xl) for a page whose body is a single reading column — the CMS Halaman pages —
   * so the band lines up with the prose beneath it instead of overhanging it by four columns.
   * `wide` (max-w-7xl, the default) for anything sitting above a grid.
   */
  width?: "wide" | "narrow";
  class?: string;
}

const { crumbs, title, dek, imageUrl, imageAlt = "", width = "wide", class: className } = Astro.props;
const hasCrumbs = !!crumbs?.length;
---

{/* REDESIGN C (DESIGN.md C2): a page header is a title, not a band. The tinted block with a kicker,
    a standfirst and room to spare pushed the first product below the fold on every listing. Same
    page background as the content, tight vertical rhythm, no eyebrow (the breadcrumb already says
    where you are). */}
<section class:list={[className]}>
  <div class:list={["mx-auto px-4 pb-4 pt-5 sm:px-6 sm:pb-6 sm:pt-8", width === "narrow" ? "max-w-3xl" : "max-w-7xl"]}>
    {hasCrumbs && <Breadcrumb items={crumbs!} />}
    <div class:list={["flex flex-col gap-4 sm:flex-row sm:items-center", hasCrumbs && "mt-3"]}>
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={imageAlt}
            width="160"
            height="160"
            loading="eager"
            class="size-20 shrink-0 rounded-sm object-cover sm:size-28"
          />
        )
      }
      <div class="min-w-0">
        <h1 class="font-display text-[1.625rem] font-semibold leading-tight tracking-[-0.01em] text-balance text-ink sm:text-4xl">
          {title}
        </h1>
        {dek && <p class="mt-1.5 max-w-xl text-[0.9375rem] leading-relaxed text-muted">{dek}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>
