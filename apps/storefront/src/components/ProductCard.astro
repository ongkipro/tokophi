---
import { IDR } from "@tokophi/lib/format";
import type { Product } from "../data/catalog";
import Stars from "./Stars.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const rating = Astro.locals.catalog.productRating(product);
---

<a
  href={`/produk/${product.handle}`}
  class="group block overflow-hidden rounded-xl bg-white ring-1 ring-line transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-200/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
>
  <div class="relative aspect-[3/4] overflow-hidden rounded-xl bg-brand-50">
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {
      product.badge && (
        <span class="absolute left-3 top-3 rounded-full bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
          {product.badge}
        </span>
      )
    }

    <span
      class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full bg-white/80 text-brand-600 opacity-0 shadow-sm backdrop-blur transition-all duration-300 group-hover:opacity-100"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current transition-colors group-hover:fill-brand-600" stroke-width="1.8">
        <path d="M12 21s-6.7-4.35-9.33-8.24C1.3 10.6 1.85 7.3 4.6 6.1c1.9-.83 4.1-.1 5.2 1.6l.2.32.2-.32c1.1-1.7 3.3-2.43 5.2-1.6 2.75 1.2 3.3 4.5 1.93 6.66C18.7 16.65 12 21 12 21Z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>

  <div class="p-4">
    <p class="text-[0.65rem] font-medium uppercase tracking-widest text-muted">{product.category}</p>
    <h3 class="mt-1 truncate font-medium text-ink transition-colors group-hover:text-brand-700">
      {product.name}
    </h3>
    <Stars value={rating.value} count={rating.count} class="mt-1.5" />
    <div class="mt-2 flex items-baseline gap-2">
      <span class="font-semibold text-ink tabular-nums">{IDR(product.price)}</span>
      {
        product.compareAt && (
          <span class="text-sm text-muted line-through tabular-nums">{IDR(product.compareAt)}</span>
        )
      }
    </div>
  </div>
</a>
