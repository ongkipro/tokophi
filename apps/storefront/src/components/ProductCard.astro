---
import { IDR } from "@tokophi/lib/format";
import { ImageOff } from "@lucide/astro";
import { imageSrcSet, inStock, type Product } from "../data/catalog";

interface Props {
  product: Product;
  /** Heading level for the product name. See the note below — this is not cosmetic. */
  level?: 2 | 3 | 4;
  /** Which grid this card sits in — picks the matching `sizes`. See SIZES below; this is a named
   *  layout rather than a raw string so a call site cannot invent one that does not match its CSS. */
  grid?: GridShape;
}

// The card's title is a heading, and its correct level depends on the page. On a listing page the
// card sits directly under the page `h1` with nothing between, so a hardcoded `h3` SKIPS h2 on every
// listing surface in the shop. ArticleCard solved exactly this with a `level` prop; the product card
// was still hardcoded. Default stays `h3` — correct under a section heading, which is the commonest
// placement (homepage sections, "Kamu mungkin suka").
// ── `sizes` — DERIVED FROM THE GRID, NOT GUESSED ──────────────────────────────────────────────────
//
// A wrong `sizes` is worse than no srcset: the browser trusts it completely and picks a candidate
// from it before layout exists. Too big and every phone downloads the 1200w; too small and a wide
// card renders a blurry 200w. So this is arithmetic on the real Tailwind classes, not a vibe.
//
// Every product grid in the shop lives in `mx-auto max-w-7xl px-4 sm:px-6` with `gap-4`, and always
// starts at `grid-cols-2` on phones. Constants: gap-4 = 16px, px-4 = 32px total, px-6 = 48px total,
// max-w-7xl = 1280px. Column width = (container - padding - gaps) / cols.
//
// The four shapes that actually exist, named by their column counts at base/sm/lg:
//
//  "2-3-4"  ProductListing, index "Paling Dicari", PDP "produk serupa", ProductGrid columns=4
//           `grid-cols-2 sm:grid-cols-3 lg:grid-cols-4`
//             <640      (100vw - 32 - 16)/2   = 50vw - 24px      (360px → 156px ✓)
//             640-1023  (100vw - 48 - 32)/3   = 33.3vw - 27px
//             1024-1279 (100vw - 48 - 48)/4   = 25vw - 24px
//             >=1280    (1280 - 48 - 48)/4    = 296px            (✓)
//  "2-4"    blog/[handle] + keranjang "kamu mungkin suka" — `grid-cols-2 lg:grid-cols-4`, i.e. it
//           SKIPS the 3-col tier, so 640-1023 is (100vw - 48 - 16)/2 = 50vw - 32px, not 33vw.
//  "2-3"    ProductGrid columns=3 — `grid-cols-2 sm:grid-cols-3`; >=1280 → (1280-48-32)/3 = 400px.
//  "2-2"    ProductGrid columns=2 — `grid-cols-2 sm:grid-cols-2`; >=1280 → (1280-48-16)/2 = 608px.
//           This one is why the shapes are enumerated at all: served the "2-3-4" string, a 608px
//           card would claim to be 296px and render the 400w rendition upscaled.
//
// Widest a card ever gets is 608px, so 1200w covers it at DPR 2 — which is where the route's
// allow-list stops.
type GridShape = "2-3-4" | "2-4" | "2-3" | "2-2";
const SIZES: Record<GridShape, string> = {
  "2-3-4":
    "(min-width: 1280px) 296px, (min-width: 1024px) calc(25vw - 24px), (min-width: 640px) calc(33.3vw - 27px), calc(50vw - 24px)",
  "2-4":
    "(min-width: 1280px) 296px, (min-width: 1024px) calc(25vw - 24px), (min-width: 640px) calc(50vw - 32px), calc(50vw - 24px)",
  "2-3": "(min-width: 1280px) 400px, (min-width: 640px) calc(33.3vw - 27px), calc(50vw - 24px)",
  "2-2": "(min-width: 1280px) 608px, (min-width: 640px) calc(50vw - 32px), calc(50vw - 24px)",
};

const { product, level = 3, grid = "2-3-4" } = Astro.props;
const sizes = SIZES[grid];
const Heading = `h${level}` as "h2" | "h3" | "h4";
// `undefined` for seeded /products/*.webp and for the no-image case — Astro then omits both
// attributes and the markup is exactly what it was before.
const srcset = imageSrcSet(product.image);
const rating = Astro.locals.catalog.productRating(product);

// The discount was computed on the PDP and NOWHERE on the card, so a shopper scanning a promo grid
// saw a struck-through price and had to do the arithmetic themselves. Same formula as
// produk/[handle].astro so the two can never disagree.
// `price === 0` means "belum diberi harga / tanya penjual" in this data, NOT free — so the card shows
// "Hubungi untuk harga" instead of "Rp0", which reads as broken. The PDP (produk/[handle].astro) makes
// the same call and drops it into the contact flow; here the card just links to the PDP as always.
const unpriced = product.price <= 0;
// `&& !unpriced`: a compareAt over a 0 base computes a bogus −100% badge — no price cut without a price.
// `&& available`: a price cut on something nobody can buy is not information, it is bait — see below.
const soldOut = !inStock(product);
const discount =
  !unpriced && !soldOut && product.compareAt && product.compareAt > product.price
    ? Math.round(((product.compareAt - product.price) / product.compareAt) * 100)
    : 0;
---

<!-- FRAMELESS / FLAT (owner, 2026-07-23). No card box — no white fill, no `ring-1 ring-line`, no drop
     shadow. The product IS the image; the type sits flush beneath it on the page. The only hover is the
     image easing up in scale and the title warming to brand — nothing lifts or casts a shadow (that was
     the framed look this replaces). The focus ring hugs the rounded IMAGE, where the eye already is,
     offset against the cream page so it reads on the shop's most-used control. -->
<a href={`/produk/${product.handle}`} class="group block focus-visible:outline-none">
  {/* The image is the card's ONE surface now that there is no outer box, so it carries the radius and
      the clip (badges, the discount pill and the sold-out scrim all ride inside this rounded frame). */}
  <div class="relative aspect-[3/4] overflow-hidden rounded-md bg-brand-50 group-focus-visible:ring-2 group-focus-visible:ring-brand-400 group-focus-visible:ring-offset-2 group-focus-visible:ring-offset-cream">
    {/* A product with NO photo renders the tinted frame, never a broken image. `catalog.ts` used to
        guess `/products/<handle>.webp` — a seed-only convention — so any merchant-created product
        without an upload showed the browser's broken-image glyph on every card. ArticleCard has
        guarded this from the start; this is the product card catching up.
        `alt=""` on purpose: the name is in the <h3> inside the SAME <a>, so a real alt makes a screen
        reader read every product twice. */}
    {product.image ? (
      <img
        src={product.image}
        srcset={srcset}
        sizes={srcset ? sizes : undefined}
        alt=""
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center" aria-hidden="true">
        <ImageOff class="size-8 text-brand-300" stroke-width={1.5} />
      </div>
    )}
    {
      product.badge && (
        <span class="absolute left-3 top-3 rounded-full bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
          {product.badge}
        </span>
      )
    }
    {/* Discount sits TOP-RIGHT so it can coexist with the merchant's own badge on the left — they
        used to be mutually exclusive because only one slot existed. Red, not brand pink: a price cut
        is the one thing on this card allowed to shout. */}
    {discount > 0 && (
      <span class="absolute right-3 top-3 rounded-full bg-red-600 px-2.5 py-1 text-xs font-bold text-white shadow-sm tabular-nums">
        −{discount}%
      </span>
    )}

    {/* SOLD OUT — audit #16 finding 4, the half that had not landed. A shopper could not tell a
        sold-out product apart in the grid and only found out after clicking: a wasted click, and in a
        promo grid it looked like an offer they could still take.

        An OVERLAY, not a third corner pill. The two corners are taken (merchant badge left, discount
        right), and more importantly this is not a label alongside the others — it changes what the
        whole card MEANS, so it reads across the card rather than decorating one corner of it. The
        image is dimmed with it, so the state is legible while scrolling past at arm's length and not
        only to someone who stops to read.

        Real text in the DOM, never `aria-hidden`: to a screen-reader user the price and the name are
        identical to a card they can buy from. The scrim is the decoration; the sentence is the fact.

        The card still LINKS to the PDP. The product page explains which variants are gone and keeps
        whatever ranking the URL has earned — de-linking it would throw both away to save one click. */}
    {soldOut && (
      <div class="absolute inset-0 flex items-center justify-center bg-cream/65">
        <span class="rounded-full bg-ink/85 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-cream shadow-sm">
          Stok habis
        </span>
      </div>
    )}

    {/* REMOVED: a heart in a white circle, top-right of the image, fading in on hover — exactly where
        Tokopedia and Shopee put "save to wishlist". It had no handler and there is no wishlist; it was
        a <span> inside the card's <a>, so clicking it just opened the product. Decoration wearing a
        control's clothes. */}
  </div>

  <div class="mt-3">
    <p class="text-[0.65rem] font-medium uppercase tracking-widest text-muted">{product.category}</p>
    {/* `line-clamp-2`, not `truncate`. At 360px in a 2-up grid the title box is ~124px, and Indonesian
        product names are long AND front-loaded with the same words — so `truncate` clipped adjacent
        cards to the IDENTICAL string ("Dress Batik Par…", "Dress Batik Par…"). Capped at TWO lines and
        `min-h` reserves both, so a 1-line title and a 2-line title still align their prices in a row. */}
    <Heading class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm font-medium leading-snug text-ink transition-colors group-hover:text-brand-700">
      {product.name}
    </Heading>
    {/* RATING — one filled star + the number + count, not a five-star row. On a flat card the five
        outlines competed with the price for weight; a single star reads as "rated 4.8" at a glance and
        keeps the card quiet. No published reviews → NO rating at all (never an invented 4.5, never
        "0 ulasan · ☆☆☆☆☆", which reads as a bad product rather than a new one). */}
    {
      rating && (
        <div
          class="mt-1.5 flex items-center gap-1 text-xs"
          role="img"
          aria-label={`Rating ${rating.value.toFixed(1)} dari 5${rating.count != null ? `, ${rating.count} ulasan` : ""}`}
        >
          <svg viewBox="0 0 20 20" class="size-3.5 shrink-0 fill-amber-400" aria-hidden="true">
            <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.62l5.82-.85L10 1.5Z" />
          </svg>
          <span class="font-semibold tabular-nums text-ink" aria-hidden="true">{rating.value.toFixed(1)}</span>
          {rating.count != null && <span class="text-muted" aria-hidden="true">({rating.count})</span>}
        </div>
      )
    }
    {/* PRICE — the current price leads in ink; a compare-at follows, smaller and struck. `flex-wrap` so
        a two-price row never clips on a 2-up phone grid (it did, `nowrap`, on every phone: the struck
        price ran past the 124px column). `gap-y-0.5` keeps a wrapped second line tight. Unpriced → a
        phrase, no figure, no struck price beside it. */}
    <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      <span class:list={["font-semibold text-ink", unpriced ? "text-sm" : "text-[0.95rem] tabular-nums"]}>
        {unpriced ? "Hubungi untuk harga" : IDR(product.price)}
      </span>
      {
        !unpriced && product.compareAt && (
          <span class="text-xs text-muted line-through tabular-nums">{IDR(product.compareAt)}</span>
        )
      }
    </div>
  </div>
</a>
