---
// One article tile — used by BOTH /blog and the homepage's Jurnal section.
//
// Extracted rather than copied. `3ce6d6c` audited every card surface and found the blog tile and
// ProductCard "do the same job and had different radius, boundary technique and hover lift", then
// made them identical. Two inline copies of this markup is how that drift starts again: the next
// person restyles the one they are looking at. Both are now FRAMELESS (owner, 2026-07-23) — no box,
// no ring, no hover lift; the image is the surface. The two still track each other: restyle both.
import { formatDate } from "../data/content";
import { imageSrcSet } from "../data/catalog";
import type { ArticleCard } from "../data/content";

// The grid this tile sits in, so `sizes` can be right. A WRONG `sizes` is worse than no srcset — the
// browser picks a candidate for a width that does not exist. Enumerated rather than passed as a raw
// string so a call site cannot invent one that disagrees with its own CSS (same reasoning as
// ProductCard's `grid` prop). All of these sit in `max-w-7xl px-4 sm:px-6` with `gap-6`.
type ArticleGrid = "1-2-3" | "1-2" | "1-3" | "1-2-4";
const SIZES: Record<ArticleGrid, string> = {
  // /blog: grid-cols-1 sm:grid-cols-2 lg:grid-cols-3
  "1-2-3": "(min-width:1280px) 395px, (min-width:1024px) calc(33.3vw - 32px), (min-width:640px) calc(50vw - 36px), calc(100vw - 2rem)",
  // homepage Jurnal, columns=2 / 3 / 4 (components/sections/Blog.astro COLS)
  "1-2": "(min-width:1280px) 604px, (min-width:640px) calc(50vw - 36px), calc(100vw - 2rem)",
  "1-3": "(min-width:1280px) 395px, (min-width:640px) calc(33.3vw - 32px), calc(100vw - 2rem)",
  "1-2-4": "(min-width:1280px) 290px, (min-width:1024px) calc(25vw - 30px), (min-width:640px) calc(50vw - 36px), calc(100vw - 2rem)",
};

interface Props {
  article: ArticleCard;
  /** Which grid this tile is rendered into — drives `sizes`. See SIZES above. */
  grid?: ArticleGrid;
  /**
   * Heading level for the title, because the right one depends on where the card sits:
   * · /blog — the page's <h1> is "Cerita & Inspirasi", so each tile is an <h2>.
   * · homepage Jurnal section — the section already owns the <h2>, so each tile is an <h3>.
   * Hard-coding either would skip a level in the other, which is exactly the outline a screen-reader
   * user navigates by. Same markup, correct outline in both.
   */
  level?: 2 | 3;
}

const { article, level = 3, grid = "1-2-3" } = Astro.props;
const Title = `h${level}` as "h2" | "h3";
---

<a href={`/blog/${article.handle}`} class="group flex flex-col focus-visible:outline-none">
  {/* FRAMELESS / FLAT — matched to ProductCard (owner, 2026-07-23). The box is gone: no white fill,
      ring or drop-shadow lift. The image is the tile's one surface, so IT carries the thin `rounded-md`
      radius and the clip, and the focus ring hugs it. 3:2, the same lock as the article's feature image
      — merchant art arrives in every shape and letting each set its own ratio makes the grid look
      broken. An article with no image keeps the brand tint rather than a broken frame. */}
  <div class="aspect-[3/2] overflow-hidden rounded-md bg-brand-50 group-focus-visible:ring-2 group-focus-visible:ring-brand-400 group-focus-visible:ring-offset-2 group-focus-visible:ring-offset-cream">
    {
      article.imageUrl && (
        <img
          src={article.imageUrl}
          srcset={imageSrcSet(article.imageUrl)}
          sizes={imageSrcSet(article.imageUrl) ? SIZES[grid] : undefined}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
      )
    }
  </div>
  <div class="mt-3 flex flex-1 flex-col">
    <p class="text-xs font-medium uppercase tracking-[0.15em] text-brand-600">
      {formatDate(article.publishedAt)}
    </p>
    {/* Title clamps to two lines (like the product card) so a long headline can't push one tile taller
        than its row; the excerpt to two as well, keeping the grid an even rhythm of image → title →
        blurb → link. `mt-auto` pins "Baca selengkapnya" to the bottom so it aligns across the row. */}
    <Title class="mt-1.5 line-clamp-2 font-display text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-brand-700">
      {article.title}
    </Title>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{article.excerpt}</p>
    <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-brand-700">
      Baca selengkapnya
      <svg
        viewBox="0 0 24 24"
        class="h-4 w-4 fill-none stroke-current transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>
