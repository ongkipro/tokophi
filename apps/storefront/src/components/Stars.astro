---
// Reusable star rating. Fractional fill via a width-clipped BRAND-coloured overlay over muted
// outlines — the rating tracks the store's scheme colour (brand-500), not a fixed gold.
interface Props {
  value: number;
  count?: number;
  size?: "sm" | "md" | "lg";
  showValue?: boolean;
  class?: string;
}
const { value, count, size = "sm", showValue = true, class: cls = "" } = Astro.props;

const pct = Math.max(0, Math.min(100, (value / 5) * 100));
const STAR = "M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.62l5.82-.85L10 1.5Z";
const dim = size === "lg" ? "h-5 w-5" : size === "md" ? "h-4 w-4" : "h-3.5 w-3.5";
const text = size === "lg" ? "text-base" : size === "md" ? "text-sm" : "text-xs";
const stars = [0, 1, 2, 3, 4];
const label = `Rating ${value.toFixed(1)} dari 5${count != null ? `, ${count} ulasan` : ""}`;
---

<div class:list={["flex items-center gap-1.5", cls]} role="img" aria-label={label}>
  <div class="relative inline-flex" aria-hidden="true">
    <div class="flex gap-0.5 text-line">
      {stars.map(() => (
        <svg viewBox="0 0 20 20" class:list={[dim, "shrink-0 fill-current"]}>
          <path d={STAR} />
        </svg>
      ))}
    </div>
    <div class="absolute inset-0 flex gap-0.5 overflow-hidden text-brand-500" style={`width:${pct}%`}>
      {stars.map(() => (
        <svg viewBox="0 0 20 20" class:list={[dim, "shrink-0 fill-current"]}>
          <path d={STAR} />
        </svg>
      ))}
    </div>
  </div>
  {showValue && <span class:list={[text, "font-semibold text-ink tabular-nums"]} aria-hidden="true">{value.toFixed(1)}</span>}
  {count != null && <span class:list={[text, "text-muted"]} aria-hidden="true">({count})</span>}
</div>
