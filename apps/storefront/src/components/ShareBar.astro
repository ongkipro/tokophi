---
// SHARE BAR — the row of share targets. Extracted from blog/[handle].astro so the PRODUCT page can
// have one too.
//
// That it lived only on the article page was backwards. Forwarding a dress into a WhatsApp group is
// the acquisition channel these merchants actually have; a blog post is the one thing on the shop
// that does NOT need to be shared to make money. One component, both pages.
//
// Instagram is absent because it HAS no web share intent — a button for it could not work. Clap /
// bookmark / repost are absent for the same reason the article page never had them: no product
// behind them.
//
// ⚠️ TAP TARGETS ARE 44px (`h-11 w-11`), not the 36px this shipped with (design audit #16). The icon
// inside stays 18px — the target grew, the drawing did not, so nothing looks heavier.
//
// ⚠️ The hrefs are built ON THE SERVER now. The old version built them in a client script, on the
// argument that "one deploy serves every store, so there is no correct URL to bake in at SSR" — which
// was true of a hard-coded host and false of `Astro.locals.origin`, which is this request's real
// scheme+host (middleware reads x-forwarded-proto/host; it is the same value `<link rel=canonical>`
// has always been built from). Server-rendered hrefs also mean the share links work before — and
// without — JS. The script that remains does only the one thing that cannot be a link: the
// clipboard / native-share button.
interface Props {
  /**
   * ABSOLUTE canonical URL of the thing being shared. Build it from `Astro.locals.origin`, never
   * from a literal host, and drop the query string — `?utm_source=…` arrives constantly on ad-landed
   * traffic and there is no reason to forward one shopper's campaign tag into the next one's chat.
   */
  url: string;
  /** What the share text says. The bare title — NOT `document.title`, which carries the " — Toko" suffix. */
  title: string;
  /**
   * Absolute image URL. Pinterest REQUIRES a media URL, so the Pinterest button is rendered only
   * when there is one — a pin with no image is a dead button, not a share.
   */
  image?: string;
  /**
   * WhatsApp. Defaults ON and should stay on: this is Indonesia, and WA is where a link actually
   * travels. The prop exists so a surface that genuinely shouldn't offer it can say so, not as a
   * knob to turn off.
   */
  whatsapp?: boolean;
  class?: string;
}

const { url, title, image, whatsapp = true, class: className } = Astro.props;

const enc = encodeURIComponent;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const x = `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`;
// `wa.me/?text=` (no phone number) opens WhatsApp on the contact picker — a share, not a chat with
// the merchant. The URL goes INSIDE the text: WhatsApp has no separate url param.
const wa = `https://wa.me/?text=${enc(`${title} ${url}`)}`;
const pin = image
  ? `https://pinterest.com/pin/create/button/?url=${enc(url)}&media=${enc(image)}&description=${enc(title)}`
  : null;

const BTN =
  "inline-flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400";
---

<div class:list={["flex items-center", className]} data-share data-url={url} data-title={title}>
  {
    whatsapp && (
      <a data-share-wa href={wa} target="_blank" rel="noopener" title="Bagikan ke WhatsApp" class={BTN}>
        <span class="sr-only">Bagikan ke WhatsApp</span>
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
        </svg>
      </a>
    )
  }
  <a data-share-fb href={fb} target="_blank" rel="noopener" title="Bagikan ke Facebook" class={BTN}>
    <span class="sr-only">Bagikan ke Facebook</span>
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true">
      <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
    </svg>
  </a>
  <a data-share-x href={x} target="_blank" rel="noopener" title="Bagikan ke X" class={BTN}>
    <span class="sr-only">Bagikan ke X</span>
    <svg viewBox="0 0 24 24" class="h-[15px] w-[15px] fill-current" aria-hidden="true">
      <path d="M18.9 2H22l-6.77 7.73L23.2 22h-6.24l-4.88-6.38L6.5 22H3.4l7.24-8.27L2.8 2h6.4l4.41 5.83L18.9 2Zm-1.09 18.14h1.72L8.27 3.77H6.42l11.39 16.37Z" />
    </svg>
  </a>
  {
    pin && (
      <a data-share-pin href={pin} target="_blank" rel="noopener" title="Simpan ke Pinterest" class={BTN}>
        <span class="sr-only">Simpan ke Pinterest</span>
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.64 7.86 6.36 9.32-.09-.79-.17-2.01.03-2.88.18-.78 1.17-4.97 1.17-4.97s-.3-.6-.3-1.48c0-1.39.81-2.43 1.81-2.43.85 0 1.26.64 1.26 1.41 0 .86-.55 2.14-.83 3.33-.24 1 .5 1.81 1.48 1.81 1.78 0 3.15-1.88 3.15-4.58 0-2.4-1.72-4.07-4.18-4.07-2.85 0-4.52 2.13-4.52 4.34 0 .86.33 1.78.74 2.28.08.1.09.19.07.29-.08.33-.26 1-.29 1.14-.05.19-.15.23-.35.14-1.3-.61-2.11-2.5-2.11-4.03 0-3.28 2.38-6.29 6.87-6.29 3.61 0 6.41 2.57 6.41 6.01 0 3.58-2.26 6.47-5.4 6.47-1.05 0-2.04-.55-2.38-1.2l-.65 2.47c-.23.9-.86 2.03-1.29 2.72.97.3 2 .46 3.07.46 5.52 0 10-4.48 10-10S17.52 2 12 2Z" />
        </svg>
      </a>
    )
  }
  <button type="button" data-share-copy title="Salin tautan" class:list={[BTN, "relative"]}>
    <span class="sr-only">Salin tautan</span>
    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-none stroke-current" stroke-width="2" aria-hidden="true">
      <path
        d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7L12 19"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span
      data-share-copied
      hidden
      role="status"
      class="absolute -top-9 right-0 whitespace-nowrap rounded-md bg-ink px-2.5 py-1 text-xs font-medium text-cream"
    >
      Tautan disalin
    </span>
  </button>
</div>

<script is:inline>
  // Only the copy button needs JS — every other target is a plain link rendered by the server.
  (function () {
    document.querySelectorAll("[data-share]").forEach(function (root) {
      // A page may hold more than one bar, and this inline script is emitted once per instance —
      // without the guard the second copy would bind a second listener to the first bar.
      if (root.dataset.shareReady) return;
      root.dataset.shareReady = "1";

      var copy = root.querySelector("[data-share-copy]");
      if (!copy) return;
      var url = root.getAttribute("data-url") || window.location.href;
      var title = root.getAttribute("data-title") || document.title;

      copy.addEventListener("click", function () {
        // On a phone the native share sheet is strictly better than a clipboard copy. On desktop,
        // clipboard. Neither is guaranteed — a non-HTTPS origin exposes NO clipboard API at all — so
        // both paths fail silently instead of throwing at the shopper.
        if (navigator.share) {
          navigator.share({ title: title, url: url }).catch(function () {});
          return;
        }
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(url).then(function () {
          // Visible confirmation: a `title` tooltip would never be seen on touch, and a copy with no
          // feedback reads as a dead button.
          var done = copy.querySelector("[data-share-copied]");
          if (!done) return;
          done.hidden = false;
          setTimeout(function () {
            done.hidden = true;
          }, 1600);
        }, function () {});
      });
    });
  })();
</script>
