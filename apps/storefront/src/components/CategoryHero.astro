---
// CATEGORY HERO — the top of a /kategori/<handle> page. Two modes, both Shopify-pro minimalist:
//
//   • NO COVER (the normal case today) → a CENTRED editorial header: eyebrow + title + dek, generous
//     whitespace, a hairline rule below. Fills the width instead of the old left-heavy header that left
//     half the row empty, and drops the floating square thumbnail.
//   • COVER SET (merchant uploaded one in Kategori) → a FULL-BLEED immersive banner: the cover as a
//     cropped background with a bottom gradient scrim and the title in white, bottom-left.
//
// Deliberately NOT the shared PageHeader (blog/kontak/halaman still use that) — this is the category
// page's own hero, so it can be more of a hero without touching those.
import Breadcrumb from "./Breadcrumb.astro";
import type { Crumb } from "../lib/breadcrumb";

interface Props {
  crumbs?: Crumb[];
  /** Small brand kicker above the title. Defaults to "Koleksi". */
  eyebrow?: string;
  title: string;
  dek?: string;
  /** Merchant cover (already absolute via mediaUrl). Empty = the centred minimal header. */
  imageUrl?: string;
  imageAlt?: string;
}

const { crumbs, eyebrow = "Koleksi", title, dek, imageUrl, imageAlt = "" } = Astro.props;
const hasCrumbs = !!crumbs?.length;
---

{
  imageUrl ? (
    /* COVER MODE — ONE cohesive banner: the breadcrumb sits IN it (top-left, white) and the title at the
       bottom-left, over a scrim that darkens top + bottom for legibility. No separate breadcrumb strip
       above it, and a modest fixed height so the cover does not eat the whole viewport. */
    <section class="relative isolate overflow-hidden bg-ink">
      <img
        src={imageUrl}
        alt={imageAlt}
        width="1920"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/40 via-transparent to-black/65" />
      <div class="mx-auto flex min-h-[240px] max-w-7xl flex-col justify-between px-4 py-6 sm:min-h-[320px] sm:px-6 sm:py-8">
        {hasCrumbs && <Breadcrumb items={crumbs!} tone="light" />}
        <div>
          {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">{eyebrow}</p>}
          <h1 class="mt-2 font-display text-3xl font-semibold text-balance text-white sm:text-4xl">{title}</h1>
          {dek && <p class="mt-3 max-w-xl leading-relaxed text-white/85">{dek}</p>}
        </div>
      </div>
    </section>
  ) : (
    /* MINIMAL MODE — breadcrumb, then a centred editorial header, hairline rule below. */
    <section class="border-b border-line">
      {hasCrumbs && (
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6">
          <Breadcrumb items={crumbs!} />
        </div>
      )}
      <div class="mx-auto max-w-2xl px-4 pb-12 pt-6 text-center sm:pb-16 sm:pt-8">
        {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">{eyebrow}</p>}
        <h1 class:list={["font-display text-3xl font-semibold text-balance text-ink sm:text-4xl", eyebrow && "mt-2"]}>
          {title}
        </h1>
        {dek && <p class="mx-auto mt-4 max-w-xl leading-relaxed text-muted">{dek}</p>}
      </div>
    </section>
  )
}
