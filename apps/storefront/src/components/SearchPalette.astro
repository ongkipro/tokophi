---
// SEARCH PALETTE — the ⌘K overlay the header's magnifier opens.
//
// ── IT IS A NATIVE <dialog>, and that is most of the design ──────────────────────────────────────
// `showModal()` gives us, for free and correctly: a focus trap, Esc to close, inert background,
// top-layer stacking (no z-index war with the sticky header), and a styleable `::backdrop`. A
// hand-rolled div would be ~150 lines of focus management to arrive at something worse. Rung 4 of
// the ladder in CLAUDE.md: use the platform.
//
// ── IT IS AN ENHANCEMENT, NOT THE ONLY DOOR ─────────────────────────────────────────────────────
// The header trigger is a real `<a href="/cari">`. With JS off — or before this script runs — it
// simply navigates to the search page, which now carries its own input. Nothing about finding a
// product depends on this file loading. That is why the trigger must never become a `<button>`:
// a button with no JS is a dead control on every page of the shop.
//
// ── WHAT IT SHOWS ───────────────────────────────────────────────────────────────────────────────
// Empty query → the store's real best-sellers, so opening it offers somewhere to go instead of an
// empty box. Typing → products (thumbnail, price, sold-out state) and matching categories, from
// /api/search, which is a projection of the SAME `catalog.search()` /cari renders. The palette and
// the results page cannot disagree about what matches.
//
// Every state is written, not just the happy one: idle, loading, empty, error. A palette that shows
// nothing while a request is in flight reads as broken.
import { Search, Package, Tag, CornerDownLeft, X } from "@lucide/astro";
---

{/* One palette per page, mounted by Layout.astro so every route has it.

    ── PHONE: A FULL-HEIGHT SHEET, NOT A FLOATING CARD ─────────────────────────────────────────
    A centred card wastes the edges of a small screen and wobbles the moment the keyboard comes up.
    Edge to edge with `100dvh` (NOT `100vh` — the URL bar makes that taller than the screen), the
    input pinned at the top, the results taking whatever is left. From `sm` it becomes the card
    again, where a card is the right shape.

    ── WHAT WAS REMOVED, AND WHY ───────────────────────────────────────────────────────────────
    The footer strip of ⌘K-style key hints (↑ ↓ ⏎ Esc) is gone. Those keys still work; they are
    simply no longer advertised. Advertising them is what made this read as a developer console
    dropped into a clothes shop — and on a phone, which is most of this shop's traffic, that strip
    was unusable furniture eating the one dimension a phone has none of. */}
<dialog
  id="search-palette"
  data-search-dialog
  aria-label="Cari produk"
  {/* ⚠️ `sm:bottom-auto` is not cosmetic. A <dialog>'s UA style is `position:fixed; inset:0;
       margin:auto` — and `m-0` (needed for the phone sheet) removes the auto margins, so with all
       four insets still at 0 the box STRETCHES to the full inset area and `h-auto` resolves to the
       max-height. Measured: three results rendered in a 704px card with a field of empty cream under
       them. Releasing the bottom edge lets the card hug its contents again. */}
  class="m-0 h-[100dvh] max-h-none w-screen max-w-none border-0 bg-cream p-0 text-ink backdrop:bg-ink/40 sm:inset-x-0 sm:bottom-auto sm:top-[8vh] sm:mx-auto sm:h-auto sm:max-h-[min(80dvh,44rem)] sm:w-[min(38rem,calc(100vw-2rem))] sm:rounded-2xl sm:shadow-[0_24px_60px_-12px_rgb(43_35_38/0.35)] sm:ring-1 sm:ring-line"
>
  {/* `flex-col` + `min-h-0` on the scroller is what makes the phone keyboard behave: the results
      area SHRINKS, instead of pushing the input off the top of the screen. */}
  {/* `h-full` is for the PHONE sheet, which must fill the screen. On the desktop card it has to be
      `h-auto` or the panel stretches to its max-height and leaves a field of empty cream under three
      results — the box must hug what is in it. */}
  <div class="flex h-full flex-col sm:h-auto sm:max-h-[inherit]">
    <div class="flex shrink-0 items-center gap-3 border-b border-line px-4">
      <Search class="size-5 shrink-0 text-muted" stroke-width={1.8} aria-hidden="true" />
      {/* `text-base` is not a style choice: below 16px iOS Safari zooms the page on focus and never
          zooms back (see global.css). Do not shrink this for looks. */}
      <input
        id="search-palette-input"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="Cari produk atau kategori…"
        aria-controls="search-palette-results"
        class="min-h-14 w-full border-0 bg-transparent text-base text-ink placeholder:text-muted focus:outline-none"
      />
      {/* A word, not a glyph. "Batal" is a bigger target than a 14px ✕ and says what it does; the
          desktop card keeps the same control because two different close affordances for one
          component is one more thing to learn. */}
      <button
        type="button"
        data-search-close
        class="-mr-1 shrink-0 rounded-full px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-brand-50 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
      >
        Batal
      </button>
    </div>

    {/* `aria-live="polite"` so a screen-reader user is told the results changed; without it the list
        updates silently and only sighted users learn anything happened.
        `pb-[env(safe-area-inset-bottom)]` keeps the last row clear of the home indicator. */}
    <div
      id="search-palette-results"
      role="listbox"
      aria-live="polite"
      aria-busy="false"
      class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-1"
    >
    </div>
  </div>
</dialog>

{/* Icon markup the script clones into results. Rendering lucide components here — rather than
    hand-writing their paths in a JS string — keeps one source for each icon. */}
<template id="search-icon-product"><Package class="size-4 text-brand-500" stroke-width={1.75} /></template>
<template id="search-icon-category"><Tag class="size-4 text-brand-500" stroke-width={1.75} /></template>

<style>
  /* ONE entrance, not a pile of effects: the sheet rises from the bottom edge on a phone (the
     direction it will be dismissed in), the card settles down a few pixels on desktop. Both are
     ~180ms — long enough to read as motion, short enough that a shopper who opens this fifty times
     a session never waits for it. */
  @media (prefers-reduced-motion: no-preference) {
    #search-palette[open] {
      animation: palette-sheet 0.18s ease-out both;
    }
    #search-palette[open]::backdrop {
      animation: palette-fade 0.18s ease-out both;
    }
    @media (min-width: 640px) {
      #search-palette[open] {
        animation-name: palette-card;
      }
    }
  }
  @keyframes palette-sheet {
    from { transform: translateY(1.5rem); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes palette-card {
    from { transform: translateY(-0.5rem) scale(0.985); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  @keyframes palette-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Chromium draws its own ✕ inside `input[type=search]`, and it landed directly beside our close
     button: two identical glyphs, one labelled and 36px, one unlabelled and ~14px. Ours stays (it
     has an accessible name and a real tap target); the browser's is hidden. Esc also clears by
     closing, and re-opening always starts empty, so nothing is lost. */
  #search-palette-input::-webkit-search-cancel-button,
  #search-palette-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>

<script is:inline>
  (function () {
    var dialog = document.getElementById("search-palette");
    var input = document.getElementById("search-palette-input");
    var results = document.getElementById("search-palette-results");
    if (!dialog || !input || !results || !dialog.showModal) return; // no <dialog> support → the <a> still navigates

    var iconProduct = (document.getElementById("search-icon-product") || {}).innerHTML || "";
    var iconCategory = (document.getElementById("search-icon-category") || {}).innerHTML || "";

    var IDR = new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 });
    var esc = function (s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    };

    var items = [];   // the currently rendered <a>s, in visual order — what ↑↓ walks
    var active = -1;
    // Every fetch gets a number; only the newest one is allowed to paint. Without this, a slow
    // response for "dr" can land after "dress" and overwrite the newer results with older ones.
    var seq = 0;

    function setActive(i) {
      if (!items.length) return;
      active = (i + items.length) % items.length;
      items.forEach(function (el, n) {
        var on = n === active;
        el.setAttribute("aria-selected", on ? "true" : "false");
        el.classList.toggle("bg-brand-50", on);
        if (on) el.scrollIntoView({ block: "nearest" });
      });
    }

    // A PRODUCT ROW, in the shop's own language: a 3:4 portrait thumbnail, because a garment is
    // recognised by its silhouette and a square crops the silhouette away. Same aspect as
    // ProductCard, so the palette reads as a miniature of the grid rather than a list of commands.
    function productRow(p) {
      var thumb = p.image
        ? '<img src="' + esc(p.image) + '" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />'
        : '<span class="flex h-full w-full items-center justify-center">' + iconProduct + "</span>";
      var price = p.soldOut
        ? '<span class="text-xs font-medium text-muted">Stok habis</span>'
        : p.price > 0
          ? '<span class="text-sm font-semibold tabular-nums text-ink">' + esc(IDR.format(p.price)) + "</span>"
          : '<span class="text-xs font-medium text-muted">Tanya harga</span>';
      return (
        '<a href="/produk/' + esc(p.handle) + '" role="option" aria-selected="false" ' +
        'class="flex items-center gap-3 rounded-xl p-2 transition-colors hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none' +
        (p.soldOut ? " opacity-60" : "") + '">' +
          '<span class="h-14 w-[2.625rem] shrink-0 overflow-hidden rounded-lg bg-brand-50">' + thumb + "</span>" +
          '<span class="min-w-0 flex-1">' +
            '<span class="block truncate text-[0.95rem] font-medium leading-snug text-ink">' + esc(p.name) + "</span>" +
            '<span class="mt-0.5 block truncate text-xs text-muted">' + esc(p.category || "") + "</span>" +
          "</span>" +
          '<span class="shrink-0 pl-2 text-right">' + price + "</span>" +
        "</a>"
      );
    }

    // CATEGORIES ARE PILLS, not list rows — the shortcut shape an Indonesian shopper already reads
    // fluently, and three rows become one line on a screen with no vertical room to spare.
    function categoryPills(list) {
      return (
        '<div class="flex flex-wrap gap-2 px-2 pb-1 pt-2">' +
        list
          .map(function (c) {
            return (
              '<a href="/kategori/' + esc(c.handle) + '" role="option" aria-selected="false" ' +
              'class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-brand-50 px-4 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none">' +
              iconCategory + esc(c.name) + "</a>"
            );
          })
          .join("") +
        "</div>"
      );
    }

    // A label carrying its count is information; "PRODUK" in grey caps was decoration.
    function heading(text, count) {
      return (
        '<p class="px-3 pb-1 pt-3 text-xs font-medium text-muted">' + esc(text) +
        (count ? ' <span class="tabular-nums">· ' + count + "</span>" : "") + "</p>"
      );
    }

    function message(text) {
      return '<p class="px-4 py-12 text-center text-sm text-muted">' + esc(text) + "</p>";
    }

    // The way OUT sits at the END of the list, full width — where a thumb already is after scrolling
    // results. It used to be a right-aligned link in a footer bar: the corner of a phone furthest
    // from anyone's hand.
    function seeAllRow(q) {
      return (
        '<a href="/cari?q=' + encodeURIComponent(q) + '" role="option" aria-selected="false" ' +
        'class="mt-1 flex min-h-12 items-center justify-center gap-1.5 rounded-xl border border-line px-4 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none">' +
        "Lihat semua hasil untuk «" + esc(q) + "»</a>"
      );
    }

    function render(data, q) {
      var html = "";
      if (data.categories && data.categories.length) html += categoryPills(data.categories);
      if (data.products && data.products.length) {
        html += heading(q ? "Produk" : "Paling dicari", q ? data.products.length : 0);
        html += data.products.map(productRow).join("");
      }
      if (q) html += seeAllRow(q);

      if (!(data.products || []).length && !(data.categories || []).length) {
        // An empty result is a moment for direction, not for mood: say what happened, then offer the
        // one move that always works.
        html =
          message("Tidak ada yang cocok dengan «" + q + "».") +
          '<p class="px-4 pb-8 text-center"><a class="inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 text-sm font-semibold text-white" href="/produk">Telusuri semua produk</a></p>';
      }

      results.innerHTML = html;
      items = Array.prototype.slice.call(results.querySelectorAll("a[role='option']"));
      active = -1;
      if (items.length) setActive(0);
    }

    function search(q) {
      var mine = ++seq;
      results.setAttribute("aria-busy", "true");
      fetch("/api/search?q=" + encodeURIComponent(q), { headers: { accept: "application/json" } })
        .then(function (r) {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then(function (data) {
          if (mine !== seq) return; // a newer keystroke already won
          results.setAttribute("aria-busy", "false");
          render(data, q);
        })
        .catch(function () {
          if (mine !== seq) return;
          results.setAttribute("aria-busy", "false");
          // Say what happened AND leave a way out — the results page does not depend on this endpoint.
          // Name what failed and give the door that does not depend on it — /cari renders from the
          // server and needs nothing from this endpoint.
          results.innerHTML =
            message("Pencarian sedang bermasalah.") +
            '<p class="px-4 pb-8 text-center"><a class="inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 text-sm font-semibold text-white" href="/cari?q=' +
            encodeURIComponent(q) + '">Buka halaman pencarian</a></p>';
          items = [];
        });
    }

    var timer = null;
    input.addEventListener("input", function () {
      var q = input.value.trim();
      clearTimeout(timer);
      // 150ms: long enough that a fast typist sends one request instead of eight, short enough that
      // the list feels like it is keeping up.
      timer = setTimeout(function () {
        search(q);
      }, 150);
    });

    input.addEventListener("keydown", function (e) {
      // ⚠️ ESC HAS TO BE HANDLED HERE, even though <dialog> closes on Esc by itself. Inside an
      // `<input type="search">` the browser spends the FIRST Escape clearing the field and stops
      // there — so the palette stayed open and the shopper's only visible feedback was their query
      // vanishing. Measured in Chromium, not assumed. Esc always closes; the palette resets its
      // input on open anyway, so nothing is lost by skipping the clear.
      if (e.key === "Escape") { e.preventDefault(); dialog.close(); return; }
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") {
        e.preventDefault();
        // Enter opens the highlighted row. With nothing highlighted — an empty or failed result —
        // it falls through to the results page, which is what a shopper who ignored the list means.
        if (active >= 0 && items[active]) items[active].click();
        else window.location.href = "/cari?q=" + encodeURIComponent(input.value.trim());
      }
    });

    function open() {
      if (dialog.open) return;
      dialog.showModal();
      input.value = "";
      results.innerHTML = message("Memuat…");
      input.focus();
      search("");
    }

    document.querySelectorAll("[data-search-open]").forEach(function (el) {
      el.addEventListener("click", function (e) {
        e.preventDefault(); // the <a href="/cari"> is the no-JS fallback; with JS we open the palette
        open();
      });
    });
    dialog.querySelectorAll("[data-search-close]").forEach(function (el) {
      el.addEventListener("click", function () { dialog.close(); });
    });

    // Click on the backdrop closes. The dialog element's own box covers the panel, so compare the
    // pointer against its rect rather than trusting `e.target` — a click on padding is still "inside".
    dialog.addEventListener("click", function (e) {
      var r = dialog.getBoundingClientRect();
      var outside = e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if (outside) dialog.close();
    });

    document.addEventListener("keydown", function (e) {
      var k = e.key.toLowerCase();
      if ((e.metaKey || e.ctrlKey) && k === "k") { e.preventDefault(); open(); return; }
      // `/` is a shortcut only when the shopper is not already typing. Without this guard, typing
      // "Jl. Melati" into the checkout address opens the palette mid-address.
      if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
        var t = e.target;
        var tag = t && t.tagName ? t.tagName.toLowerCase() : "";
        if (tag === "input" || tag === "textarea" || tag === "select" || (t && t.isContentEditable)) return;
        e.preventDefault();
        open();
      }
    });
  })();
</script>
