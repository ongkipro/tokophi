---
// SEARCH PALETTE — the ⌘K overlay the header's magnifier opens.
//
// ── IT IS A NATIVE <dialog>, and that is most of the design ──────────────────────────────────────
// `showModal()` gives us, for free and correctly: a focus trap, Esc to close, inert background,
// top-layer stacking (no z-index war with the sticky header), and a styleable `::backdrop`. A
// hand-rolled div would be ~150 lines of focus management to arrive at something worse. Rung 4 of
// the ladder in CLAUDE.md: use the platform.
//
// ── IT IS AN ENHANCEMENT, NOT THE ONLY DOOR ─────────────────────────────────────────────────────
// The header trigger is a real `<a href="/cari">`. With JS off — or before this script runs — it
// simply navigates to the search page, which now carries its own input. Nothing about finding a
// product depends on this file loading. That is why the trigger must never become a `<button>`:
// a button with no JS is a dead control on every page of the shop.
//
// ── WHAT IT SHOWS ───────────────────────────────────────────────────────────────────────────────
// Empty query → the store's real best-sellers, so opening it offers somewhere to go instead of an
// empty box. Typing → products (thumbnail, price, sold-out state) and matching categories, from
// /api/search, which is a projection of the SAME `catalog.search()` /cari renders. The palette and
// the results page cannot disagree about what matches.
//
// Every state is written, not just the happy one: idle, loading, empty, error. A palette that shows
// nothing while a request is in flight reads as broken.
import { Search, Package, Tag, CornerDownLeft, X } from "@lucide/astro";

// The same automatic category list the desktop mega panel shows (Header.astro): every published
// category that has products, with its live count. Rendered into the dialog so the EMPTY state can
// offer categories without a request, in the same order and words as the menu.
const { catalog } = Astro.locals;
const CATEGORIES = catalog.collections
  .filter((c) => c.handle !== "produk-terlaris")
  .map((c) => ({ handle: c.handle, name: c.name, count: catalog.byCollection(c.handle).length }))
  .filter((c) => c.count > 0);
---

{/* One palette per page, mounted by Layout.astro so every route has it.

    ── ONE FULL SCREEN, AT EVERY WIDTH ─────────────────────────────────────────────────────────
    Phone, tablet and desktop all get the whole viewport. Searching is a mode, not a side panel: the
    shop behind it is not something you are meant to be reading while you type.

    Width is spent on BREATHING ROOM, not on stretching. The content sits in a centred `max-w-7xl`
    column — on a 1920px screen an input 1900px wide is not "using the space", it is losing the eye
    between the magnifier and the caret. The surface goes edge to edge; the reading measure does not.

    ⚠️ TWO HEIGHTS, on purpose. The DIALOG is a full-screen opaque sheet (`h-[100dvh]`) so the shop
    behind it is ALWAYS covered — even the strip the on-screen keyboard will overlay. The INNER column
    is the one that tracks the *visual* viewport (`--sp-h` = `visualViewport.height`): the input pins to
    the visible top and the results scroll in exactly the space ABOVE the keyboard. Earlier the DIALOG
    itself was only `--sp-h` tall, so below it — between the last result and the keyboard — the page
    bled through and scrolled (seen on a real iPhone, 2026-07-23). Covering the whole screen with the
    sheet and bounding only the CONTENT means the worst case is "a result sits under the keyboard", never
    "the store shows through". `100dvh` is the fallback where `visualViewport` is absent. */}
<dialog
  id="search-palette"
  data-search-dialog
  aria-label="Cari produk"
  data-categories={JSON.stringify(CATEGORIES)}
  class="fixed inset-x-0 top-0 m-0 h-[100dvh] max-h-none w-screen max-w-none overscroll-contain rounded-none border-0 bg-cream p-0 text-ink md:bottom-auto md:h-auto md:max-h-[85vh] md:shadow-[0_24px_48px_-24px_rgb(0_0_0/0.35)]"
>
  {/* The INNER column is what visualViewport sizes (`--sp-h`) + shifts (`translateY(offsetTop)`); the
      sheet above stays pinned full-screen. `min-h-0` on the scroller lets the results area SHRINK
      instead of pushing the input off the top of the screen when the keyboard opens. */}
  <div data-sp-inner style="height: var(--sp-h, 100dvh);" class="flex flex-col overflow-hidden md:h-auto! md:max-h-[85vh]">
    {/* REDESIGN C (owner 2026-11-05, "Shopify modern"): the query sits in a real bordered FIELD, with
        its own clear button, instead of bare text on a white sheet. Same column as the results. */}
    <div class="shrink-0 border-b border-line">
      <div class="mx-auto flex w-full max-w-7xl items-center gap-2 px-4 py-3 sm:px-6 md:py-4">
        <label class="flex min-h-12 flex-1 items-center gap-2 rounded-lg border border-line bg-white px-3 transition-[border-color,box-shadow] hover:border-muted focus-within:border-ink focus-within:shadow-[0_0_0_1px_var(--color-ink)]">
          <Search class="size-5 shrink-0 text-muted" stroke-width={1.8} aria-hidden="true" />
          {/* `text-base` is not a style choice: below 16px iOS Safari zooms the page on focus and never
              zooms back (see global.css). Do not shrink this for looks. */}
          <input
            id="search-palette-input"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="Cari produk atau kategori…"
            aria-label="Cari produk atau kategori"
            aria-controls="search-palette-results"
            class="h-11 w-full min-w-0 border-0 bg-transparent text-base text-ink placeholder:text-muted focus:outline-none"
          />
          <button
            type="button"
            data-search-clear
            hidden
            aria-label="Hapus pencarian"
            class="-mr-1.5 inline-flex size-9 shrink-0 items-center justify-center rounded-full text-muted transition-colors hover:bg-mist hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          >
            <X class="size-4" stroke-width={2} aria-hidden="true" />
          </button>
        </label>
        {/* A word, not a glyph: a bigger target than a 14px ✕, and it says what it does. */}
        <button
          type="button"
          data-search-close
          class="inline-flex min-h-11 shrink-0 items-center rounded-lg px-3 text-sm font-medium text-ink transition-colors hover:bg-mist focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
        >
          Batal
        </button>
      </div>
    </div>

    {/* The SCROLLER is full width so its scrollbar sits at the screen edge where a scrollbar belongs;
        the column inside it stays at reading measure.
        `aria-live="polite"` so a screen-reader user is told the results changed — without it the list
        updates silently and only sighted users learn anything happened.
        `pb-[env(safe-area-inset-bottom)]` keeps the last row clear of the home indicator. */}
    <div
      id="search-palette-results"
      role="listbox"
      aria-live="polite"
      aria-busy="false"
      class="min-h-0 flex-1 overflow-y-auto overscroll-contain md:max-h-[calc(85vh-5rem)]"
    >
    </div>
  </div>
</dialog>

{/* Icon markup the script clones into results. Rendering lucide components here — rather than
    hand-writing their paths in a JS string — keeps one source for each icon. */}
<template id="search-icon-product"><Package class="size-4 text-muted" stroke-width={1.75} /></template>
<template id="search-icon-category"><Tag class="size-4 text-muted" stroke-width={1.75} /></template>

<style>
  /* ONE entrance. The surface is opaque and covers the viewport, so there is no backdrop to fade and
     no card to scale — a short rise and fade is the whole gesture, at every width. ~180ms: long
     enough to read as motion, short enough that opening this fifty times a session never costs a wait. */
  @media (prefers-reduced-motion: no-preference) {
    #search-palette[open] {
      animation: palette-in 0.18s ease-out both;
    }
  }
  @keyframes palette-in {
    from { transform: translateY(0.75rem); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* Chromium draws its own ✕ inside `input[type=search]`, and it landed directly beside our close
     button: two identical glyphs, one labelled and 36px, one unlabelled and ~14px. Ours stays (it
     has an accessible name and a real tap target); the browser's is hidden. Esc also clears by
     closing, and re-opening always starts empty, so nothing is lost. */
  /* From md the palette is a panel, not a sheet: the shop shows (dimmed) beneath it. */
  #search-palette::backdrop { background: rgb(0 0 0 / 0.35); }

  #search-palette-input::-webkit-search-cancel-button,
  #search-palette-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>

{/* GLOBAL, not scoped: everything below targets markup the script injects with `innerHTML`, which never
    carries Astro's scope attribute — a scoped rule here silently matches nothing. */}
<style is:global>
  /* ↑↓ highlight — an outline on the active option, never a fill. */
  #search-palette-results a[data-active] { outline: 2px solid var(--color-ink); outline-offset: 3px; border-radius: 4px; }
  /* From md the panel shows ONE full row of products (4, then 5 from lg); the rest is one click away
     in "Lihat semua hasil". Phones keep every result. */
  @media (min-width: 768px) { #search-palette-results [data-sp-grid] > :nth-child(n + 5) { display: none; } }
  @media (min-width: 1024px) { #search-palette-results [data-sp-grid] > :nth-child(5) { display: block; } }
</style>

<script is:inline>
  (function () {
    var dialog = document.getElementById("search-palette");
    var input = document.getElementById("search-palette-input");
    var results = document.getElementById("search-palette-results");
    if (!dialog || !input || !results || !dialog.showModal) return; // no <dialog> support → the <a> still navigates

    var iconProduct = (document.getElementById("search-icon-product") || {}).innerHTML || "";
    var iconCategory = (document.getElementById("search-icon-category") || {}).innerHTML || "";

    var IDR = new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 });
    var esc = function (s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    };

    var items = [];   // the currently rendered <a>s, in visual order — what ↑↓ walks
    var active = -1;
    // Every fetch gets a number; only the newest one is allowed to paint. Without this, a slow
    // response for "dr" can land after "dress" and overwrite the newer results with older ones.
    var seq = 0;

    function setActive(i) {
      if (!items.length) return;
      active = (i + items.length) % items.length;
      items.forEach(function (el, n) {
        var on = n === active;
        el.setAttribute("aria-selected", on ? "true" : "false");
        el.toggleAttribute("data-active", on);
        if (on) el.scrollIntoView({ block: "nearest" });
      });
    }

    // ── `sizes` FOR A CARD, DERIVED FROM THE PALETTE'S OWN GRID ────────────────────────────────────
    // Same measure as the desktop mega panel (owner 2026-11-05): `max-w-7xl px-4 sm:px-6`; from md an
    // `11rem` suggestions column + `gap-12` beside the grid. Cards have no padding, so image = column:
    //   <768       2-up, gap-3:  (100vw - 32 - 12) / 2                   = calc(50vw - 22px)
    //   768-1023   4-up, gap-4:  (100vw - 48 - 48) / 4  (no suggestions)  = calc(25vw - 24px)
    //   1024-1279  5-up, gap-4:  (100vw - 48 - 64) / 5  (no suggestions)  = calc(20vw - 22px)
    //   >=1280     (1280 - 48 - 64) / 5 = 234px without suggestions, 188px with them
    // ONE `sizes` serves both layouts, so it declares the WIDER (no-suggestions) box: the only error it
    // can make is a rung up, never a blurry image. `scripts/check-search-srcset.mjs` measures it.
    var CARD_SIZES = "(min-width: 1280px) 234px, (min-width: 1024px) calc(20vw - 22px), (min-width: 768px) calc(25vw - 24px), calc(50vw - 22px)";

    // A PRODUCT CARD in the shop's own language — the same shape as `ProductCard.astro` after redesign
    // C: image (4:5, 4px radius) → name (two lines, regular weight) → price. No category eyebrow.
    // ⚠️ THE IMAGE CARRIES A SRCSET, AND IT COMES FROM THE SERVER (`api/search.ts`). This <img> does not
    // exist until somebody opens the palette, so only the browser check above can see it. `p.srcset`
    // absent → both attributes omitted. Everything goes through `esc` — this is string concatenation
    // into `innerHTML`, so an unescaped value is an injection vector, not just a bug.
    function productCard(p) {
      var srcset = p.srcset ? ' srcset="' + esc(p.srcset) + '" sizes="' + esc(CARD_SIZES) + '"' : "";
      var thumb = p.image
        ? '<img src="' + esc(p.image) + '"' + srcset + ' alt="" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />'
        : '<span class="flex h-full w-full items-center justify-center">' + iconProduct + "</span>";
      var price = p.soldOut
        ? '<span class="text-sm text-muted">Stok habis</span>'
        : p.price > 0
          ? '<span class="text-sm font-semibold tabular-nums text-ink">' + esc(IDR.format(p.price)) + "</span>"
          : '<span class="text-sm text-muted">Tanya harga</span>';
      return (
        '<a href="/produk/' + esc(p.handle) + '" role="option" aria-selected="false" ' +
        'class="group block min-w-0 focus-visible:outline-none' + (p.soldOut ? " opacity-60" : "") + '">' +
          '<span class="block aspect-[4/5] w-full overflow-hidden rounded-sm bg-mist">' + thumb + "</span>" +
          '<span class="mt-2 line-clamp-2 break-words text-sm leading-snug text-ink">' + esc(p.name) + "</span>" +
          '<span class="mt-0.5 block">' + price + "</span>" +
        "</a>"
      );
    }

    function productGrid(list) {
      // From md the panel shows ONE full row (4, then 5 from lg) — a lone card on a second row read as a
      // mistake; "Lihat semua hasil" is the way to the rest. Phones keep every result (2-up, scrolls).
      return '<div data-sp-grid class="grid grid-cols-2 gap-x-3 gap-y-6 md:grid-cols-4 md:gap-x-4 lg:grid-cols-5">' + list.map(productCard).join("") + "</div>";
    }

    // SUGGESTIONS — the left column from md (a plain text list, Horizon-style); on a phone the same links
    // become one horizontal row of outlined chips above the products, so they cost one line of height.
    function suggestionLink(href, label, count) {
      return (
        '<a href="' + href + '" role="option" aria-selected="false" ' +
        'class="inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border border-line px-3.5 text-sm text-ink transition-colors hover:border-ink ' +
        'md:flex md:min-h-0 md:justify-between md:gap-3 md:rounded-sm md:border-0 md:px-0 md:py-1.5 md:text-[0.9375rem] md:underline-offset-4 md:hover:underline">' +
        '<span class="truncate">' + label + "</span>" +
        (count != null ? '<span class="hidden shrink-0 text-sm text-muted tabular-nums md:inline">' + count + "</span>" : "") +
        "</a>"
      );
    }
    var STORE_CATEGORIES = [];
    try { STORE_CATEGORIES = JSON.parse(dialog.getAttribute("data-categories") || "[]"); } catch (e) { STORE_CATEGORIES = []; }
    function suggestions(data, q) {
      var links = [];
      if (q) links.push(suggestionLink("/cari?q=" + encodeURIComponent(q), "Cari \u201c" + esc(q) + "\u201d"));
      // Typed → the categories the API matched; empty → every category, with counts (= the mega panel).
      var cats = q ? data.categories || [] : STORE_CATEGORIES;
      cats.forEach(function (c) {
        links.push(suggestionLink("/kategori/" + esc(c.handle), esc(c.name), q ? null : c.count));
      });
      if (!links.length) return "";
      return (
        "<div>" +
          heading(q ? "Saran" : "Kategori") +
          '<div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6 md:mx-0 md:flex-col md:gap-0 md:overflow-visible md:px-0">' +
          links.join("") + "</div>" +
        "</div>"
      );
    }

    // A label carrying its count is information; grey caps were decoration.
    function heading(text, count) {
      // Same label as the mega panel's ("Belanja", "Kategori", "Produk terbaru"): small, muted, no caps.
      return '<p class="mb-3 text-sm text-muted">' + esc(text) + (count ? ' <span class="tabular-nums">· ' + count + "</span>" : "") + "</p>";
    }

    function message(text) {
      return '<p class="mx-auto w-full max-w-7xl px-4 py-16 text-center text-sm text-muted">' + esc(text) + "</p>";
    }

    // The way OUT: under the products, as a text link with an arrow (the Horizon footer of the panel).
    function seeAllRow(q) {
      return (
        '<a href="/cari?q=' + encodeURIComponent(q) + '" role="option" aria-selected="false" ' +
        'class="mt-6 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-ink underline underline-offset-4 hover:text-brand-700">' +
        "Lihat semua hasil untuk \u201c" + esc(q) + "\u201d →</a>"
      );
    }

    var BTN = "inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-700";

    function render(data, q) {
      var products = data.products || [];
      var html = "";
      var side = suggestions(data, q);
      var main = "";
      if (products.length) {
        main += heading(q ? "Produk" : "Paling dicari", q ? products.length : 0);
        main += productGrid(products);
      }
      if (q && products.length) main += seeAllRow(q);
      html =
        '<div class="mx-auto w-full max-w-7xl px-4 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-4 sm:px-6 md:pb-10 md:pt-6' +
          (side ? ' md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-12">' + side + '<div class="mt-6 min-w-0 md:mt-0">' : '"><div class="min-w-0">') +
          main + "</div>" +
        "</div>";

      if (!products.length && !(data.categories || []).length) {
        // An empty result is a moment for direction, not for mood: say what happened, then offer the
        // one move that always works.
        html =
          message("Tidak ada yang cocok dengan \u201c" + q + "\u201d.") +
          '<p class="px-4 pb-8 text-center"><a class="' + BTN + '" href="/produk">Telusuri semua produk</a></p>';
      }

      results.innerHTML = html;
      // Only what is visible: ↑↓ must never land on a card the row limit above has hidden.
      items = Array.prototype.slice.call(results.querySelectorAll("a[role='option']")).filter(function (el) { return el.offsetParent !== null; });
      active = -1;
    }

    function search(q) {
      var mine = ++seq;
      results.setAttribute("aria-busy", "true");
      fetch("/api/search?q=" + encodeURIComponent(q), { headers: { accept: "application/json" } })
        .then(function (r) {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then(function (data) {
          if (mine !== seq) return; // a newer keystroke already won
          results.setAttribute("aria-busy", "false");
          render(data, q);
        })
        .catch(function () {
          if (mine !== seq) return;
          results.setAttribute("aria-busy", "false");
          // Say what happened AND leave a way out — the results page does not depend on this endpoint.
          // Name what failed and give the door that does not depend on it — /cari renders from the
          // server and needs nothing from this endpoint.
          results.innerHTML =
            message("Pencarian sedang bermasalah.") +
            '<p class="px-4 pb-8 text-center"><a class="' + BTN + '" href="/cari?q=' +
            encodeURIComponent(q) + '">Buka halaman pencarian</a></p>';
          items = [];
        });
    }

    var timer = null;
    var clearBtn = dialog.querySelector("[data-search-clear]");
    if (clearBtn) clearBtn.addEventListener("click", function () {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });
    input.addEventListener("input", function () {
      var q = input.value.trim();
      if (clearBtn) clearBtn.hidden = !input.value;
      clearTimeout(timer);
      // 150ms: long enough that a fast typist sends one request instead of eight, short enough that
      // the list feels like it is keeping up.
      timer = setTimeout(function () {
        search(q);
      }, 150);
    });

    input.addEventListener("keydown", function (e) {
      // ⚠️ ESC HAS TO BE HANDLED HERE, even though <dialog> closes on Esc by itself. Inside an
      // `<input type="search">` the browser spends the FIRST Escape clearing the field and stops
      // there — so the palette stayed open and the shopper's only visible feedback was their query
      // vanishing. Measured in Chromium, not assumed. Esc always closes; the palette resets its
      // input on open anyway, so nothing is lost by skipping the clear.
      if (e.key === "Escape") { e.preventDefault(); dialog.close(); return; }
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") {
        e.preventDefault();
        // Enter opens the highlighted row. With nothing highlighted — an empty or failed result —
        // it falls through to the results page, which is what a shopper who ignored the list means.
        if (active >= 0 && items[active]) items[active].click();
        else window.location.href = "/cari?q=" + encodeURIComponent(input.value.trim());
      }
    });

    // LOCK THE PAGE BEHIND IT — the iOS-safe way. `overflow:hidden` on <html>/<body> is IGNORED by
    // iOS Safari for touch scrolling, so the background kept moving behind the open panel. Pinning the
    // BODY at `position:fixed; top:-scrollY` is the method that actually holds on every engine; the
    // scroll position is put back on unlock. The desktop scrollbar's width is handed back as padding
    // so the layout does not jump when it disappears.
    var _savedScrollY = 0;
    function lockScroll() {
      _savedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
      var gap = window.innerWidth - document.documentElement.clientWidth;
      var body = document.body;
      body.style.position = "fixed";
      body.style.top = -_savedScrollY + "px";
      body.style.left = "0";
      body.style.right = "0";
      body.style.width = "100%";
      if (gap > 0) body.style.paddingRight = gap + "px";
    }
    function unlockScroll() {
      var body = document.body;
      body.style.position = "";
      body.style.top = "";
      body.style.left = "";
      body.style.right = "";
      body.style.width = "";
      body.style.paddingRight = "";
      window.scrollTo(0, _savedScrollY);
    }
    // ⚠️ On the `close` EVENT, not inside the close button's handler: Escape closes a <dialog>
    // natively and never runs our button code. Hooking the button alone locks the page forever.
    var inner = dialog.querySelector("[data-sp-inner]");
    dialog.addEventListener("close", function () {
      unlockScroll();
      if (inner) inner.style.transform = "";
      dialog.style.removeProperty("--sp-h");
    });

    // ── KEYBOARD-AWARE HEIGHT ────────────────────────────────────────────────────────────────
    // `visualViewport.height` is the part of the page NOT covered by the on-screen keyboard. Pinning
    // the dialog to it (via `--sp-h`) is what keeps the last result reachable instead of hidden
    // behind the keyboard — the whole reason "search while typing" felt cut off on a phone.
    // `offsetTop` matters too: iOS scrolls the layout viewport up under the keyboard, so the visual
    // viewport starts a few pixels down; translating by it keeps the input pinned to the real top.
    var vv = window.visualViewport;
    function syncViewport() {
      if (!vv) return;
      // `--sp-h` sizes the INNER column (inherited via the CSS var); `offsetTop` shifts it down so the
      // input stays at the visible top when iOS scrolls the layout viewport under the keyboard. The
      // full-screen sheet itself never moves — it must keep covering the store behind it.
      dialog.style.setProperty("--sp-h", vv.height + "px");
      if (inner) inner.style.transform = vv.offsetTop ? "translateY(" + vv.offsetTop + "px)" : "";
    }
    if (vv) {
      vv.addEventListener("resize", syncViewport);
      vv.addEventListener("scroll", syncViewport);
    }

    function open() {
      if (dialog.open) return;
      lockScroll();
      dialog.showModal();
      syncViewport();
      input.value = "";
      if (clearBtn) clearBtn.hidden = true;
      results.innerHTML = message("Memuat…");
      input.focus();
      search("");
    }

    document.querySelectorAll("[data-search-open]").forEach(function (el) {
      el.addEventListener("click", function (e) {
        e.preventDefault(); // the <a href="/cari"> is the no-JS fallback; with JS we open the palette
        open();
      });
    });
    dialog.querySelectorAll("[data-search-close]").forEach(function (el) {
      el.addEventListener("click", function () { dialog.close(); });
    });

    // Click on the backdrop closes. The dialog element's own box covers the panel, so compare the
    // pointer against its rect rather than trusting `e.target` — a click on padding is still "inside".
    dialog.addEventListener("click", function (e) {
      var r = dialog.getBoundingClientRect();
      var outside = e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if (outside) dialog.close();
    });

    document.addEventListener("keydown", function (e) {
      var k = e.key.toLowerCase();
      if ((e.metaKey || e.ctrlKey) && k === "k") { e.preventDefault(); open(); return; }
      // `/` is a shortcut only when the shopper is not already typing. Without this guard, typing
      // "Jl. Melati" into the checkout address opens the palette mid-address.
      if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey) {
        var t = e.target;
        var tag = t && t.tagName ? t.tagName.toLowerCase() : "";
        if (tag === "input" || tag === "textarea" || tag === "select" || (t && t.isContentEditable)) return;
        e.preventDefault();
        open();
      }
    });
  })();
</script>
