---
// PAGINATION — real links to real URLs. No client state, no JS required.
//
// Every control on this storefront that changes WHAT IS ON SCREEN lives in the URL (`?q=`, `?sort=`,
// now `?page=`), for the same three reasons each time: the view is shareable, the back button works,
// and it renders with JS off. An "infinite scroll" would have failed all three — and would have
// re-fired RevealGrid's MutationObserver, the exact bug that moved sorting to the server.
//
// Page 1 is the BARE url — `?page=1` is deleted, not written. One list page, one address: otherwise
// `/produk` and `/produk?page=1` are two URLs for identical HTML, and every internal link has to
// remember which one it meant.
//
// EVERY OTHER PARAM IS CARRIED. Paging out of a filtered, sorted search result must keep the filter,
// the sort AND the query — dropping any of them silently throws the shopper back to the full
// catalogue, which reads as the site losing their place.
interface Props {
  /** 1-based, already clamped by the caller. */
  page: number;
  totalPages: number;
  /** What is being paged, for the nav's accessible name. */
  label?: string;
}

const { page, totalPages, label = "Halaman produk" } = Astro.props;

const href = (n: number) => {
  const url = new URL(Astro.url);
  if (n <= 1) url.searchParams.delete("page");
  else url.searchParams.set("page", String(n));
  return `${url.pathname}${url.search}`;
};

// First, last, and the current page ±1 — everything else collapses into a single ellipsis. At 7 pages
// or fewer that formula already yields every page, so there is no separate "show them all" branch.
const WINDOW = 1;
const slots: (number | "gap")[] = [];
for (let n = 1; n <= totalPages; n += 1) {
  if (n === 1 || n === totalPages || Math.abs(n - page) <= WINDOW) slots.push(n);
  else if (slots[slots.length - 1] !== "gap") slots.push("gap");
}

// Shared with the number links so a disabled arrow keeps the exact footprint of an enabled one —
// min-h-11/min-w-11 is the 44px tap target the a11y pass fixed everywhere else.
const CELL =
  "inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 text-sm font-medium tabular-nums";
const LINK =
  "border border-line bg-white text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream motion-reduce:transition-none";
// A disabled arrow is a <span>, never an <a>: there is no such thing as a link that goes nowhere, and
// `aria-disabled` on an anchor still lets a keyboard user follow it.
const OFF = "border border-line/60 bg-transparent text-muted/60";
---

{
  totalPages > 1 && (
    <nav aria-label={label} class="mx-auto mt-12 max-w-7xl px-4 sm:px-6">
      <div class="rounded-[1.25rem] border border-line bg-white/75 p-4 shadow-sm backdrop-blur supports-[backdrop-filter]:bg-cream/80 sm:p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium text-ink">Halaman {page} dari {totalPages}</p>
            <p class="mt-1 text-xs text-muted">Lanjutkan telusuri katalog tanpa kehilangan urutan yang sedang dipilih.</p>
          </div>

          <div class="flex flex-wrap items-center gap-2 sm:justify-end">
            {page > 1 ? (
              <a href={href(page - 1)} rel="prev" class:list={[CELL, LINK]}>
                <span aria-hidden="true">‹</span>
                <span class="ml-1 hidden sm:inline">Sebelumnya</span>
                <span class="sr-only sm:hidden">Halaman sebelumnya</span>
              </a>
            ) : (
              <span class:list={[CELL, OFF]} aria-hidden="true">
                <span>‹</span>
                <span class="ml-1 hidden sm:inline">Sebelumnya</span>
              </span>
            )}

            <ol class="flex items-center gap-1">
              {slots.map((slot) =>
                slot === "gap" ? (
                  <li class:list={[CELL, "text-muted"]} aria-hidden="true">
                    …
                  </li>
                ) : (
                  <li>
                    {slot === page ? (
                      <span class:list={[CELL, "bg-brand-600 font-semibold text-white"]} aria-current="page">
                        {slot}
                      </span>
                    ) : (
                      <a href={href(slot)} class:list={[CELL, LINK]} aria-label={`Halaman ${slot}`}>
                        {slot}
                      </a>
                    )}
                  </li>
                ),
              )}
            </ol>

            {page < totalPages ? (
              <a href={href(page + 1)} rel="next" class:list={[CELL, LINK]}>
                <span class="mr-1 hidden sm:inline">Berikutnya</span>
                <span class="sr-only sm:hidden">Halaman berikutnya</span>
                <span aria-hidden="true">›</span>
              </a>
            ) : (
              <span class:list={[CELL, OFF]} aria-hidden="true">
                <span class="mr-1 hidden sm:inline">Berikutnya</span>
                <span>›</span>
              </span>
            )}
          </div>
        </div>
      </div>
    </nav>
  )
}
