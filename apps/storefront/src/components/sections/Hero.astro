---
// ADR 0009 — Hero section (storefront half). Props-driven, placed + edited from the Tema builder;
// nothing here is hardcoded to the homepage.
//
// Layout: a FULL-BLEED hero — the image is the background of the whole section, the copy sits on
// top of it. The slides CROSS-FADE (opacity), they don't translate: no width math, no clones, and it
// is the one transition that degrades to "nothing moves" under prefers-reduced-motion.
//
// Carousel chrome (dots, autoplay) only appears from 2 slides up — a 1-slide hero, which is what
// every pre-carousel saved template resolves to via `heroSlides()`, stays a plain static hero.
import { heroSlides, HERO_INTERVAL_MS, type HeroConfig } from "@tokophi/sections";

type Props = HeroConfig;
const { align, badge, ratingText, intervalMs } = Astro.props;

const slides = heroSlides(Astro.props);
const isCarousel = slides.length > 1;
// 0 (or a nonsense value) = autoplay off; the merchant can park the hero on slide 1.
const interval = typeof intervalMs === "number" && intervalMs >= 0 ? intervalMs : HERO_INTERVAL_MS;

// Copy sits ON the photo, so it is white — which makes the layer UNDER the image load-bearing for
// legibility, not decoration. It is `ink` (a fixed dark token), never `brand-*`: brand is a merchant
// hex expanded to a scale (@tokophi/lib/colors), so a store with a pale brand would render white
// text on a near-white panel the moment an image 404s or a slide carries no imageUrl at all.
const FOCAL = { left: "object-left", center: "object-center", right: "object-right" } as const;
const focalClass = (s: (typeof slides)[number]) => FOCAL[s.focal ?? "center"];
const centered = align === "center";
---

<section
  class="relative isolate flex min-h-[32rem] items-end overflow-hidden bg-ink md:min-h-[36rem] md:items-center lg:min-h-[42rem]"
  data-hero
  data-interval={interval}
  aria-roledescription={isCarousel ? "carousel" : undefined}
  aria-label={isCarousel ? "Sorotan koleksi" : undefined}
>
  <!-- Background images — full-bleed, cross-faded. A failed/missing image just reveals the `ink`
       section background, so the copy stays legible instead of landing on a broken frame.

       ⚠️ ONLY SLIDE 1 GETS A `src`. The rest carry `data-src` and are loaded by the script below,
       after load, on idle. `loading="lazy"` did NOT do this and cannot: lazy only defers images
       BELOW THE FOLD, and all the slides are stacked at `inset-0` — dead centre of the viewport. So
       every slide downloaded during first paint. Measured on live: **278.6KB of hero, of which
       212.6KB was `opacity: 0`** — invisible for the first several seconds, and competing for
       bandwidth with the LCP image, which is slide 1. The carousel only advances via JS, so a
       no-JS visitor could never reach slides 2..n anyway: nothing is lost by letting JS ask for them. -->
  {
    slides.map((slide, i) =>
      slide.imageUrl ? (
        <img
          data-hero-img
          src={i === 0 ? slide.imageUrl : undefined}
          data-src={i === 0 ? undefined : slide.imageUrl}
          alt=""
          width="1920"
          height="1080"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          decoding={i === 0 ? "sync" : "async"}
          onerror="this.style.display='none'"
          class:list={[
            "absolute inset-0 -z-10 h-full w-full object-cover transition-opacity duration-1000 ease-out motion-reduce:transition-none",
            focalClass(slide),
            i === 0 ? "opacity-100" : "opacity-0",
          ]}
        />
      ) : (
        /* No image → the BRAND-TINTED PANEL the registry has always promised ("empty = brand-tinted
           gradient panel"). It did not exist: this div carried no background at all, so an image-less
           hero fell through to the section's flat `bg-ink` — a generic dark slab identical on every
           store. That is the hero a merchant who has not built a homepage yet actually gets, so it is
           worth being their colour rather than nobody's.
           `brand-700 → ink` (not a pale shade): the copy on top is white, and the scrim below only
           DARKENS. A merchant with a pale brand hex must still get legible white text. */
        <div
          data-hero-img
          class:list={[
            "absolute inset-0 -z-10 bg-gradient-to-br from-brand-700 via-brand-600 to-ink",
            i === 0 ? "opacity-100" : "opacity-0",
          ]}
        />
      ),
    )
  }

  <!-- Scrim. Two layers, and they are what buys AA contrast for white text over an arbitrary
       merchant photo: a bottom-up wash (a light sky would otherwise wash out the copy) plus, for a
       left-aligned hero, a left-to-right wash that darkens exactly the column the text occupies and
       leaves the right of the photo clean.
       The horizontal wash is DESKTOP-ONLY (`hidden md:block`): a phone is too narrow to have a
       "text column" and a "photo column", so there it would just dim the whole frame. Narrow screens
       instead drop the copy to the bottom (`items-end` above) and lean on the vertical wash, which
       keeps the subject's face visible ABOVE the text instead of behind it. -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/55 to-ink/30"></div>
  {
    !centered && (
      <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-ink/80 via-ink/35 to-transparent md:block" />
    )
  }

  <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 md:py-24">
    <div class:list={["max-w-xl", centered && "mx-auto text-center"]}>
      {
        badge && (
          <span class="mb-6 inline-flex rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-medium tracking-wide text-white ring-1 ring-white/30 backdrop-blur-sm">
            {badge}
          </span>
        )
      }
      <!-- Slides stacked in a single grid cell so the tallest one sets the height (no layout jump
           mid-cross-fade). -->
      <div class="grid grid-cols-1 grid-rows-1">
        {
          slides.map((slide, i) => (
            <div
              data-hero-copy
              inert={i !== 0 ? true : undefined}
              class:list={[
                "col-start-1 row-start-1 transition-opacity duration-700 ease-out motion-reduce:transition-none",
                i === 0 ? "opacity-100" : "pointer-events-none opacity-0",
              ]}
            >
              <h1 class="font-display text-4xl font-semibold leading-[1.08] text-balance text-white drop-shadow-sm sm:text-5xl md:text-[3.5rem]">
                {slide.heading}
              </h1>
              <p
                class:list={[
                  "mt-5 max-w-md text-base leading-relaxed text-white/85 sm:text-lg",
                  centered && "mx-auto",
                ]}
              >
                {slide.subheading}
              </p>
              {slide.ctaLabel && (
                <div class:list={["mt-8 flex flex-wrap gap-3", centered && "justify-center"]}>
                  <a
                    href={slide.ctaHref}
                    class="rounded-full bg-white px-7 py-3 text-sm font-semibold text-ink shadow-lg shadow-ink/30 transition-all hover:-translate-y-0.5 hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                  >
                    {slide.ctaLabel}
                  </a>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div
        class:list={[
          "mt-9 flex flex-wrap items-center gap-x-6 gap-y-3",
          centered && "justify-center",
        ]}
      >
        {
          isCarousel && (
            <div
              class="flex items-center gap-2"
              role="tablist"
              aria-label="Pilih sorotan"
              data-hero-dots
            >
              {slides.map((slide, i) => (
                <button
                  type="button"
                  role="tab"
                  data-hero-dot
                  data-index={i}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-label={`Sorotan ${i + 1}: ${slide.heading}`}
                  tabindex={i === 0 ? 0 : -1}
                  class="h-1.5 rounded-full bg-white/40 transition-all duration-300 hover:bg-white/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink motion-reduce:transition-none aria-selected:w-8 aria-selected:bg-white w-2.5"
                />
              ))}
            </div>
          )
        }
        {ratingText && <p class="text-sm text-white/75">{ratingText}</p>}
      </div>
    </div>
  </div>
</section>

<script>
  // Vanilla + tiny on purpose (no carousel dependency): cross-fade, autoplay with pause-on-hover,
  // pause-on-focus, pause-when-tab-hidden, dot tabs with roving arrow-key focus, and NO autoplay at
  // all under prefers-reduced-motion (slide 1 just stays put — every slide still reachable by dot).
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initHero(root: HTMLElement) {
    const copies = [...root.querySelectorAll<HTMLElement>("[data-hero-copy]")];
    const images = [...root.querySelectorAll<HTMLElement>("[data-hero-img]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")];
    if (copies.length < 2) return; // static hero — nothing to drive

    // Promote a deferred slide's `data-src` to `src`. Idempotent — once promoted there is no
    // `data-src` left, so re-calling it is free. Slide 1 never has one (it ships with a real `src`
    // so the LCP image is in the HTML, discoverable by the preload scanner, not gated behind JS).
    const wake = (el: HTMLElement) => {
      const src = el.dataset.src;
      if (!src) return;
      delete el.dataset.src;
      el.removeAttribute("data-src");
      (el as HTMLImageElement).src = src;
    };

    // Fetch the off-screen slides only once the page has finished loading, and then only when the
    // browser says it is idle. They are needed `interval` ms from now at the earliest (5s+), so
    // there is no reason for them to race the LCP image for bandwidth. `requestIdleCallback` is
    // absent on Safari <17 — the timeout fallback keeps the carousel working there rather than
    // leaving those slides permanently blank.
    const wakeAll = () => images.forEach(wake);
    const idle = (window as any).requestIdleCallback as undefined | ((cb: () => void) => void);
    const preloadRest = () => (idle ? idle(wakeAll) : setTimeout(wakeAll, 400));
    if (document.readyState === "complete") preloadRest();
    else window.addEventListener("load", preloadRest, { once: true });

    const interval = Number(root.dataset.interval ?? 0);
    let index = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let hovered = false;
    let focused = false;

    const canAutoplay = () => interval > 0 && !reduced.matches;

    const schedule = () => {
      clearTimeout(timer);
      if (!canAutoplay() || hovered || focused || document.hidden) return;
      timer = setTimeout(() => show(index + 1), interval);
    };

    // `prefetchNext` is false for the initial show(0) ONLY. Without that flag the init call would
    // wake slide 2 on the spot and hand back exactly the bandwidth this deferral just saved.
    const show = (next: number, prefetchNext = true) => {
      index = (next + copies.length) % copies.length;
      // Wake the slide we are about to reveal BEFORE fading to it — a dot clicked in the first
      // moments (or autoplay on a machine that never goes idle) must not cross-fade to a blank
      // frame. Wake the one after it too, so the following transition has it decoded already.
      wake(images[index]);
      if (prefetchNext) wake(images[(index + 1) % images.length]);
      copies.forEach((el, i) => {
        const on = i === index;
        el.classList.toggle("opacity-100", on);
        el.classList.toggle("opacity-0", !on);
        el.classList.toggle("pointer-events-none", !on);
        el.inert = !on; // keeps the off-screen CTAs out of the tab order
      });
      images.forEach((el, i) => {
        el.classList.toggle("opacity-100", i === index);
        el.classList.toggle("opacity-0", i !== index);
      });
      dots.forEach((el, i) => {
        el.setAttribute("aria-selected", i === index ? "true" : "false");
        el.tabIndex = i === index ? 0 : -1;
      });
      schedule();
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => show(i));
      dot.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        show(index + step);
        dots[index].focus();
      });
    });

    root.addEventListener("pointerenter", () => {
      hovered = true;
      schedule();
    });
    root.addEventListener("pointerleave", () => {
      hovered = false;
      schedule();
    });
    root.addEventListener("focusin", () => {
      focused = true;
      schedule();
    });
    root.addEventListener("focusout", () => {
      focused = false;
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    reduced.addEventListener("change", schedule);

    show(0, false);
  }

  document.querySelectorAll<HTMLElement>("[data-hero]").forEach(initHero);
</script>
