---
import Stars from "../Stars.astro";
import SectionHeading from "../SectionHeading.astro";
import type { TestimoniConfig } from "@tokophi/sections";

type Props = TestimoniConfig;
const { heading, items } = Astro.props;

// A testimonial is an advertising claim — so the registry default is now `items: []` (it used to ship
// two INVENTED customers, with names and 5★ ratings). An empty list is therefore the NORMAL state for
// a store that has just dragged this section on, and rendering the section anyway would publish a
// heading with prev/next arrows over an empty track. Render nothing at all instead.
const testimonials = items ?? [];
---

{testimonials.length > 0 && (
<section class="bg-brand-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex items-center justify-between gap-4">
      <SectionHeading title={heading} />
      <div class:list={["shrink-0 gap-2", testimonials.length > 1 ? "flex" : "hidden"]} data-testimoni-nav>
        <button
          type="button"
          aria-label="Sebelumnya"
          data-testimoni-prev
          class="grid h-9 w-9 place-items-center rounded-full bg-white text-ink ring-1 ring-line transition hover:bg-brand-100"
        >
          ←
        </button>
        <button
          type="button"
          aria-label="Berikutnya"
          data-testimoni-next
          class="grid h-9 w-9 place-items-center rounded-full bg-white text-ink ring-1 ring-line transition hover:bg-brand-100"
        >
          →
        </button>
      </div>
    </div>
    <div
      data-testimoni-track
      class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        testimonials.map((item) => (
          <figure class="w-[85%] shrink-0 snap-start rounded-2xl bg-white p-6 sm:w-[45%] lg:w-[31%]">
            {/* The shared SVG <Stars> — this used to hand-roll the rating out of "★" TEXT, which
                renders in whatever star glyph the OS font ships and is a second, drifting copy of
                something the product page already solves. */}
            <div class="mb-2 flex items-center gap-1.5">
              <Stars value={item.rating} size="sm" showValue={false} />
              <span class="text-xs font-medium text-muted">{item.rating}/5</span>
            </div>
            <blockquote class="text-ink">&ldquo;{item.quote}&rdquo;</blockquote>
            <figcaption class="mt-3 text-sm font-medium text-muted">— {item.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
)}

<script>
  // Lightweight scroll-snap carousel — no framework, one listener pair per section instance.
  document.querySelectorAll<HTMLElement>("[data-testimoni-nav]").forEach((nav) => {
    const track = nav.closest("div")?.parentElement?.querySelector<HTMLElement>("[data-testimoni-track]");
    if (!track) return;
    const scrollByCard = (dir: 1 | -1) => {
      const card = track.querySelector("figure");
      const amount = (card?.clientWidth ?? 300) + 16;
      track.scrollBy({ left: dir * amount, behavior: "smooth" });
    };
    nav.querySelector("[data-testimoni-prev]")?.addEventListener("click", () => scrollByCard(-1));
    nav.querySelector("[data-testimoni-next]")?.addEventListener("click", () => scrollByCard(1));
  });
</script>
