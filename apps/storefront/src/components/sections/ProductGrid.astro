---
import type { ProductGridConfig } from "@tokophi/sections";
import ProductCard from "../ProductCard.astro";
import SectionHeading from "../SectionHeading.astro";
import { recentProducts, randomProducts, type Product } from "../../data/catalog";
import { HOMEPAGE_CONTEXT, type SectionContext } from "./context";

type Props = ProductGridConfig & { ctx?: SectionContext };
// `imageRatio` is deliberately NOT destructured: imagery is locked to 1:1 (T-10) and templates saved
// before the lock still carry a 3:4/4:5 value. Reading it would honour data we have decided to ignore.
const { heading, mode, collectionHandle, limit, columns, ctx = HOMEPAGE_CONTEXT } = Astro.props;

const catalog = Astro.locals.catalog;

// The section's own `collectionHandle` always wins. When the merchant left it empty, the PAGE
// supplies the scope (ADR 0009 — this is what makes one Grid Produk section work as "produk di
// kategori ini" on a category template and "produk serupa" on a product template):
//   • category page → that collection
//   • product page  → the product's category, minus the product you're already looking at
//   • homepage      → the whole catalog (unchanged)
const scopedHandle =
  collectionHandle ||
  (ctx.kind === "category" ? ctx.collectionHandle : ctx.kind === "product" ? ctx.product.categoryHandle : "");

let pool: Product[] = scopedHandle ? catalog.byCollection(scopedHandle) : catalog.products;
if (ctx.kind === "product") pool = pool.filter((p) => p.handle !== ctx.product.handle);

const MODE_FN = { terlaris: catalog.bestsellers, terbaru: recentProducts, acak: randomProducts };
// `mode` comes out of `page_templates.sections` JSON, so it is only as trustworthy as whatever last
// wrote that column. An unknown value used to be `undefined(pool)` — a TypeError that takes the WHOLE
// storefront page down, homepage included. seed-templates.ts documented exactly this hazard and the
// guard was added to the SEED rather than to the render path. A section falling back to bestsellers
// is a section showing the wrong products; a throw here is a shop that is offline.
// `limit` is merchant-typed and arrives from jsonb, so it is not a number until proven. Our own Puck
// override REPLACES Puck's built-in clamp and passes `min`/`max` as HTML attributes only — and
// `<input type="number" min>` does not stop anyone typing. Measured against this very `.slice`:
// `0` → the grid renders its heading over zero products; `-5` → `slice(0,-5)` drops the LAST five
// (a 4-product pool renders empty); clearing the box omits the key entirely → `slice(0, undefined)`
// → the whole catalogue, unpaginated. Guard here, because this is where every writer ends up.
const safeLimit = Number.isInteger(limit) && limit > 0 ? Math.min(limit, 24) : 8;
const products = (MODE_FN[mode] ?? catalog.bestsellers)(pool).slice(0, safeLimit);
const colsClass = { 2: "sm:grid-cols-2", 3: "sm:grid-cols-3", 4: "sm:grid-cols-3 lg:grid-cols-4" }[columns];
// The card's `sizes` has to describe the SAME grid these classes build — this is merchant-chosen, so
// it is the one place where hardcoding a single shape would be wrong for two thirds of the options.
// A 2-col section renders a 608px card at desktop; told it was 296px, it would upscale a 400w file.
const gridShape = ({ 2: "2-2", 3: "2-3", 4: "2-3-4" } as const)[columns];
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading align="center" title={heading} />
  <div class:list={["mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-y-14", colsClass]}>
    {products.map((p) => <ProductCard product={p} grid={gridShape} />)}
  </div>
</section>
