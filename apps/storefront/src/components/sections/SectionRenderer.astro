---
// ADR 0009 — storefront half of the section registry. Maps each `page_templates.sections`
// entry's `type` to its Astro component; the admin's Puck config (apps/admin/lib/theme/puck-config.tsx)
// is the other half, sharing the same @tokophi/sections config shapes.
//
// A switch (not a type→component lookup map) on purpose: TS can't narrow `item.props` to the
// component's specific config through a map indexed by the discriminant, so a map+spread would
// require unsafe casts. The switch narrows `item` per-branch instead — fully type-checked.
//
// `context` = the page the template is rendering on (homepage / a category / a product). It is
// forwarded to the sections that can use it — see ./context.ts.
import type { StoredTemplateData } from "@tokophi/sections";
import { HOMEPAGE_CONTEXT, type SectionContext } from "./context";
import Hero from "./Hero.astro";
import ProductGrid from "./ProductGrid.astro";
import BannerPromo from "./BannerPromo.astro";
import Testimoni from "./Testimoni.astro";
import ImageText from "./ImageText.astro";
import Marquee from "./Marquee.astro";
import RichText from "./RichText.astro";
import CategoryNav from "./CategoryNav.astro";
import CollectionBento from "./CollectionBento.astro";
import Blog from "./Blog.astro";

interface Props {
  data: StoredTemplateData;
  context?: SectionContext;
}

const { data, context = HOMEPAGE_CONTEXT } = Astro.props;
---

{
  data.content.map((item) => {
    switch (item.type) {
      case "hero":
        return <Hero {...item.props} />;
      case "product-grid":
        return <ProductGrid {...item.props} ctx={context} />;
      case "banner-promo":
        return <BannerPromo {...item.props} />;
      case "testimoni":
        return <Testimoni {...item.props} />;
      case "image-text":
        return <ImageText {...item.props} />;
      case "marquee":
        return <Marquee {...item.props} />;
      case "rich-text":
        return <RichText {...item.props} />;
      case "category-nav":
        return <CategoryNav {...item.props} />;
      case "collection-bento":
        return <CollectionBento {...item.props} />;
      case "blog":
        return <Blog {...item.props} />;
    }
  })
}
