---
// ADR 0009 — storefront half of the section registry. Maps each `page_templates.sections`
// entry's `type` to its Astro component; the admin's Puck config (apps/admin/lib/theme/puck-config.tsx)
// is the other half, sharing the same @tokophi/sections config shapes.
//
// A switch (not a type→component lookup map) on purpose: TS can't narrow `item.props` to the
// component's specific config through a map indexed by the discriminant, so a map+spread would
// require unsafe casts. The switch narrows `item` per-branch instead — fully type-checked.
//
// `context` = the page the template is rendering on (homepage / a category / a product). It is
// forwarded to the sections that can use it — see ./context.ts.
import type { StoredTemplateData } from "@tokophi/sections";
import { HOMEPAGE_CONTEXT, type SectionContext } from "./context";
import { mediaUrl } from "../../data/catalog";
import Hero from "./Hero.astro";
import ProductListingSection from "./ProductListingSection.astro";
import ProductGrid from "./ProductGrid.astro";
import Multicolumn from "./Multicolumn.astro";
import Faq from "./Faq.astro";
import BannerPromo from "./BannerPromo.astro";
import Testimoni from "./Testimoni.astro";
import ImageText from "./ImageText.astro";
import Marquee from "./Marquee.astro";
import RichText from "./RichText.astro";
import CategoryNav from "./CategoryNav.astro";
import CollectionBento from "./CollectionBento.astro";
import Lookbook from "./Lookbook.astro";
import Blog from "./Blog.astro";

interface Props {
  data: StoredTemplateData;
  context?: SectionContext;
}

const { data, context = HOMEPAGE_CONTEXT } = Astro.props;

// ── MERCHANT UPLOADS MUST BE REWRITTEN TO THE ADMIN ORIGIN ───────────────────────────────────────
//
// The Store Builder's image picker stores `/api/uploads/<name>`, and that path is served by the
// ADMIN app — a different origin in production. NO section component called `mediaUrl()`, so every
// image a merchant uploaded through the picker 404'd on their own shop. It went unseen because the
// seeded template's only three image props are static files (`/hero/hero-1.webp`, …), so the
// merchant-upload path is unreachable by clicking around the demo.
//
// Applied ONCE here rather than at the six render sites: six copies of the same call is six chances
// for the next section to forget it. `mediaUrl` passes a non-upload path straight through, so this
// is a no-op for static assets. Keys, not shapes — `slides[]` and `items[]` nest their own.
const IMAGE_KEYS = new Set(["imageUrl", "mobileImageUrl"]);
function withMedia<T>(value: T): T {
  if (Array.isArray(value)) return value.map(withMedia) as unknown as T;
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value as Record<string, unknown>).map(([k, v]) =>
        IMAGE_KEYS.has(k) && typeof v === "string" ? [k, v ? mediaUrl(v) : v] : [k, withMedia(v)],
      ),
    ) as T;
  }
  return value;
}
---

{
  data.content.map((raw) => {
    const item = { ...raw, props: withMedia(raw.props) } as typeof raw;
    switch (item.type) {
      case "hero":
        return <Hero {...item.props} />;
      case "product-listing":
        return <ProductListingSection {...item.props} ctx={context} />;
      case "multicolumn":
        return <Multicolumn {...item.props} />;
      case "faq":
        return <Faq {...item.props} />;
      case "product-grid":
        return <ProductGrid {...item.props} ctx={context} />;
      case "banner-promo":
        return <BannerPromo {...item.props} />;
      case "testimoni":
        return <Testimoni {...item.props} />;
      case "image-text":
        return <ImageText {...item.props} />;
      case "marquee":
        return <Marquee {...item.props} />;
      case "rich-text":
        return <RichText {...item.props} />;
      case "category-nav":
        return <CategoryNav {...item.props} />;
      case "collection-bento":
        return <CollectionBento {...item.props} />;
      case "lookbook":
        return <Lookbook {...item.props} />;
      case "blog":
        return <Blog {...item.props} />;
      // ── EVERY TYPE MUST HAVE AN ARM, AND AN UNKNOWN ONE MUST NOT VANISH ────────────────────────
      //
      // Two different failures meet here and they need two different answers.
      //
      // ① **A type we forgot.** Adding a key to `SectionConfigMap` without an arm above used to
      //    compile and render NOTHING — part of a merchant's published page simply disappeared, with
      //    no error, no failed build and no migration to point at. `_exhaustive: never` is the fix:
      //    with every arm present `item` is `never` here, so the assignment holds; the moment a new
      //    type exists without an arm, `item` is that variant and this line fails to compile.
      //    (The admin half already had this for free — `Config<SectionConfigMap>` in
      //    apps/admin/lib/theme/puck-config.tsx is an exhaustive mapped type, so the BUILDER refused
      //    a new section while the RENDERER stayed silent. This closes the asymmetry.)
      //    ⚠️ The fix is this arm, never deleting arms above. Narrow the PALETTE
      //    (`SECTIONS_BY_TEMPLATE_TYPE`), never the renderer: a template saved earlier holding a
      //    section no longer offered for its type must keep rendering.
      //
      // ② **A type that genuinely is not known here** — an older template read by a rolled-back
      //    deploy, or a row hand-edited/imported. That is a RUNTIME fact no compiler can prevent, and
      //    the compile-time guard above does nothing about it. It stays a `console.warn` on the
      //    server (this is SSR, so it lands in the container log where it can be grepped) plus a
      //    visible panel in DEV only. NOT visible in production on purpose: a shopper on a merchant's
      //    live shop must not be shown our internal error, and a merchant must not have a red box
      //    published under their brand. Silence toward the shopper, never silence toward us.
      default: {
        const unknown = item as { type: string };
        const _exhaustive: never = item;
        void _exhaustive;
        console.warn(
          `[SectionRenderer] no renderer for section type "${unknown.type}" — it was skipped. ` +
            `Add a case arm in SectionRenderer.astro, or the section is from a newer template than this deploy.`,
        );
        return import.meta.env.DEV ? (
          <div
            data-unknown-section={unknown.type}
            style="margin:1rem;padding:1rem;border:2px dashed #dc2626;border-radius:.75rem;background:#fef2f2;color:#7f1d1d;font:14px/1.5 system-ui,sans-serif"
          >
            <strong>Unknown section type “{unknown.type}”.</strong> Nothing was rendered here. Add a{" "}
            <code>case "{unknown.type}":</code> arm to <code>SectionRenderer.astro</code>. (Dev only —
            production renders nothing and logs a warning.)
          </div>
        ) : null;
      }
    }
  })
}
