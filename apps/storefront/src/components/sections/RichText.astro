---
// ADR 0009 — Rich text / statement section. Placed/edited from the Tema builder.
//
// REDESIGN 2026-07-24 (owner reference #13): a clean, centred STATEMENT — a small eyebrow, one large
// display line as the heading, an optional supporting line, and a quiet underlined text link (not a
// pill button). The statement carries the weight; everything else stays out of its way.
import type { RichTextConfig } from "@tokophi/sections";
import { safeHref } from "../../lib/safe-href";

type Props = RichTextConfig;
const { heading, body, ctaLabel, ctaHref, theme, eyebrow } = Astro.props;
const dark = theme === "gelap";
---

<section class:list={dark ? "bg-ink" : "bg-cream"}>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-28">
    {
      eyebrow && (
        <p
          class:list={[
            "mb-5 text-xs font-semibold uppercase tracking-[0.2em]",
            dark ? "text-white/60" : "text-brand-600",
          ]}
        >
          {eyebrow}
        </p>
      )
    }
    {
      heading && (
        <h2
          class:list={[
            "font-display text-3xl font-semibold leading-[1.15] text-balance sm:text-4xl md:text-5xl",
            dark ? "text-cream" : "text-ink",
          ]}
        >
          {heading}
        </h2>
      )
    }
    {
      body && (
        <p
          class:list={[
            "mx-auto mt-6 max-w-xl text-base leading-relaxed sm:text-lg",
            dark ? "text-white/70" : "text-muted",
          ]}
        >
          {body}
        </p>
      )
    }
    {
      ctaLabel && (
        <a
          href={safeHref(ctaHref)}
          class:list={[
            "mt-8 inline-block rounded-sm text-sm font-medium underline decoration-1 underline-offset-4 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
            dark ? "text-cream/90 hover:text-white" : "text-ink/80 hover:text-ink",
          ]}
        >
          {ctaLabel}
        </a>
      )
    }
  </div>
</section>
