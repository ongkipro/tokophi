---
// ADR 0009 — Lookbook section (storefront half). Placed/edited from the Tema builder.
//
// A centred heading (+ optional description) over ONE wide, full-bleed banner image — the reference's
// "Lookbook" beat. Deliberately simple: no shoppable dots, no carousel. The image is the section; the
// heading names it. An empty `imageUrl` renders the brand-tinted panel, never a broken frame.
import type { LookbookConfig } from "@tokophi/sections";

type Props = LookbookConfig;
const { heading, description, imageUrl } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
  {
    (heading || description) && (
      <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-10">
        {heading && <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">{heading}</h2>}
        {description && <p class="mt-3 text-base leading-relaxed text-muted">{description}</p>}
      </div>
    )
  }
  {/* Wide on a desktop (21:9), taller on a phone (4:3) so the subject is not cropped to a sliver.
      `rounded-md` to match the flat product/blog cards and the bento tiles. */}
  <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-brand-100 sm:aspect-[21/9]">
    {
      imageUrl ? (
        <img src={imageUrl} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
      ) : (
        <span class="block h-full w-full bg-gradient-to-br from-brand-100 to-brand-200" aria-hidden="true" />
      )
    }
  </div>
</section>
