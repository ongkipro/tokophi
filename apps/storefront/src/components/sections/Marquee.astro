---
import type { ColorPalette, MarqueeConfig } from "@tokophi/sections";
import { paletteStyleString, resolvePalette } from "@tokophi/sections";

type Props = MarqueeConfig & { palettes: ColorPalette[] };
const { text, speed, paletteId, palettes } = Astro.props;
const p = resolvePalette(paletteId, palettes);
const duration = { lambat: "40s", sedang: "25s", cepat: "12s" }[speed] ?? "25s";
---

<section
  class="overflow-hidden bg-[var(--scheme-button)] py-4"
  style={`${paletteStyleString(p)};--marquee-duration: ${duration}`}
>
  <div class="marquee-track flex w-max gap-8 whitespace-nowrap">
    {
      Array(2)
        .fill(null)
        .map(() => (
          <span class="flex shrink-0 gap-8">
            {Array(6)
              .fill(text)
              .map((t) => (
                <span class="font-display text-lg font-medium text-[var(--scheme-button-text)] opacity-90">{t}</span>
              ))}
          </span>
        ))
    }
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee var(--marquee-duration, 25s) linear infinite;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
