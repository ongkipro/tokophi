---
import type { BannerPromoConfig } from "@tokophi/sections";
import { safeHref } from "../../lib/safe-href";
import { imageSrcSet } from "../../data/catalog";

type Props = BannerPromoConfig;
const { heading, subheading, imageUrl, href, badge } = Astro.props;

// A merchant who clears the link leaves `href=""`, which reloads the current page — a control that
// looks like a link and behaves like a mistake. With no destination this is a banner, not a link.
// Sanitised FIRST, so a rejected scheme degrades to the non-link <div> branch rather than
// rendering an <a> with no href (which looks like a link and behaves like a mistake).
const safeCta = safeHref(href);
const Tag = safeCta ? "a" : "div";

// `sizes` tells the browser how WIDE this image renders, and it trusts it completely when
// choosing a srcset candidate — a wrong value is worse than no srcset at all. Derived from this
// component's own layout: Full-bleed banner behind the copy.
const SIZES = "100vw";
---

<section class="mx-auto max-w-7xl px-4 sm:px-6">
  <Tag
    href={safeCta}
    class="group relative flex min-h-[220px] items-center overflow-hidden rounded-sm bg-mist-strong p-8 sm:p-12"
  >
    {
      imageUrl && (
        <img
          src={imageUrl}
          srcset={imageSrcSet(imageUrl)}
          sizes={imageSrcSet(imageUrl) ? SIZES : undefined}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-300 ease-out group-hover:scale-[1.03]"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/25 to-transparent" />
    <div class="relative space-y-2">
      {
        badge && (
          <span class="inline-block rounded-sm bg-ink px-2 py-0.5 text-xs font-semibold text-white">
            {badge}
          </span>
        )
      }
      <h3 class="font-display text-[1.375rem] font-semibold leading-tight tracking-[-0.01em] text-white sm:text-[1.75rem]">{heading}</h3>
      <p class="max-w-sm text-white/85">{subheading}</p>
    </div>
  </Tag>
</section>
