---
import type { ColorPalette, ImageTextConfig } from "@tokophi/sections";
import { paletteStyleString, resolvePalette } from "@tokophi/sections";

type Props = ImageTextConfig & { palettes: ColorPalette[] };
const { heading, body, imageUrl, imageSide, eyebrow, paletteId, palettes } = Astro.props;
const p = resolvePalette(paletteId, palettes);
---

<section class="mx-auto max-w-7xl bg-[var(--scheme-background)] px-4 py-16 sm:px-6 sm:py-20" style={paletteStyleString(p)}>
  <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-16">
    <div class:list={["aspect-[4/3] overflow-hidden rounded-2xl bg-brand-100", imageSide === "right" && "md:order-2"]}>
      {imageUrl && <img src={imageUrl} alt="" class="h-full w-full object-cover" />}
    </div>
    <div>
      {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--scheme-accent)]">{eyebrow}</p>}
      <h2 class="mt-3 font-display text-3xl font-semibold text-[var(--scheme-text)] sm:text-4xl">{heading}</h2>
      <p class="mt-4 max-w-md text-[var(--scheme-text)] opacity-70">{body}</p>
    </div>
  </div>
</section>
