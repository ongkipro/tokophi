---
// ADR 0009 — Image + text section (storefront half). Placed/edited from the Tema builder.
//
// REDESIGN 2026-07-23 (owner reference, Shopify-style): a premium split banner — a large 4:3 image
// on one side, the copy on the other, generous whitespace and a real type hierarchy. It used to be a
// bare `aspect-[4/3]` box next to an unstyled heading + one grey paragraph; this is the same data
// (heading, body, imageUrl, imageSide, eyebrow) given the layout the reference asks for.
//
// The BODY is split on blank lines into paragraphs, so a merchant who writes two thoughts gets two
// blocks with air between them, not one wall — the reference copy is two short paragraphs. Nothing is
// invented: an empty field renders nothing (no eyebrow rule, no image frame guessing a URL).
import type { ImageTextConfig } from "@tokophi/sections";
import { safeHref } from "../../lib/safe-href";
import { ArrowRight } from "@lucide/astro";
import { imageSrcSet } from "../../data/catalog";

type Props = ImageTextConfig;
const { heading, body, imageUrl, imageSide, eyebrow, ctaLabel, ctaHref } = Astro.props;

const paragraphs = (body ?? "")
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);

// `sizes` tells the browser how WIDE this image renders, and it trusts it completely when
// choosing a srcset candidate — a wrong value is worse than no srcset at all. Derived from this
// component's own layout: Half the content column from md up; full width below it.
const SIZES = "(min-width: 768px) 50vw, 100vw";
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-20">
    {/* IMAGE — large, 4:3, softly rounded. `imageSide === "right"` reorders it on md+ (it always
        leads on a phone, where the eye wants the picture first). No image → the brand-tinted panel,
        never a broken frame or a guessed URL. */}
    <div
      class:list={[
        "relative aspect-[4/3] overflow-hidden rounded-3xl bg-brand-100 ring-1 ring-line",
        imageSide === "right" && "md:order-2",
      ]}
    >
      {
        imageUrl ? (
          <img
            src={imageUrl}
            srcset={imageSrcSet(imageUrl)}
            sizes={imageSrcSet(imageUrl) ? SIZES : undefined}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <span class="block h-full w-full bg-gradient-to-br from-brand-100 to-brand-200" aria-hidden="true" />
        )
      }
    </div>

    {/* COPY — eyebrow · display heading · body paragraphs. The heading is the loudest thing here, so
        it carries the display weight and a tight leading; the eyebrow is the reference's small kicker. */}
    <div class="max-w-xl">
      {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-brand-600">{eyebrow}</p>}
      {heading && <h2 class="font-display text-3xl font-semibold leading-tight text-balance text-ink sm:text-4xl">{heading}</h2>}
      {
        paragraphs.length > 0 && (
          <div class="mt-5 space-y-4 text-base leading-relaxed text-muted sm:mt-6">
            {paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        )
      }
      {/* Optional CTA — the reference's "SHOP" button, as the site's arrow-in-circle pill so it reads as
          one family with the hero and pre-footer CTAs. Only renders when the merchant set a label. */}
      {
        ctaLabel && (
          <a
            href={safeHref(ctaHref) ?? "/kategori/semua"}
            class="group mt-8 inline-flex items-center gap-3 rounded-full bg-ink py-2 pl-2 pr-6 text-sm font-semibold uppercase tracking-wide text-cream shadow-lg shadow-ink/20 transition-colors hover:bg-ink/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
          >
            <span class="flex size-9 items-center justify-center rounded-full ring-1 ring-cream/25 transition-colors group-hover:bg-cream group-hover:text-ink">
              <ArrowRight class="size-4" stroke-width={2} aria-hidden="true" />
            </span>
            {ctaLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
