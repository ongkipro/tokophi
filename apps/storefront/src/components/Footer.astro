---
// Tenant resolved per-request from the Host header (src/middleware.ts).
//
// ── EVERY MERCHANT FIELD BELOW IS OPTIONAL, AND TODAY THEY ARE ALL EMPTY ────────────────────────
// `address`, `phone` and the five social usernames landed with migration 0063; the seller form that
// fills them is still being built, so the state you can actually SEE right now is "merchant filled in
// nothing". That is the state this footer is designed for first: each block is computed above and
// rendered only when it holds real content, so an unfilled shop gets a shorter footer — never an
// empty social strip, never a "Hubungi kami" heading with nothing under it, never an address box
// containing one blank line.
//
// This is the same failure the platform already shipped once: `wa.me/6281234567890` (the canonical
// Indonesian dummy number) went out as a live WhatsApp button on every page of every store because a
// missing value fell back to a placeholder. A missing channel is honest; a dead one is a lie.
import { MapPin, Phone } from "@lucide/astro";
import { getFooterNav, getMainNav } from "../data/nav";
import SocialLinks from "./SocialLinks.astro";
import { clamp } from "../lib/text";

const { store, catalog } = Astro.locals;

// ── BOTH NAV COLUMNS ARE THE MERCHANT'S, NOT OURS ────────────────────────────────────────────────
//
// The footer used to carry two columns of OUR content: "Koleksi" derived automatically from
// `catalog.collections` (so a merchant could not order or label it), and "Belanja" hardcoded to
// Beranda / Keranjang / Customer Service. That is the exact pattern `data/nav.ts` documents as the
// bug it keeps fixing — platform defaults living in a tenant's storefront. Measured consequence
// elsewhere: a hardcoded category menu served `/kategori/dress` → 404 on every page of a coffee shop.
//
// Now: column 2 mirrors the MAIN menu (the same tree as the header, admin → Navigasi) and column 3 is
// the merchant's FOOTER menu. Both already drop dead links — unpublished categories in `getMainNav`,
// draft pages in `getFooterNav` — so neither column can point at a 404.
const MENU = await getMainNav(store.id, catalog.collections);
const tagline = clamp(store.tagline, 120);
const PAGES = await getFooterNav(store.id);

// A merchant can save a field and later blank it out; `""` must behave exactly like `null` or the
// truthiness checks below would render an empty row. Trim once, here, and use these everywhere.
const clean = (v: string | null | undefined) => {
  const t = (v ?? "").trim();
  return t.length > 0 ? t : null;
};

// The public phone is free text ("(0274) 123456", "0812-3456-7890") because that is how a shop writes
// it on its own signage. Only the `tel:` href is normalised — the label stays exactly as typed.
const phone = clean(store.phone);
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : null;

// The address is a textarea: 2–4 lines, and merchants leave blank lines in the middle. Split, trim,
// drop the empties — an address block whose only content is a blank line must not render at all.
const addressLines = (clean(store.address) ?? "")
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean);

// Location line: the merchant's published address when there is one, otherwise the store's registered
// city (always present) so the shop is never anonymous about where it is.
const city = clean(store.city);

// Username → profile URL. The DB stores the USERNAME only (no `@`, no URL, schema 0063) precisely so
// this file — not merchant input — decides the origin: a stored full URL is a place to paste someone
// else's profile, or a `javascript:` scheme. A leading `@` is stripped anyway because it is the single
// most likely thing a merchant types into a field labelled "username".
const handle = (v: string | null) => clean(v)?.replace(/^@+/, "") ?? null;
const SOCIALS = [
  { key: "instagram", label: "Instagram", user: handle(store.socialInstagram), url: (u: string) => `https://instagram.com/${u}` },
  { key: "tiktok", label: "TikTok", user: handle(store.socialTiktok), url: (u: string) => `https://tiktok.com/@${u}` },
  { key: "facebook", label: "Facebook", user: handle(store.socialFacebook), url: (u: string) => `https://facebook.com/${u}` },
  { key: "pinterest", label: "Pinterest", user: handle(store.socialPinterest), url: (u: string) => `https://pinterest.com/${u}` },
  { key: "x", label: "X", user: handle(store.socialX), url: (u: string) => `https://x.com/${u}` },
].filter((s): s is typeof s & { user: string } => Boolean(s.user));

// Does the "Hubungi kami" heading have anything to head? If not, neither the heading nor its list
// exists. A heading is a promise that something follows it. The store's WhatsApp number is
// deliberately NOT consulted: the footer no longer carries a WhatsApp button (the chat launcher and
// /kontak do), so a shop whose only channel is WhatsApp must not be given an empty column heading.
const hasContact = Boolean(telHref);

// Shared classes. Tap targets are ≥44px (design audit #16 — the share buttons were raised from 36 to
// 44 for the same reason), and every transition carries a `motion-reduce:` escape.
// ── ONE TYPEFACE, THREE VOICES ───────────────────────────────────────────────────────────────────
// `global.css` points `--font-display` at `--font-sans` on purpose: a display face is BRAND VOICE and
// that belongs to the merchant, not to the platform. So the hierarchy here is built from WEIGHT,
// TRACKING and OPACITY instead of from a second family.
//
//   heading  full cream · semibold · widest tracking   — the loudest thing in a column
//   caption  70% cream  · medium   · tighter tracking  — subordinate, and visibly so
//   link     75% cream  · regular                      — the mass of the column
//
// ⚠️ Nothing here drops below `cream/70`: that measures 7.7:1 on ink, and `/45` — which shipped once —
// measures 4.05:1 and fails AA. It slipped past a palette audit because it is an OPACITY, not a colour.
//
// `min-h-11 lg:min-h-9`: 44px is the touch floor these links were raised to, and it is right for a
// thumb. On `lg` the pointer is a mouse and 36px is both comfortable and well past the 24px AA
// minimum — at 44px a nine-item column reads as a loose stack rather than a list.
const LINK =
  "inline-flex min-h-11 items-center rounded-sm text-cream/75 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none lg:min-h-9";
const HEADING = "text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-cream";
const CAPTION = "text-[0.7rem] font-medium uppercase tracking-[0.12em] text-cream/70";
---

<footer class="mt-24 bg-ink text-cream/85">
  {/* REMOVED: the newsletter band. Its form was `onsubmit="return false"` — no handler anywhere, no
      request, no toast, no subscriber table — under copy promising style tips and offers by email.
      There is no mailer and no list to join, so the button did literally nothing on every page of
      every store. Wiring it to an INSERT would not fix it: it would still promise an email nothing
      can send. (JSX comment, not HTML — an HTML comment ships to the browser.) */}
  {/* A 12-COLUMN TRACK, not four equal quarters. The four blocks do not carry equal weight: the brand
      needs a measure wide enough to read a sentence in, the menu is the tallest list, and "Informasi"
      is four short links that do not need the same width as either. Equal columns made that
      difference look like a mistake instead of a structure. Spans: 4 / 3 / 2 / 3. */}
  <div class="mx-auto grid max-w-7xl gap-x-10 gap-y-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-12 lg:gap-x-8 lg:py-16">
    {/* ── 1. Identity — who this shop is, and nothing else ─────────────────────────────────────── */}
    <div class="lg:col-span-4">
      {
        store.logoUrl ? (
          <img src={store.logoUrl} alt={store.name} width="160" height="48" class="h-10 w-auto object-contain object-left" />
        ) : (
          <p class="font-display text-2xl font-semibold text-cream">{store.name}</p>
        )
      }
      {/* CLAMPED ON A WORD. The Seller's "Deskripsi singkat" caps at 160 characters, so a merchant who
          writes to the cap stores a sentence ending mid-word — the demo's reads "…dari masing-masing
          da". 120 is the length that fills this column without turning a footer into a paragraph. */}
      {tagline && <p class="mt-4 text-sm leading-relaxed text-cream/70">{tagline}</p>}
    </div>

    {/* ── 2. The MERCHANT'S main menu — the same tree the header renders ───────────────────────── */}
    {
      MENU.length > 0 && (
        <nav aria-label="Menu toko" class="lg:col-span-3">
          <h2 class={HEADING}>Menu</h2>
          <ul class="mt-3 text-sm">
            {MENU.map((item) =>
              item.children?.length ? (
                /* A dropdown parent carries NO href — `getMainNav` strips it, because the seed's
                   target for one is literally "#". Rendering it as a link would put a link to
                   nowhere in the footer of every page; it is a group label with its items under it. */
                <li class="mt-4 first:mt-0">
                  {/* The `border-l` + indent that used to wrap these is gone. A footer column has one
                      level of hierarchy to spend; spending it on a rule and a 12px inset made the
                      categories read as a nested tree inside a flat list. A caption above them says
                      the same thing and draws nothing. */}
                  <p class={CAPTION}>{item.label}</p>
                  {/* TWO COLUMNS. The categories are the only nested list here, and at one per row they made the
                       Menu column eleven rows tall beside neighbours of four — the footer read as one long
                       column with three short ones parked next to it. */}
                  <ul class="mt-1 grid grid-cols-2 gap-x-4">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class={LINK}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={item.href} class={LINK}>
                    {item.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        </nav>
      )
    }

    {/* ── 3. The MERCHANT'S footer menu (admin → Navigasi), draft pages already dropped ────────── */}
    {
      PAGES.length > 0 && (
        <nav aria-label="Informasi toko" class="lg:col-span-2">
          <h2 class={HEADING}>Informasi</h2>
          <ul class="mt-3 text-sm">
            {PAGES.map((p) => (
              <li>
                <a href={p.href} class={LINK}>
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {/* ── 4. Every way to reach this shop — contact, address, social ───────────────────────────
        Each row is computed above and rendered only when it holds something real. A merchant who has
        filled in nothing gets a shorter footer, never a "Hubungi kami" heading with nothing under it.
        `city` is the store's registered city, so in practice this column always says where the shop
        is — but the guard stays, because "in practice" is not a guarantee. */}
    {
      (hasContact || addressLines.length > 0 || city || SOCIALS.length > 0) && (
        <div class="lg:col-span-3">
          <h2 class={HEADING}>Hubungi kami</h2>

          {/* ⚠️ The "Hubungi via WhatsApp" button was REMOVED here by the owner (2026-07-22). The
              footer's contact column is address · phone · social, and a green CTA button was the one
              thing in it shouting. WhatsApp is NOT gone from the shop — the floating chat launcher
              and /kontak both still open it, and it remains the channel these merchants actually
              sell on (see AGENTS.md on cart recovery). This is a layout decision about the footer,
              not a change of channel: do not "restore" it here. */}
          {telHref && phone && (
            <ul class="mt-3 text-sm">
              <li>
                <a href={telHref} class={`${LINK} gap-2`}>
                  <Phone class="size-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
                  <span class="tabular-nums">{phone}</span>
                </a>
              </li>
            </ul>
          )}

          {
            addressLines.length > 0 ? (
              <address class="mt-4 flex gap-2 text-sm not-italic leading-relaxed text-cream/70">
                <MapPin class="mt-0.5 h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
                <span>
                  {addressLines.map((line) => (
                    <span class="block">{line}</span>
                  ))}
                </span>
              </address>
            ) : (
              city && (
                <p class="mt-4 flex items-center gap-2 text-sm text-cream/70">
                  <MapPin class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
                  {city}, Indonesia
                </p>
              )
            )
          }

          <SocialLinks socials={SOCIALS} storeName={store.name} class="mt-4" />
        </div>
      )
    }
  </div>

  <div class="border-t border-white/10">
    {/* `text-cream/45` measured 4.05:1 on the ink footer — below AA, and Lighthouse `color-contrast`
       scores 0 on it. global.css already fixed `--color-muted` for exactly this reason; this one
       slipped through because it is an OPACITY, not a colour, so no palette audit could see it.
       `/70` measures 7.7:1 on the same background (composited, not guessed). */}
    <p class="mx-auto max-w-7xl px-4 py-6 text-xs text-cream/70 sm:px-6">
      © 2026 {store.name}. Ditenagai TokoΦ.
    </p>
  </div>
</footer>
