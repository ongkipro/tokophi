---
import { STORE, COLLECTIONS } from "../data/catalog";
---

<footer class="mt-24 bg-ink text-cream/90">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div class="md:col-span-1">
      <p class="font-display text-2xl font-semibold text-cream">{STORE.name}</p>
      <p class="mt-3 max-w-xs text-sm text-cream/70">{STORE.tagline}</p>
      <a
        href={`https://wa.me/${STORE.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-500"
      >
        Hubungi via WhatsApp
      </a>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-cream/60">Koleksi</p>
      <ul class="mt-4 grid grid-cols-2 gap-2 text-sm text-cream/80">
        {
          COLLECTIONS.map((c) => (
            <li>
              <a href={`/kategori/${c.handle}`} class="transition-colors hover:text-white">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-cream/60">Belanja</p>
      <ul class="mt-4 space-y-2 text-sm text-cream/80">
        <li><a href="/" class="transition-colors hover:text-white">Beranda</a></li>
        <li><a href="/keranjang" class="transition-colors hover:text-white">Keranjang</a></li>
        <li>
          <a href={`https://wa.me/${STORE.whatsapp}`} target="_blank" rel="noopener" class="transition-colors hover:text-white">
            Customer Service
          </a>
        </li>
        <li class="pt-2 text-cream/60">📍 {STORE.city}, Indonesia</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-cream/50 sm:px-6">
      © 2026 {STORE.name}. Ditenagai Indostore.
    </p>
  </div>
</footer>
