---
// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;
const COLLECTIONS = catalog.collections;

const waHref = `https://wa.me/${store.whatsapp}`;
---

<footer class="mt-24 bg-ink text-cream/85">
  <!-- Newsletter -->
  <div class="border-b border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-md">
        <p class="font-display text-xl text-cream sm:text-2xl">Dapatkan kabar koleksi terbaru</p>
        <p class="mt-2 text-sm text-cream/60">Tips gaya & penawaran spesial, langsung ke email kamu.</p>
      </div>
      <form class="flex w-full max-w-md gap-2" onsubmit="return false">
        <label for="newsletter-email" class="sr-only">Alamat email</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          placeholder="Alamat email kamu"
          autocomplete="email"
          class="min-w-0 flex-1 rounded-full border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-cream placeholder:text-cream/40 transition-colors focus-visible:border-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-brand-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
        >
          Langganan
        </button>
      </form>
    </div>
  </div>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-3">
    <div class="md:col-span-1">
      <p class="font-display text-2xl font-semibold text-cream">{store.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream/60">{store.tagline}</p>
      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.4-8.28 8.4Z" />
        </svg>
        Hubungi via WhatsApp
      </a>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-cream/50">Koleksi</p>
      <ul class="mt-5 grid grid-cols-2 gap-y-3 text-sm text-cream/75">
        {
          COLLECTIONS.map((c) => (
            <li>
              <a
                href={`/kategori/${c.handle}`}
                class="rounded-sm transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
              >
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-cream/50">Belanja</p>
      <ul class="mt-5 space-y-3 text-sm text-cream/75">
        <li>
          <a href="/" class="rounded-sm transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">Beranda</a>
        </li>
        <li>
          <a href="/keranjang" class="rounded-sm transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">Keranjang</a>
        </li>
        <li>
          <a href={waHref} target="_blank" rel="noopener" class="rounded-sm transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400">
            Customer Service
          </a>
        </li>
        <li class="pt-1 text-cream/50">📍 {store.city}, Indonesia</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-4 py-6 text-xs text-cream/45 sm:px-6">
      © 2026 {store.name}. Ditenagai TokoΦ.
    </p>
  </div>
</footer>
