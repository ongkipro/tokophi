---
import { ShoppingBag, ArrowRight, Search, ChevronRight, Phone, Mail } from "@lucide/astro";
import { IDR } from "@tokophi/lib/format";
import { imageSrcSet, mediaUrl } from "../data/catalog";
import { getMainNav, type NavItem } from "../data/nav";

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;
// The store's OWN menu, as built in the admin's Navigasi editor. The collections are passed for the
// FALLBACK only (a store that has built a menu gets exactly that menu): a store with no menu rows —
// which is every freshly provisioned one — used to be handed a hardcoded copy of Batik Nusantara's
// categories, so its header linked to /kategori/dress and 404'd on every page. See data/nav.ts.
const MAIN_NAV = await getMainNav(store.id, catalog.collections);

// The mega-menu utility bar linked to hardcoded demo collections that 404 on any tenant without them.
// What is left is the bestseller shortcut, rendered only if THIS store actually has that collection.
//
// The promo shortcut that used to live here is GONE: it was gated on the store owning a
// `promo-gajian` collection, yet its href was `/promo` (the hub) and its LABEL was that collection's
// name — so it promised a category and delivered a different page, and it hid the hub entirely from
// every store without that one demo handle. `/promo` is now a default MAIN-NAV item instead
// (data/nav.ts + the seeded menu), which is editable and deletable in Navigasi like any other.
const terlarisCol = catalog.findCollection("produk-terlaris");
const showUtilityBar = Boolean(terlarisCol);
// Merchant logo (stores.logo_url) when set, else the store name as a wordmark.
const logo = store.logoUrl ? mediaUrl(store.logoUrl) : null;
const pathname = Astro.url.pathname;
// The homepage header floats over the hero (transparent → solid on scroll); every other page keeps
// the sticky solid bar. One flag drives both the positioning and the colour-flip <style> below.
const isHome = pathname === "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");

// A parent item is "active" when its own href matches or any child link matches.
const isItemActive = (item: NavItem) => {
  if (item.href && isActive(item.href)) return true;
  return !!item.children?.some((c) => isActive(c.href));
};

// --- Mega menu content ---
//
// The nav TREE comes from the store's own menu in the DB (getMainNav → the admin's Navigasi editor).
// What the panel SHOWS on top of it is live per-tenant catalog data: a thumbnail and a real product
// count per category. The menu decides WHICH categories to list; the catalog decides what they
// actually contain — so a store whose categories differ from the seed still gets a truthful panel.
const categoryMeta = (href: string) => {
  const handle = href.startsWith("/kategori/") ? href.slice("/kategori/".length) : "";
  if (!handle) return null;
  const items = catalog.byCollection(handle);
  const col = catalog.findCollection(handle);
  // A menu entry pointing at a category with no products is a dead end — the panel says so rather
  // than sending a shopper to an empty grid with no warning.
  // No emoji fallback: a category with no photo gets a Lucide glyph (see the panel), which stays
  // inside the brand palette instead of an OS-coloured pictograph.
  return { count: items.length, image: items[0]?.image };
};

// The two collection TILES on the panel's right (owner reference, 2026-08-25 — the Threadheads
// shape: text-link columns left, two big image tiles right). The first two menu categories that can
// show a photo; a menu with fewer than two photographed categories simply renders fewer tiles.
// `MAIN_NAV` is the merchant's own menu, so the merchant curates these by ordering their menu.

// ── THE DRAWER IS SPLIT, NOT LOOPED ──────────────────────────────────────────────────────────────
// A shop's mobile menu answers one question first: WHAT DO YOU SELL. Rendering the merchant's tree in
// source order buried that answer inside a collapsed row, so the drawer opened as six identical text
// links floating in an empty panel — efficient, and characterless, and two thirds air.
// So: the plain links stay a compact 2-up block at the top (they are utility), and the categories get
// the space, with the photo and the live count the desktop mega panel already shows.
// The drawer is MINIMALIST now (owner reference, 2026-07-23): large plain-text links, and the
// categories live behind a "Kategori ›" row that drills into a sub-panel — the Shopify Dawn pattern.
// So `MAIN_NAV` is rendered whole, in order; parents with children become the drill triggers.
const DRAWER_GROUPS = MAIN_NAV.filter((i) => i.children?.length);
// Two bestsellers for the foot strip — real data, server-rendered, no client fetch. The reference
// shows a product strip at the bottom of the menu; these are it.
const DRAWER_FEATURED = catalog.bestsellers().slice(0, 2);

// ── `sizes` FOR THE HEADER'S THREE CATALOG IMAGES ────────────────────────────────────────────────
//
// These three render on EVERY page of the shop, and all three used to be a bare `<img>`: the browser
// was handed the full-size original for a 44 px tile. Measured on the seeded demo at 1440×900, the
// five mega-menu thumbnails alone cost **74 490 B** — more than the rest of the homepage's catalog
// images put together — and the drawer's two cost **17 596 B** on a 412 px phone. Both are pure
// waste: the same products' 200w/400w renditions were already on the wire for the product cards.
//
// ⚠️ Each `sizes` is derived from ITS OWN box, because the browser trusts `sizes` completely when it
// picks a candidate — a wrong one is worse than no srcset at all. Three sites, three derivations:
//
//   TILE — a fixed 248 px, and it is fixed BY CONSTRUCTION: the tile column is `md:grid-cols-[1fr_32rem]`
//     — a hard 512 px, not a fraction, precisely so this number cannot drift with the link column —
//     holding two tiles in `grid-cols-2 gap-4`: (512 − 16) / 2 = 248 px. The panel only exists where
//     the nav does (`xl:flex`, ≥1280), where `max-w-7xl` is pinned, so there is no other branch.
//
//   DRAWER — `(min-width: 416px) 186px, calc((100vw - 44px) / 2)`:
//     drawer  `w-full max-w-[26rem]`  → min(100vw, 416)
//     inner   `px-4` + `grid-cols-2 gap-3` → tile = (min(100vw, 416) − 32 − 12) / 2
//     Measured 184 px at 412 (= (412 − 44)/2). ⚠️ Here — unlike the PDP thumbnail rail, where
//     `max-w-[7rem]` only CAPS a `flex-1 basis-0` share and declaring the cap over-claimed by 1,7×
//     and cost a whole rung — the cap binds deterministically: the drawer is `w-full` against the
//     viewport, so above 416 px the tile really is exactly 186 px. A `max-w` is only a `sizes` when
//     you can say at which viewport it starts binding.
const TILE_SIZES = "248px";
const DRAWER_TILE_SIZES = "(min-width: 416px) 186px, calc((100vw - 44px) / 2)";

// Contact for the drawer's foot. Read straight off the store — no second copy of the footer's
// normalising, because these two fields need none: `phone` is free text by design (a shop writes its
// landline the way it writes it on its signage) and `email` is validated at the Seller form.
// Each renders only when the merchant published it, so an unfilled shop gets a shorter drawer.
const drawerPhone = (store.phone ?? "").trim() || null;
const drawerEmail = (store.email ?? "").trim() || null;
---

{/* HOME: the header floats over the hero, transparent, and turns solid on scroll (the
    Casaio pattern). Elsewhere it is the sticky solid bar it always was. The colour flip
    lives in the style block at the foot of this file, keyed on `data-solid`, so no child
    needs to know which state it is in.
    ⚠️ This comment sat BETWEEN the attributes below. Astro still built it, but its TSX
    transform read it as an attribute — which is why `astro check` reported 8 errors and
    typechecked NONE of the storefront's 92 files for eight days. Keep comments outside
    the tag. */}
<header
  id="site-header"
  data-header
  data-overlay={isHome ? "true" : undefined}
  data-solid="false"
  class:list={[
    "z-40 transition-colors duration-300 motion-reduce:transition-none",
    isHome
      ? "fixed inset-x-0 top-0 border-b border-transparent"
      : "sticky top-0 border-b border-line bg-cream/85 backdrop-blur",
  ]}
>
  {/* `relative` anchors the mega panel to the header, not to the word that opens it. */}
  {/* A centred logo that does not care how long the merchant's menu is: the left group (search +
      nav) and the right group (cart) sit at the edges via `justify-between`, and the logo is
      ABSOLUTELY centred over the bar. A 3-col grid tied the centre to the nav's width, so a 6-item
      menu shoved the logo off-centre; this pins it to the true middle regardless. */}
  {/* TWO ROWS on desktop — the robust centred-logo layout. Row 1 is [search/hamburger · logo ·
      cart]; the nav gets its own centred row below, so a long merchant menu (the demo has six
      items) can never collide with the logo the way a single-row left-nav did. On a phone
      there is no row 2 — the nav lives in the drawer. `relative` on the outer wrapper is the
      mega-panel anchor; the nav row is `relative` too so the panel drops beneath IT. */}
  {/* ONE ROW: nav (left) · logo (centre) · search + cart (right). The logo is centred
      ABSOLUTELY so a longer merchant menu never shoves it off-centre; `relative` on this
      container anchors the mega panel, which drops from `top-full` below the bar. On a phone
      the nav is replaced by the hamburger and lives in the drawer. */}
  <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-4 sm:px-6">
    {/* LEFT — hamburger (mobile) · nav (desktop) */}
    <div class="flex min-w-0 items-center gap-2">
      <button
      type="button"
      id="menu-open"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="Buka menu"
      class="inline-flex items-center justify-center rounded-full border border-line p-2 text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 xl:hidden"
      >
      <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
      <path d="M3.5 6h17M3.5 12h17M3.5 18h17" stroke-linecap="round" />
      </svg>
      </button>
      {/* Inline from `xl`, not `lg`: beside a CENTRED logo the left nav must clear the middle, and a
          merchant menu is variable-length. The demo six-item menu overlaps the logo by 84px at 1024
          (measured); showing the inline nav only where a long menu fits, and using the drawer at
          1024-1279, keeps the single row uncollidable on any store. */}
      <nav aria-label="Navigasi utama" class="hidden items-center gap-5 text-sm text-muted xl:flex xl:gap-7">
      {
      MAIN_NAV.map((item) =>
      item.children ? (
      /* NOT `relative`: the panel must position against the header container above, not
      against this trigger. */
      <div class="dropdown" data-dropdown>
      <button
      type="button"
      class:list={[
      "dropdown-trigger flex items-center gap-1 relative py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:scale-x-100 motion-reduce:after:transition-none",
      isItemActive(item) ? "font-medium text-ink after:scale-x-100" : "",
      ]}
      aria-expanded="false"
      aria-haspopup="true"
      >
      {item.label}
      <svg
      viewBox="0 0 24 24"
      class="dropdown-chevron h-3.5 w-3.5 fill-none stroke-current transition-transform duration-200"
      stroke-width="2"
      aria-hidden="true"
      >
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      </button>
      {/* `pt-3` instead of `mt-3`: the gap between the trigger and the card must be INSIDE
      the hover target, or moving the pointer down into the panel crosses a dead zone
      and the menu snaps shut. A transparent pad is the bridge. */}
      <div
      class="dropdown-panel invisible absolute inset-x-4 top-full z-50 translate-y-1 pt-3 opacity-0 transition-all duration-200 sm:inset-x-6"
      >
      <div
      class="overflow-hidden rounded-2xl border border-line bg-cream shadow-xl"
      >
      <div class="grid gap-8 p-6 md:grid-cols-[1fr_32rem] lg:p-7">
      {/* LINK COLUMNS — plain text, the Threadheads shape. The 44px thumbnail rows are gone:
      in a panel this wide they read as a second search-results list, and the two TILES to the
      right now carry all the photography this surface needs. */}
      <div class="flex min-w-0 flex-col">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Kategori</p>
      <div class="mt-4 grid gap-x-8 gap-y-0.5 sm:grid-cols-2">
      {item.children.map((child) => (
      <a
      href={child.href}
      aria-current={isActive(child.href) ? "page" : undefined}
      class:list={[
      "block rounded-md px-1.5 py-1.5 text-[0.95rem] leading-snug transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
      isActive(child.href) ? "font-medium text-brand-700" : "text-ink hover:text-brand-700",
      ]}
      >
      {child.label}
      </a>
      ))}
      </div>
      <a
      href="/produk"
      class="mt-auto inline-flex items-center gap-1 self-start rounded-sm px-1.5 pt-5 text-sm font-medium text-muted transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
      Lihat semua produk
      <ArrowRight class="h-3.5 w-3.5" stroke-width={2} aria-hidden="true" />
      </a>
      </div>

      {/* TWO TILES — big photo, bold name under it, like the reference's "Shop Essentials" /
      "Heavyweight". The merchant curates them by ordering their menu: first two categories
      with a photo win. */}
      {(() => {
      {/* flatMap, not map+filter: the truthy guard narrows `meta` to non-null INSIDE the branch,
      so the returned objects are typed with a real `meta` — a .filter() predicate does not
      narrow the element type, which is the ts(18047) CI caught on its first live run. */}
      const tiles = item.children
      .flatMap((child) => {
      const meta = categoryMeta(child.href);
      return meta && meta.image ? [{ child, meta }] : [];
      })
      .slice(0, 2);
      return tiles.length > 0 ? (
      <div class="grid grid-cols-2 gap-4">
      {tiles.map(({ child, meta }) => (
      <a
      href={child.href}
      class="group/tile flex flex-col rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
      <span class="block aspect-[4/3] w-full overflow-hidden rounded-xl bg-brand-50">
      <img
      src={meta.image}
      srcset={imageSrcSet(meta.image)}
      sizes={imageSrcSet(meta.image) ? TILE_SIZES : undefined}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover/tile:scale-105 motion-reduce:transition-none motion-reduce:group-hover/tile:scale-100"
      />
      </span>
      <span class="mt-2.5 block text-center text-[0.95rem] font-semibold text-ink transition-colors group-hover/tile:text-brand-700">
      {child.label}
      </span>
      <span class="block text-center text-xs text-muted tabular-nums">
      {meta.count > 0 ? `${meta.count} produk` : "Segera hadir"}
      </span>
      </a>
      ))}
      </div>
      ) : null;
      })()}
      </div>

      {/* Utility bar: a shortcut to this store's own bestseller collection, shown only when it
      exists (the handle is a demo one otherwise). The promo shortcut moved to the main nav. */}
      {showUtilityBar && (
      <div
      class="flex items-center justify-between gap-4 border-t border-line bg-brand-50/50 px-6 py-3 text-sm"
      >
      {terlarisCol && (
      <a
      href="/kategori/produk-terlaris"
      class="ml-auto hidden rounded-sm text-muted transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 sm:block"
      >
      {terlarisCol.name}
      <ArrowRight class="ml-1 inline h-3.5 w-3.5" stroke-width={2} aria-hidden="true" />
      </a>
      )}
      </div>
      )}
      </div>
      </div>
      </div>
      ) : (
      <a
      href={item.href}
      aria-current={isActive(item.href!) ? "page" : undefined}
      class:list={[
      "relative py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:scale-x-100 motion-reduce:after:transition-none",
      isActive(item.href!) ? "font-medium text-ink after:scale-x-100" : "",
      ]}
      >
      {item.label}
      </a>
      )
      )
      }
      </nav>
    </div>

    {/* CENTRE — logo */}
    <a
    href="/"
    data-logo
    class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 shrink-0 rounded-md font-display text-xl font-semibold tracking-tight text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 sm:text-2xl"
    >
    {
    logo ? (
    <img src={logo} alt={store.name} class="h-9 w-auto max-w-[8.5rem] object-contain sm:h-10 sm:max-w-[11rem]" />
    ) : (
    store.name
    )
    }
    </a>

    {/* RIGHT — search · cart */}
    <div class="flex items-center gap-0.5 sm:gap-1">
      <a
      href="/cari"
      data-search-open
      aria-label="Cari produk"
      aria-keyshortcuts="Control+K Meta+K"
      title="Cari — tekan ⌘K"
      class="inline-flex size-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
      >
      <Search class="size-5" stroke-width={1.8} aria-hidden="true" />
      </a>
      <a
      href="/keranjang"
      class="relative inline-flex size-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
      >
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
      <path d="M2.5 3h1.6l1.5 12.5a1.5 1.5 0 0 0 1.5 1.3h9.3a1.5 1.5 0 0 0 1.47-1.2l1.4-7.3H6" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="9" cy="20" r="1.2" fill="currentColor" stroke="none" />
      <circle cx="17" cy="20" r="1.2" fill="currentColor" stroke="none" />
      </svg>
      {/* The count is a BADGE now, not a word beside the label — but it is still real text inside
      the link, so the accessible name computes to "Keranjang <n> item". The old note here
      warned that an `aria-label` saying "Keranjang" beside visible text reading "Keranjang 0"
      scored 0 on `label-content-name-mismatch`: a voice-control user says "click Keranjang"
      and nothing happens. There is still no aria-label, for exactly that reason. */}
      <span class="sr-only">Keranjang</span>
      {/* Hidden at zero — a badge reading "0" is a notification that nothing happened. The script
      below owns BOTH the number and the `hidden` attribute; setting only `textContent` (as it
      used to) would leave a badge that never appears no matter what is in the cart.
      The unit is a separate sr-only child so the accessible name reads "Keranjang 3 item" when
      there is a cart and plain "Keranjang" when there is not — and so the script can rewrite
      the digits without wiping the word. */}
      <span
      id="cart-count"
      hidden
      class="absolute -right-0.5 -top-0.5 inline-flex min-w-5 items-center justify-center rounded-full bg-brand-600 px-1.5 text-xs font-semibold text-white tabular-nums"
      ><span data-cart-n>0</span><span class="sr-only"> item</span></span
      >
      </a>
    </div>
  </div>
</header>

{/* HEADER COLOUR FLIP — transparent over the hero, solid once scrolled. Global (not scoped) and keyed
    on `#site-header[data-solid]` so a child does not need to know the state. Only the OVERLAY header
    (homepage) is transparent; the sticky bar on other pages is unaffected. */}
<style is:global>
  /* Transparent state: white on the dark hero. Higher specificity than the utility classes it
     overrides, so nav links, icons and the logo all read white without editing each one. */
  #site-header[data-overlay][data-solid="false"] { background: transparent; color: #fff; }
  #site-header[data-overlay][data-solid="false"] a,
  #site-header[data-overlay][data-solid="false"] button,
  #site-header[data-overlay][data-solid="false"] nav { color: #fff; }
  /* The hover wash is for the ICON buttons only (search / cart / hamburger) — NOT the nav links,
     which use an animated underline, and NOT the logo, which has no hover state at all. */
  #site-header[data-overlay][data-solid="false"] a:not([data-logo]):not(nav a):hover,
  #site-header[data-overlay][data-solid="false"] button:not(.dropdown-trigger):hover { background-color: rgb(255 255 255 / 0.14); color: #fff; }
  /* The mobile menu button keeps a border — make it a soft white one while transparent. */
  #site-header[data-overlay][data-solid="false"] #menu-open { border-color: rgb(255 255 255 / 0.35); }

  /* Solid state on the homepage: the same cream bar every other page already wears. */
  #site-header[data-overlay][data-solid="true"] {
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    border-bottom-color: var(--color-line);
    backdrop-filter: blur(8px);
  }
</style>

<script is:inline>
  (function () {
    var header = document.getElementById("site-header");
    if (!header || header.getAttribute("data-overlay") === null) return; // only the overlay (home) header flips
    // Solid once the shopper has scrolled past the first ~5rem — transparent while the top of the
    // hero is what fills the screen, solid as soon as they commit to scrolling. `requestAnimationFrame`
    // coalesces the scroll storm into one write per frame.
    var THRESHOLD = 80;
    var ticking = false;
    function apply() {
      header.setAttribute("data-solid", window.scrollY > THRESHOLD ? "true" : "false");
      ticking = false;
    }
    window.addEventListener("scroll", function () {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    }, { passive: true });
    apply(); // a reload partway down the page must start solid, not transparent
  })();
</script>

{/* Mobile drawer */}
<div id="mobile-menu" class="xl:hidden">
  <div
    id="menu-overlay"
    class="pointer-events-none fixed inset-0 z-50 bg-ink/40 opacity-0 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>
  {/* A <div>, not an <aside>. Lighthouse `aria-allowed-role` scores 0 on this: <aside> carries an
      implicit `complementary` role and ARIA forbids overriding it with `dialog`, so a screen reader
      is handed a contradiction — is this a landmark or a modal? A <div> has no implicit role, which
      is exactly why it is the right element to give one to. Nothing visual changes; `aside` was
      never doing any work here beyond looking semantic. */}
  <div
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    inert
    class="fixed inset-y-0 right-0 z-50 flex w-full max-w-[26rem] translate-x-full flex-col bg-cream shadow-2xl transition-transform duration-300 ease-out"
  >
    {/* X on the LEFT, borderless — the minimalist reference. No logo in the menu header: the menu is
        the shop's own space and a wordmark repeated from the bar is noise. `size-11` = the 44px floor. */}
    <div class="flex items-center px-3 py-3">
      <button
        type="button"
        id="menu-close"
        aria-label="Tutup menu"
        class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-ink transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    {/* TWO PANELS in one drawer: the main list, and a Kategori sub-panel that slides over it — the
        modern Shopify (Dawn) drill-down. Both live inside the same #mobile-drawer so focus stays
        trapped in the modal; the script toggles `data-sub` on the wrapper to translate them, and
        marks the off-screen panel `aria-hidden` so the focus trap skips it. */}
    <div id="drawer-panels" class="relative flex-1 overflow-hidden">
      {/* ── MAIN PANEL ─────────────────────────────────────────────────────────────────────────── */}
      <div data-drawer-panel="main" class="absolute inset-0 flex flex-col overflow-y-auto transition-transform duration-300 ease-out">
        <nav aria-label="Navigasi seluler" class="flex-1 px-6 pb-4 pt-2">
          {/* MINIMALIST: large plain-text links, generous line-height, no thumbnails. A parent with
              children is a button that drills into the Kategori panel — the categories are not shown
              inline here, they are one tap away, exactly like the reference. */}
          <ul class="flex flex-col">
            {
              MAIN_NAV.map((item) =>
                item.children?.length ? (
                  <li>
                    <button
                      type="button"
                      data-drawer-drill
                      aria-haspopup="true"
                      aria-expanded="false"
                      class="flex w-full items-center justify-between gap-4 py-2.5 text-left text-[1.6rem] font-normal leading-tight text-ink transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                    >
                      {item.label}
                      <ChevronRight class="size-6 shrink-0 text-muted" stroke-width={1.75} aria-hidden="true" />
                    </button>
                  </li>
                ) : (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href!) ? "page" : undefined}
                      class:list={[
                        "block py-2.5 text-[1.6rem] font-normal leading-tight transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                        isActive(item.href!) ? "text-brand-700" : "text-ink",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>

        {/* Foot strip: contact (when published) + two bestsellers as product cards — the reference's
            bottom strip, but real data rather than "recently viewed" placeholders. */}
        <div class="mt-auto">
          {
            (drawerPhone || drawerEmail) && (
              <ul class="flex flex-col gap-0.5 border-t border-line px-4 py-3 text-sm">
                {drawerPhone && (
                  <li>
                    <a
                      href={`tel:${drawerPhone.replace(/[^\d+]/g, "")}`}
                      class="flex min-h-11 items-center gap-3 rounded-xl px-2 text-ink transition-colors hover:bg-brand-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                    >
                      <Phone class="size-4 shrink-0 text-muted" stroke-width={1.75} aria-hidden="true" />
                      <span class="tabular-nums">{drawerPhone}</span>
                    </a>
                  </li>
                )}
                {drawerEmail && (
                  <li>
                    <a
                      href={`mailto:${drawerEmail}`}
                      class="flex min-h-11 items-center gap-3 rounded-xl px-2 text-ink transition-colors hover:bg-brand-50/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                    >
                      <Mail class="size-4 shrink-0 text-muted" stroke-width={1.75} aria-hidden="true" />
                      <span class="truncate">{drawerEmail}</span>
                    </a>
                  </li>
                )}
              </ul>
            )
          }
          {
            DRAWER_FEATURED.length > 0 && (
              <div class="border-t border-line px-4 py-4">
                <p class="px-1 pb-2 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-muted">Pilihan untuk kamu</p>
                <div class="grid grid-cols-2 gap-3">
                  {DRAWER_FEATURED.map((prod) => (
                    <a
                      href={`/produk/${prod.handle}`}
                      class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 rounded-lg"
                    >
                      <span class="block aspect-[3/4] overflow-hidden rounded-lg bg-brand-50 ring-1 ring-line">
                        {prod.image ? (
                          <img
                            src={prod.image}
                            srcset={imageSrcSet(prod.image)}
                            sizes={imageSrcSet(prod.image) ? DRAWER_TILE_SIZES : undefined}
                            alt=""
                            loading="lazy"
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:group-hover:scale-100"
                          />
                        ) : (
                          <span class="flex h-full w-full items-center justify-center">
                            <ShoppingBag class="size-5 text-brand-300" stroke-width={1.5} aria-hidden="true" />
                          </span>
                        )}
                      </span>
                      <span class="mt-1.5 block truncate text-xs font-medium text-ink">{prod.name}</span>
                      {prod.price > 0 && <span class="block text-xs tabular-nums text-muted">{IDR(prod.price)}</span>}
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>

      {/* ── KATEGORI SUB-PANEL — slides over the main list ──────────────────────────────────────── */}
      <div
        data-drawer-panel="kategori"
        aria-hidden="true"
        class="absolute inset-0 flex translate-x-full flex-col overflow-y-auto bg-cream transition-transform duration-300 ease-out"
      >
        <button
          type="button"
          data-drawer-back
          class="flex min-h-12 items-center gap-2 px-5 py-2 text-sm font-medium text-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
        >
          <ChevronRight class="size-4 rotate-180" stroke-width={2} aria-hidden="true" />
          Kembali
        </button>
        <nav aria-label="Kategori" class="px-6 pb-6">
          {
            DRAWER_GROUPS.map((group) => (
              <Fragment>
                <p class="pb-1 pt-3 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-muted">{group.label}</p>
                <ul class="flex flex-col">
                  {group.children!.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isActive(child.href) ? "page" : undefined}
                        class:list={[
                          "block py-2 text-[1.25rem] font-normal leading-snug transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                          isActive(child.href) ? "text-brand-700" : "text-ink",
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </Fragment>
            ))
          }
        </nav>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    function updateBadge() {
      try {
        var cart = JSON.parse(localStorage.getItem("cart") || "[]");
        var count = cart.reduce(function (n, i) {
          return n + (i.qty || 1);
        }, 0);
        var el = document.getElementById("cart-count");
        var n = el && el.querySelector("[data-cart-n]");
        if (!el || !n) return;
        n.textContent = String(count);
        // The badge is `hidden` in the markup, so this line is not decoration — without it the count
        // never becomes visible at all.
        el.hidden = count < 1;
      } catch (e) {}
    }
    updateBadge();
    window.addEventListener("storage", updateBadge);
    window.addEventListener("cart:updated", updateBadge);
  })();
</script>

<script is:inline>
  (function () {
    var openBtn = document.getElementById("menu-open");
    var closeBtn = document.getElementById("menu-close");
    var overlay = document.getElementById("menu-overlay");
    var drawer = document.getElementById("mobile-drawer");
    if (!openBtn || !drawer || !overlay) return;

    // ── THE DRAWER CLAIMS `aria-modal="true"`, SO IT HAS TO BEHAVE LIKE ONE ──────────────────────
    // Measured before this was written: on open, focus stayed on the burger OUTSIDE the panel, so a
    // keyboard or screen-reader user was told "modal dialog" and left standing in the page behind it.
    // Announcing modality you do not enforce is the half-working control this repo keeps paying for.
    var FOCUSABLE = 'a[href], button:not([disabled]), summary, input, select, textarea, [tabindex]:not([tabindex="-1"])';
    var panels = drawer.querySelector("#drawer-panels");
    var mainPanel = drawer.querySelector('[data-drawer-panel="main"]');
    var subPanel = drawer.querySelector('[data-drawer-panel="kategori"]');

    function focusables() {
      return Array.prototype.slice.call(drawer.querySelectorAll(FOCUSABLE)).filter(function (el) {
        if (el.offsetParent === null) return false; // hidden (collapsed / display:none)
        // The off-screen drill panel is still laid out (translate, not display:none), so exclude
        // anything inside a panel currently marked aria-hidden — or Tab walks onto controls the
        // shopper cannot see.
        var hidden = el.closest('[aria-hidden="true"]');
        return !(hidden && drawer.contains(hidden));
      });
    }

    // ── DRILL-DOWN: main list ⇄ Kategori sub-panel ────────────────────────────────────────────
    function showSub(on) {
      if (!panels || !subPanel || !mainPanel) return;
      // Translate both: main slides left, sub slides in from the right.
      mainPanel.style.transform = on ? "translateX(-100%)" : "";
      subPanel.style.transform = on ? "translateX(0)" : "";
      subPanel.inert = !on;
      mainPanel.inert = on;
      subPanel.setAttribute("aria-hidden", on ? "false" : "true");
      mainPanel.setAttribute("aria-hidden", on ? "true" : "false");
      var drill = drawer.querySelector("[data-drawer-drill]");
      if (drill) drill.setAttribute("aria-expanded", on ? "true" : "false");
    }
    drawer.querySelectorAll("[data-drawer-drill]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        showSub(true);
        var back = subPanel && subPanel.querySelector("[data-drawer-back]");
        if (back) back.focus();
      });
    });
    drawer.querySelectorAll("[data-drawer-back]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        showSub(false);
        var drill = drawer.querySelector("[data-drawer-drill]");
        if (drill) drill.focus();
      });
    });

    function open() {
      overlay.classList.remove("pointer-events-none", "opacity-0");
      drawer.classList.remove("translate-x-full");
      // Reachable again — see the note in close(). Removed BEFORE focus moves into the panel, or the
      // browser refuses to focus a control inside an inert subtree.
      drawer.removeAttribute("inert");
      openBtn.setAttribute("aria-expanded", "true");
      lockScroll();
      showSub(false); // always open on the main list, never mid-drill
      // Into the panel, not at the top of it: the close button is the one control every shopper
      // wants within reach, and landing there means Escape is not the only way out.
      var first = drawer.querySelector("#menu-close") || focusables()[0];
      if (first) first.focus();
    }
    function close() {
      overlay.classList.add("pointer-events-none", "opacity-0");
      drawer.classList.add("translate-x-full");
      // ⚠️ INERT, or the closed drawer keeps ~15 off-screen controls in the tab order. It is only
      // slid out of view (`translate-x-full`) — still `display:flex`, still visible, so the tab-stop
      // filter's `offsetParent === null` test passes it straight through. Measured: the SIXTH tab from
      // the top of the homepage landed on the close button OUTSIDE the viewport, then walked ten more
      // invisible links. A keyboard user could not get past the header. WCAG 2.4.3 / 2.4.11.
      drawer.setAttribute("inert", "");
      openBtn.setAttribute("aria-expanded", "false");
      unlockScroll();
      showSub(false); // reset, so the next open starts on the main list
      // Focus goes back to what opened it. Without this a keyboard user is dropped at the top of the
      // document with no idea where they were.
      if (drawer.contains(document.activeElement)) openBtn.focus();
    }

    // Scroll lock — the iOS-safe way, identical to the search palette so both panels behave the same. `overflow:hidden` on <html>/<body> is IGNORED by
    // iOS Safari for touch scrolling, so the background kept moving behind the open panel. Pinning the
    // BODY at `position:fixed; top:-scrollY` is the method that actually holds on every engine; the
    // scroll position is put back on unlock. The desktop scrollbar's width is handed back as padding
    // so the layout does not jump when it disappears.
    var _savedScrollY = 0;
    function lockScroll() {
      _savedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
      var gap = window.innerWidth - document.documentElement.clientWidth;
      var body = document.body;
      body.style.position = "fixed";
      body.style.top = -_savedScrollY + "px";
      body.style.left = "0";
      body.style.right = "0";
      body.style.width = "100%";
      if (gap > 0) body.style.paddingRight = gap + "px";
    }
    function unlockScroll() {
      var body = document.body;
      body.style.position = "";
      body.style.top = "";
      body.style.left = "";
      body.style.right = "";
      body.style.width = "";
      body.style.paddingRight = "";
      window.scrollTo(0, _savedScrollY);
    }

    openBtn.addEventListener("click", open);
    if (closeBtn) closeBtn.addEventListener("click", close);
    overlay.addEventListener("click", close);
    document.addEventListener("keydown", function (e) {
      var isOpen = !drawer.classList.contains("translate-x-full");
      if (!isOpen) return;
      if (e.key === "Escape") {
        if (subPanel && subPanel.getAttribute("aria-hidden") === "false") {
          showSub(false);
          var drill = drawer.querySelector("[data-drawer-drill]");
          if (drill) drill.focus();
        } else {
          close();
        }
        return;
      }
      if (e.key !== "Tab") return;
      // Wrap at the ends. Without this, Tab off the last item walks into the page the dialog says is
      // unavailable, and Shift+Tab off the first walks into the header.
      var list = focusables();
      if (!list.length) return;
      var first = list[0];
      var last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      else if (!drawer.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
    });
    // close after navigating to a link inside the drawer
    drawer.querySelectorAll("a[href]").forEach(function (a) {
      a.addEventListener("click", close);
    });
  })();
</script>

<style>
  /* Desktop mega menu: opens on CLICK only — `.is-open` is the whole state.
     It used to open on `:hover` and `:focus-within` too, and that was the source of every workaround
     that used to live here and in the script below: a `.is-closed` class whose only job was to beat
     the `:hover` rule, plus a `dd.matches(":hover")` test, because clicking to close under a resting
     pointer left the panel on screen and the button felt dead.
     Hover is also the wrong verb on a touch screen — a tap has to mean one thing, and on a hybrid
     laptop the panel opened at every pointer that merely crossed the word on its way somewhere else. */
  .dropdown.is-open > .dropdown-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .dropdown.is-open .dropdown-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel,
    .dropdown-chevron {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // --- Desktop mega menu: CLICK to open, click again / outside / Escape to close ---
    //
    // No hover. The whole state is one class, so there is nothing to keep in sync and no rule to
    // out-specify. `aria-expanded` is on the trigger (a real <button>), so a screen reader and the
    // panel can never disagree about whether it is open.
    var dropdowns = Array.prototype.slice.call(document.querySelectorAll("[data-dropdown]"));

    function closeAll(except) {
      dropdowns.forEach(function (dd) {
        if (dd === except) return;
        dd.classList.remove("is-open");
        var t = dd.querySelector(".dropdown-trigger");
        if (t) t.setAttribute("aria-expanded", "false");
      });
    }

    dropdowns.forEach(function (dd) {
      var trigger = dd.querySelector(".dropdown-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", function (e) {
        e.preventDefault();
        var open = dd.classList.contains("is-open");
        // Only one panel at a time: two mega panels overlapping is not a state anyone chose.
        closeAll(dd);
        dd.classList.toggle("is-open", !open);
        trigger.setAttribute("aria-expanded", String(!open));
      });

      // Following a link should not leave the panel hanging if the browser restores this page from
      // bfcache — the shopper would come back to a menu they never reopened.
      dd.querySelectorAll("a[href]").forEach(function (a) {
        a.addEventListener("click", function () { closeAll(); });
      });
    });

    document.addEventListener("click", function (e) {
      var inside = dropdowns.some(function (dd) { return dd.contains(e.target); });
      if (!inside) closeAll();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      var open = dropdowns.filter(function (dd) { return dd.classList.contains("is-open"); });
      if (!open.length) return;
      // Return focus to the control that opened it, or the keyboard user is dropped at the top of
      // the document with no idea where they were.
      var t = open[0].querySelector(".dropdown-trigger");
      closeAll();
      if (t) t.focus();
    });

    // The mobile accordion's script lived here — ~25 lines keeping a chevron transform, a `hidden`
    // class and an `aria-expanded` in sync. It is a native <details> now, so the platform owns all
    // three and there is nothing left to keep in sync. Deleted, not replaced.
  })();
</script>
