---
import { STORE, COLLECTIONS } from "../data/catalog";
---

<header class="sticky top-0 z-40 border-b border-line bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0 font-display text-xl font-semibold tracking-tight text-ink sm:text-2xl">
      {STORE.name}
    </a>

    <nav class="mx-auto hidden items-center gap-6 text-sm font-medium text-muted lg:flex">
      <a href="/" class="transition-colors hover:text-brand-600">Beranda</a>
      {
        COLLECTIONS.map((c) => (
          <a href={`/kategori/${c.handle}`} class="transition-colors hover:text-brand-600">
            {c.name}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href={`https://wa.me/${STORE.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:border-brand-400 hover:text-brand-600 sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.4-8.28 8.4Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43l-.48-.01c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z" />
        </svg>
        WhatsApp
      </a>

      <a
        href="/keranjang"
        class="relative inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-sm font-medium text-cream transition-colors hover:bg-brand-700"
        aria-label="Keranjang"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
          <path d="M2.5 3h1.6l1.5 12.5a1.5 1.5 0 0 0 1.5 1.3h9.3a1.5 1.5 0 0 0 1.47-1.2l1.4-7.3H6" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="9" cy="20" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="17" cy="20" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        <span class="hidden sm:inline">Keranjang</span>
        <span
          id="cart-count"
          class="ml-0.5 inline-flex min-w-5 items-center justify-center rounded-full bg-brand-600 px-1.5 text-xs font-semibold text-white"
          >0</span
        >
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function updateBadge() {
      try {
        var cart = JSON.parse(localStorage.getItem("cart") || "[]");
        var count = cart.reduce(function (n, i) {
          return n + (i.qty || 1);
        }, 0);
        var el = document.getElementById("cart-count");
        if (el) el.textContent = String(count);
      } catch (e) {}
    }
    updateBadge();
    window.addEventListener("storage", updateBadge);
    window.addEventListener("cart:updated", updateBadge);
  })();
</script>
