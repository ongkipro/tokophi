---
import { ShoppingBag, Tag, ArrowRight, Search } from "@lucide/astro";
import { IDR } from "@tokophi/lib/format";
import { mediaUrl } from "../data/catalog";
import { getMainNav, type NavItem } from "../data/nav";

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;
// The store's OWN menu, as built in the admin's Navigasi editor. The collections are passed for the
// FALLBACK only (a store that has built a menu gets exactly that menu): a store with no menu rows —
// which is every freshly provisioned one — used to be handed a hardcoded copy of Batik Nusantara's
// categories, so its header linked to /kategori/dress and 404'd on every page. See data/nav.ts.
const MAIN_NAV = await getMainNav(store.id, catalog.collections);

// The mega-menu utility bar linked to two hardcoded demo collections (promo-gajian, produk-terlaris)
// that 404 on any tenant that doesn't have them. Render each link only if THIS store actually has that
// collection, using its real name — and hide the whole bar when neither exists.
const promoCol = catalog.findCollection("promo-gajian");
const terlarisCol = catalog.findCollection("produk-terlaris");
const showUtilityBar = Boolean(promoCol || terlarisCol);
// Merchant logo (stores.logo_url) when set, else the store name as a wordmark.
const logo = store.logoUrl ? mediaUrl(store.logoUrl) : null;
const pathname = Astro.url.pathname;
// Prefill the search box on /cari so a shopper refining a search doesn't start from blank. `q` is the
// ONLY thing we read from the URL, and only here — trimmed + capped exactly like the /cari page does.
const searchQuery = pathname === "/cari" ? (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100) : "";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(href + "/");

// A parent item is "active" when its own href matches or any child link matches.
const isItemActive = (item: NavItem) => {
  if (item.href && isActive(item.href)) return true;
  return !!item.children?.some((c) => isActive(c.href));
};

// --- Mega menu content ---
//
// The nav TREE comes from the store's own menu in the DB (getMainNav → the admin's Navigasi editor).
// What the panel SHOWS on top of it is live per-tenant catalog data: a thumbnail and a real product
// count per category. The menu decides WHICH categories to list; the catalog decides what they
// actually contain — so a store whose categories differ from the seed still gets a truthful panel.
const categoryMeta = (href: string) => {
  const handle = href.startsWith("/kategori/") ? href.slice("/kategori/".length) : "";
  if (!handle) return null;
  const items = catalog.byCollection(handle);
  const col = catalog.findCollection(handle);
  // A menu entry pointing at a category with no products is a dead end — the panel says so rather
  // than sending a shopper to an empty grid with no warning.
  // No emoji fallback: a category with no photo gets a Lucide glyph (see the panel), which stays
  // inside the brand palette instead of an OS-coloured pictograph.
  return { count: items.length, image: items[0]?.image };
};

// The one product the panel promotes. Bestseller, not random: the menu is prime real estate and a
// shopper opening it is browsing, not committed — show them the thing most likely to convert.
const featured = catalog.bestsellers()[0];
---

<header class="sticky top-0 z-40 border-b border-line bg-cream/85 backdrop-blur">
  <!-- `relative` here is what the mega panel anchors to. It used to anchor to its own trigger
       (left-1/2 + -translate-x-1/2), which centres a 62rem panel on a button sitting far right in
       the nav — so the panel hung off the left edge of the screen. A mega menu belongs to the
       HEADER, not to the word that opens it. -->
  <div class="relative mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 sm:px-6">
    <a
      href="/"
      class="shrink-0 rounded-md font-display text-xl font-semibold tracking-tight text-ink transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 sm:text-2xl"
    >
      {
        logo ? (
          <img src={logo} alt={store.name} class="h-9 w-auto max-w-[11rem] object-contain sm:h-10" />
        ) : (
          store.name
        )
      }
    </a>

    <nav aria-label="Navigasi utama" class="mx-auto hidden items-center gap-7 text-sm text-muted lg:flex">
      {
        MAIN_NAV.map((item) =>
          item.children ? (
            <!-- NOT `relative`: the panel must position against the header container above, not
                 against this trigger. -->
            <div class="dropdown" data-dropdown>
              <button
                type="button"
                class:list={[
                  "dropdown-trigger relative flex items-center gap-1 rounded-sm py-1 transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                  isItemActive(item)
                    ? "font-medium text-brand-700 after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-full after:bg-brand-600"
                    : "",
                ]}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg
                  viewBox="0 0 24 24"
                  class="dropdown-chevron h-3.5 w-3.5 fill-none stroke-current transition-transform duration-200"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <!-- `pt-3` instead of `mt-3`: the gap between the trigger and the card must be INSIDE
                   the hover target, or moving the pointer down into the panel crosses a dead zone
                   and the menu snaps shut. A transparent pad is the bridge. -->
              <div
                class="dropdown-panel invisible absolute inset-x-4 top-full z-50 translate-y-1 pt-3 opacity-0 transition-all duration-200 sm:inset-x-6"
              >
                <div
                  class="overflow-hidden rounded-2xl border border-line bg-cream/95 shadow-xl backdrop-blur"
                >
                  <div class="grid gap-6 p-5 md:grid-cols-[1.7fr_1fr]">
                    <!-- Categories -->
                    <div>
                      <div class="flex items-center justify-between px-1 pb-3">
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">
                          Kategori
                        </p>
                        <a
                          href="/produk"
                          class="rounded-sm text-xs font-medium text-muted transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                        >
                          Lihat semua
                          <ArrowRight class="ml-1 inline h-3.5 w-3.5" stroke-width={2} aria-hidden="true" />
                        </a>
                      </div>

                      <div class="grid gap-1 sm:grid-cols-2">
                        {item.children.map((child) => {
                          const meta = categoryMeta(child.href);
                          return (
                            <a
                              href={child.href}
                              aria-current={isActive(child.href) ? "page" : undefined}
                              class:list={[
                                "group/cat flex items-center gap-3 rounded-xl p-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                                isActive(child.href) ? "bg-brand-50" : "hover:bg-brand-50/70",
                              ]}
                            >
                              {/* Thumbnail = the category's first product. No product → a Lucide
                                  glyph, never an empty or broken frame. */}
                              <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-brand-50 ring-1 ring-line">
                                {meta?.image ? (
                                  <img
                                    src={meta.image}
                                    alt=""
                                    loading="lazy"
                                    class="h-full w-full object-cover transition-transform duration-300 group-hover/cat:scale-105"
                                  />
                                ) : (
                                  <ShoppingBag class="h-5 w-5 text-brand-400" stroke-width={1.75} aria-hidden="true" />
                                )}
                              </span>
                              <span class="min-w-0">
                                <span
                                  class:list={[
                                    "block truncate text-sm transition-colors",
                                    isActive(child.href)
                                      ? "font-medium text-brand-700"
                                      : "text-ink group-hover/cat:text-brand-700",
                                  ]}
                                >
                                  {child.label}
                                </span>
                                <span class="block text-xs text-muted tabular-nums">
                                  {meta
                                    ? meta.count > 0
                                      ? `${meta.count} produk`
                                      : "Segera hadir"
                                    : "Lihat koleksi"}
                                </span>
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </div>

                    <!-- Featured product. The menu is prime real estate; a column of links wastes it. -->
                    {featured && (
                      <a
                        href={`/produk/${featured.handle}`}
                        class="group/feat flex flex-col rounded-xl border border-line bg-white p-3 transition-all hover:border-brand-400 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                      >
                        <span class="aspect-[4/3] w-full overflow-hidden rounded-lg bg-brand-50">
                          <img
                            src={featured.image}
                            alt=""
                            loading="lazy"
                            class="h-full w-full object-cover transition-transform duration-500 group-hover/feat:scale-105"
                          />
                        </span>
                        <span class="mt-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">
                          Terlaris
                        </span>
                        <span class="mt-1 line-clamp-2 text-sm font-medium leading-snug text-ink transition-colors group-hover/feat:text-brand-700">
                          {featured.name}
                        </span>
                        <span class="mt-1 text-sm font-semibold text-ink tabular-nums">
                          {IDR(featured.price)}
                        </span>
                      </a>
                    )}
                  </div>

                  <!-- Utility bar: shortcuts to this store's own promo/bestseller collections, shown
                       only when they exist (they are hardcoded demo handles otherwise). -->
                  {showUtilityBar && (
                  <div
                    class="flex items-center justify-between gap-4 border-t border-line bg-brand-50/50 px-6 py-3 text-sm"
                  >
                    {promoCol && (
                    <a
                      href="/kategori/promo-gajian"
                      class="inline-flex items-center gap-2 rounded-sm font-medium text-brand-700 transition-colors hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
                    >
                      <Tag class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
                      {promoCol.name}
                    </a>
                    )}
                    {terlarisCol && (
                    <a
                      href="/kategori/produk-terlaris"
                      class="ml-auto hidden rounded-sm text-muted transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 sm:block"
                    >
                      {terlarisCol.name}
                      <ArrowRight class="ml-1 inline h-3.5 w-3.5" stroke-width={2} aria-hidden="true" />
                    </a>
                    )}
                  </div>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href!) ? "page" : undefined}
              class:list={[
                "relative rounded-sm py-1 transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                isActive(item.href!)
                  ? "font-medium text-brand-700 after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-full after:bg-brand-600"
                  : "",
              ]}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      {/* REMOVED: the "Akun" pill. It pointed at /akun, which was a FAKE login page: the form had no
          handler and no endpoint — it swallowed an email and a PASSWORD, called preventDefault(), and
          revealed a div reading "Demo — sistem akun aktif setelah backend terhubung." Shipped demo text
          on a live shop, and a shopper typing a password they have certainly reused elsewhere into a
          form that discards it. There are no shopper accounts by design (buying never requires one —
          see AGENTS.md), so there is nothing for this link to point at. */}

      {/* Search — a plain GET form to /cari: it works with JS disabled and the result URL is shareable
          (?q=…). Desktop only; the phone gets one inside the drawer. `type="search"` gives a native
          clear button; the query is capped at 100 (a search string, not a validated field). */}
      <form action="/cari" method="get" role="search" class="hidden lg:block">
        <label for="site-search" class="sr-only">Cari produk</label>
        {/* ⚠️ The search field is `w-40` until `xl`, THEN `w-52`. The desktop nav switches on at `lg`
            (1024px) — and at exactly 1024 the row (logo + 7 nav items + a 208px search + the cart
            pill) needs 4–6px more than the 976px the container leaves, so the whole shop scrolled
            sideways on every iPad in landscape. Nothing in that row may shrink without losing a nav
            label, so the search field gives up 48px on the one tier where it is tight and takes them
            back at `xl`. Do not widen it below `xl` without re-running `npm run audit:responsive`.

            (This note sat INSIDE the <input>'s attribute list for one commit. `astro build` accepted
            it and the page shipped correctly — `astro check` did not, with 24 errors. A comment is
            not an attribute; markup comments belong between tags.) */}
        <div class="relative flex items-center">
          <input
            id="site-search"
            type="search"
            name="q"
            value={searchQuery}
            maxlength="100"
            placeholder="Cari produk…"
            autocomplete="off"
            enterkeyhint="search"
            class="min-h-11 w-40 rounded-full border border-line bg-white pl-4 pr-11 text-sm text-ink placeholder:text-muted transition-colors hover:border-brand-400 focus-visible:border-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none xl:w-52"
          />
          <button
            type="submit"
            aria-label="Cari"
            class="absolute inset-y-0 right-0 inline-flex w-11 items-center justify-center rounded-r-full text-brand-600 transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
          >
            <Search class="h-4 w-4" stroke-width={1.8} aria-hidden="true" />
          </button>
        </div>
      </form>

      {/* NO aria-label on this link. It said "Keranjang" while the visible text reads "Keranjang 0",
          so Lighthouse `label-content-name-mismatch` scored 0 — a voice-control user says "click
          Keranjang" and nothing happens, because the name they can SEE is not the name the browser
          matched on. With the label gone the name is computed from the content, which is the visible
          text by definition, and the two can never drift apart again.
          The word is `sr-only` rather than `hidden` below the sm breakpoint: `hidden` removed it from
          the accessible name too, leaving every phone user a link named just "0". */}
      <a
        href="/keranjang"
        class="relative inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-sm font-medium text-cream transition-colors hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
          <path d="M2.5 3h1.6l1.5 12.5a1.5 1.5 0 0 0 1.5 1.3h9.3a1.5 1.5 0 0 0 1.47-1.2l1.4-7.3H6" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="9" cy="20" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="17" cy="20" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        <span class="sr-only sm:not-sr-only sm:inline">Keranjang</span>
        <span
          id="cart-count"
          class="ml-0.5 inline-flex min-w-5 items-center justify-center rounded-full bg-brand-600 px-1.5 text-xs font-semibold text-white"
          >0</span
        >
        <span class="sr-only">item</span>
      </a>

      <button
        type="button"
        id="menu-open"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Buka menu"
        class="inline-flex items-center justify-center rounded-full border border-line p-2 text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
          <path d="M3.5 6h17M3.5 12h17M3.5 18h17" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div id="mobile-menu" class="lg:hidden">
  <div
    id="menu-overlay"
    class="pointer-events-none fixed inset-0 z-50 bg-ink/40 opacity-0 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>
  {/* A <div>, not an <aside>. Lighthouse `aria-allowed-role` scores 0 on this: <aside> carries an
      implicit `complementary` role and ARIA forbids overriding it with `dialog`, so a screen reader
      is handed a contradiction — is this a landmark or a modal? A <div> has no implicit role, which
      is exactly why it is the right element to give one to. Nothing visual changes; `aside` was
      never doing any work here beyond looking semantic. */}
  <div
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    class="fixed inset-y-0 right-0 z-50 flex w-[85%] max-w-sm translate-x-full flex-col bg-cream shadow-2xl transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <a href="/" class="font-display text-xl font-semibold tracking-tight text-ink">
        {logo ? <img src={logo} alt={store.name} class="h-8 w-auto max-w-[9rem] object-contain" /> : store.name}
      </a>
      <button
        type="button"
        id="menu-close"
        aria-label="Tutup menu"
        class="inline-flex items-center justify-center rounded-full border border-line p-2 text-ink transition-colors hover:border-brand-400 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav aria-label="Navigasi seluler" class="flex-1 overflow-y-auto px-3 py-4">
      {/* Search lives at the TOP of the drawer — a phone is where most Indonesian shoppers browse, so
          it belongs where the thumb lands first, not buried under the category list. Same GET form as
          desktop; submitting reloads the page, which closes the drawer for free. */}
      <form action="/cari" method="get" role="search" class="mb-4 px-1">
        <label for="mobile-search" class="sr-only">Cari produk</label>
        <div class="relative flex items-center">
          <input
            id="mobile-search"
            type="search"
            name="q"
            value={searchQuery}
            maxlength="100"
            placeholder="Cari produk…"
            autocomplete="off"
            enterkeyhint="search"
            class="min-h-11 w-full rounded-full border border-line bg-white pl-4 pr-11 text-base text-ink placeholder:text-muted focus-visible:border-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
          />
          <button
            type="submit"
            aria-label="Cari"
            class="absolute inset-y-0 right-0 inline-flex w-11 items-center justify-center rounded-r-full text-brand-600 transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 motion-reduce:transition-none"
          >
            <Search class="h-5 w-5" stroke-width={1.8} aria-hidden="true" />
          </button>
        </div>
      </form>

      <ul class="flex flex-col gap-1">
        {
          MAIN_NAV.map((item) =>
            item.children ? (
              <li data-accordion>
                <button
                  type="button"
                  class:list={[
                    "accordion-trigger flex w-full items-center justify-between rounded-xl px-4 py-3 text-base transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                    isItemActive(item)
                      ? "bg-brand-50 font-medium text-brand-700"
                      : "text-ink hover:bg-brand-50/60 hover:text-brand-700",
                  ]}
                  aria-expanded={isItemActive(item) ? "true" : "false"}
                >
                  <span>{item.label}</span>
                  <svg
                    viewBox="0 0 24 24"
                    class="accordion-chevron h-4 w-4 fill-none stroke-current transition-transform duration-200"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul
                  class:list={[
                    "accordion-panel mt-1 flex flex-col gap-0.5 overflow-hidden pl-3 transition-all",
                    isItemActive(item) ? "" : "hidden",
                  ]}
                >
                  {/* Same thumbnail + live count as the desktop mega panel. A phone is where most
                      Indonesian shoppers actually browse — it should not get the stripped version. */}
                  {item.children.map((child) => {
                    const meta = categoryMeta(child.href);
                    return (
                      <li>
                        <a
                          href={child.href}
                          aria-current={isActive(child.href) ? "page" : undefined}
                          class:list={[
                            "flex items-center gap-3 rounded-xl p-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                            isActive(child.href) ? "bg-brand-50" : "hover:bg-brand-50/60",
                          ]}
                        >
                          <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-brand-50 ring-1 ring-line">
                            {meta?.image ? (
                              <img src={meta.image} alt="" loading="lazy" class="h-full w-full object-cover" />
                            ) : (
                              <ShoppingBag class="h-4 w-4 text-brand-400" stroke-width={1.75} aria-hidden="true" />
                            )}
                          </span>
                          <span class="min-w-0">
                            <span
                              class:list={[
                                "block truncate text-sm",
                                isActive(child.href) ? "font-medium text-brand-700" : "text-ink",
                              ]}
                            >
                              {child.label}
                            </span>
                            <span class="block text-xs text-muted tabular-nums">
                              {meta ? (meta.count > 0 ? `${meta.count} produk` : "Segera hadir") : "Lihat koleksi"}
                            </span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href!) ? "page" : undefined}
                  class:list={[
                    "block rounded-xl px-4 py-3 text-base transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400",
                    isActive(item.href!)
                      ? "bg-brand-50 font-medium text-brand-700"
                      : "text-ink hover:bg-brand-50/60 hover:text-brand-700",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="border-t border-line px-5 py-4">
      {/* Same reason as the desktop pill above — /akun is gone. */}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function updateBadge() {
      try {
        var cart = JSON.parse(localStorage.getItem("cart") || "[]");
        var count = cart.reduce(function (n, i) {
          return n + (i.qty || 1);
        }, 0);
        var el = document.getElementById("cart-count");
        if (el) el.textContent = String(count);
      } catch (e) {}
    }
    updateBadge();
    window.addEventListener("storage", updateBadge);
    window.addEventListener("cart:updated", updateBadge);
  })();
</script>

<script is:inline>
  (function () {
    var openBtn = document.getElementById("menu-open");
    var closeBtn = document.getElementById("menu-close");
    var overlay = document.getElementById("menu-overlay");
    var drawer = document.getElementById("mobile-drawer");
    if (!openBtn || !drawer || !overlay) return;

    function open() {
      overlay.classList.remove("pointer-events-none", "opacity-0");
      drawer.classList.remove("translate-x-full");
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }
    function close() {
      overlay.classList.add("pointer-events-none", "opacity-0");
      drawer.classList.add("translate-x-full");
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    openBtn.addEventListener("click", open);
    if (closeBtn) closeBtn.addEventListener("click", close);
    overlay.addEventListener("click", close);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });
    // close after navigating to a link inside the drawer
    drawer.querySelectorAll("a[href]").forEach(function (a) {
      a.addEventListener("click", close);
    });
  })();
</script>

<style>
  /* Desktop mega menu: open on hover / keyboard focus-within, or when JS marks it open */
  .dropdown:hover > .dropdown-panel,
  .dropdown:focus-within > .dropdown-panel,
  .dropdown.is-open > .dropdown-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .dropdown:hover .dropdown-chevron,
  .dropdown:focus-within .dropdown-chevron,
  .dropdown.is-open .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Click-to-close was broken: the `:hover` rule above kept the panel visible while the pointer sat
     on the trigger, so removing `.is-open` did nothing and the click looked dead. `.is-closed` is
     the explicit override — set on click-close, cleared on mouseleave so hover works again after. */
  .dropdown.is-closed > .dropdown-panel {
    visibility: hidden;
    opacity: 0;
  }
  .dropdown.is-closed .dropdown-chevron {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-panel,
    .dropdown-chevron {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // --- Desktop dropdown (hover via CSS; click + keyboard + outside-click here) ---
    var dropdowns = Array.prototype.slice.call(document.querySelectorAll("[data-dropdown]"));
    dropdowns.forEach(function (dd) {
      var trigger = dd.querySelector(".dropdown-trigger");
      if (!trigger) return;

      function openDD() {
        dd.classList.add("is-open");
        dd.classList.remove("is-closed");
        trigger.setAttribute("aria-expanded", "true");
      }
      function closeDD() {
        dd.classList.remove("is-open");
        // `.is-closed` beats the CSS `:hover` rule — without it, a click-to-close under a resting
        // pointer leaves the panel on screen and the button feels broken.
        dd.classList.add("is-closed");
        trigger.setAttribute("aria-expanded", "false");
      }

      trigger.addEventListener("click", function (e) {
        e.preventDefault();
        // Toggle on what the shopper actually SEES, not on `.is-open`. Hover opens the panel purely
        // in CSS without ever setting that class — so a class-only check made the first click on a
        // hovered (visible) panel "open" it again, i.e. do nothing.
        var visible =
          !dd.classList.contains("is-closed") &&
          (dd.classList.contains("is-open") || dd.matches(":hover") || dd.contains(document.activeElement));
        if (visible) closeDD();
        else openDD();
      });
      // keep aria in sync when hovering opens it
      dd.addEventListener("mouseenter", function () {
        if (!dd.classList.contains("is-closed")) trigger.setAttribute("aria-expanded", "true");
      });
      dd.addEventListener("mouseleave", function () {
        // Leaving resets the click-suppression, so hover opens it again next time.
        dd.classList.remove("is-closed");
        if (!dd.classList.contains("is-open")) trigger.setAttribute("aria-expanded", "false");
      });
      dd.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          closeDD();
          trigger.focus();
        }
      });
      // Navigating away from an open panel should not leave it hanging if the browser restores the
      // page from bfcache.
      dd.querySelectorAll("a[href]").forEach(function (a) {
        a.addEventListener("click", closeDD);
      });
      dd.__closeDD = closeDD;
    });

    document.addEventListener("click", function (e) {
      dropdowns.forEach(function (dd) {
        if (!dd.contains(e.target) && dd.__closeDD) dd.__closeDD();
      });
    });

    // --- Mobile accordion (parent expand/collapse) ---
    document.querySelectorAll("[data-accordion]").forEach(function (acc) {
      var trigger = acc.querySelector(".accordion-trigger");
      var panel = acc.querySelector(".accordion-panel");
      var chevron = acc.querySelector(".accordion-chevron");
      if (!trigger || !panel) return;
      // sync initial chevron with server-rendered expanded state
      if (chevron && !panel.classList.contains("hidden")) chevron.style.transform = "rotate(180deg)";
      trigger.addEventListener("click", function () {
        var isOpen = !panel.classList.contains("hidden");
        if (isOpen) {
          panel.classList.add("hidden");
          trigger.setAttribute("aria-expanded", "false");
          if (chevron) chevron.style.transform = "";
        } else {
          panel.classList.remove("hidden");
          trigger.setAttribute("aria-expanded", "true");
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });
  })();
</script>
