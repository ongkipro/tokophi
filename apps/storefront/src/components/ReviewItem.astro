---
// ONE review row — rendered on the PDP (first five) and again inside the "Semua ulasan" dialog, so
// the two can never drift. Plain text only: every field is shopper or merchant input and Astro
// escapes it. `data-rating` lets the dialog's star chips filter rows without a request.
import Stars from "./Stars.astro";

interface Props {
  rev: { author: string; rating: number; body: string; daysAgo: number; reply?: string | null };
}
const { rev } = Astro.props;
---

<li data-rating={Math.round(rev.rating)}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-mist-strong text-sm font-semibold text-ink" aria-hidden="true">
        {rev.author.trim().charAt(0).toUpperCase()}
      </span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <span class="font-medium text-ink">{rev.author}</span>
          {/* VERIFIED (owner 2026-11-05): the word in the body colour, the mark in the blue a shopper
              already reads as "verified" from social media — the one deliberate colour on the page. */}
          <span class="inline-flex items-center gap-1 text-xs text-ink">
            <svg viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true">
              <path fill="#1D9BF0" d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
              <path d="m9 12 2 2 4-4" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Terverifikasi
          </span>
        </div>
        <p class="text-xs text-muted">{rev.daysAgo === 0 ? "Hari ini" : `${rev.daysAgo} hari lalu`}</p>
      </div>
    </div>
    <Stars value={rev.rating} size="sm" showValue={false} class="mt-1 shrink-0" />
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">{rev.body}</p>
  {
    rev.reply && (
      <div class="mt-3 rounded-md bg-mist px-3 py-2">
        <p class="text-xs font-semibold text-ink">Balasan penjual</p>
        <p class="mt-1 text-sm leading-relaxed text-ink">{rev.reply}</p>
      </div>
    )
  }
</li>
