---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { clamp } from "../lib/text";
import Analytics from "../components/Analytics.astro";
import MarketingPixels from "../components/MarketingPixels.astro";
import ImageFallback from "../components/ImageFallback.astro";
import Chat from "../components/Chat.astro";
import ThemeTokens from "../components/ThemeTokens.astro";
import { mediaUrl, ADMIN_BASE } from "../data/catalog";

interface Props {
  title: string;
  description?: string;
  /** Social-card image. Site-relative or absolute — it is made absolute below. */
  image?: string;
  /** og:type. `product` on a PDP, `article` on a blog post, `website` everywhere else. */
  type?: "website" | "product" | "article";
  /** Extra <head> markup (JSON-LD, article:* tags). Rendered raw — pass ONLY server-built strings. */
  head?: string;
  /**
   * `<meta name="robots">`. Omit on anything you want indexed — an absent tag already means
   * "index,follow", so emitting that would be noise.
   *
   * Set `"noindex,follow"` on a page that is per-shopper or thin (e.g. /keranjang). ⚠️ Note this is
   * NOT redundant with a robots.txt `Disallow`, which is the opposite of what it looks like: a
   * disallowed URL can still be indexed **URL-only** from inbound links, and because the crawler is
   * forbidden from FETCHING it, it can never read the `noindex` that would have kept it out. The two
   * mechanisms do different jobs.
   */
  robots?: string;
}

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog, origin } = Astro.locals;
const { title, description = store.tagline, image, type = "website", head, robots } = Astro.props;

const fullTitle = `${title} - ${store.name}`;

// A meta/OG description longer than ~155 chars is truncated mid-sentence by Google and hard-cut by
// WhatsApp's preview card. `clamp` (src/lib/text.ts) cuts on a word and marks it — the footer needs
// the same treatment for the same merchant field, so the rule lives in one place.
const desc = clamp(description ?? "");

// CANONICAL — per request, never baked in. One deploy serves every merchant, so the correct host is
// whatever the shopper landed on (a custom domain, <slug>.tokophi.com, or localhost). `origin` comes
// from the middleware, which reads x-forwarded-proto/host — behind Cloudflare the adapter sees plain
// HTTP, so Astro.url.protocol would emit http:// canonicals that 301 on every crawl.
//
// The query string is dropped: this is ad-landed traffic, so `?utm_source=…` arrives constantly, and
// leaving it in would splinter one page's ranking signals across dozens of URL variants.
//
// …EXCEPT `page`, which is not a tracking parameter — it is a different set of products. Dropping it
// made every page of a paginated listing canonicalise to page 1, i.e. declare itself a duplicate of a
// page that does not contain its products. For a 12-per-page catalogue that hides everything from the
// 13th product on from search entirely. Paginated pages must SELF-canonicalise (Google's own
// guidance since rel=prev/next was retired). `page=1` still normalises to the bare path — it is the
// same page and two URLs for it is the splintering this comment is about.
//
// An ALLOW-LIST, not a blocklist: a new tracking param must not have to be discovered and banned.
const CANONICAL_PARAMS = ["page"] as const;
const canonicalUrl = new URL(Astro.url.pathname, origin);
for (const k of CANONICAL_PARAMS) {
  const v = Astro.url.searchParams.get(k);
  if (v && v !== "1" && /^\d{1,4}$/.test(v)) canonicalUrl.searchParams.set(k, v);
}
const canonical = canonicalUrl.href;

// The merchant's favicon (stores.favicon_url, set in Pengaturan → Profil Toko). mediaUrl() rewrites
// an admin `/api/uploads/…` path to wherever uploads are actually served from — the same treatment
// the logo already gets in Header.astro. null → the platform icon.
const favicon = store.faviconUrl ? mediaUrl(store.faviconUrl) : null;

// og:image MUST be absolute — crawlers do not resolve a relative one. Product images are either
// site-relative (/products/x.webp) or already absolute (mediaUrl() rewrites admin uploads).
const ogImage = (() => {
  // ⚠️ `mediaUrl()` on the LOGO. `store.logoUrl` is the relative `/api/uploads/<name>` the admin
  // writes, and that path is served by the ADMIN app — resolving it against the STOREFRONT origin
  // produced a 404 on every share. The favicon fifteen lines up already does this; the og:image did
  // not. Measured: `/`, `/produk`, `/kontak` and every `/halaman/*` all shared a broken thumbnail,
  // because they carry no explicit image and fall through to the logo — which is the first thing
  // onboarding asks a merchant to upload. `image` is passed already-absolute by its callers.
  const src = image || (store.logoUrl ? mediaUrl(store.logoUrl) : "") || "";
  if (!src) return null;
  try {
    return new URL(src, origin).href;
  } catch {
    return null;
  }
})();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The merchant's own tab icon when they set one (Pengaturan → Profil Toko), else the platform's.
        A shop on its own domain wearing TokoΦ's favicon reads as "this isn't really my site" — the
        exact impression a white-label builder is bought to avoid. No `type=`: the upload may be PNG,
        ICO or WebP, and asserting the wrong one is worse than letting the browser sniff it. */}
    {favicon
      ? <link rel="icon" href={favicon} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />}
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter. There were NONE — so every product link forwarded to a WhatsApp group
         (the cheapest acquisition channel these merchants have) landed as a bare grey URL: no photo,
         no name, no price. For an ad-landed fashion store that is the difference between a share that
         converts and one nobody taps. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {
      ogImage && (
        <Fragment>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:alt" content={fullTitle} />
          <meta name="twitter:image" content={ogImage} />
        </Fragment>
      )
    }
    {/* The merchant's photos, logo and favicon are served by the ADMIN app — a different origin in
        production — so the browser paid DNS+TLS+RTT before the first byte of the LCP candidate on any
        store that uses uploads. Only the two font hosts were preconnected. */}
    {ADMIN_BASE && <link rel="preconnect" href={ADMIN_BASE} crossorigin />}
    {/* Inter is SELF-HOSTED (see styles/global.css). The Google Fonts <link> that used to sit here was
        render-blocking for 1.409 ms on production, in front of an LCP that was 82% render delay.
        `preload` because the font is referenced from inside a stylesheet, so the browser would
        otherwise only discover it after parsing the CSS. latin only — latin-ext is fetched on demand
        by unicode-range and preloading it would download 84 KB almost nobody needs. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- ADR 0009 — merchant's design-token overrides (brand shades + chosen neutrals/display font,
         stores.theme 0092). One shared injection site; see ThemeTokens.astro for the gating rule. -->
    <ThemeTokens />
    <!-- Per-page <head> extras: JSON-LD, article:* tags. Server-built strings only. -->
    {head && <Fragment set:html={head} />}
    <!-- Funnel/device tracking → POST /api/track → analytics_events → admin /analitik. -->
    <Analytics />
    <!-- Merchant's own marketing pixels (Meta/Google/TikTok), per store — Pemasaran → Pelacakan. -->
    <MarketingPixels />
    <ImageFallback />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    {/* Skip link (WCAG 2.4.1) — a keyboard/screen-reader shopper lands on the header nav every page and
        had to tab through all of it to reach the products. `sr-only` until focused, then it shows. */}
    <a
      href="#main"
      class="sr-only rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      Lewati ke konten
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* One palette per page — the header trigger, ⌘K and `/` all open this instance. */}
    <SearchPalette />
    <!-- Obrolan — shopper ⇄ merchant chat. Mounted once here so the bubble is on every page. -->
    <Chat />
  </body>
</html>
