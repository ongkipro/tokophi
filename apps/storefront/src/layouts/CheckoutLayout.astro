---
// CHECKOUT CHROME — the tunnel. Deliberately NOT Layout.astro.
//
// ADR 0009 §4: checkout is LOCKED. The layout belongs to the platform; the merchant gets branding
// TOKENS only (logo + brand colour). This is the Shopify line — `checkoutBrandingUpsert` lets a
// merchant set a logo and colours and nothing else; the structure is Shopify's. Same here: if this
// ever becomes a `page_templates` type, we hand the one screen that takes money to drag-and-drop.
//
// What Layout.astro renders that this file must NOT:
//   · Header — mega menu, category links, cart pill. Every one is an exit at the most expensive
//     point in the funnel. The shopper is 30 seconds from paying; do not offer them "Kategori".
//   · Footer — a link farm, same reason.
//   · Chat — dropped from checkout by decision (2026-07-16). It was the one arguable keep (a question
//     answered is a sale saved), but it is also a conversation that pauses a payment, and there is no
//     one guaranteed to be on the other end.
// The exits here are CHOSEN, not absent (updated 2026-07-16): the logo → home, and a cart link →
// /keranjang, which is also what "Kembali ke keranjang" in the summary does. What stays banned is the
// nav — a mega menu is a shelf of destinations, and this screen is not for browsing.
//
// Analytics STAYS. Checkout is the whole point of the funnel — dropping the tracking here would blind
// /analitik exactly where it matters.
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import { mediaUrl } from "../data/catalog";

interface Props {
  title: string;
  description?: string;
}

// Tenant resolved per-request from the Host header (src/middleware.ts).
const { store, catalog } = Astro.locals;
const BRAND_SHADES = catalog.brandShades;
const { title, description } = Astro.props;

// The merchant's logo, or their name as a wordmark when stores.logo_url is null. This — plus the
// brand colour below — is the ENTIRE per-store variance of the checkout, by design.
const LOGO = store.logoUrl ? mediaUrl(store.logoUrl) : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — {store.name}</title>
    {description && <meta name="description" content={description} />}

    <!-- No canonical, no Open Graph. Nothing links to a checkout and nobody shares one — those tags
         exist to win a crawl or a WhatsApp preview card, and neither applies here.

         robots.txt already disallows /checkout (src/pages/robots.txt.ts) and that is the primary
         instruction; Google will not fetch this page and so will never read the tag below. It is here
         for the crawlers that fetch anyway — robots.txt is a request, this is on the page itself. -->
    <meta name="robots" content="noindex,nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- ADR 0009 — the merchant's brand colour. Declared after global.css so these custom properties
         win the cascade; every bg-brand-*/text-brand-* utility on the page reads them via var(). -->
    <style set:html={`:root { ${Object.entries(BRAND_SHADES).map(([shade, hex]) => `--color-brand-${shade}: ${hex};`).join(" ")} }`} />
    <!-- CHECKOUT SURFACE — NEUTRAL, not the storefront's cream.
         The shop is warm on purpose (`--color-cream` #faf6f2, a tinted paper). A checkout should be
         the opposite: white, quiet, and out of the way, so the only colour left on screen is the
         merchant's brand on the one button that matters. Cream also made "white form vs recessed
         panel" a contrast between two nearly identical warm tones.
         Scoped to the checkout, NOT changed globally — the storefront's cream is the shop's identity
         and none of this may leak into it. The brand shades above still apply: surface is the
         platform's, colour is the merchant's. -->
    <style is:global>
      :root {
        --co-panel: #f5f5f5; /* the recessed summary column */
        --co-line: #e3e3e3;  /* hairlines — neutral, not the storefront's warm --color-line */
      }
    </style>
    <Analytics />
  </head>
  <!-- No `bg-white` on <body> — it would be a DEAD CLASS. global.css sets `body { background: cream }`
       unlayered, and Tailwind v4 emits utilities inside `@layer utilities`; an unlayered rule beats
       every layered one regardless of specificity, so the utility loses silently. The column
       backgrounds are set on <main>/<aside> instead, which nothing unlayered targets.
       (This note is an HTML comment on purpose: a `{/* … */}` JSX comment placed between </head> and
       <body> is NOT a comment — Astro renders it as text, straight onto the top of the page.) -->
  <body class="min-h-screen text-ink antialiased">
    <!-- TWO COLUMNS, the way Shopify's checkout is built: a WHITE form column and a RECESSED summary
         panel that bleeds to the right edge of the viewport and runs the full height. The panel is
         not a card — it is the page. That single relationship (form bright, summary quiet, a hairline
         between them) is most of what reads as "clean"; our version had every section in its own
         rounded card floating on cream, which is six competing rectangles instead of two zones.
         Each column keeps its content in an inner max-width box aligned to the centre gutter, so the
         two meet in the middle rather than drifting apart on a wide screen. -->

    <!-- The logo LINKS HOME (user's call, 2026-07-16). It was deliberately inert — the tunnel
         argument: home is an exit at the most expensive point in the funnel. That reasoning stands,
         but a shop's mark is the one thing every shopper expects to be clickable, and an unclickable
         one reads as broken rather than as focused. The cart link on the right makes the trade
         explicit: the exits here are chosen, not absent.
         The "Pembayaran aman" badge is gone. It sat where a shopper looks for their cart, and a
         platform asserting its own trustworthiness in a corner is the weakest possible place to
         spend that space — the padlock in the address bar already says it, and better. -->
    {/* The logo aligns with the FORM column and the cart sits at the far RIGHT of the page — the cart
        used to be `ml-auto` inside the form column's own 36rem box, so on a wide screen it landed
        mid-canvas and read as floating rather than as the header's right-hand control.
        One flex row on a phone; on `lg` the same two columns as the body below, so each end lands
        where its column does. ONE cart link either way — no `lg:hidden` twin to keep in sync. */}
    <header class="border-b border-[var(--co-line)] bg-white">
      <div class="flex items-center px-4 py-4 sm:px-6 lg:grid lg:grid-cols-2 lg:px-0 lg:py-0">
        <div class="flex min-w-0 lg:justify-end lg:py-4">
          {/* `lg:pl-6` matches the form column's own `sm:px-6`, so the logo starts on the SAME x as
              the first field (measured: both 168px at 1440). Without it the box is flush at 144 and
              the wordmark hangs 24px left of everything under it. */}
          <div class="flex w-full items-center lg:max-w-xl lg:pl-6 lg:pr-10">
            <a
              href="/"
              class="shrink-0 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
              aria-label={`Beranda ${store.name}`}
            >
              {
                LOGO ? (
                  <img src={LOGO} alt={store.name} class="h-9 w-auto max-w-[12rem] object-contain sm:h-10" />
                ) : (
                  <span class="font-display text-xl font-semibold tracking-tight text-ink sm:text-2xl">
                    {store.name}
                  </span>
                )
              }
            </a>
          </div>
        </div>
        {/* Back to the cart they came from — the same destination as "Kembali ke keranjang" in the
            summary. One intent, two places, no third idea. */}
        <div class="ml-auto flex min-w-0 lg:ml-0 lg:justify-start lg:py-4">
          <div class="flex w-full items-center lg:max-w-md lg:px-10">
            <a
              href="/keranjang"
              class="ml-auto inline-flex shrink-0 items-center gap-2 rounded-md p-1.5 text-sm font-medium text-muted transition-colors hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
              aria-label="Kembali ke keranjang"
            >
              <span class="relative inline-flex">
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-none stroke-current" stroke-width="1.6" aria-hidden="true">
                  <path d="M2.5 3h1.6l1.5 12.5a1.5 1.5 0 0 0 1.5 1.3h9.3a1.5 1.5 0 0 0 1.47-1.2l1.4-7.3H6" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="9" cy="20" r="1.2" fill="currentColor" stroke="none" />
                  <circle cx="17" cy="20" r="1.2" fill="currentColor" stroke="none" />
                </svg>
                {/* The count. Hidden until JS has actually read the cart — a hard-coded "0" would be
                    a lie for the ~always case where the cart has something in it, and it would flash
                    that lie on every load. */}
                <span
                  id="checkout-cart-count"
                  hidden
                  class="absolute -right-2 -top-2 inline-flex min-w-4 items-center justify-center rounded-full bg-brand-600 px-1 text-[10px] font-semibold leading-4 text-white tabular-nums"
                ></span>
              </span>
              <span class="hidden sm:inline">Keranjang</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <script is:inline>
      // The cart badge. `localStorage.cart` is the same store `/keranjang` and the checkout summary
      // read — there is no server-side cart — so this counts UNITS, not lines: two of one dress is
      // "2", which is what the summary's thumbnails also say.
      (function () {
        var el = document.getElementById("checkout-cart-count");
        if (!el) return;
        try {
          var n = JSON.parse(localStorage.getItem("cart") || "[]").reduce(function (t, i) {
            return t + (Number(i && i.qty) || 1);
          }, 0);
          if (n > 0) {
            el.textContent = String(n);
            el.hidden = false;
          }
        } catch (e) {
          /* a corrupt cart must never break the page the shopper is paying on */
        }
      })();
    </script>

    {/* No `items-start`: the cells must STRETCH so the white form column and the recessed panel both
         run the full height of the row. With items-start each cell shrank to its content and the two
         zones stopped being zones. */}
    <div class="lg:grid lg:grid-cols-2">
      {/* SUMMARY. `order-first` on mobile keeps the collapsed total bar at the very top (the phone
          pattern); on desktop it is the right column. Explicit col/row placement rather than source
          order, because the two must not fight over which cell they land in. */}
      <aside class="order-first border-b border-[var(--co-line)] bg-[var(--co-panel)] lg:order-none lg:col-start-2 lg:row-start-1 lg:min-h-[calc(100vh-4.5rem)] lg:border-b-0 lg:border-l">
        <div class="w-full px-4 sm:px-6 lg:sticky lg:top-0 lg:max-w-md lg:px-10 lg:py-10">
          <slot name="summary" />
        </div>
      </aside>

      {/* The BRIGHT zone. White against the panel's cream is the whole contrast the reference is
           built on — on cream-vs-cream the hairline divider was carrying it alone, and losing. */}
      <main class="bg-white lg:col-start-1 lg:row-start-1 lg:flex lg:justify-end">
        <div class="w-full px-4 py-8 sm:px-6 lg:max-w-xl lg:py-10 lg:pr-10">
          <slot />
        </div>
      </main>
    </div>

    <!-- Minimal by intent: no policy links invented here. If the merchant has such pages they belong
         in the storefront footer, not fabricated into the checkout. -->
    {/* `bg-white` explicitly: without it the storefront's warm cream shows through from <body> (which
         cannot be overridden there — see the note above), leaving a tinted strip under a page that is
         otherwise neutral. */}
    <footer class="border-t border-[var(--co-line)] bg-white">
      <div class="lg:grid lg:grid-cols-2">
        <div class="lg:flex lg:justify-end">
          <div class="w-full px-4 py-6 text-xs text-muted sm:px-6 lg:max-w-xl lg:pr-10">
            {store.name} — Ditenagai TokoΦ
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
