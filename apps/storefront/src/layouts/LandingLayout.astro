---
// Standalone FULL landing layout — same <head> (SEO/OG, fonts, brand colours, analytics) as Layout,
// but NO site chrome: no Header nav, no Footer, no Chat bubble, no skip-link. A direct-order funnel
// (/promo/<handle>) is meant to hold attention on ONE product and ONE call to action; the storefront
// menu is exactly the distraction it must not have. Analytics stays — funnel traffic is the whole
// point of tracking.
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import MarketingPixels from "../components/MarketingPixels.astro";
import ImageFallback from "../components/ImageFallback.astro";
import ThemeTokens from "../components/ThemeTokens.astro";
import { mediaUrl } from "../data/catalog";
import { clamp } from "../lib/text";

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
}

const { store, origin } = Astro.locals;
const { title, description = store.tagline, image, robots } = Astro.props;

const fullTitle = `${title} - ${store.name}`;

const desc = clamp(description);
const canonical = new URL(Astro.url.pathname, origin).href;
const favicon = store.faviconUrl ? mediaUrl(store.faviconUrl) : null;
const ogImage = (() => {
  // ⚠️ `mediaUrl()` on the LOGO. `store.logoUrl` is the relative `/api/uploads/<name>` the admin
  // writes, and that path is served by the ADMIN app — resolving it against the STOREFRONT origin
  // produced a 404 on every share. The favicon fifteen lines up already does this; the og:image did
  // not. Measured: `/`, `/produk`, `/kontak` and every `/halaman/*` all shared a broken thumbnail,
  // because they carry no explicit image and fall through to the logo — which is the first thing
  // onboarding asks a merchant to upload. `image` is passed already-absolute by its callers.
  const src = image || (store.logoUrl ? mediaUrl(store.logoUrl) : "") || "";
  if (!src) return null;
  try {
    return new URL(src, origin).href;
  } catch {
    return null;
  }
})();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {favicon
      ? <link rel="icon" href={favicon} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />}
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {
      ogImage && (
        <Fragment>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:alt" content={fullTitle} />
          <meta name="twitter:image" content={ogImage} />
        </Fragment>
      )
    }
    {/* Inter is SELF-HOSTED (see styles/global.css). The Google Fonts <link> that used to sit here was
        render-blocking for 1.409 ms on production, in front of an LCP that was 82% render delay.
        `preload` because the font is referenced from inside a stylesheet, so the browser would
        otherwise only discover it after parsing the CSS. latin only — latin-ext is fetched on demand
        by unicode-range and preloading it would download 84 KB almost nobody needs. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Merchant design tokens (brand shades + chosen neutrals/display font) — shared with Layout.astro. */}
    <ThemeTokens />
    <Analytics />
    {/* ⚠️ THE AD FUNNEL'S OWN LAYOUT MUST CARRY THE AD PIXELS. This was missing, so /promo/<handle>,
        /lp/<slug> and /thanks — the pages a merchant sends PAID traffic to, and the page where that
        traffic converts — fired nothing at all: no PageView, no ViewContent, no InitiateCheckout, no
        Purchase, and no `ttclid` capture (which only happens on a landing page and which the checkout
        reads back later). A store with no CAPI token recorded ZERO conversions from its ad funnel while
        build, lint and `astro check` stayed green. Same class of miss as CheckoutLayout's, one layout
        over: the note there says "every layout a shopper can convert under" — this is one of them. */}
    <MarketingPixels />
    <ImageFallback />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <slot />
  </body>
</html>
