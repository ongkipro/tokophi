---
// Header override (spec §6.4 C1): wordmark "Toko" + the Φ mark, "Panduan", primary nav, and the
// two Seller entry points. Search is deliberately NOT here (owner ruling 2026-10-12): it lives in the
// home hero and at the top of the sidebar.
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import Lucide from "./Lucide.astro";

const path = Astro.url.pathname;
const nav = [
  { label: "Mulai", href: "/mulai/", match: "/mulai/" },
  { label: "Referensi", href: "/referensi/kamus/", match: "/referensi/" },
  { label: "FAQ", href: "/faq/", match: "/faq/" },
];
const APP = "https://app.tokophi.com";
---

<div class="tp-header">
  <a href="/" class="tp-brand" aria-label="Panduan TokoΦ, ke beranda">
    <span class="tp-word">Toko<span class="tp-mark" aria-hidden="true">Φ</span></span>
    <span class="tp-section">Panduan</span>
  </a>

  <nav class="tp-nav" aria-label="Navigasi utama">
    {nav.map((n) => (
      <a href={n.href} aria-current={path.startsWith(n.match) ? "page" : undefined}>{n.label}</a>
    ))}
  </nav>

  <div class="tp-actions print:hidden">
    <div class="tp-theme"><ThemeSelect /></div>
    <a class="tp-btn tp-btn-ghost" href={`${APP}/daftar`}>Daftar gratis</a>
    <a class="tp-btn tp-btn-solid" href={`${APP}/login`}>Masuk</a>
    {/* Phones on pages without a sidebar (the home page) get no Starlight menu button; this native
        <details> menu is that missing navigation (review round 2). */}
    <details class="tp-mnav">
      <summary aria-label="Buka menu"><Lucide name="menu" size={20} /></summary>
      <nav aria-label="Menu">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={`${APP}/daftar`}>Daftar gratis</a>
      </nav>
    </details>
  </div>
</div>

<style>
  .tp-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }
  .tp-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--sl-color-white);
    min-width: 0;
  }
  .tp-word {
    display: inline-flex;
    align-items: center;
    gap: 0.05rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .tp-mark {
    color: var(--sl-color-accent);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1;
  }
  :global([data-theme="dark"]) .tp-mark { color: var(--sl-color-accent-high); }
  .tp-section {
    padding-left: 0.75rem;
    border-left: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
  }
  .tp-nav {
    display: none;
    gap: 1.5rem;
  }
  .tp-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .tp-nav a:hover { color: var(--sl-color-white); }
  .tp-nav a[aria-current="page"] {
    color: var(--sl-color-white);
    border-bottom-color: var(--sl-color-accent);
  }
  .tp-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }
  .tp-theme { display: flex; margin-inline-end: 0.25rem; }
  .tp-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.9rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .tp-btn-ghost {
    display: none;
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
  }
  .tp-btn-ghost:hover { border-color: var(--sl-color-gray-3); }
  .tp-btn-solid {
    background: var(--sl-color-accent);
    color: #fff;
  }
  :global([data-theme="dark"]) .tp-btn-solid { color: #111; }
  .tp-btn-solid:hover { background: var(--sl-color-accent-high); }
  :global([data-theme="dark"]) .tp-btn-solid:hover { color: #111; }
  .tp-btn:focus-visible, .tp-nav a:focus-visible, .tp-brand:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .tp-mnav { display: none; position: relative; }
  :global(:root:not([data-has-sidebar])) .tp-mnav { display: block; }
  .tp-mnav summary {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    list-style: none;
  }
  .tp-mnav summary::-webkit-details-marker { display: none; }
  .tp-mnav summary:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .tp-mnav[open] summary { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
  .tp-mnav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    display: grid;
    min-width: 12rem;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    box-shadow: 0 12px 32px -12px rgb(15 23 42 / 0.3);
  }
  .tp-mnav nav a {
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }
  .tp-mnav nav a:hover, .tp-mnav nav a:focus-visible { outline: none; background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  @media (min-width: 50rem) {
    :global(:root:not([data-has-sidebar])) .tp-mnav { display: none; }
    .tp-nav { display: flex; }
    .tp-btn-ghost { display: inline-flex; }
  }
</style>
