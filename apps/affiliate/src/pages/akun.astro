---
// Akun: who is signed in, change password (revokes every other session), sign out.
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import PasswordField from "../components/PasswordField.astro";
import ForgotPassword from "../components/ForgotPassword.astro";
import { db } from "@tokophi/db";
import { changePassword, PASSWORD_MIN } from "../data/auth";
import { signInUrl } from "../lib/nav";
import { initials } from "../lib/view";

const account = Astro.locals.account;
const sessionId = Astro.locals.sessionId;
if (!account || !sessionId) return Astro.redirect(signInUrl(Astro.url));
let error: { field: "current" | "next"; text: string } | null = null;
let done: number | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const r = await changePassword(db, account.id, sessionId, String(f.get("current") ?? ""), String(f.get("next") ?? ""));
  if (r.ok) done = r.signedOutOthers;
  else error = { field: r.field, text: r.error };
}
---
<Layout title="Akun" active="akun">
  <div class="stack narrow">
    <header class="page-head"><h1>Akun</h1></header>
    <section class="card stack" aria-label="Profil">
      <div class="title-row">
        <span class="mark" aria-hidden="true">{initials(account.name)}</span>
        <div><span class="prog-name">{account.name}</span><span class="prog-sub">{account.email}</span></div>
      </div>
      <p class="help">WhatsApp <span class="num">{account.phone}</span> — dikirim ke seller setiap kali Anda mendaftar ke toko baru.</p>
    </section>
    <section class="card" aria-labelledby="pw-h">
      <h2 id="pw-h">Ganti kata sandi</h2>
      {done !== null && (
        <p class="notice" role="status"><Icon name="circle-check" /><span>Kata sandi diganti.{done > 0 ? ` ${done} perangkat lain dikeluarkan.` : ""}</span></p>
      )}
      <form method="post" novalidate>
        <input type="text" name="username" value={account.email} autocomplete="username" hidden readonly />
        <div class="field">
          <PasswordField id="current" name="current" label="Kata sandi saat ini" autocomplete="current-password" error={error?.field === "current" ? error.text : null} autofocus={error?.field === "current"} />
        </div>
        <div class="field">
          <PasswordField id="next" name="next" label="Kata sandi baru" autocomplete="new-password" minlength={PASSWORD_MIN} error={error?.field === "next" ? error.text : null} describedBy="next-help" autofocus={error?.field === "next"}>
            <p class="help" id="next-help">Minimal {PASSWORD_MIN} karakter. Perangkat lain yang sedang masuk akan dikeluarkan.</p>
          </PasswordField>
        </div>
        <button class="button primary block" type="submit">Simpan kata sandi</button>
      </form>
      <ForgotPassword />
    </section>
    <form method="post" action="/keluar">
      <button class="button secondary block" type="submit">Keluar dari akun</button>
    </form>
  </div>
</Layout>
