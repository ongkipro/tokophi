---
// Sign in: email + password (ADR 0022). Plain form POST to itself — works with JS off. No password reset
// by email exists (there is no mail provider): the page says who to ask instead.
import Layout from "../layouts/Layout.astro";
import { db } from "@tokophi/db";
import { signInWithPassword } from "../lib/signin";
import { safeNext } from "../lib/nav";
import { AFFILIATE_COOKIE, affiliateCookieOptions, clientIp } from "../lib/session";

const next = safeNext(Astro.url.searchParams.get("next"));
if (Astro.locals.account) return Astro.redirect(next);
let error = "";
let email = "";
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  email = String(f.get("email") ?? "").slice(0, 254);
  const r = await signInWithPassword(db, {
    ip: clientIp(Astro.request, Astro.clientAddress),
    email,
    password: String(f.get("password") ?? ""),
    userAgent: Astro.request.headers.get("user-agent"),
  });
  if (r.ok) {
    Astro.cookies.set(AFFILIATE_COOKIE, r.token, affiliateCookieOptions());
    return Astro.redirect(safeNext(String(f.get("next") ?? "")), 303);
  }
  error = r.error;
}
const signupHref = next === "/" ? "/daftar" : `/daftar?next=${encodeURIComponent(next)}`;
---
<Layout title="Masuk">
  <section class="card narrow">
    <h1>Masuk ke Affiliate TokoΦ</h1>
    <p class="lead">Satu akun untuk jadi affiliate di banyak toko TokoΦ. Akun ini terpisah dari akun belanja Anda.</p>
    <form method="post" novalidate>
      {error && <p class="alert" role="alert">{error}</p>}
      <input type="hidden" name="next" value={next} />
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required value={email} />
      </div>
      <div class="field">
        <label for="password">Kata sandi</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="button primary block" type="submit">Masuk</button>
    </form>
    <p class="help">Lupa kata sandi? Reset lewat email belum tersedia. Hubungi seller toko yang Anda promosikan atau support TokoΦ untuk bantuan.</p>
    <p>Belum punya akun? <a href={signupHref}>Daftar jadi affiliate</a></p>
  </section>
</Layout>
