---
// Not found — also what every "not mine" record answers (another account's programme is
// indistinguishable from an unknown one).
import Layout from "../layouts/Layout.astro";
const signedIn = !!Astro.locals.account;
---
<Layout title="Tidak ditemukan">
  <section class="card narrow">
    <h1>Halaman tidak ditemukan</h1>
    <p class="muted">Alamatnya salah, atau data ini bukan milik akun yang sedang masuk.</p>
    <div class="actions stack-sm">
      {signedIn ? (
        <>
          <a class="button primary" href="/">Kembali ke Ringkasan</a>
          <a class="button secondary" href="/komisi">Lihat komisi</a>
        </>
      ) : (
        <>
          <a class="button primary" href="/masuk">Masuk</a>
          <a class="button secondary" href="/daftar">Daftar jadi affiliate</a>
        </>
      )}
    </div>
  </section>
</Layout>
