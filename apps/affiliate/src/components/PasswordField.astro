---
// A password input with a show/hide toggle. The toggle is client-side only and progressive: it is
// rendered `hidden` and revealed by the script, so without JS the field is a plain password input.
// It never changes what is submitted — only `type="password"` ↔ `type="text"` on this one input.
import Icon from "./Icon.astro";

interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete: "current-password" | "new-password";
  minlength?: number;
  /** Error text for this field (server-side); sets aria-invalid and is linked by aria-describedby. */
  error?: string | null;
  /** Help text id(s) already rendered below by the caller, if any. */
  describedBy?: string;
  autofocus?: boolean;
}
const { id, name, label, autocomplete, minlength, error, describedBy, autofocus } = Astro.props;
const errId = `${id}-err`;
const described = [describedBy, error ? errId : undefined].filter(Boolean).join(" ") || undefined;
---
<label for={id}>{label}</label>
<div class="pw">
  <input
    id={id}
    name={name}
    type="password"
    autocomplete={autocomplete}
    required
    minlength={minlength}
    autocapitalize="none"
    spellcheck="false"
    autofocus={autofocus}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={described}
  />
  <button class="pw-toggle" type="button" data-pw-toggle={id} aria-controls={id} aria-pressed="false" aria-label="Tampilkan kata sandi" hidden>
    <span data-pw-show><Icon name="eye" /></span>
    <span data-pw-hide hidden><Icon name="eye-off" /></span>
  </button>
</div>
{error && <p class="error" id={errId}>{error}</p>}
<slot />
<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>("button[data-pw-toggle]")) {
    const input = document.getElementById(b.dataset.pwToggle!) as HTMLInputElement | null;
    if (!input) continue;
    b.hidden = false;
    const show = b.querySelector<HTMLElement>("[data-pw-show]");
    const hide = b.querySelector<HTMLElement>("[data-pw-hide]");
    b.addEventListener("click", () => {
      const visible = input.type === "password";
      input.type = visible ? "text" : "password";
      b.setAttribute("aria-pressed", String(visible));
      if (show) show.hidden = visible;
      if (hide) hide.hidden = !visible;
    });
  }
  // Back to type=password before submit, so a password manager sees a password field it can save.
  for (const f of document.querySelectorAll("form")) {
    f.addEventListener("submit", () => {
      for (const i of f.querySelectorAll<HTMLInputElement>(".pw input")) i.type = "password";
    });
  }
</script>
