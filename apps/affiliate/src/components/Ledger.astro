---
// The commission ledger. No buyer data: the order is named by its NUMBER only, as text.
// Wide screens: a table. Phones: each row becomes a labelled card (order + status, date · store,
// "Nilai barang" vs "Komisi") — the two money columns are never shown unlabelled side by side.
import { IDR } from "@tokophi/lib/format";
import type { Commission } from "../data/affiliate";
import { STATE_LABEL, dateId, stateText } from "../lib/view";

interface Props {
  rows: Commission[];
  /** /komisi (all programmes) shows the store column; a programme's own page does not. */
  showStore?: boolean;
  caption: string;
}
const { rows, showStore = false, caption } = Astro.props;
---
<div class="card ledger-wrap">
  <table class="ledger">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Pesanan</th>
        <th scope="col">Tanggal</th>
        {showStore && <th scope="col">Toko</th>}
        <th scope="col" class="r">Nilai barang</th>
        <th scope="col" class="r">Komisi</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="c-order"><span class="code">{r.orderNumber}</span></td>
          <td class="c-date num">{dateId(r.placedAt)}{showStore && <span class="store-inline"> · {r.storeName}</span>}</td>
          {showStore && <td class="c-store"><a href={`/toko/${r.affiliateId}`}>{r.storeName}</a></td>}
          <td class="r num c-base" data-label="Nilai barang">{IDR(r.baseIdr)}</td>
          <td class="r num c-comm" data-label="Komisi"><strong>{IDR(r.commissionIdr)}</strong>{r.rateNote && <span class="rate">{r.rateNote}</span>}</td>
          <td class="c-state"><span class={`badge ${STATE_LABEL[r.state].tone}`}>{stateText(r)}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
