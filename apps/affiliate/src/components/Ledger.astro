---
// The commission ledger. No buyer data: the order is named by its NUMBER only, as text.
import { IDR } from "@tokophi/lib/format";
import type { Commission } from "../data/affiliate";
import { STATE_LABEL, dateId, stateText } from "../lib/view";

interface Props {
  rows: Commission[];
  /** /komisi (all programmes) shows the store column; a programme's own page does not. */
  showStore?: boolean;
  caption: string;
}
const { rows, showStore = false, caption } = Astro.props;
---
<div class="card">
  <table class="ledger">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Tanggal</th>
        {showStore && <th scope="col">Toko</th>}
        <th scope="col">Pesanan</th>
        <th scope="col" class="r">Nilai barang</th>
        <th scope="col" class="r">Komisi</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="num">{dateId(r.placedAt)}</td>
          {showStore && <td><a href={`/toko/${r.affiliateId}`}>{r.storeName}</a></td>}
          <td><span class="code">{r.orderNumber}</span></td>
          <td class="r num">{IDR(r.baseIdr)}</td>
          <td class="r num"><strong>{IDR(r.commissionIdr)}</strong>{r.rateNote && <span class="rate">{r.rateNote}</span>}</td>
          <td><span class={`badge ${STATE_LABEL[r.state].tone}`}>{stateText(r)}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
